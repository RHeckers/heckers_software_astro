# Cloudflare Turnstile — get these from https://dash.cloudflare.com → Turnstile
# Site key is PUBLIC (rendered in the browser). Must be prefixed PUBLIC_ so Astro exposes it.
PUBLIC_TURNSTILE_SITE_KEY=your-real-site-key-here

# Secret key is SERVER-ONLY. Set this in the Azure Functions app settings, not here.
# TURNSTILE_SECRET_KEY=your-secret-key-here
