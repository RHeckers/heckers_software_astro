---
/**
 * The one thing the company does, as a diagram, in the order the work
 * really happens: discovery, development, AI integration and deployment,
 * each card naming the milestone it produces (what to build, a proof of
 * concept and demo, a working pilot, production). The rail climbs a step
 * per stage, and the step between the pilot and deployment is drawn as a
 * broken track with "where most stall" under it; the route bridges it.
 * Inline SVG, CSS animation only.
 *
 * One loop (12 s): Discover lights and a comet sets off along the rail,
 * lighting each stage as it arrives and drawing the link after it. At
 * the gap the comet slows, the bridge draws across, the stall label
 * fades, Deploy lights, the beacon ripples and the status pill lands.
 * Then everything resets. The per-stage keyframes are generated from one
 * schedule so the comet and the stages stay in step.
 */
interface Props {
  /** Extra class for the figure, so the page can place it in its grid.
      The page's scoped-style attribute arrives with it and is spread
      onto the figure, so the page's rules for that class apply. */
  class?: string;
  [key: `data-${string}`]: string | undefined;
  caption?: string;
}

const {
  class: className,
  caption = "Most initiatives stall between the pilot and production. We take them that last step, and hand them over to your team.",
  ...rest
} = Astro.props;

/* The steps, each with the milestone it ends in and the width its text
   needs. */
const stages = [
  { label: "Discover", outcome: "what to build first", icon: "search", w: 100 },
  { label: "Develop", outcome: "proof of concept, demo", icon: "code", w: 118 },
  { label: "Integrate AI", outcome: "a working pilot", icon: "spark", w: 100 },
  { label: "Deploy", outcome: "in production", icon: "up", w: 84 },
] as const;

/* Geometry, in viewBox units (560 x 300). The rail climbs one step per
   stage, bottom left to top right. The step after the pilot (Integrate
   AI to Deploy) is wider than the others: that is the gap. */
const STAGE = { h: 66, gap: 20, rise: 44, baseY: 206 };
const GAP_AFTER = 2;
const GAP_WIDTH = 46;
const last = stages.length - 1;
const gapAfter = (i: number) => (i === GAP_AFTER ? GAP_WIDTH : STAGE.gap);
const stageX = (i: number) =>
  12 + stages.slice(0, i).reduce((x, s, j) => x + s.w + gapAfter(j), 0);
const stageY = (i: number) => STAGE.baseY - i * STAGE.rise;
const stageMid = (i: number) => stageX(i) + stages[i].w / 2;
const stageEnd = (i: number) => stageX(i) + stages[i].w;
const rail = (i: number) => stageY(i) + STAGE.h / 2;
const BEACON = { x: 536, y: rail(last) };
const pathEnd = BEACON.x - 14;

/* The step between two stages: an S-curve from the right edge of one to
   the left edge of the next. Its length is sampled so the comet's stops
   can be placed as exact fractions of the path. */
const step = (x1: number, y1: number, x2: number, y2: number) => {
  const c1 = [x1 + (x2 - x1) * 0.55, y1];
  const c2 = [x2 - (x2 - x1) * 0.55, y2];
  const point = (t: number) => {
    const u = 1 - t;
    return [
      u * u * u * x1 + 3 * u * u * t * c1[0] + 3 * u * t * t * c2[0] + t * t * t * x2,
      u * u * u * y1 + 3 * u * u * t * c1[1] + 3 * u * t * t * c2[1] + t * t * t * y2,
    ];
  };
  let len = 0;
  let prev = point(0);
  for (let k = 1; k <= 24; k++) {
    const next = point(k / 24);
    len += Math.hypot(next[0] - prev[0], next[1] - prev[1]);
    prev = next;
  }
  return { d: `C ${c1[0]} ${c1[1]}, ${c2[0]} ${c2[1]}, ${x2} ${y2}`, len };
};

const linkPath = (i: number) =>
  i < last
    ? `M ${stageEnd(i)} ${rail(i)} ${step(stageEnd(i), rail(i), stageX(i + 1), rail(i + 1)).d}`
    : `M ${stageEnd(i)} ${rail(i)} H ${pathEnd}`;
const gapCentre = {
  x: (stageEnd(GAP_AFTER) + stageX(GAP_AFTER + 1)) / 2,
  y: rail(GAP_AFTER) + 50,
};

/* The comet path runs through every stage centre; `at` holds the
   distance to each centre, so the keyframes can stop there exactly. */
const cometParts = [`M ${stageMid(0)} ${rail(0)}`];
const at = [0];
let cometLen = 0;
for (let i = 0; i <= last; i++) {
  cometParts.push(`H ${stageEnd(i)}`);
  cometLen += stageEnd(i) - stageMid(i);
  if (i < last) {
    const s = step(stageEnd(i), rail(i), stageX(i + 1), rail(i + 1));
    cometParts.push(s.d, `H ${stageMid(i + 1)}`);
    cometLen += s.len + stageMid(i + 1) - stageX(i + 1);
    at.push(cometLen);
  } else {
    cometParts.push(`H ${pathEnd}`);
    cometLen += pathEnd - stageEnd(i);
  }
}
const cometPath = cometParts.join(" ");
const along = (i: number) => ((at[i] / cometLen) * 100).toFixed(1);

/*
  Schedule, in percent of the loop. The comet leaves Discover at 10 %,
  reaches Develop at 20 % and Integrate AI at 34 %. The gap takes longer:
  the comet crosses it from 46 % to 56 % while the bridge draws under it,
  Deploy lights at 56 %, and the beacon goes live at 66 %. Each stage
  lights as the comet arrives; each link draws as the comet crosses it.
  The hold ends at 90 %; by 96 % everything is idle again.
*/
const arrive = [6, 20, 34, 56];
const idleBox = "fill: rgba(232, 237, 246, 0.05); stroke: rgba(232, 237, 246, 0.35);";
const litBox = "fill: rgba(47, 125, 209, 0.3); stroke: #2f7dd1;";
const timeline = stages
  .map((_, i) => {
    const on = arrive[i];
    const lit = on + 4;
    const [linkOn, linkDone] =
      i === GAP_AFTER ? [44, 54] : i === last ? [60, 64] : [on + 8, on + 12];
    return `
@keyframes p2p-stage-${i} { 0%, ${on}% { ${idleBox} } ${lit}%, 90% { ${litBox} } 96%, 100% { ${idleBox} } }
@keyframes p2p-halo-${i} { 0%, ${on}% { opacity: 0; } ${lit}%, 90% { opacity: 0.55; } 96%, 100% { opacity: 0; } }
@keyframes p2p-ink-${i} { 0%, ${on}% { color: rgba(232, 237, 246, 0.62); } ${lit}%, 90% { color: #ffffff; } 96%, 100% { color: rgba(232, 237, 246, 0.62); } }
@keyframes p2p-link-${i} { 0%, ${linkOn}% { stroke-dashoffset: 1; } ${linkDone}%, 90% { stroke-dashoffset: 0; } 96%, 100% { stroke-dashoffset: 1; } }
.p2p .stage--${i} .stage__box { animation-name: p2p-stage-${i}; }
.p2p .stage--${i} .stage__halo { animation-name: p2p-halo-${i}; }
.p2p .stage--${i} .stage__ink { animation-name: p2p-ink-${i}; }
.p2p .link--${i} { animation-name: p2p-link-${i}; }`;
  })
  .join("\n");
---

<figure class:list={["p2p", className]} {...rest}>
  <svg
    class="art"
    viewBox="0 0 560 300"
    role="img"
    aria-label="A route from discovery through development and AI integration to deployment, bridging the gap between the pilot and production where most initiatives stall."
    style={`--at-1: ${along(1)}%; --at-2: ${along(2)}%; --at-3: ${along(3)}%`}
  >
    <defs>
      <pattern
        id="p2p-dots"
        width="18"
        height="18"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="1.5" cy="1.5" r="1.1" fill="rgba(232, 237, 246, 0.12)"></circle>
      </pattern>
      <radialGradient id="p2p-fade" cx="50%" cy="50%" r="62%">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#000000"></stop>
      </radialGradient>
      <mask id="p2p-mask">
        <rect width="560" height="300" fill="url(#p2p-fade)"></rect>
      </mask>
      <radialGradient id="p2p-ambient" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(47, 125, 209, 0.22)"></stop>
        <stop offset="1" stop-color="rgba(47, 125, 209, 0)"></stop>
      </radialGradient>
      <radialGradient id="p2p-ambient-live" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(63, 174, 140, 0.28)"></stop>
        <stop offset="1" stop-color="rgba(63, 174, 140, 0)"></stop>
      </radialGradient>
      <filter id="p2p-blur" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="9"></feGaussianBlur>
      </filter>
      <filter id="p2p-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="3"></feGaussianBlur>
      </filter>
    </defs>

    <!-- Backdrop: a dot grid that fades at the edges, and a soft glow
         along the rail that turns green when the work goes live. -->
    <rect
      class="grid"
      width="560"
      height="300"
      fill="url(#p2p-dots)"
      mask="url(#p2p-mask)"></rect>
    <ellipse
      class="ambient"
      cx="280"
      cy={(rail(0) + rail(last)) / 2}
      rx="280"
      ry="90"
      transform={`rotate(-14 280 ${(rail(0) + rail(last)) / 2})`}
      fill="url(#p2p-ambient)"></ellipse>
    <ellipse
      class="ambient ambient--live"
      cx={BEACON.x - 60}
      cy={BEACON.y}
      rx="160"
      ry="90"
      fill="url(#p2p-ambient-live)"></ellipse>

    <text class="eyebrow" x={stageX(0)} y={stageY(0) + STAGE.h + 24}>
      The road to production
    </text>
    <text class="eyebrow eyebrow--end" x={BEACON.x} y={stageY(last) - 18}>
      Live
    </text>

    <!-- The route, faint before it is travelled. The step after the pilot
         is the gap: broken and tinted, with the stall label under it. -->
    <g class="tracks">
      {
        stages.map((_, i) => (
          <path
            class:list={["track", { "track--gap": i === GAP_AFTER }]}
            d={linkPath(i)}
          />
        ))
      }
    </g>
    <text class="stall" x={gapCentre.x} y={gapCentre.y}>
      where most stall
    </text>

    <!-- The rail: four steps, each with an icon, its name and the
         milestone it ends in. -->
    <g class="stages">
      {
        stages.map((stage, i) => (
          <g class={`stage stage--${i}`}>
            <rect
              class="stage__halo"
              x={stageX(i)}
              y={stageY(i)}
              width={stage.w}
              height={STAGE.h}
              rx="12"
              filter="url(#p2p-blur)"
            />
            <rect
              class="stage__box"
              x={stageX(i)}
              y={stageY(i)}
              width={stage.w}
              height={STAGE.h}
              rx="12"
            />
            <g
              class="stage__ink stage__icon"
              transform={`translate(${stageMid(i)} ${stageY(i) + 17})`}
            >
              {stage.icon === "search" && (
                <>
                  <circle cx="-2" cy="-2" r="5" />
                  <path d="M 2 2 L 7 7" />
                </>
              )}
              {stage.icon === "code" && (
                <path d="M -4 -6 L -10 0 L -4 6 M 4 -6 L 10 0 L 4 6" />
              )}
              {stage.icon === "spark" && (
                <>
                  <path d="M -2 -7 L -0.4 -2.4 L 4 -1 L -0.4 0.4 L -2 5 L -3.6 0.4 L -8 -1 L -3.6 -2.4 Z" />
                  <path d="M 6 2 L 6.9 4.1 L 9 5 L 6.9 5.9 L 6 8 L 5.1 5.9 L 3 5 L 5.1 4.1 Z" />
                </>
              )}
              {stage.icon === "up" && (
                <>
                  <path d="M 0 6 V -6 M -5 -1 L 0 -6 L 5 -1" />
                  <path d="M -7 8 H 7" />
                </>
              )}
            </g>
            <text class="stage__ink stage__label" x={stageMid(i)} y={stageY(i) + 41}>
              {stage.label}
            </text>
            <text class="stage__outcome" x={stageMid(i)} y={stageY(i) + 56}>
              {stage.outcome}
            </text>
          </g>
        ))
      }
      {
        stages.map((_, i) => (
          <path
            class:list={["link", `link--${i}`, { "link--bridge": i === GAP_AFTER }]}
            pathLength="1"
            d={linkPath(i)}
          />
        ))
      }
    </g>

    <!-- Production: a beacon that ripples once the work is live. -->
    <g class="beacon">
      <circle class="ring ring--1" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle class="ring ring--2" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle
        class="beacon__glow"
        cx={BEACON.x}
        cy={BEACON.y}
        r="9"
        filter="url(#p2p-glow)"></circle>
      <circle class="beacon__core" cx={BEACON.x} cy={BEACON.y} r="7"></circle>
    </g>

    <!-- The comet and its tail, on the same path. offset-path is set
         inline because it is built from the geometry above. -->
    <circle
      class="comet comet--tail"
      r="9"
      filter="url(#p2p-glow)"
      style={`offset-path: path("${cometPath}")`}></circle>
    <circle
      class="comet comet--head"
      r="4"
      style={`offset-path: path("${cometPath}")`}></circle>

    <g class="status">
      <rect x={BEACON.x - 196} y={BEACON.y + 100} width="196" height="30" rx="15"></rect>
      <circle class="status__dot" cx={BEACON.x - 178} cy={BEACON.y + 115} r="4"></circle>
      <text x={BEACON.x - 164} y={BEACON.y + 119}>Live, handed to your team</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<!-- Per-stage keyframes, generated from the schedule above. Global on
     purpose: keyframe names are page-wide anyway, and every selector is
     rooted at .p2p. -->
<style is:inline set:html={timeline} />

<style>
  .p2p {
    margin: 0;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .art {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: chillax, sans-serif;
    --loop: 12s;
    --ease-soft: cubic-bezier(0.22, 0.61, 0.36, 1);
    --ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .art text {
    font-size: 12.5px;
    font-weight: 500;
    fill: rgba(232, 237, 246, 0.82);
  }

  figcaption {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.55);
    max-width: 44ch;
  }

  .art .eyebrow {
    font-family: synonym, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(232, 237, 246, 0.42);
  }

  .art .eyebrow--end {
    text-anchor: middle;
  }

  /* --- Route --- */

  .track {
    fill: none;
    stroke: rgba(232, 237, 246, 0.16);
    stroke-width: 1.25;
    stroke-dasharray: 3 5;
    stroke-linecap: round;
  }

  /* The gap: a broken, reddish track. */
  .track--gap {
    stroke: rgba(229, 117, 110, 0.55);
    stroke-dasharray: 2 6;
  }

  .art .stall {
    font-family: synonym, sans-serif;
    font-size: 10.5px;
    font-weight: 400;
    text-anchor: middle;
    fill: rgba(229, 117, 110, 0.85);
  }

  .link {
    fill: none;
    stroke: #2f7dd1;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* The bridge over the gap is the point of the picture: a touch heavier. */
  .link--bridge {
    stroke-width: 2.5;
  }

  /* --- Stages --- */

  .stage__box {
    fill: rgba(232, 237, 246, 0.05);
    stroke: rgba(232, 237, 246, 0.35);
    stroke-width: 1.5;
  }

  .stage__halo {
    fill: #2f7dd1;
    opacity: 0;
  }

  .stage__ink {
    color: rgba(232, 237, 246, 0.62);
  }

  .stage__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage__label {
    fill: currentColor;
    text-anchor: middle;
  }

  .art .stage__outcome {
    font-family: synonym, sans-serif;
    font-size: 9.5px;
    font-weight: 400;
    text-anchor: middle;
    fill: rgba(232, 237, 246, 0.5);
  }

  /* --- Beacon --- */

  .beacon__core {
    fill: #3fae8c;
    opacity: 0.35;
  }

  .beacon__glow {
    fill: #3fae8c;
    opacity: 0;
  }

  .ring {
    fill: none;
    stroke: #3fae8c;
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ambient--live {
    opacity: 0;
  }

  /* --- Comet --- */

  .comet {
    fill: #ffffff;
    opacity: 0;
  }

  .comet--tail {
    fill: #7fb6ef;
  }

  /* --- Status pill --- */

  .status {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .status rect {
    fill: rgba(232, 237, 246, 0.06);
    stroke: rgba(232, 237, 246, 0.16);
    stroke-width: 1;
  }

  .status text {
    fill: var(--color-ink-light);
    font-size: 12px;
  }

  .status__dot {
    fill: #3fae8c;
  }

  /* --- The loop --- */

  .stage__box,
  .stage__halo,
  .stage__ink,
  .link,
  .stall,
  .beacon__core,
  .beacon__glow,
  .ring,
  .ambient--live,
  .comet,
  .status {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .link {
    animation-timing-function: var(--ease-soft);
  }

  .stall {
    animation-name: p2p-stall;
  }

  .beacon__core {
    animation-name: p2p-beacon-core;
  }

  .beacon__glow {
    animation-name: p2p-beacon-glow;
  }

  .ambient--live {
    animation-name: p2p-ambient-live;
  }

  .ring--1 {
    animation-name: p2p-ring-1;
    animation-timing-function: ease-out;
  }

  .ring--2 {
    animation-name: p2p-ring-2;
    animation-timing-function: ease-out;
  }

  .comet {
    animation-name: p2p-comet;
    animation-timing-function: linear;
  }

  /* The tail runs the same schedule a moment behind the head. */
  .comet--tail {
    animation-delay: 0.1s;
  }

  .status {
    animation-name: p2p-status;
    animation-timing-function: var(--ease-pop);
  }

  /* The comet reaches each stage as that stage switches on: 20 %, 34 %,
     then crosses the gap slowly to Deploy at 56 % and reaches the beacon
     at 66 %. The stops are the stage centres as fractions of the path,
     set inline on the svg from the geometry. */
  @keyframes p2p-comet {
    0%,
    7% {
      offset-distance: 0%;
      opacity: 0;
    }
    9%,
    10% {
      offset-distance: 0%;
      opacity: 1;
    }
    20% {
      offset-distance: var(--at-1);
    }
    34% {
      offset-distance: var(--at-2);
    }
    46% {
      offset-distance: var(--at-2);
    }
    56% {
      offset-distance: var(--at-3);
    }
    66% {
      offset-distance: 100%;
      opacity: 1;
    }
    69%,
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  /* The stall label gives way once the bridge is across. */
  @keyframes p2p-stall {
    0%,
    50% {
      opacity: 1;
    }
    57%,
    92% {
      opacity: 0;
    }
    98%,
    100% {
      opacity: 1;
    }
  }

  @keyframes p2p-beacon-core {
    0%,
    65% {
      opacity: 0.35;
    }
    69%,
    90% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0.35;
    }
  }

  @keyframes p2p-beacon-glow {
    0%,
    65% {
      opacity: 0;
    }
    69%,
    90% {
      opacity: 0.9;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @keyframes p2p-ambient-live {
    0%,
    65% {
      opacity: 0;
    }
    72%,
    90% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  /* Two ripples each while the work is live. */
  @keyframes p2p-ring-1 {
    0%,
    66% {
      transform: scale(0.5);
      opacity: 0;
    }
    67% {
      opacity: 0.8;
    }
    76% {
      transform: scale(2.4);
      opacity: 0;
    }
    77% {
      transform: scale(0.5);
      opacity: 0.8;
    }
    86%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes p2p-ring-2 {
    0%,
    71% {
      transform: scale(0.5);
      opacity: 0;
    }
    72% {
      opacity: 0.6;
    }
    81% {
      transform: scale(2.4);
      opacity: 0;
    }
    82% {
      transform: scale(0.5);
      opacity: 0.6;
    }
    90%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes p2p-status {
    0%,
    69% {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
    }
    75%,
    90% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
    }
  }

  /* Reduced motion: the finished picture, nothing moving. */
  @media (prefers-reduced-motion: reduce) {
    .art * {
      animation: none !important;
    }

    .stage__box {
      fill: rgba(47, 125, 209, 0.3);
      stroke: #2f7dd1;
    }

    .stage__halo {
      opacity: 0.4;
    }

    .stage__ink {
      color: #ffffff;
    }

    .link {
      stroke-dashoffset: 0;
    }

    .stall {
      opacity: 0;
    }

    .beacon__core,
    .ambient--live,
    .status {
      opacity: 1;
      transform: none;
    }

    .beacon__glow {
      opacity: 0.9;
    }

    .comet,
    .ring {
      display: none;
    }
  }
</style>
