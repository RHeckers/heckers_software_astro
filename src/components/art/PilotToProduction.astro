---
/**
 * The one thing the company does, as a route map: a main line along the
 * bottom (Discover, Develop, Validate, Deploy) with the milestones each
 * step produces stacked above it. Discovery climbs into a proof of
 * concept and comes down into development; development climbs into
 * integrations and then AI integration and comes down into validation;
 * validation climbs into a demo and then a pilot and comes down into
 * deployment. The descent from AI integration into validation is drawn
 * as a broken track with "where most projects stall" under it; the route
 * bridges it. Main-line stops are solid pills; the stacked stops are
 * dashed and dim until the route reaches them. Inline SVG, CSS only.
 *
 * One loop (14 s): a comet runs the whole route, lighting each stop as
 * it arrives and drawing the link after it. It halts at the top of the
 * development stack, the bridge draws down into Validate, the stall
 * label fades, and at the end the beacon ripples and the status pill
 * lands. Then everything resets. Every keyframe that depends on a stop
 * is generated below from one schedule.
 */
interface Props {
  /** Extra class for the figure, so the page can place it in its grid.
      The page's scoped-style attribute arrives with it and is spread
      onto the figure, so the page's rules for that class apply. */
  class?: string;
  [key: `data-${string}`]: string | undefined;
  caption?: string;
}

const {
  class: className,
  caption = "Most initiatives stall between a working integration and a validated pilot. We take them the whole way to production, and hand them over to your team.",
  ...rest
} = Astro.props;

/* The stops, in route order. `col` is the main-line step they belong
   to, `row` how high they sit above it (0 is the main line). Widths fit
   the labels. */
const stops = [
  { label: "Discover", col: 0, row: 0, w: 108 },
  { label: "Proof of concept", col: 0, row: 1, w: 124 },
  { label: "Develop", col: 1, row: 0, w: 108 },
  { label: "Integrations", col: 1, row: 1, w: 116 },
  { label: "Integrate AI", col: 1, row: 2, w: 116 },
  { label: "Validate", col: 2, row: 0, w: 108 },
  { label: "Demo", col: 2, row: 1, w: 96 },
  { label: "Pilot", col: 2, row: 2, w: 96 },
  { label: "Deploy", col: 3, row: 0, w: 100 },
] as const;

/* Geometry, in viewBox units (600 x 340). */
const COL_X = [72, 212, 380, 512];
const PILL = { h: 40, rx: 20 };
const ROW_TOP = 236;
const ROW_GAP = 64;
const rowTop = (row: number) => ROW_TOP - row * ROW_GAP;
const cx = (i: number) => COL_X[stops[i].col];
const cy = (i: number) => rowTop(stops[i].row) + PILL.h / 2;
const left = (i: number) => cx(i) - stops[i].w / 2;
const right = (i: number) => cx(i) + stops[i].w / 2;
const last = stops.length - 1;
const GAP_AFTER = 4; // Integrate AI → Validate
const BEACON = { x: 586, y: cy(last) };
const pathEnd = BEACON.x - 12;

/* A descent from the top of one stack to the next main-line stop: an
   S-curve with horizontal tangents from the right edge of the one to the
   left edge of the other. Its length is sampled so the comet's stops can
   be placed as exact fractions of the path. */
const curve = (x1: number, y1: number, x2: number, y2: number) => {
  const c1 = [x1 + (x2 - x1) * 0.5, y1];
  const c2 = [x2 - (x2 - x1) * 0.5, y2];
  const point = (t: number) => {
    const u = 1 - t;
    return [
      u * u * u * x1 + 3 * u * u * t * c1[0] + 3 * u * t * t * c2[0] + t * t * t * x2,
      u * u * u * y1 + 3 * u * u * t * c1[1] + 3 * u * t * t * c2[1] + t * t * t * y2,
    ];
  };
  let len = 0;
  let prev = point(0);
  for (let k = 1; k <= 32; k++) {
    const next = point(k / 32);
    len += Math.hypot(next[0] - prev[0], next[1] - prev[1]);
    prev = next;
  }
  return { d: `C ${c1[0]} ${c1[1]}, ${c2[0]} ${c2[1]}, ${x2} ${y2}`, len };
};

/* The link after stop i: straight up within a stack, a descent to the
   next column otherwise, and a short run to the beacon at the end. */
const climbs = (i: number) => i < last && stops[i + 1].col === stops[i].col;
const linkPath = (i: number) => {
  if (i === last) return `M ${cx(i)} ${cy(i)} H ${pathEnd}`;
  if (climbs(i)) return `M ${cx(i)} ${cy(i)} V ${cy(i + 1)}`;
  return `M ${right(i)} ${cy(i)} ${curve(right(i), cy(i), left(i + 1), cy(i + 1)).d}`;
};

/* The comet path runs the whole route through every stop centre; `at`
   holds the distance to each centre, so the keyframes halt there. */
const parts = [`M ${cx(0)} ${cy(0)}`];
const at = [0];
let total = 0;
for (let i = 0; i < last; i++) {
  if (climbs(i)) {
    parts.push(`V ${cy(i + 1)}`);
    total += Math.abs(cy(i + 1) - cy(i));
  } else {
    const c = curve(right(i), cy(i), left(i + 1), cy(i + 1));
    parts.push(`H ${right(i)}`, c.d, `H ${cx(i + 1)}`);
    total += stops[i].w / 2 + c.len + stops[i + 1].w / 2;
  }
  at.push(total);
}
parts.push(`H ${pathEnd}`);
total += pathEnd - cx(last);
const cometPath = parts.join(" ");
const along = (i: number) => ((at[i] / total) * 100).toFixed(2);

/*
  Schedule, in percent of the loop. The comet leaves Discover at 8 % and
  reaches the next stops at the times below. It halts at the top of the
  development stack, then takes the long drop into Validate (35 – 43 %)
  while the bridge draws under it, and reaches the beacon at 72 %. Each
  stop lights as the comet arrives; each link draws as the comet runs it.
  The hold ends at 90 %; by 96 % everything is idle again.
*/
const arrive = [5, 13, 20, 27, 33, 44, 51, 58, 65];
const HALT_UNTIL = 35;
const BEACON_AT = 72;

/* Main-line stops are solid; the stacked stops are dashed and dimmer,
   like something not yet certain, until the route reaches them. */
const isSub = (i: number) => stops[i].row > 0;
const idleFor = (i: number) =>
  isSub(i)
    ? "fill: rgba(232, 237, 246, 0.03); stroke: rgba(232, 237, 246, 0.3); stroke-dasharray: 5 5;"
    : "fill: rgba(232, 237, 246, 0.05); stroke: rgba(232, 237, 246, 0.35);";
const litFor = (i: number) =>
  isSub(i)
    ? "fill: rgba(47, 125, 209, 0.3); stroke: #2f7dd1; stroke-dasharray: 10 0;"
    : "fill: rgba(47, 125, 209, 0.3); stroke: #2f7dd1;";
const inkIdle = (i: number) =>
  isSub(i) ? "rgba(232, 237, 246, 0.5)" : "rgba(232, 237, 246, 0.7)";
const stopCss = stops
  .map((_, i) => {
    const on = arrive[i];
    const full = on + 3;
    const idle = idleFor(i);
    const lit = litFor(i);
    const [linkOn, linkDone] =
      i === GAP_AFTER
        ? [HALT_UNTIL, arrive[i + 1] - 1]
        : i === last
          ? [BEACON_AT - 5, BEACON_AT - 1]
          : [on + 2, arrive[i + 1]];
    return `
@keyframes p2p-stop-${i} { 0%, ${on}% { ${idle} } ${full}%, 90% { ${lit} } 96%, 100% { ${idle} } }
@keyframes p2p-halo-${i} { 0%, ${on}% { opacity: 0; } ${full}%, 90% { opacity: 0.5; } 96%, 100% { opacity: 0; } }
@keyframes p2p-ink-${i} { 0%, ${on}% { fill: ${inkIdle(i)}; } ${full}%, 90% { fill: #ffffff; } 96%, 100% { fill: ${inkIdle(i)}; } }
@keyframes p2p-link-${i} { 0%, ${linkOn}% { stroke-dashoffset: 1; } ${linkDone}%, 90% { stroke-dashoffset: 0; } 96%, 100% { stroke-dashoffset: 1; } }
.p2p .stop--${i} .stop__box { animation-name: p2p-stop-${i}; }
.p2p .stop--${i} .stop__halo { animation-name: p2p-halo-${i}; }
.p2p .stop--${i} .stop__label { animation-name: p2p-ink-${i}; }
.p2p .link--${i} { animation-name: p2p-link-${i}; }`;
  })
  .join("\n");

/* The comet: invisible at the start, visible from 8 %, at each stop at
   its arrival time, a halt before the gap, then the beacon. */
const cometFrames = [
  `0%, 6% { offset-distance: 0%; opacity: 0; }`,
  `8% { offset-distance: 0%; opacity: 1; }`,
  ...stops.slice(1).map((_, k) => {
    const i = k + 1;
    const hold = i === GAP_AFTER ? `, ${HALT_UNTIL}%` : "";
    return `${arrive[i]}%${hold} { offset-distance: ${along(i)}%; }`;
  }),
  `${BEACON_AT}% { offset-distance: 100%; opacity: 1; }`,
  `${BEACON_AT + 3}%, 100% { offset-distance: 100%; opacity: 0; }`,
];
const timeline = `${stopCss}\n@keyframes p2p-comet { ${cometFrames.join(" ")} }`;

/* The stall label sits under the main line, beneath the gap's landing. */
const gapLabel = {
  x: (right(GAP_AFTER) + left(GAP_AFTER + 1)) / 2,
  y: rowTop(0) + PILL.h + 24,
};
---

<figure class:list={["p2p", className]} {...rest}>
  <svg
    class="art"
    viewBox="0 0 600 340"
    role="img"
    aria-label="A route map from discovery to production: discovery climbs into a proof of concept and comes down into development; development climbs into integrations and AI integration and comes down into validation, the drop where most projects stall; validation climbs into a demo and a pilot and comes down into deployment."
  >
    <defs>
      <pattern
        id="p2p-dots"
        width="18"
        height="18"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="1.5" cy="1.5" r="1.1" fill="rgba(232, 237, 246, 0.12)"></circle>
      </pattern>
      <radialGradient id="p2p-fade" cx="50%" cy="50%" r="62%">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#000000"></stop>
      </radialGradient>
      <mask id="p2p-mask">
        <rect width="600" height="340" fill="url(#p2p-fade)"></rect>
      </mask>
      <radialGradient id="p2p-ambient" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(47, 125, 209, 0.2)"></stop>
        <stop offset="1" stop-color="rgba(47, 125, 209, 0)"></stop>
      </radialGradient>
      <radialGradient id="p2p-ambient-live" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(63, 174, 140, 0.28)"></stop>
        <stop offset="1" stop-color="rgba(63, 174, 140, 0)"></stop>
      </radialGradient>
      <filter id="p2p-blur" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="8"></feGaussianBlur>
      </filter>
      <filter id="p2p-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="3"></feGaussianBlur>
      </filter>
    </defs>

    <!-- Backdrop: a dot grid that fades at the edges, and a soft glow
         along the route that turns green when the work goes live. -->
    <rect
      class="grid"
      width="600"
      height="340"
      fill="url(#p2p-dots)"
      mask="url(#p2p-mask)"></rect>
    <ellipse
      class="ambient"
      cx="300"
      cy={rowTop(1) + PILL.h / 2}
      rx="310"
      ry="120"
      fill="url(#p2p-ambient)"></ellipse>
    <ellipse
      class="ambient ambient--live"
      cx={BEACON.x - 80}
      cy={BEACON.y - 30}
      rx="180"
      ry="120"
      fill="url(#p2p-ambient-live)"></ellipse>

    <!-- The main line itself, faint, so the stacks read as detours. -->
    <line
      class="mainline"
      x1={cx(0)}
      y1={cy(0)}
      x2={pathEnd}
      y2={cy(0)}></line>

    <text class="eyebrow" x={left(0)} y="326">The road to production</text>
    <text class="eyebrow eyebrow--end" x={BEACON.x} y={cy(last) - 26}>
      Live
    </text>

    <!-- The route, faint before it is travelled. The drop from AI
         integration into validation is the gap: broken and tinted, with
         the stall label under its landing. -->
    <g class="tracks">
      {
        stops.map((_, i) => (
          <path
            class:list={["track", { "track--gap": i === GAP_AFTER }]}
            d={linkPath(i)}
          />
        ))
      }
    </g>
    <text class="stall" x={gapLabel.x} y={gapLabel.y}>
      where most projects stall
    </text>

    <!-- The travelled route, drawn link by link under the comet. -->
    <g class="links">
      {
        stops.map((_, i) => (
          <path
            class:list={["link", `link--${i}`, { "link--bridge": i === GAP_AFTER }]}
            pathLength="1"
            d={linkPath(i)}
          />
        ))
      }
    </g>

    <!-- The stops. -->
    <g class="stops">
      {
        stops.map((stop, i) => (
          <g class:list={["stop", `stop--${i}`, { "stop--sub": stop.row > 0 }]}>
            <rect
              class="stop__halo"
              x={left(i)}
              y={rowTop(stop.row)}
              width={stop.w}
              height={PILL.h}
              rx={PILL.rx}
              filter="url(#p2p-blur)"
            />
            <rect
              class="stop__box"
              x={left(i)}
              y={rowTop(stop.row)}
              width={stop.w}
              height={PILL.h}
              rx={PILL.rx}
            />
            <text class="stop__label" x={cx(i)} y={rowTop(stop.row) + 25}>
              {stop.label}
            </text>
          </g>
        ))
      }
    </g>

    <!-- Production: a beacon that ripples once the work is live. -->
    <g class="beacon">
      <circle class="ring ring--1" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle class="ring ring--2" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle
        class="beacon__glow"
        cx={BEACON.x}
        cy={BEACON.y}
        r="9"
        filter="url(#p2p-glow)"></circle>
      <circle class="beacon__core" cx={BEACON.x} cy={BEACON.y} r="7"></circle>
    </g>

    <!-- The comet and its tail, on the same path. offset-path is set
         inline because it is built from the geometry above. -->
    <circle
      class="comet comet--tail"
      r="9"
      filter="url(#p2p-glow)"
      style={`offset-path: path("${cometPath}")`}></circle>
    <circle
      class="comet comet--head"
      r="4"
      style={`offset-path: path("${cometPath}")`}></circle>

    <g class="status">
      <rect x={BEACON.x - 206} y="298" width="206" height="32" rx="16"></rect>
      <circle class="status__dot" cx={BEACON.x - 188} cy="314" r="4"></circle>
      <text x={BEACON.x - 174} y="318.5">Live, handed to your team</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<!-- Keyframes generated from the schedule above. Global on purpose:
     keyframe names are page-wide anyway, and every selector is rooted
     at .p2p. -->
<style is:inline set:html={timeline} />

<style>
  .p2p {
    margin: 0;
    width: 100%;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .art {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: chillax, sans-serif;
    --loop: 14s;
    --ease-soft: cubic-bezier(0.22, 0.61, 0.36, 1);
    --ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .art text {
    font-size: 14px;
    font-weight: 500;
    fill: rgba(232, 237, 246, 0.82);
  }

  figcaption {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.55);
    max-width: 48ch;
  }

  .art .eyebrow {
    font-family: synonym, sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(232, 237, 246, 0.42);
  }

  .art .eyebrow--end {
    text-anchor: middle;
  }

  /* --- Route --- */

  .mainline {
    stroke: rgba(232, 237, 246, 0.08);
    stroke-width: 6;
    stroke-linecap: round;
  }

  .track {
    fill: none;
    stroke: rgba(232, 237, 246, 0.18);
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    stroke-linecap: round;
  }

  /* The gap: a broken, reddish track. */
  .track--gap {
    stroke: rgba(229, 117, 110, 0.6);
    stroke-dasharray: 2 6;
  }

  .art .stall {
    font-family: synonym, sans-serif;
    font-size: 11.5px;
    font-weight: 400;
    text-anchor: middle;
    fill: rgba(229, 117, 110, 0.85);
  }

  .link {
    fill: none;
    stroke: #2f7dd1;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* The bridge over the gap is the point of the picture: a touch heavier. */
  .link--bridge {
    stroke-width: 2.75;
  }

  /* --- Stops --- */

  .stop__box {
    fill: rgba(232, 237, 246, 0.05);
    stroke: rgba(232, 237, 246, 0.35);
    stroke-width: 1.5;
  }

  .stop__halo {
    fill: #2f7dd1;
    opacity: 0;
  }

  .stop__label {
    fill: rgba(232, 237, 246, 0.7);
    text-anchor: middle;
  }

  /* Stacked stops: dashed and dimmer until the route reaches them. */
  .stop--sub .stop__box {
    fill: rgba(232, 237, 246, 0.03);
    stroke: rgba(232, 237, 246, 0.3);
    stroke-width: 1.5;
    stroke-dasharray: 5 5;
  }

  .stop--sub .stop__label {
    fill: rgba(232, 237, 246, 0.5);
  }

  /* --- Beacon --- */

  .beacon__core {
    fill: #3fae8c;
    opacity: 0.35;
  }

  .beacon__glow {
    fill: #3fae8c;
    opacity: 0;
  }

  .ring {
    fill: none;
    stroke: #3fae8c;
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ambient--live {
    opacity: 0;
  }

  /* --- Comet --- */

  .comet {
    fill: #ffffff;
    opacity: 0;
  }

  .comet--tail {
    fill: #7fb6ef;
  }

  /* --- Status pill --- */

  .status {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .status rect {
    fill: rgba(232, 237, 246, 0.06);
    stroke: rgba(232, 237, 246, 0.16);
    stroke-width: 1;
  }

  .status text {
    fill: var(--color-ink-light);
    font-size: 13px;
  }

  .status__dot {
    fill: #3fae8c;
  }

  /* --- The loop --- */

  .stop__box,
  .stop__halo,
  .stop__label,
  .link,
  .stall,
  .beacon__core,
  .beacon__glow,
  .ring,
  .ambient--live,
  .comet,
  .status {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  .link {
    animation-timing-function: var(--ease-soft);
  }

  .stall {
    animation-name: p2p-stall;
  }

  .beacon__core {
    animation-name: p2p-beacon-core;
  }

  .beacon__glow {
    animation-name: p2p-beacon-glow;
  }

  .ambient--live {
    animation-name: p2p-ambient-live;
  }

  .ring--1 {
    animation-name: p2p-ring-1;
    animation-timing-function: ease-out;
  }

  .ring--2 {
    animation-name: p2p-ring-2;
    animation-timing-function: ease-out;
  }

  /* The comet's keyframes are generated with the schedule. */
  .comet {
    animation-name: p2p-comet;
    animation-timing-function: linear;
  }

  /* The tail runs the same schedule a moment behind the head. */
  .comet--tail {
    animation-delay: 0.1s;
  }

  .status {
    animation-name: p2p-status;
    animation-timing-function: var(--ease-pop);
  }

  /* The stall label gives way once the bridge is across. */
  @keyframes p2p-stall {
    0%,
    40% {
      opacity: 1;
    }
    46%,
    92% {
      opacity: 0;
    }
    98%,
    100% {
      opacity: 1;
    }
  }

  @keyframes p2p-beacon-core {
    0%,
    71% {
      opacity: 0.35;
    }
    75%,
    90% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0.35;
    }
  }

  @keyframes p2p-beacon-glow {
    0%,
    71% {
      opacity: 0;
    }
    75%,
    90% {
      opacity: 0.9;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @keyframes p2p-ambient-live {
    0%,
    71% {
      opacity: 0;
    }
    78%,
    90% {
      opacity: 1;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  /* Two ripples each while the work is live. */
  @keyframes p2p-ring-1 {
    0%,
    72% {
      transform: scale(0.5);
      opacity: 0;
    }
    73% {
      opacity: 0.8;
    }
    81% {
      transform: scale(2.4);
      opacity: 0;
    }
    82% {
      transform: scale(0.5);
      opacity: 0.8;
    }
    90%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes p2p-ring-2 {
    0%,
    76.5% {
      transform: scale(0.5);
      opacity: 0;
    }
    77.5% {
      opacity: 0.6;
    }
    85.5% {
      transform: scale(2.4);
      opacity: 0;
    }
    86.5% {
      transform: scale(0.5);
      opacity: 0.6;
    }
    92%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }

  @keyframes p2p-status {
    0%,
    75% {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
    }
    81%,
    90% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
    96%,
    100% {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
    }
  }

  /* Reduced motion: the finished picture, nothing moving. */
  @media (prefers-reduced-motion: reduce) {
    .art * {
      animation: none !important;
    }

    .stop__box {
      fill: rgba(47, 125, 209, 0.3);
      stroke: #2f7dd1;
      stroke-dasharray: none;
    }

    .stop__halo {
      opacity: 0.4;
    }

