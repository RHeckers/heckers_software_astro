---
/**
 * The one thing the company does, as a diagram, in the order the work
 * really happens: discovery looks at the pile of stalled pilots and picks
 * the one worth finishing, then build, integration and shipping take it
 * into production. Inline SVG, CSS animation only, no script.
 *
 * One loop (12 s): Discover lights up and a comet climbs from it into the
 * pile; the pilots are scanned one by one and the proof of concept lifts
 * off the pile, lit; the comet comes back down into Build and runs the
 * rail, lighting each stage as it passes; the production beacon ripples
 * when it arrives and the status pill lands. Then everything resets for
 * the next pilot. The per-stage keyframes are generated below, so the
 * slots stay in step with the comet's schedule.
 */
interface Props {
  /** Extra class for the figure, so the page can place it in its grid.
      The page's scoped-style attribute arrives with it and is spread
      onto the figure, so the page's rules for that class apply. */
  class?: string;
  [key: `data-${string}`]: string | undefined;
  caption?: string;
}

const {
  class: className,
  caption = "Most pilots stay a demo. Discovery picks the one worth finishing, and one owner takes it through build and integration into production.",
  ...rest
} = Astro.props;

const stages = [
  { label: "Discover", icon: "search" },
  { label: "Build", icon: "code" },
  { label: "Integrate", icon: "link" },
  { label: "Ship", icon: "arrow" },
] as const;

/* Geometry, in viewBox units (560 x 380). */
const CARD = { w: 176, h: 42 };
/* One aligned list, like a backlog: nothing in it looks chosen until
   discovery picks the bottom one. */
const pilots = [
  { x: 28, y: 24, label: "Demo" },
  { x: 28, y: 76, label: "Pilot" },
  { x: 28, y: 128, label: "Proof of concept", picked: true },
];
const picked = pilots[2];
/* Where the route enters the pile and where it leaves it: both on the
   underside of the picked card, so the comet slides along it while the
   pile is scanned. */
const pileIn = { x: picked.x + 40, y: picked.y + CARD.h };
const pileOut = { x: picked.x + 140, y: picked.y + CARD.h };

const STAGE = { w: 100, h: 56, y: 236, gap: 22 };
const stageX = (i: number) => 16 + i * (STAGE.w + STAGE.gap);
const stageMid = (i: number) => stageX(i) + STAGE.w / 2;
const railY = STAGE.y + STAGE.h / 2;
const BEACON = { x: 528, y: railY };

/* Discover up into the pile, and the pile down into Build. */
const upCurve = `C ${stageMid(0)} ${STAGE.y - 36}, ${pileIn.x} ${pileIn.y + 36}, ${pileIn.x} ${pileIn.y}`;
const downCurve = `C ${pileOut.x} ${pileOut.y + 36}, ${stageMid(1)} ${STAGE.y - 36}, ${stageMid(1)} ${STAGE.y}`;
const leadUpPath = `M ${stageMid(0)} ${STAGE.y} ${upCurve}`;
const leadDownPath = `M ${pileOut.x} ${pileOut.y} ${downCurve}`;
const linkPath = (i: number) =>
  i < stages.length - 1
    ? `M ${stageX(i) + STAGE.w} ${railY} H ${stageX(i + 1)}`
    : `M ${stageX(i) + STAGE.w} ${railY} H ${BEACON.x - 14}`;
/* The rail between Discover and Build is not travelled: the route goes
   through the pile instead. */
const links = [1, 2, 3];
const cometPath = `M ${stageMid(0)} ${railY} V ${STAGE.y} ${upCurve} H ${pileOut.x} ${downCurve} V ${railY} H ${BEACON.x - 14}`;

/*
  Schedule, in percent of the loop. Discover lights at 6 %. The comet
  climbs into the pile (10 – 17 %), slides under the picked card while the
  pilots are scanned (17 – 31 %), comes down into Build (31 – 38 %), then
  reaches Integrate at 50 %, Ship at 62 % and the beacon at 72 %. Each
  stage lights as the comet arrives; the link after it draws as the comet
  crosses it. The hold ends at 90 %; by 96 % everything is idle again.
*/
const arrive = [6, 38, 50, 62];
const idleBox = "fill: rgba(232, 237, 246, 0.05); stroke: rgba(232, 237, 246, 0.35);";
const litBox = "fill: rgba(47, 125, 209, 0.3); stroke: #2f7dd1;";
const timeline = stages
  .map((_, i) => {
    const on = arrive[i];
    const lit = on + 4;
    const linkOn = on + 7;
    const linkDone = on + 10;
    const link = links.includes(i)
      ? `
@keyframes p2p-link-${i} { 0%, ${linkOn}% { stroke-dashoffset: 1; } ${linkDone}%, 90% { stroke-dashoffset: 0; } 96%, 100% { stroke-dashoffset: 1; } }
.p2p .link--${i} { animation-name: p2p-link-${i}; }`
      : "";
    return `
@keyframes p2p-stage-${i} { 0%, ${on}% { ${idleBox} } ${lit}%, 90% { ${litBox} } 96%, 100% { ${idleBox} } }
@keyframes p2p-halo-${i} { 0%, ${on}% { opacity: 0; } ${lit}%, 90% { opacity: 0.55; } 96%, 100% { opacity: 0; } }
@keyframes p2p-ink-${i} { 0%, ${on}% { color: rgba(232, 237, 246, 0.62); } ${lit}%, 90% { color: #ffffff; } 96%, 100% { color: rgba(232, 237, 246, 0.62); } }
.p2p .stage--${i} .stage__box { animation-name: p2p-stage-${i}; }
.p2p .stage--${i} .stage__halo { animation-name: p2p-halo-${i}; }
.p2p .stage--${i} .stage__ink { animation-name: p2p-ink-${i}; }${link}`;
  })
  .join("\n");
---

<figure class:list={["p2p", className]} {...rest}>
  <svg
    class="art"
    viewBox="0 0 560 380"
    role="img"
    aria-label="Discovery looks at three stalled pilots, picks the proof of concept and takes it through build and integration into production."
  >
    <defs>
      <pattern
        id="p2p-dots"
        width="18"
        height="18"
        patternUnits="userSpaceOnUse"
      >
        <circle cx="1.5" cy="1.5" r="1.1" fill="rgba(232, 237, 246, 0.12)"></circle>
      </pattern>
      <radialGradient id="p2p-fade" cx="50%" cy="60%" r="62%">
        <stop offset="0" stop-color="#ffffff"></stop>
        <stop offset="1" stop-color="#000000"></stop>
      </radialGradient>
      <mask id="p2p-mask">
        <rect width="560" height="380" fill="url(#p2p-fade)"></rect>
      </mask>
      <radialGradient id="p2p-ambient" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(47, 125, 209, 0.22)"></stop>
        <stop offset="1" stop-color="rgba(47, 125, 209, 0)"></stop>
      </radialGradient>
      <radialGradient id="p2p-ambient-live" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="rgba(63, 174, 140, 0.28)"></stop>
        <stop offset="1" stop-color="rgba(63, 174, 140, 0)"></stop>
      </radialGradient>
      <filter id="p2p-blur" x="-60%" y="-60%" width="220%" height="220%">
        <feGaussianBlur stdDeviation="9"></feGaussianBlur>
      </filter>
      <filter id="p2p-glow" x="-100%" y="-100%" width="300%" height="300%">
        <feGaussianBlur stdDeviation="3"></feGaussianBlur>
      </filter>
    </defs>

    <!-- Backdrop: a dot grid that fades at the edges, and a soft glow
         under the rail that turns green when the work goes live. -->
    <rect
      class="grid"
      width="560"
      height="380"
      fill="url(#p2p-dots)"
      mask="url(#p2p-mask)"></rect>
    <ellipse
      class="ambient"
      cx="290"
      cy={railY}
      rx="270"
      ry="80"
      fill="url(#p2p-ambient)"></ellipse>
    <ellipse
      class="ambient ambient--live"
      cx={BEACON.x - 60}
      cy={railY}
      rx="160"
      ry="80"
      fill="url(#p2p-ambient-live)"></ellipse>

    <!-- Headings for the three regions. -->
    <text class="eyebrow" x={pilots[0].x} y="12">Your pilots</text>
    <text class="eyebrow" x={stageX(0)} y={STAGE.y + STAGE.h + 20}>
      Our work
    </text>
    <text class="eyebrow eyebrow--end" x={BEACON.x} y={STAGE.y - 14}>
      Live
    </text>

    <!-- The pile of pilots. Each looks like a document: a title and two
         lines of greyed-out text. -->
    <g class="pilots">
      {
        pilots.map((p, i) => (
          <g class:list={["pilot", `pilot--${i}`, { "pilot--picked": p.picked }]}>
            {p.picked && (
              <rect
                class="pilot__halo"
                x={p.x}
                y={p.y}
                width={CARD.w}
                height={CARD.h}
                rx="10"
                filter="url(#p2p-blur)"
              />
            )}
            <rect
              class="pilot__box"
              x={p.x}
              y={p.y}
              width={CARD.w}
              height={CARD.h}
              rx="10"
            />
            <text class="pilot__title" x={p.x + 14} y={p.y + 18}>
              {p.label}
            </text>
            <rect class="pilot__line" x={p.x + 14} y={p.y + 27} width="66" height="4" rx="2" />
            <rect class="pilot__line" x={p.x + 86} y={p.y + 27} width="38" height="4" rx="2" />
          </g>
        ))
      }
    </g>

    <!-- The route, faint before it is travelled. -->
    <g class="tracks">
      <path class="track" d={leadUpPath}></path>
      <path class="track" d={leadDownPath}></path>
      {links.map((i) => <path class="track" d={linkPath(i)} />)}
    </g>

    <path class="lead lead--up" pathLength="1" d={leadUpPath}></path>
    <path class="lead lead--down" pathLength="1" d={leadDownPath}></path>

    <!-- The delivery rail: four stages with an icon each. -->
    <g class="stages">
      {
        stages.map((stage, i) => (
          <g class={`stage stage--${i}`}>
            <rect
              class="stage__halo"
              x={stageX(i)}
              y={STAGE.y}
              width={STAGE.w}
              height={STAGE.h}
              rx="12"
              filter="url(#p2p-blur)"
            />
            <rect
              class="stage__box"
              x={stageX(i)}
              y={STAGE.y}
              width={STAGE.w}
              height={STAGE.h}
              rx="12"
            />
            <g
              class="stage__ink stage__icon"
              transform={`translate(${stageMid(i)} ${STAGE.y + 19})`}
            >
              {stage.icon === "search" && (
                <>
                  <circle cx="-2" cy="-2" r="5" />
                  <path d="M 2 2 L 7 7" />
                </>
              )}
              {stage.icon === "code" && (
                <path d="M -4 -6 L -10 0 L -4 6 M 4 -6 L 10 0 L 4 6" />
              )}
              {stage.icon === "link" && (
                <>
                  <circle cx="-7" cy="0" r="3" />
                  <circle cx="7" cy="0" r="3" />
                  <path d="M -4 0 H 4" />
                </>
              )}
              {stage.icon === "arrow" && (
                <path d="M -6 6 L 6 -6 M -1 -6 H 6 V 1" />
              )}
            </g>
            <text class="stage__ink stage__label" x={stageMid(i)} y={STAGE.y + 44}>
              {stage.label}
            </text>
          </g>
        ))
      }
      {
        links.map((i) => (
          <path class={`link link--${i}`} pathLength="1" d={linkPath(i)} />
        ))
      }
    </g>

    <!-- Production: a beacon that ripples once the work is live. -->
    <g class="beacon">
      <circle class="ring ring--1" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle class="ring ring--2" cx={BEACON.x} cy={BEACON.y} r="12"></circle>
      <circle
        class="beacon__glow"
        cx={BEACON.x}
        cy={BEACON.y}
        r="9"
        filter="url(#p2p-glow)"></circle>
      <circle class="beacon__core" cx={BEACON.x} cy={BEACON.y} r="7"></circle>
    </g>

    <!-- The comet and its tail, on the same path. offset-path is set
         inline because it is built from the geometry above. -->
    <circle
      class="comet comet--tail"
      r="9"
      filter="url(#p2p-glow)"
      style={`offset-path: path("${cometPath}")`}></circle>
    <circle
      class="comet comet--head"
      r="4"
      style={`offset-path: path("${cometPath}")`}></circle>

    <g class="status">
      <rect x={BEACON.x - 176} y="318" width="176" height="30" rx="15"></rect>
      <circle class="status__dot" cx={BEACON.x - 158} cy="333" r="4"></circle>
      <text x={BEACON.x - 144} y="337">In production, owned</text>
    </g>
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<!-- Per-stage keyframes, generated from the schedule above. Global on
     purpose: keyframe names are page-wide anyway, and every selector is
     rooted at .p2p. -->
<style is:inline set:html={timeline} />

<style>
  .p2p {
    margin: 0;
    width: 100%;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .art {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: chillax, sans-serif;
    --loop: 12s;
    --ease-soft: cubic-bezier(0.22, 0.61, 0.36, 1);
    --ease-pop: cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .art text {
    font-size: 12.5px;
    font-weight: 500;
    fill: rgba(232, 237, 246, 0.82);
  }

  figcaption {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.55);
    max-width: 44ch;
  }

  .art .eyebrow {
    font-family: synonym, sans-serif;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: rgba(232, 237, 246, 0.42);
  }

  .art .eyebrow--end {
    text-anchor: middle;
  }

  /* --- Pilots --- */

  .pilot__box {
    fill: rgba(232, 237, 246, 0.03);
    stroke: rgba(232, 237, 246, 0.3);
    stroke-width: 1.25;
    stroke-dasharray: 4 4;
  }

  .pilot__title {
    fill: rgba(232, 237, 246, 0.5);
  }

  .pilot__line {
    fill: rgba(232, 237, 246, 0.14);
  }

  .pilot__halo {
    fill: #2f7dd1;
    opacity: 0;
  }

  /* --- Route --- */

  .track {
    fill: none;
    stroke: rgba(232, 237, 246, 0.16);
    stroke-width: 1.25;
    stroke-dasharray: 3 5;
    stroke-linecap: round;
  }

  .lead,
  .link {
    fill: none;
    stroke: #2f7dd1;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  /* --- Stages --- */

  .stage__box {
    fill: rgba(232, 237, 246, 0.05);
    stroke: rgba(232, 237, 246, 0.35);
    stroke-width: 1.5;
  }

  .stage__halo {
    fill: #2f7dd1;
    opacity: 0;
  }

  .stage__ink {
    color: rgba(232, 237, 246, 0.62);
  }

  .stage__icon {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .stage__label {
    fill: currentColor;
    text-anchor: middle;
  }

  /* --- Beacon --- */

  .beacon__core {
    fill: #3fae8c;
    opacity: 0.35;
  }

  .beacon__glow {
    fill: #3fae8c;
    opacity: 0;
  }

  .ring {
    fill: none;
    stroke: #3fae8c;
    stroke-width: 1.5;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .ambient--live {
    opacity: 0;
  }

  /* --- Comet --- */

  .comet {
    fill: #ffffff;
    opacity: 0;
  }

  .comet--tail {
    fill: #7fb6ef;
  }

  /* --- Status pill --- */

  .status {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .status rect {
    fill: rgba(232, 237, 246, 0.06);
    stroke: rgba(232, 237, 246, 0.16);
    stroke-width: 1;
  }

  .status text {
    fill: var(--color-ink-light);
    font-size: 12px;
  }

  .status__dot {
    fill: #3fae8c;
  }

  /* --- The loop --- */

  .pilot,
  .pilot__box,
  .pilot__halo,
  .pilot__title,
  .pilot__line,
  .lead,
  .stage__box,
  .stage__halo,
  .stage__ink,
  .link,
  .beacon__core,
  .beacon__glow,
  .ring,
  .ambient--live,
  .comet,
  .status {
    animation-duration: var(--loop);
    animation-iteration-count: infinite;
    animation-timing-function: ease-in-out;
  }

  /* Discovery scans the pile: each pilot brightens in turn, and the
     proof of concept is the one that stays lit, lifts off the pile and
     leaves the other two dimmed behind it. */
  .pilot--0 .pilot__box {
    animation-name: p2p-scan-0;
  }

  .pilot--1 .pilot__box {
    animation-name: p2p-scan-1;
  }

  .pilot--picked {
    transform-box: fill-box;
    transform-origin: center;
    animation-name: p2p-pick-lift;
    animation-timing-function: var(--ease-pop);
  }

  .pilot--picked .pilot__box {
    animation-name: p2p-pick-box;
  }

  .pilot--picked .pilot__title {
    animation-name: p2p-pick-title;
  }

  .pilot--picked .pilot__line {
    animation-name: p2p-pick-line;
  }

  .pilot__halo {
    animation-name: p2p-pick-halo;
  }

  .pilot:not(.pilot--picked) {
    animation-name: p2p-ghost;
  }

  .lead {
    animation-timing-function: var(--ease-soft);
  }

  .lead--up {
    animation-name: p2p-lead-up;
  }

  .lead--down {
    animation-name: p2p-lead-down;
  }

  .link {
    animation-timing-function: var(--ease-soft);
  }

  .beacon__core {
    animation-name: p2p-beacon-core;
  }

  .beacon__glow {
    animation-name: p2p-beacon-glow;
  }

  .ambient--live {
    animation-name: p2p-ambient-live;
  }

  .ring--1 {
    animation-name: p2p-ring-1;
    animation-timing-function: ease-out;
  }

  .ring--2 {
    animation-name: p2p-ring-2;
    animation-timing-function: ease-out;
  }

  .comet {
    animation-name: p2p-comet;
    animation-timing-function: linear;
  }

  /* The tail runs the same schedule a moment behind the head. */
  .comet--tail {
    animation-delay: 0.1s;
  }

  .status {
    animation-name: p2p-status;
    animation-timing-function: var(--ease-pop);
  }

  @keyframes p2p-scan-0 {
    0%,
    16% {
      stroke: rgba(232, 237, 246, 0.3);
      fill: rgba(232, 237, 246, 0.03);
    }
    18%,
    20% {
      stroke: rgba(232, 237, 246, 0.95);
      fill: rgba(232, 237, 246, 0.1);
    }
    23%,
    100% {
      stroke: rgba(232, 237, 246, 0.3);
      fill: rgba(232, 237, 246, 0.03);
    }
  }

  @keyframes p2p-scan-1 {
    0%,
    20% {
      stroke: rgba(232, 237, 246, 0.3);
      fill: rgba(232, 237, 246, 0.03);
    }
    22%,
    24% {
      stroke: rgba(232, 237, 246, 0.95);
      fill: rgba(232, 237, 246, 0.1);
    }
    27%,
    100% {
      stroke: rgba(232, 237, 246, 0.3);
      fill: rgba(232, 237, 246, 0.03);
    }
  }

  /* The picked card starts out like the other two (dashed, dim) and
     turns solid and blue when discovery lands on it. */
  @keyframes p2p-pick-box {
    0%,
    24% {
      fill: rgba(232, 237, 246, 0.03);
      stroke: rgba(232, 237, 246, 0.3);
      stroke-dasharray: 4 4;
    }
    26%,
    28% {
      fill: rgba(232, 237, 246, 0.14);
      stroke: #ffffff;
      stroke-dasharray: 8 0;
    }
    31%,
    90% {
      fill: rgba(47, 125, 209, 0.3);
      stroke: #2f7dd1;
      stroke-dasharray: 8 0;
    }
    96%,
    100% {
      fill: rgba(232, 237, 246, 0.03);
      stroke: rgba(232, 237, 246, 0.3);
      stroke-dasharray: 4 4;
    }
  }

  @keyframes p2p-pick-title {
    0%,
    24% {
      fill: rgba(232, 237, 246, 0.5);
    }
    28%,
    90% {
      fill: #ffffff;
    }
    96%,
    100% {
      fill: rgba(232, 237, 246, 0.5);
    }
  }

  @keyframes p2p-pick-line {
    0%,
    24% {
      fill: rgba(232, 237, 246, 0.14);
    }
    28%,
    90% {
      fill: rgba(232, 237, 246, 0.3);
    }
    96%,
    100% {
      fill: rgba(232, 237, 246, 0.14);
    }
  }

  @keyframes p2p-pick-lift {
    0%,
    27% {
      transform: translateY(0);
    }
    32%,
    90% {
      transform: translateY(-4px);
    }
    96%,
    100% {
      transform: translateY(0);
    }
  }

  @keyframes p2p-pick-halo {
    0%,
    27% {
      opacity: 0;
    }
    32%,
    90% {
      opacity: 0.5;
    }
    96%,
    100% {
      opacity: 0;
    }
  }

  @keyframes p2p-ghost {
    0%,
    27% {
      opacity: 1;
    }
    32%,
    90% {
      opacity: 0.45;
    }
    96%,
    100% {
      opacity: 1;
    }
  }

  @keyframes p2p-lead-up {
    0%,
    10% {
      stroke-dashoffset: 1;
    }
    17%,
    90% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 1;
    }
  }

  @keyframes p2p-lead-down {
    0%,
    31% {
      stroke-dashoffset: 1;
    }
    37%,
    90% {
      stroke-dashoffset: 0;
    }
    96%,
    100% {
      stroke-dashoffset: 1;
    }
  }

  /* The comet's stops, as fractions of its path: up out of Discover
     (4.4 %), into the pile (16.8 %), along the picked card (32.7 %), down
     into Build (48.3 %), then Integrate (67.6 %), Ship (87 %), beacon. */
  @keyframes p2p-comet {
    0%,
    7% {
      offset-distance: 0%;
      opacity: 0;
    }
    9%,
    10% {
      offset-distance: 0%;
      opacity: 1;
    }
    17% {
      offset-distance: 16.8%;
    }
    31% {
      offset-distance: 32.7%;
    }
    38% {
