---
/**
 * The contact form in a modal, for pages that end on their pricing and
 * have no contact section underneath. Every link to #contactForm on the
 * page opens the dialog instead of scrolling; the form inside is the same
 * Contact component, so subject preselection and sending work unchanged.
 */
import Contact from "./Contact.astro";
---

<dialog class="contact-dialog" id="contactDialog" aria-label="Contact form">
  <button type="button" class="contact-dialog__close" data-close aria-label="Close">
    <span aria-hidden="true">×</span>
  </button>
  <Contact />
</dialog>

<script>
  const dialog = document.getElementById("contactDialog") as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === "function") {
    const open = () => {
      if (!dialog.open) dialog.showModal();
    };
    document
      .querySelectorAll<HTMLAnchorElement>('a[href$="#contactForm"]')
      .forEach((link) => {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          open();
        });
      });
    dialog.querySelector("[data-close]")?.addEventListener("click", () => {
      dialog.close();
    });
    // Click on the backdrop closes it; clicks inside the content do not.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    if (location.hash === "#contactForm") open();
  }
</script>

<style>
  .contact-dialog {
    width: min(1200px, calc(100vw - 2rem));
    max-height: min(92vh, 100%);
    /* The global reset zeroes margins; a dialog centres with auto. */
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 20px;
    background: var(--color-light-alt);
    color: var(--color-ink);
    box-shadow: 0 40px 80px rgba(5, 10, 20, 0.45);
    overflow: auto;
  }

  .contact-dialog::backdrop {
    background: rgba(11, 18, 32, 0.7);
    backdrop-filter: blur(4px);
  }

  .contact-dialog__close {
    position: sticky;
    top: 0.75rem;
    float: right;
    margin: 0.75rem 0.75rem 0 0;
    z-index: 2;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-stroke);
    background: var(--color-light-raised);
    color: var(--color-ink);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .contact-dialog__close:hover,
  .contact-dialog__close:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* The contact section brings its own generous padding; trim it a little
     inside the modal so the form is reached without a scroll on desktop. */
  .contact-dialog :global(.contact) {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  /* Phones: a full-screen sheet instead of a floating card, so the form
     gets the whole width. The spam-protection widget is 300px wide and
     does not shrink; inside a card with two layers of padding it was
     wider than the form and gave the dialog a horizontal scroll. */
  @media (max-width: 639px) {
    .contact-dialog {
      width: 100%;
      max-width: 100%;
      height: 100%;
      max-height: 100%;
      border-radius: 0;
    }

    .contact-dialog :global(.contact) {
      padding-inline: 1rem;
    }

    .contact-dialog :global(.contact-form) {
      padding: 1rem;
    }
  }
</style>
