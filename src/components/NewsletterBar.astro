---
/**
 * A slim opt-in bar for blog posts, shown while the reader is in the
 * second half of the article: it slides in once half of it is read and
 * out again at 85%, and does the same in reverse when they scroll back
 * up. Before and after that stretch it is out of the way.
 *
 * It shows on every visit to a post. Closing it hides it for that page
 * view only. It is never shown to someone who already subscribed, or
 * while the cookie banner is open, so two bars never stack. On narrow
 * screens the form drops under the text so the reader can subscribe
 * without leaving their place in the article.
 */
import NewsletterForm from "./NewsletterForm.astro";

interface Props {
  /** Selector of the article body; the bar follows how far it is read. */
  watch: string;
  /** Id of the full signup card under the article. */
  target: string;
}

const { watch, target } = Astro.props;
---

<div
  class="nl-bar"
  id="newsletter-bar"
  role="region"
  aria-label="Newsletter"
  data-watch={watch}
  data-target={target}
  hidden
>
  <p class="nl-bar__text">
    Enjoying this? <span class="nl-bar__sub">Get the next post by email.</span>
  </p>
  <div class="nl-bar__form">
    <NewsletterForm id="newsletter-bar-form" variant="bare" />
  </div>
  <button type="button" class="nl-bar__close" aria-label="Dismiss">
    <svg
      width="14"
      height="14"
      viewBox="0 0 14 14"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M2 2l10 10M12 2L2 12"></path>
    </svg>
  </button>
</div>

<style>
  .nl-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    padding: 0.6rem 1rem;
    background: var(--color-light-raised);
    border-top: 1px solid var(--color-stroke);
    box-shadow: 0 -8px 30px color-mix(in srgb, var(--c-dark) 12%, transparent);
    color: var(--color-ink);
    font-family: "synonym", sans-serif;
    font-size: var(--font-sm);
    transform: translateY(0);
    transition:
      transform 240ms ease,
      opacity 240ms ease;
  }

  .nl-bar[hidden] {
    display: none;
  }

  .nl-bar.is-leaving {
    transform: translateY(100%);
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nl-bar.is-entering {
      animation: nl-bar-in 280ms ease;
    }
  }

  @keyframes nl-bar-in {
    from {
      transform: translateY(100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  :global(:root[data-theme="dark"]) .nl-bar {
    box-shadow: 0 -8px 30px color-mix(in srgb, var(--c-dark) 45%, transparent);
  }

  .nl-bar__text {
    margin: 0;
    line-height: 1.4;
    font-weight: var(--font-weight-semi-bold);
  }

  .nl-bar__sub {
    font-weight: var(--font-weight-normal);
    color: var(--color-ink-muted);
  }

  .nl-bar__form {
    width: min(100%, 380px);
  }

  .nl-bar__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-muted);
    cursor: pointer;
    flex-shrink: 0;
  }

  .nl-bar__close:hover {
    background: var(--color-light-alt);
    color: var(--color-ink);
  }

  /* Narrow screens: the text and the close button on one row, the form
     full width underneath. */
  @media (max-width: 640px) {
    .nl-bar {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 0.5rem 0.75rem;
      padding: 0.6rem 1rem 0.75rem;
    }

    .nl-bar__text {
      flex: 1;
      min-width: 0;
    }

    .nl-bar__form {
      order: 1;
      width: 100%;
    }
  }
</style>

<script>
  const SUBSCRIBED_KEY = "newsletter-subscribed";
  /* The stretch of the article the bar is shown for, as fractions read. */
  const SHOW_FROM = 0.5;
  const SHOW_UNTIL = 0.85;

  const bar = document.getElementById("newsletter-bar");

  function read(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function cookieBannerOpen(): boolean {
    const cc = document.getElementById("cookie-consent");
    return !!cc && !cc.hidden;
  }

  const article = bar
    ? document.querySelector<HTMLElement>(bar.dataset.watch ?? "")
    : null;

  if (bar && article && !read(SUBSCRIBED_KEY)) {
    let done = false; // closed or subscribed, for this page view
    let leaving = 0; // timer of the slide-out in progress

    /** How much of the article has passed the bottom of the screen. */
    function progress(): number {
      const rect = article!.getBoundingClientRect();
      return (window.innerHeight - rect.top) / rect.height;
    }

    function wanted(): boolean {
      if (done || cookieBannerOpen()) return false;
      const read = progress();
      return read >= SHOW_FROM && read < SHOW_UNTIL;
    }

    function show() {
      window.clearTimeout(leaving);
      leaving = 0;
      const wasHidden = bar!.hidden;
      bar!.hidden = false;
      bar!.classList.remove("is-leaving");
      if (wasHidden) bar!.classList.add("is-entering");
    }

    function hide() {
      if (bar!.hidden || leaving) return;
      bar!.classList.remove("is-entering");
      bar!.classList.add("is-leaving");
      leaving = window.setTimeout(() => {
        leaving = 0;
        bar!.hidden = true;
        bar!.classList.remove("is-leaving");
      }, 260);
    }

    function sync() {
      if (wanted()) show();
      else hide();
    }

    /* One measurement per scroll event; cheap enough to run directly. */
    const onScroll = sync;

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    sync();

    function finish() {
      done = true;
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", onScroll);
      hide();
    }

    /* Closing it is for this page view; the next post shows it again. */
    bar.querySelector(".nl-bar__close")?.addEventListener("click", finish);

    window.addEventListener("newsletter-subscribed", () => {
      // Let the "You're in" message sit for a moment before leaving.
      setTimeout(finish, 2500);
    });

    window.addEventListener("cookie-consent-changed", sync);
  }
</script>
