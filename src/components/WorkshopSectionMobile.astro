---
import { Image } from "astro:assets";
import ngPolandCode from "../assets/workshop/ng-poland-2024.6.jpg";
import ngPolandSponsors from "../assets/workshop/ng-poland-2024.7.jpg";
import ngPolandHall from "../assets/workshop/ng-poland-2024.4.jpg";
import zurichWorkshop from "../assets/workshop/angular-zurich.png";
import { WORKSHOPS } from "../lib/workshops";

// One photograph per workshop, each from a different room. The wide card
// crops differently from the round desktop one, so the framing differs too.
const images = {
  "enterprise-angular": { src: ngPolandCode, objectPosition: "center" },
  "nx-monorepo": { src: ngPolandHall, objectPosition: "center" },
  ai: { src: zurichWorkshop, objectPosition: "center" },
  "ui-libraries": { src: ngPolandSponsors, objectPosition: "center" },
} as const;

const workshops = WORKSHOPS.map((item) => ({
  ...item,
  image: images[item.id].src,
  objectPosition: images[item.id].objectPosition,
}));
---

<section>
  <h2 class="workshops__heading">Workshops</h2>
  <div class="workshops">
    <div class="workshops__list">
      {
        workshops.map((item, index) => (
          <article
            class="workshop-card"
            style={`--card-stagger: ${index * 120}ms`}
          >
            <div class="card-media" aria-hidden="true">
              <Image
                src={item.image}
                alt={item.title}
                loading="lazy"
                style={`--object-position: ${item.objectPosition ?? "center"}; object-position: var(--object-position);`}
              />
            </div>
            <div class="card-body">
              <p class="card-tag">{item.tag}</p>
              <h3>{item.title}</h3>
              <p class="card-description">{item.description}</p>
              <div class="card-actions">
                <a class="card-cta" href="#contactForm" data-subject="Workshop">
                  Book workshop
                </a>
                <a class="card-link" href={`/services/workshops#${item.id}`}>
                  Workshop details &rarr;
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  section {
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 6vw, 5rem);
    overflow: hidden;
    /* Same treatment as the pinned desktop panel: one sweep per viewport
       height, then the gradient's end colour. */
    background-color: var(--color-dark);
    background-image: var(--background-gradient-primary);
    background-attachment: fixed;
    background-size: 100% 100svh;
    background-repeat: no-repeat;
  }

  /* Same treatment as the title over the pinned desktop carousel. */
  .workshops__heading {
    text-align: center;
    text-transform: uppercase;
    font-size: clamp(2rem, 9vw, 3rem);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.06em;
    line-height: 1;
    color: var(--color-ink-light);
    margin-bottom: clamp(1.5rem, 6vw, 2.5rem);
  }

  .workshops {
    width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }

  .workshops__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.25rem, 4vw, 2rem);
    align-items: stretch;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0;
  }

  .workshop-card {
    display: grid;
    grid-template-columns: 1fr;
    align-items: stretch;
    background: linear-gradient(180deg, #ffffff 0%, #f8f4f2 100%);
    border: 1px solid var(--color-stroke);
    border-radius: 18px;
    padding: clamp(1rem, 5vw, 1.35rem);
    box-shadow: 0 26px 60px rgba(40, 12, 19, 0.14);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    gap: 1rem;
    transform-origin: center;
    width: 100%;
    min-width: 0;
    height: auto;
    opacity: 0;
    transform: translateX(18vw) translateY(10px);
    transition:
      transform 1.5s cubic-bezier(0.22, 0.61, 0.36, 1),
      opacity 1.5s ease;
    transition-delay: var(--card-stagger, 0ms);
  }

  .workshop-card.is-visible {
    opacity: 1;
    transform: translateX(0) translateY(0);
  }

  .workshop-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 35% 15%,
      rgba(58, 120, 105, 0.12),
      transparent 40%
    );
    pointer-events: none;
    z-index: 0;
  }

  .workshop-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 120% 50%,
      rgba(44, 16, 23, 0.14),
      transparent 45%
    );
    pointer-events: none;
    z-index: 0;
  }

  .card-media {
    border-radius: 14px;
    overflow: hidden;
    height: clamp(180px, 45vw, 260px);
    min-height: 0;
    max-height: 260px;
    background: var(--color-light-alt);
    position: relative;
    z-index: 1;
    box-shadow: 0 10px 24px rgba(40, 12, 19, 0.08);
  }

  .card-media :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: var(--object-position, center);
    transform: scale(1.02);
    filter: saturate(1.05);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    z-index: 1;
    height: 100%;
  }

  .card-tag {
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    font-size: var(--font-sm);
    margin-top: 0.1rem;
  }

  .card-body h3 {
    font-size: clamp(1.35rem, 3vw, 1.7rem);
    line-height: 1.2;
    color: var(--color-ink);
    margin-top: 0.7rem;
    margin-bottom: 0.1rem;
  }

  .card-description {
    color: var(--color-ink-muted);
    font-size: var(--font-md);
    font-family: synonym;
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
    padding-top: var(--spacer-md);
    margin-top: 1.1rem;
  }

  .card-link {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-link:hover,
  .card-link:focus-visible {
    color: var(--color-accent-strong);
  }

  .card-cta {
    display: inline-block;
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-light);
    background-color: var(--color-accent);
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .card-cta:hover,
  .card-cta:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    color: var(--color-light-alt);
    background-color: var(--color-accent-strong);
  }

  .card-cta:active {
    transform: translateY(0);
  }

  @media (min-width: 769px) {
    .workshops__list {
      gap: clamp(1.5rem, 3vw, 2.5rem);
    }

    .workshop-card {
      grid-template-columns: minmax(300px, 45%) 1fr;
      height: 500px;
      min-height: fit-content;
      padding: clamp(1.1rem, 4vw, 1.4rem);
    }

    .card-media {
      height: 100%;
      min-height: 260px;
      max-height: none;
    }

    .card-body {
      padding-inline: 0.25rem;
      gap: var(--spacer-base);
    }

    .card-actions {
      padding-top: var(--spacer-lg);
    }
  }
</style>

<script>
  const cards = document.querySelectorAll(".workshop-card");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.3 },
  );

  cards.forEach((card) => observer.observe(card));
</script>
