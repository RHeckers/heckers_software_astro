---
import { categoryHref, type BlogCategory } from "../lib/categories";

interface Props {
  /** Categories to show (only those with at least one post). */
  categories: readonly BlogCategory[];
  /** Currently active category; undefined means "All". */
  active?: BlogCategory;
}

const { categories, active } = Astro.props;
---

<nav class="filter-bar" aria-label="Filter posts by category">
  <ul>
    <li>
      <a href="/blog/" aria-current={active ? undefined : "page"}>All</a>
    </li>
    {
      categories.map((category) => (
        <li>
          <a
            href={categoryHref(category)}
            aria-current={category === active ? "page" : undefined}
          >
            {category}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .filter-bar ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .filter-bar a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--color-stroke-strong);
    border-radius: 999px;
    color: var(--color-ink);
    font-family: "synonym", sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .filter-bar a:hover,
  .filter-bar a:focus-visible {
    border-color: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .filter-bar a[aria-current="page"] {
    background: var(--color-dark);
    border-color: var(--color-dark);
    color: var(--color-ink-light);
  }
</style>
