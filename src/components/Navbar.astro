---
import { SERVICES } from "../lib/services";
---

<nav class="nav" aria-label="Main Navigation">
  <div id="pill" class="pill">
    <a class="brand" href="/">HECKERS SOFTWARE</a>
    <button
      type="button"
      class="hamburger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="main-menu">☰</button
    >
    <button type="button" class="close" aria-label="Close menu">×</button>
    <div class="menu" id="main-menu">
      <ul>
        <li><a href="/">Home</a></li>
        {
          SERVICES.map((service) => (
            <li>
              <a href={service.href}>{service.navLabel}</a>
            </li>
          ))
        }
        <li><a href="/blog">Blog</a></li>
        <li><a href="/#contactForm" data-contact-link>Contact</a></li>
      </ul>
    </div>
  </div>
</nav>

<style>
  :root {
    --pill-height: 40px;
    --radius-pill: 999px;
    --transition-main: 550ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a {
    all: unset;
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    transition: transform 500ms ease-in;
  }

  .nav.hidden {
    transform: translate(-50%, -200%);
  }

  .nav:has(.pill.open) {
    top: 0;
  }

  .pill {
    gap: 1rem;
    height: var(--pill-height);
    background: var(--color-stroke-strong);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;

    transform-origin: center;
    transition:
      width var(--transition-main),
      height var(--transition-main),
      border-radius var(--transition-main),
      box-shadow var(--transition-main);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  /* OPEN STATE */
  .pill.open {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
  }

  .pill.no-close-animation {
    transition: none;
  }

  .brand {
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
  }

  .hamburger,
  .close {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    line-height: 1;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .hamburger:focus-visible,
  .close:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .hamburger {
    font-size: 20px;
  }

  .close {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 24px;
    font-weight: var(--font-weight-bold);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: none;
    z-index: 1100;
  }

  .pill.open .close {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 300ms ease 450ms;
  }

  /* MENU */
  .menu {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    /* default = no animation (used on close) */
    transition: none;
  }

  .pill.open .menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    /* animation only when opening */
    transition: opacity 300ms ease 450ms;
  }

  .pill.open .brand,
  .pill.open .hamburger {
    display: none;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .menu li {
    font-size: 32px;
    font-weight: 700;
    margin: 16px 0;
  }

  .menu a {
    cursor: pointer;
  }
</style>

<script>
  const nav = document.querySelector(".nav") as HTMLElement;
  const pill = document.getElementById("pill") as HTMLElement;
  const hamburger = pill.querySelector(".hamburger") as HTMLButtonElement;
  const close = pill.querySelector(".close") as HTMLButtonElement;
  const menuLinks = pill.querySelectorAll(".menu a") as NodeListOf<HTMLElement>;

  function openMenu() {
    pill.classList.add("open");
    hamburger.setAttribute("aria-expanded", "true");
    // Move focus into the dialog-like menu so keyboard users can close it.
    close.focus({ preventScroll: true });
  }

  function closeMenu(restoreFocus = true) {
    pill.classList.remove("open");
    hamburger.setAttribute("aria-expanded", "false");
    if (restoreFocus) hamburger.focus({ preventScroll: true });
  }

  function closeMenuInstant() {
    pill.classList.add("no-close-animation");
    closeMenu(false);

    // Re-enable transitions for subsequent open/close interactions.
    window.requestAnimationFrame(() => {
      pill.classList.remove("no-close-animation");
    });
  }

  // The contact form sits on the home page and on every service page. On
  // pages that have it, link to it in place; elsewhere the link falls back
  // to the home page form.
  const contactLink = pill.querySelector<HTMLAnchorElement>(
    "[data-contact-link]",
  );
  if (contactLink && document.getElementById("contactForm")) {
    contactLink.setAttribute("href", "#contactForm");
  }

  hamburger.addEventListener("click", openMenu);
  close.addEventListener("click", () => closeMenu());

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && pill.classList.contains("open")) {
      closeMenu();
    }
  });

  menuLinks.forEach((link) => {
    link.addEventListener("click", () => {
      const href = link.getAttribute("href");
      if (!href) {
        return;
      }

      const targetUrl = new URL(href, window.location.href);
      const currentUrl = new URL(window.location.href);
      const isSameDocument =
        targetUrl.origin === currentUrl.origin &&
        targetUrl.pathname === currentUrl.pathname &&
        targetUrl.search === currentUrl.search;

      // Only run close behavior for in-page navigation, and do it instantly.
      if (isSameDocument) {
        closeMenuInstant();
      }
    });
  });

  let lastScrollY = window.scrollY;
  let ticking = false;

  function onScroll() {
    const currentScrollY = window.scrollY;

    if (!pill.classList.contains("open")) {
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        // scrolling down
        nav.classList.add("hidden");
      } else {
        // scrolling up
        nav.classList.remove("hidden");
      }
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  });
</script>
