<nav class="nav" role="navigation" aria-label="Main Navigation">
  <div id="pill" class="pill" aria-expanded="false" aria-controls="main-menu">
    <span class="brand">HECKERS SOFTWARE</span>
    <span class="hamburger" role="button" aria-label="Open menu" tabindex="0"
      >☰</span
    >
    <span class="close" role="button" aria-label="Close menu" tabindex="0"
      >×</span
    >
    <div class="menu" id="main-menu" role="menu">
      <ul>
        <li role="none"><a role="menuitem" href="">Blog</a></li>
        <li role="none">
          <a role="menuitem" href="#code-analysis">Code Analysis</a>
        </li>
        <li role="none"><a role="menuitem" href="#workshops">Workshops</a></li>
        <li role="none">
          <a role="menuitem" href="#app-development">App Development</a>
        </li>
        <li role="none">
          <a role="menuitem" href="#contactForm">Contact</a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<style>
  :root {
    --pill-height: 40px;
    --radius-pill: 999px;
    --transition-main: 550ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  a {
    all: unset;
  }

  span:focus-visible {
    outline: none;
  }

  .nav {
    position: fixed;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    transition: transform 500ms ease-in;
  }

  .nav.hidden {
    transform: translate(-50%, -200%);
  }

  .nav:has(.pill.open) {
    top: 0;
  }

  .pill {
    gap: 1rem;
    height: var(--pill-height);
    background: var(--color-stroke-strong);
    color: var(--color-ink);
    border-radius: var(--radius-pill);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 20px;
    cursor: pointer;

    transform-origin: center;
    transition:
      width var(--transition-main),
      height var(--transition-main),
      border-radius var(--transition-main),
      box-shadow var(--transition-main);
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .pill:focus,
  .pill:active {
    outline: none;
  }

  /* OPEN STATE */
  .pill.open {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    cursor: default;
  }

  .brand {
    font-weight: 600;
    white-space: nowrap;
  }

  .hamburger {
    font-size: 20px;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .close {
    position: absolute;
    top: 24px;
    right: 24px;
    font-size: 24px;
    cursor: pointer;
    font-weight: var(--font-weight-bold);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: none;
    z-index: 1100;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
  }

  .hamburger:focus,
  .hamburger:active,
  .close:focus,
  .close:active {
    outline: none;
  }

  .pill.open .close {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 300ms ease 450ms;
  }

  /* MENU */
  .menu {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    /* default = no animation (used on close) */
    transition: none;
  }

  .pill.open .menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    /* animation only when opening */
    transition: opacity 300ms ease 450ms;
  }

  .pill.open .menu {
    opacity: 1;
    pointer-events: auto;
    transition-delay: 450ms;
  }
  .pill.open .brand,
  .pill.open .hamburger {
    display: none;
  }

  .menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .menu li {
    font-size: 32px;
    font-weight: 700;
    margin: 16px 0;
    cursor: pointer;
  }
</style>

<script>
  const nav = document.querySelector(".nav") as HTMLElement;
  const pill = document.getElementById("pill") as HTMLElement;
  const hamburger = pill.querySelector(".hamburger") as HTMLElement;
  const close = pill.querySelector(".close") as HTMLElement;
  const menuLinks = pill.querySelectorAll(".menu a") as NodeListOf<HTMLElement>;

  hamburger.addEventListener("click", () => {
    pill.classList.add("open");
    pill.setAttribute("aria-expanded", "true");
  });

  close.addEventListener("click", () => {
    pill.classList.remove("open");
    pill.setAttribute("aria-expanded", "false");
  });

  menuLinks.forEach((link) => {
    link.addEventListener("click", () => {
      pill.classList.remove("open");
      pill.setAttribute("aria-expanded", "false");
    });
  });

  let lastScrollY = window.scrollY;
  let ticking = false;

  function onScroll() {
    const currentScrollY = window.scrollY;

    if (!pill.classList.contains("open")) {
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        // scrolling down
        nav.classList.add("hidden");
      } else {
        // scrolling up
        nav.classList.remove("hidden");
      }
    }

    lastScrollY = currentScrollY;
    ticking = false;
  }

  window.addEventListener("scroll", () => {
    if (!ticking) {
      window.requestAnimationFrame(onScroll);
      ticking = true;
    }
  });
</script>
