---
import { Image } from "astro:assets";
import ContentCards from "./ContentCards.astro";

import code_img from "../assets/code_img.svg";
---

<section>
  <div class="image-overlay-container">
    <Image
      src={code_img}
      alt="Code snippet"
      loading="lazy"
      class="img circle-mask-image"
    />
    <div class="content-reveal">
      <h2 class="reveal-title">Architecture Report</h2>
      <div class="reveal-card-shell">
        <div class="reveal-card-scroll">
          <ul class="reveal-card-list">
            <ContentCards icon="◎" title="Deep Code Analysis">
              We perform a <span class="accent accent-1">deep analysis</span> of your
              codebase to surface architectural smells and find clear areas for <span
                class="accent accent-4">improvement</span
              >.
            </ContentCards>
            <ContentCards icon="📄" title="Improvements Report">
              You receive a <span class="accent accent-1">detailed report</span> with
              <span class="accent accent-3">architectural recommendations</span> to
              boost code quality, maintainability, and
              <span class="accent accent-4">scalability</span>.
            </ContentCards>
            <ContentCards icon="🗓" title="Plan & Walkthrough">
              Together with your team, we craft a
              <span class="accent accent-1">prioritized action plan</span>,
              sequence the
              <span class="accent accent-3">critical fixes</span>, and guide
              rollout so you can <span class="accent accent-4">ship faster</span
              > with confidence.
            </ContentCards>
          </ul>
        </div>
        <div class="reveal-card-nav" aria-label="Scroll cards">
          <button
            class="reveal-card-button"
            data-direction="prev"
            aria-label="Previous card"
          >
            ←
          </button>
          <button
            class="reveal-card-button"
            data-direction="next"
            aria-label="Next card"
          >
            →
          </button>
        </div>
      </div>
      <a href="#" class="cta-button">Get Your Report</a>
    </div>
  </div>
</section>

<script is:inline>
  const scrollShells = document.querySelectorAll(".reveal-card-shell");

  scrollShells.forEach((shell) => {
    const container = shell.querySelector(".reveal-card-scroll");
    const list = shell.querySelector(".reveal-card-list");
    const buttons = shell.querySelectorAll(".reveal-card-button");

    if (!container || !list || buttons.length === 0) return;

    const getStep = () => {
      const firstCard = list.querySelector(".app-card");
      const styles = window.getComputedStyle(list);
      const gap = parseFloat(styles.columnGap || styles.gap || "0");
      return (firstCard?.clientWidth || 0) + gap;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = button.getAttribute("data-direction");
        const step = getStep() || container.clientWidth;
        const delta = direction === "next" ? step : -step;
        container.scrollBy({ left: delta, behavior: "smooth" });
      });
    });
  });
</script>

<style>
  section {
    /* min-height: 150vh; */
    background-color: var(--color-dark-soft);
    overflow: visible;
    view-timeline-name: --section-timeline;
  }
  .image-overlay-container {
    position: sticky;
    top: 0;
    width: 100%;
    min-height: 100vh;
  }

  .reveal-card-list .accent {
    font-weight: var(--font-weight-normal);
    animation-timeline: --section-timeline;
  }

  .reveal-card-list .accent-1 {
    animation-range: entry 65% cover 50%;
  }

  .reveal-card-list .accent-3 {
    animation-range: entry 70% cover 50%;
  }

  .reveal-card-list .accent-4 {
    animation-range: entry 75% cover 50%;
  }

  .img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: left;
    z-index: 1;
  }

  .circle-mask-image {
    background: transparent;
    -webkit-mask-image: radial-gradient(
      circle 75px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 75px, white 90%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 200px 200px;
    mask-size: 200px 200px;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-path;
    opacity: 0.4;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 50% cover 50%;
  }

  .content-reveal {
    min-height: 100vh;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacer-base) 0;
    max-width: 100%;
    margin: 0 auto;
    gap: var(--spacer-xl);
  }

  .reveal-title {
    font-size: 3.5rem;
    font-weight: var(--font-weight-light);
    color: var(--color-ink-light);
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  .reveal-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    flex-wrap: nowrap;
    overflow: visible;
    gap: var(--spacer-md);
    padding: 0 1rem var(--spacer-md);
    scrollbar-width: none;
    text-align: left;
    font-size: 1.2rem;
    overflow: visible;
  }

  .reveal-card-list::after {
    content: "";
    flex: 0 0 1px;
  }

  .reveal-card-list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .reveal-card-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1rem;
  }

  .reveal-card-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .reveal-card-shell {
    width: 100%;
  }

  .reveal-card-nav {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--spacer-sm);
    gap: var(--spacer-sm);
    margin-right: var(--spacer-md);
  }

  .reveal-card-button {
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: rgba(15, 26, 43, 0.7);
    color: var(--color-ink-light);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-lg);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .cta-button {
    display: inline-block;
    margin-top: var(--spacer-lg);
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: var(--color-ink-light);
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    opacity: 0.5;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 45% cover 55%;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .reveal-card-list :global(.app-card) {
    flex: 0 0 82vw;
    max-width: 82vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @keyframes mask-zigzag-path {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 5%;
      mask-position: 0% 5%;
    }
    10% {
      opacity: 0.4;
    }
    20% {
      -webkit-mask-position: 80% 10%;
      mask-position: 80% 10%;
    }
    40% {
      -webkit-mask-position: 7% 15%;
      mask-position: 7% 15%;
    }
    60% {
      -webkit-mask-position: 0% 20%;
      mask-position: 0% 20%;
    }
    85% {
      -webkit-mask-position: 35% 80%;
      mask-position: 35% 80%;
    }
    95% {
      -webkit-mask-position: 5% 90%;
      mask-position: 5% 90%;
    }
    100% {
      -webkit-mask-position: 0% 100%;
      mask-position: 0% 100%;
    }
  }

  @media (min-width: 641px) {
    .content-reveal {
      padding: var(--spacer-3xl) var(--spacer-2xl);
      max-width: 1200px;
    }

    .reveal-title {
      font-size: 7rem;
    }

    .reveal-card-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--spacer-lg);
      padding: 0;
    }

    .reveal-card-scroll {
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding: 0;
    }

    .reveal-card-nav {
      display: none;
      margin-right: 0;
    }

    .reveal-card-list :global(.app-card) {
      flex: initial;
      max-width: none;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }

    .cta-button {
      padding: var(--spacer-lg) var(--spacer-2xl);
      font-size: var(--font-2xl);
    }

    .circle-mask-image {
      -webkit-mask-image: radial-gradient(
        circle 150px,
        white 90%,
        transparent 100%
      );
      mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
      -webkit-mask-size: 300px 300px;
      mask-size: 300px 300px;
    }

    @keyframes mask-zigzag-path {
      0% {
        opacity: 0;
        -webkit-mask-position: 0% 5%;
        mask-position: 0% 5%;
      }
      10% {
        opacity: 0.4;
      }
      20% {
        -webkit-mask-position: 25% 10%;
        mask-position: 25% 10%;
      }
      40% {
        -webkit-mask-position: 7% 30%;
        mask-position: 7% 30%;
      }
      60% {
        -webkit-mask-position: 0% 70%;
        mask-position: 0% 70%;
      }
      80% {
        -webkit-mask-position: 15% 100%;
        mask-position: 15% 100%;
      }
      100% {
        -webkit-mask-position: 0% 100%;
        mask-position: 0% 100%;
      }
    }
  }
</style>
