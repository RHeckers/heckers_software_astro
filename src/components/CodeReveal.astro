---
import { Image } from "astro:assets";
import code_img from "../assets/code_img.svg";
---

<div class="code-reveal-scroll-container" id="code-analysis">
  <section id="code-reveal" class="code-reveal-section code-reveal--sticky">
    <Image
      src={code_img}
      alt="Code analysis"
      loading="lazy"
      class="section-bg-image"
    />

    <div class="content-reveal">
      <h2 class="reveal-title">How we transform your codebase</h2>

      <div class="bento-grid">
        <div class="bento-card card-1">
          <div class="card-header">
            <span class="card-step">01</span>
            <h3 class="card-title">Deep Dive</h3>
          </div>
          <p class="card-desc">
            We audit your codebase, architecture, and workflows — surfacing the
            issues that hold you back.
          </p>
        </div>

        <div class="bento-card card-2">
          <div class="card-header">
            <span class="card-step">02</span>
            <h3 class="card-title">Clear Roadmap</h3>
          </div>
          <p class="card-desc">
            You receive a prioritized report with targeted, actionable fixes —
            no guesswork.
          </p>
        </div>

        <div class="bento-card card-3">
          <div class="card-header">
            <span class="card-step">03</span>
            <h3 class="card-title">Team Alignment</h3>
          </div>
          <p class="card-desc">
            We present our findings and co&#8209;create an execution plan that
            fits your goals, timeline, and team capacity.
          </p>
        </div>

        <div class="bento-card card-4">
          <div class="card-header">
            <span class="card-step">04</span>
            <h3 class="card-title">Hands&#8209;On Execution</h3>
          </div>
          <p class="card-desc">
            We implement the improvements ourselves or guide your developers
            through every change. Either way, your codebase comes out stronger.
          </p>
        </div>
      </div>

      <a href="#contactForm" class="cta-button">Start Now</a>
    </div>
  </section>
  <div id="code-reveal-spacer" style="height:0;"></div>
</div>

<script>
  (function () {
    const scrollContainer = document.querySelector(
      ".code-reveal-scroll-container",
    ) as HTMLElement;
    const section = document.querySelector(
      ".code-reveal--sticky",
    ) as HTMLElement;
    const spacer = document.getElementById("code-reveal-spacer") as HTMLElement;
    if (!scrollContainer || !section || !spacer) return;

    const cards = Array.from(
      section.querySelectorAll(".bento-card"),
    ) as HTMLElement[];
    const total = cards.length;

    requestAnimationFrame(() => {
      function updateFromScroll() {
        const containerRect = scrollContainer.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const scrollable = scrollContainer.offsetHeight - viewportHeight;
        const scrolled = Math.min(Math.max(-containerRect.top, 0), scrollable);
        const progress = scrollable > 0 ? scrolled / scrollable : 0;

        // Reveal cards one by one as user scrolls
        cards.forEach((card, i) => {
          const threshold = (i + 1) / (total + 1);
          card.classList.toggle("card-visible", progress >= threshold);
        });

        if (progress >= 1) {
          spacer.style.height = section.offsetHeight + "px";
        } else {
          spacer.style.height = "0px";
        }
      }

      updateFromScroll();
      window.addEventListener("scroll", updateFromScroll, { passive: true });
      window.addEventListener("resize", updateFromScroll);
    });
  })();
</script>

<style>
  /* ─── Scroll container ─── */
  .code-reveal-scroll-container {
    background-color: var(--color-light);
    padding: 2rem 0;
    position: relative;
    height: calc(100svh + 1800px);
  }

  #code-reveal-spacer {
    width: 100%;
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ─── Sticky section ─── */
  .code-reveal-section.code-reveal--sticky {
    position: sticky;
    margin: 0 1rem;
    border-radius: 15px;
    top: 2.5rem;
    z-index: 10;
    will-change: transform;
    view-timeline-name: --section-timeline;
    background: var(--background-gradient-primary);
    overflow: hidden;
  }

  /* ─── Background code image with circle mask ─── */
  .section-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
    z-index: 1;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(
      circle 100px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 100px, white 90%, transparent 100%);
    -webkit-mask-size: 200px 200px;
    mask-size: 200px 200px;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-mobile;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 5% cover 85%;
  }

  @keyframes mask-zigzag-mobile {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 0%;
      mask-position: 0% 0%;
    }
    8% {
      opacity: 0.7;
    }
    25% {
      -webkit-mask-position: 65% 18%;
      mask-position: 65% 18%;
    }
    45% {
      -webkit-mask-position: 5% 40%;
      mask-position: 5% 40%;
    }
    65% {
      -webkit-mask-position: 60% 60%;
      mask-position: 60% 60%;
    }
    70% {
      -webkit-mask-position: 5% 75%;
      mask-position: 5% 75%;
      opacity: 0.7;
    }
    82% {
      opacity: 0;
    }
    100% {
      opacity: 0;
      -webkit-mask-position: 50% 95%;
      mask-position: 50% 95%;
    }
  }

  /* ─── Content ─── */
  .content-reveal {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacer-xl) var(--spacer-md);
    margin: 0 auto;
  }

  .reveal-title {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: var(--spacer-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  /* ─── Bento grid — stacked on mobile ─── */
  .bento-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  /* ─── Cards ─── */
  .bento-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: var(--spacer-lg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(25px);
    transition:
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento-card.card-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Group step number + title tightly */
  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-bottom: 0.6rem;
  }

  .card-step {
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    font-family: synonym, sans-serif;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    line-height: 1.2;
  }

  .card-desc {
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.7);
    line-height: 1.5;
    font-family: synonym, sans-serif;
  }

  /* ─── CTA ─── */
  .cta-button {
    display: inline-block;
    margin-top: var(--spacer-xl);
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: var(--color-ink-light);
    border-radius: 50px;
    text-decoration: none;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  /* ─── Desktop ─── */
  @media (min-width: 641px) {
    .content-reveal {
      max-width: 1200px;
      padding: var(--spacer-2xl) var(--spacer-xl);
      min-height: calc(100svh - 6rem);
      justify-content: center;
    }

    .code-reveal-section.code-reveal--sticky {
      margin: 0 2rem;
    }

    .reveal-title {
      font-size: clamp(2.5rem, 4.5vw, 4rem);
      margin-bottom: var(--spacer-2xl);
    }

    /* Bento grid — 3 columns, 2 rows */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      grid-template-rows: 1fr 1fr;
      gap: 1rem;
    }

    .card-1 {
      grid-column: 1;
      grid-row: 1;
    }
    .card-2 {
      grid-column: 2;
      grid-row: 1;
    }
    .card-3 {
      grid-column: 1 / 3;
      grid-row: 2;
    }
    .card-4 {
      grid-column: 3;
      grid-row: 1 / 3;
      position: relative;
      background: rgba(47, 125, 209, 0.07);
      border-color: rgba(47, 125, 209, 0.12);
    }

    .card-4::after {
      content: "04";
      position: absolute;
      bottom: 0.75rem;
      right: 1rem;
      font-size: 7rem;
      font-weight: 700;
      line-height: 1;
      color: rgba(47, 125, 209, 0.06);
      pointer-events: none;
    }

    .bento-card {
      padding: var(--spacer-xl);
    }

    .card-header {
      gap: 0.15rem;
      margin-bottom: 0.75rem;
    }

    .card-title {
      font-size: var(--font-2xl);
    }

    .card-desc {
      font-size: var(--font-md);
    }

    .cta-button {
      padding: var(--spacer-lg) var(--spacer-2xl);
      font-size: var(--font-2xl);
    }

    /* Desktop circle mask — original zigzag animation */
    .section-bg-image {
      -webkit-mask-image: radial-gradient(
        circle 150px,
        white 90%,
        transparent 100%
      );
      mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
      -webkit-mask-size: 300px 300px;
      mask-size: 300px 300px;
      animation-name: mask-zigzag-path;
      animation-range: entry 10% cover 90%;
    }

    @keyframes mask-zigzag-path {
      0% {
        opacity: 0;
        -webkit-mask-position: 0% 5%;
        mask-position: 0% 5%;
      }
      10% {
        opacity: 0.8;
      }
      20% {
        -webkit-mask-position: 70% 10%;
        mask-position: 70% 10%;
      }
      40% {
        -webkit-mask-position: 3% 20%;
        mask-position: 3% 20%;
      }
      70% {
        -webkit-mask-position: 70% 40%;
        mask-position: 70% 40%;
      }
      100% {
        -webkit-mask-position: 0% 90%;
        mask-position: 0% 90%;
      }
    }
  }
</style>
