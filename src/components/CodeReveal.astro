---
import { Image } from "astro:assets";
import ContentCards from "./ContentCards.astro";

import code_img from "../assets/code_img.svg";
---

<section>
  <div class="image-overlay-container">
    <Image
      src={code_img}
      alt="Code snippet"
      loading="lazy"
      class="img circle-mask-image"
    />
    <div class="content-reveal">
      <h2 class="reveal-title">Architecture Report</h2>
      <ul class="reveal-card-list">
        <ContentCards icon="◎" title="Deep Code Analysis">
          We perform a <span class="accent accent-1">deep analysis</span> of your
          codebase to surface architectural smells and find clear areas for <span
            class="accent accent-4">improvement</span
          >.
        </ContentCards>
        <ContentCards icon="📄" title="Improvements Report">
          You receive a <span class="accent accent-1">detailed report</span> with
          <span class="accent accent-3">architectural recommendations</span> to boost
          code quality, maintainability, and
          <span class="accent accent-4">scalability</span>.
        </ContentCards>
        <ContentCards icon="🗓" title="Plan & Walkthrough">
          Together with your team, we craft a
          <span class="accent accent-1">prioritized action plan</span>, sequence
          the
          <span class="accent accent-3">critical fixes</span>, and guide rollout
          so you can <span class="accent accent-4">ship faster</span> with confidence.
        </ContentCards>
      </ul>
      <a href="#" class="cta-button">Get Your Architecture Report</a>
    </div>
  </div>
</section>

<style>
  section {
    height: 150vh;
    background-color: var(--color-bordaux-light);
    overflow: visible;
    view-timeline-name: --section-timeline;
  }
  .image-overlay-container {
    position: sticky;
    top: 0;
    width: 100%;
    min-height: 100vh;
  }

  .reveal-card-list .accent {
    font-weight: var(--font-weight-normal);
    animation-timeline: --section-timeline;
  }

  .reveal-card-list .accent-1 {
    animation-range: entry 65% cover 40%;
  }

  .reveal-card-list .accent-3 {
    animation-range: entry 70% cover 40%;
  }

  .reveal-card-list .accent-4 {
    animation-range: entry 75% cover 40%;
  }

  .img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: left;
    z-index: 1;
  }

  .circle-mask-image {
    background: transparent;
    -webkit-mask-image: radial-gradient(
      circle 150px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 300px 300px;
    mask-size: 300px 300px;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-path;
    opacity: 0.4;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 50% cover 50%;
  }

  .content-reveal {
    min-height: 100vh;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--spacer-3xl) var(--spacer-2xl);
    max-width: 1200px;
    margin: 0 auto;
    gap: var(--spacer-xl);
  }

  .reveal-title {
    font-size: 7rem;
    font-weight: var(--font-weight-light);
    color: white;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  .reveal-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacer-lg);
    text-align: left;
    font-size: 1.2rem;
  }

  .cta-button {
    display: inline-block;
    margin-top: var(--spacer-lg);
    padding: var(--spacer-lg) var(--spacer-2xl);
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: white;
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    opacity: 0.5;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 45% cover 55%;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-hover);
    color: var(--color-accent-hover);
  }

  @keyframes mask-zigzag-path {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 5%;
      mask-position: 0% 5%;
    }
    10% {
      opacity: 0.4;
    }
    20% {
      -webkit-mask-position: 25% 10%;
      mask-position: 25% 10%;
    }
    40% {
      -webkit-mask-position: 7% 30%;
      mask-position: 7% 30%;
    }
    60% {
      -webkit-mask-position: 0% 70%;
      mask-position: 0% 70%;
    }
    80% {
      -webkit-mask-position: 15% 100%;
      mask-position: 15% 100%;
    }
    100% {
      -webkit-mask-position: 0% 100%;
      mask-position: 0% 100%;
    }
  }
</style>
