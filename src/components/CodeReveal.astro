---
import { Image } from "astro:assets";
import code_img from "../assets/code_img.svg";
import { HOME_CATEGORY_LINKS, resolveHomeLink } from "../lib/home-links";

const articlesLink = await resolveHomeLink(HOME_CATEGORY_LINKS.codeAnalysis);
---

<div class="code-reveal-scroll-container">
  <!--
    Anchor target for #code-analysis. It sits at the end of the scroll
    distance, so a link to this section lands with every step already
    revealed instead of at the start of the reveal animation.
  -->
  <div class="code-reveal-anchor" id="code-analysis" aria-hidden="true"></div>
  <section id="code-reveal" class="code-reveal-section code-reveal--sticky">
    <Image
      src={code_img}
      alt="Code analysis"
      loading="lazy"
      class="section-bg-image"
    />

    <div class="content-reveal">
      <h2 class="reveal-title">The Architecture Assessment</h2>
      <p class="reveal-lede">
        A fixed-scope assessment of your Angular or Nx codebase by senior
        engineers. Typically two to three weeks from kickoff to roadmap.
      </p>

      <div class="bento-grid">
        <div class="bento-card card-1">
          <div class="card-header">
            <span class="card-step">01</span>
            <h3 class="card-title">Deep dive</h3>
          </div>
          <p class="card-desc">
            We read your codebase, architecture and workflows, and talk to the
            people who work in it daily. That is where the real problems
            surface.
          </p>
        </div>

        <div class="bento-card card-2">
          <div class="card-header">
            <span class="card-step">02</span>
            <h3 class="card-title">Report</h3>
          </div>
          <p class="card-desc">
            A written report with every finding ranked by impact and the
            concrete fix for each. No guesswork, no generic advice.
          </p>
        </div>

        <div class="bento-card card-3">
          <div class="card-header">
            <span class="card-step">03</span>
            <h3 class="card-title">Roadmap with your team</h3>
          </div>
          <p class="card-desc">
            We present the findings to your team and turn them into an execution
            plan that fits your goals, timeline and capacity. You can run it
            yourself from here.
          </p>
        </div>

        <div class="bento-card card-4">
          <div class="card-header">
            <span class="card-step"
              >04 <em class="card-optional">optional</em></span
            >
            <h3 class="card-title">Hands&#8209;on execution</h3>
          </div>
          <p class="card-desc">
            Want it done? We implement the improvements ourselves or guide your
            developers through every change, pairing and reviewing as we go.
            Either way, your codebase comes out stronger and your team knows
            why.
          </p>
        </div>
      </div>

      <a href="#contactForm" class="cta-button" data-subject="Code Review">
        Book your assessment
      </a>
      {
        articlesLink && (
          <a href={articlesLink.href} class="articles-link">
            {articlesLink.label}
          </a>
        )
      }
    </div>
  </section>
  <div id="code-reveal-spacer" style="height:0;"></div>
</div>

<script>
  (function () {
    const scrollContainer = document.querySelector(
      ".code-reveal-scroll-container",
    ) as HTMLElement;
    const section = document.querySelector(
      ".code-reveal--sticky",
    ) as HTMLElement;
    const spacer = document.getElementById("code-reveal-spacer") as HTMLElement;
    if (!scrollContainer || !section || !spacer) return;

    const cards = Array.from(
      section.querySelectorAll(".bento-card"),
    ) as HTMLElement[];
    const total = cards.length;

    requestAnimationFrame(() => {
      let spacerHeight = "";

      function updateFromScroll() {
        // Read layout first, then write, so the browser never has to
        // recalculate layout halfway through this handler (forced reflow).
        const containerRect = scrollContainer.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const scrollable = scrollContainer.offsetHeight - viewportHeight;
        const sectionHeight = section.offsetHeight;
        const scrolled = Math.min(Math.max(-containerRect.top, 0), scrollable);
        const progress = scrollable > 0 ? scrolled / scrollable : 0;

        // Reveal cards one by one as user scrolls
        cards.forEach((card, i) => {
          const threshold = (i + 1) / (total + 1);
          card.classList.toggle("card-visible", progress >= threshold);
        });

        const nextHeight = progress >= 1 ? sectionHeight + "px" : "0px";
        if (nextHeight !== spacerHeight) {
          spacerHeight = nextHeight;
          spacer.style.height = nextHeight;
        }
      }

      updateFromScroll();
      window.addEventListener("scroll", updateFromScroll, { passive: true });
      window.addEventListener("resize", updateFromScroll);
    });
  })();
</script>

<style>
  /* ─── Scroll container ─── */
  .code-reveal-scroll-container {
    background-color: var(--color-light);
    padding: 2rem 0;
    position: relative;
    height: calc(100svh + 1800px);
  }

  #code-reveal-spacer {
    width: 100%;
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Container height is 100svh + the scroll distance, so this lands where
     the reveal progress reaches 100%. */
  .code-reveal-anchor {
    position: absolute;
    left: 0;
    top: calc(100% - 100svh);
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  /* ─── Sticky section ─── */
  .code-reveal-section.code-reveal--sticky {
    position: sticky;
    margin: 0 1rem;
    border-radius: 15px;
    top: 2.5rem;
    z-index: 10;
    will-change: transform;
    view-timeline-name: --section-timeline;
    background: var(--background-gradient-primary);
    overflow: hidden;
  }

  /* ─── Background code image with circle mask ─── */
  .section-bg-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left;
    z-index: 1;
    opacity: 0.6;
    -webkit-mask-image: radial-gradient(
      circle 100px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 100px, white 90%, transparent 100%);
    -webkit-mask-size: 200px 200px;
    mask-size: 200px 200px;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-mobile;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 5% cover 85%;
  }

  @keyframes mask-zigzag-mobile {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 0%;
      mask-position: 0% 0%;
    }
    8% {
      opacity: 0.7;
    }
    25% {
      -webkit-mask-position: 65% 18%;
      mask-position: 65% 18%;
    }
    45% {
      -webkit-mask-position: 5% 40%;
      mask-position: 5% 40%;
    }
    65% {
      -webkit-mask-position: 60% 60%;
      mask-position: 60% 60%;
    }
    70% {
      -webkit-mask-position: 5% 75%;
      mask-position: 5% 75%;
      opacity: 0.7;
    }
    82% {
      opacity: 0;
    }
    100% {
      opacity: 0;
      -webkit-mask-position: 50% 95%;
      mask-position: 50% 95%;
    }
  }

  /* ─── Content ─── */
  .content-reveal {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacer-xl) var(--spacer-md);
    margin: 0 auto;
  }

  .reveal-title {
    text-align: center;
    font-size: 1.75rem;
    margin-bottom: var(--spacer-base);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  .reveal-lede {
    text-align: center;
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.72);
    max-width: 58ch;
    margin: 0 auto var(--spacer-lg);
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 12% cover 37%;
  }

  .card-optional {
    font-style: normal;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0;
    margin-left: 0.4rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    border: 1px solid rgba(47, 125, 209, 0.5);
    color: rgba(232, 237, 246, 0.8);
  }

  /* ─── Bento grid — stacked on mobile ─── */
  .bento-grid {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
  }

  /* ─── Cards ─── */
  .bento-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: var(--spacer-lg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateY(25px);
    transition:
      opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .bento-card.card-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Group step number + title tightly */
  .card-header {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin-bottom: 0.6rem;
  }

  .card-step {
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    font-family: synonym, sans-serif;
    letter-spacing: 0.05em;
  }

  .card-title {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    line-height: 1.2;
  }

  .card-desc {
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.7);
    line-height: 1.5;
    font-family: synonym, sans-serif;
  }

  /* ─── CTA ─── */
  .cta-button {
    display: inline-block;
    margin-top: var(--spacer-xl);
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: var(--color-ink-light);
    border-radius: 50px;
    text-decoration: none;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  /* Deliberately quiet so it never competes with the CTA above it. */
  .articles-link {
    margin-top: var(--spacer-lg);
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-normal);
    color: rgba(232, 237, 246, 0.55);
    text-decoration: none;
    letter-spacing: 0.01em;
  }

  .articles-link:hover,
  .articles-link:focus-visible {
    color: var(--color-ink-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ─── Desktop ─── */
  @media (min-width: 641px) {
    .content-reveal {
      max-width: 1200px;
      padding: var(--spacer-lg) var(--spacer-xl);
      min-height: calc(100svh - 6rem);
      justify-content: center;
    }

    .code-reveal-section.code-reveal--sticky {
      margin: 0 2rem;
    }

    .reveal-title {
      font-size: clamp(2.25rem, 4vw, 3.5rem);
      margin-bottom: var(--spacer-md);
    }

    .reveal-lede {
      font-size: 1.15rem;
      max-width: 64ch;
      margin-bottom: var(--spacer-xl);
    }

    /* Bento grid — 3 columns, 2 rows */
    .bento-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      grid-template-rows: 1fr 1fr;
      gap: 1rem;
    }

    .card-1 {
      grid-column: 1;
      grid-row: 1;
    }
    .card-2 {
      grid-column: 2;
      grid-row: 1;
    }
    .card-3 {
      grid-column: 1 / 3;
      grid-row: 2;
    }
    .card-4 {
      grid-column: 3;
      grid-row: 1 / 3;
      position: relative;
      background: rgba(47, 125, 209, 0.07);
      border-color: rgba(47, 125, 209, 0.12);
    }

    .card-4::after {
      content: "04";
      position: absolute;
      bottom: 0.75rem;
      right: 1rem;
      font-size: 7rem;
      font-weight: 700;
      line-height: 1;
      color: rgba(47, 125, 209, 0.06);
      pointer-events: none;
    }

    .bento-card {
      padding: var(--spacer-lg) var(--spacer-xl);
    }

    .card-header {
      gap: 0.15rem;
      margin-bottom: 0.6rem;
    }

    .card-title {
      font-size: var(--font-2xl);
    }

    .card-desc {
      font-size: var(--font-md);
    }

    .cta-button {
      margin-top: var(--spacer-lg);
      padding: var(--spacer-md) var(--spacer-2xl);
      font-size: var(--font-xl);
    }

    .articles-link {
      margin-top: var(--spacer-md);
    }

    /* Short desktop viewports: keep the whole panel visible while sticky. */
    @media (max-height: 860px) {
      .content-reveal {
        min-height: 0;
      }

      .bento-card {
        padding: var(--spacer-md) var(--spacer-lg);
      }

      .card-title {
        font-size: var(--font-xl);
      }

      .card-desc {
        font-size: 0.95rem;
      }
    }

    /* Desktop circle mask — original zigzag animation */
    .section-bg-image {
      -webkit-mask-image: radial-gradient(
        circle 150px,
        white 90%,
        transparent 100%
      );
      mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
      -webkit-mask-size: 300px 300px;
      mask-size: 300px 300px;
      animation-name: mask-zigzag-path;
      animation-range: entry 10% cover 90%;
    }

    @keyframes mask-zigzag-path {
      0% {
        opacity: 0;
        -webkit-mask-position: 0% 5%;
        mask-position: 0% 5%;
      }
      10% {
        opacity: 0.8;
      }
      20% {
        -webkit-mask-position: 70% 30%;
        mask-position: 70% 30%;
      }
      40% {
        -webkit-mask-position: 3% 37%;
        mask-position: 3% 37%;
      }
      70% {
        -webkit-mask-position: 70% 40%;
        mask-position: 70% 40%;
      }
      100% {
        -webkit-mask-position: 0% 90%;
        mask-position: 0% 90%;
      }
    }
  }
</style>
