---
import { Image } from "astro:assets";

import code_img from "../assets/code_img.svg";
---

<div class="image-overlay-container">
  <Image
    src={code_img}
    alt="Code snippet"
    loading="lazy"
    class="img circle-mask-image"
  />
  <div class="content-reveal">
    <h2 class="reveal-title">Code Analysis & Architecture Report</h2>
    <p class="reveal-text">
      We <span class="accent accent-1">review</span> your <span
        class="accent accent-1">Angular</span
      > + <span class="accent accent-1">Nx</span> codebase end-to-end to <span
        class="accent accent-3">uncover</span
      > architectural <span class="accent accent-3">bottlenecks</span>, hidden
      coupling, and build/CI slowdowns. Our approach adapts to your setup, but
      every engagement includes an end-to-end review, a
      <span class="accent accent-3">detailed report</span> with prioritized, actionable
      recommendations, and a
      <span class="accent accent-4">walkthrough</span> so your team can start <span
        class="accent accent-4">ship faster</span
      >, and build with a structure that scales..
    </p>
    <a href="#" class="cta-button">Get Your Architecture Report</a>
  </div>
</div>

<style>
  .image-overlay-container {
    position: sticky;
    top: 0;
    width: 100%;
    min-height: 100vh;
  }

  .reveal-text .accent {
    font-weight: var(--font-weight-normal);
    animation-timeline: --section-timeline;
  }

  .reveal-text .accent-1 {
    animation-range: entry 70% cover 40%;
  }

  .reveal-text .accent-3 {
    animation-range: entry 75% cover 40%;
  }

  .reveal-text .accent-4 {
    animation-range: entry 80% cover 40%;
  }

  .img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: left;
    z-index: 1;
  }

  .circle-mask-image {
    background: transparent;
    -webkit-mask-image: radial-gradient(
      circle 150px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 300px 300px;
    mask-size: 300px 300px;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-path;
    opacity: 0.4;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 50% cover 50%;
  }

  .content-reveal {
    height: 100vh;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-evenly;
    text-align: center;
    padding: var(--spacer-3xl) var(--spacer-2xl);
    max-width: 1200px;
    margin: 0 auto;
  }

  .reveal-title {
    font-size: 7rem;
    font-weight: var(--font-weight-light);
    color: white;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  .reveal-text {
    font-size: 2rem;
    font-weight: var(--font-weight-lighter);
    font-family: var(--font-secondary);
    color: white;
    line-height: 1.6;
    margin-bottom: var(--spacer-2xl);
    opacity: 0;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 20% cover 45%;
  }

  .cta-button {
    display: inline-block;
    padding: var(--spacer-lg) var(--spacer-2xl);
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: white;
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    opacity: 0.5;
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 45% cover 55%;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-hover);
    color: var(--color-accent-hover);
  }

  @keyframes mask-zigzag-path {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 5%;
      mask-position: 0% 5%;
    }
    10% {
      opacity: 0.4;
    }
    20% {
      -webkit-mask-position: 15% 10%;
      mask-position: 15% 10%;
    }
    40% {
      -webkit-mask-position: 5% 30%;
      mask-position: 5% 30%;
    }
    60% {
      -webkit-mask-position: 0% 70%;
      mask-position: 0% 70%;
    }
    80% {
      -webkit-mask-position: 15% 100%;
      mask-position: 15% 100%;
    }
    100% {
      -webkit-mask-position: 0% 100%;
      mask-position: 0% 100%;
    }
  }
</style>
