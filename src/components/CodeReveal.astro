---
import { Image } from "astro:assets";
import code_img from "../assets/code_img.svg";
import SlideBlocks from "./SlideBlocks.astro";
---

<div class="code-reveal-scroll-container">
  <section id="code-reveal" class="code-reveal-section code-reveal--sticky">
    <div class="image-overlay-container">
      <Image
        src={code_img}
        alt="Code snippet"
        loading="lazy"
        class="img circle-mask-image"
      />
      <div class="content-reveal">
        <h2 class="reveal-title">Four steps of improvement</h2>

        <SlideBlocks
          cards={[
            {
              isActive: true,
              title: "Codebase Analysis",
              description:
                "Our industry experts perform a deep analysis of your existing codebase and architecture. This helps us identify code smells, architectural issues, performance bottlenecks, and security vulnerabilities that may be hindering your application's success.",
              backgroundImage:
                "https://plus.unsplash.com/premium_photo-1678566111481-8e275550b700?q=80&w=774&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
            },
            {
              title: "Improvement Report",
              backgroundImage:
                "https://images.unsplash.com/photo-1454165804606-c3d57bc86b40?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
              description:
                "Next, we compile a comprehensive report detailing our findings. This report highlights critical issues, prioritizes them based on impact, and provides actionable recommendations for improvement.",
            },
            {
              title: "Alignment Meeting",
              backgroundImage:
                "https://images.unsplash.com/photo-1524178232363-1fb2b075b655?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
              description:
                "We will share the improvement report with your team and walk you through our recommendations. We collaborate to create a tailored plan that aligns with your business goals and technical requirements.",
            },
            {
              title: "Implementation",
              backgroundImage:
                "https://images.unsplash.com/photo-1521737711867-e3b97375f902?q=80&w=774&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
              description:
                "Our experts can do the heavy lifting for you by implementing the recommended changes directly into your codebase. Alternatively, we can provide guidance and support for your team to carry out the improvements.",
            },
          ]}
        />
        <a href="#" class="cta-button">Start Now</a>
      </div>
    </div>
  </section>
  <div id="code-reveal-spacer" style="height:0;"></div>
</div>

<script>
  // Sticky scroll-animated SlideBlocks logic
  (function () {
    const scrollContainer = document.querySelector(
      ".code-reveal-scroll-container",
    ) as HTMLElement;
    const section = document.querySelector(
      ".code-reveal--sticky",
    ) as HTMLElement;
    const spacer = document.getElementById("code-reveal-spacer") as HTMLElement;
    if (!scrollContainer || !section || !spacer) return;

    // Find SlideBlocks cards (fix: use .project-card from SlideBlocks)
    const slideBlocks = section.querySelector(".slider");
    let cards: HTMLElement[] = [];
    if (slideBlocks) {
      cards = Array.from(slideBlocks.querySelectorAll(".project-card"));
    }
    const total = cards.length;

    function setActiveCard(index: number) {
      cards.forEach((card, i) => {
        card.classList.toggle("project-card-active", i === index);
      });
    }

    function updateFromScroll() {
      const containerRect = scrollContainer.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const scrollable = scrollContainer.offsetHeight - viewportHeight;
      const scrolled = Math.min(Math.max(-containerRect.top, 0), scrollable);
      const progress = scrollable > 0 ? scrolled / scrollable : 0;
      const index = Math.round(progress * (total - 1));
      setActiveCard(index);
      // Unstick when last card is active
      if (progress >= 1) {
        spacer.style.height = section.offsetHeight + "px";
      } else {
        spacer.style.height = "0px";
      }
    }

    setActiveCard(0);
    updateFromScroll();
    window.addEventListener("scroll", updateFromScroll, { passive: true });
    window.addEventListener("resize", updateFromScroll);
  })();
</script>

<style>
  .code-reveal-scroll-container {
    background-color: var(--color-light);
    padding-bottom: 1.5rem;
    position: relative;
    height: calc(100vh + 1800px); /* Adjust for desired scroll length */
  }
  #code-reveal-spacer {
    width: 100%;
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .code-reveal-section.code-reveal--sticky {
    position: sticky;
    margin: 0 1rem;
    border-radius: 15px;
    top: 4.5rem;
    z-index: 10;
    will-change: transform;
    view-timeline-name: --section-timeline;
    background:
      radial-gradient(circle at 10% 10%, #1c2a45 0%, #0f1a2b 45%),
      linear-gradient(180deg, #0f1a2b 0%, #0c1625 100%);
  }

  .image-overlay-container {
    position: sticky;
    top: 0;
    width: 100%;
  }

  .img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    object-position: left;
    z-index: 1;
  }

  .circle-mask-image {
    background: transparent;
    -webkit-mask-image: radial-gradient(
      circle 75px,
      white 90%,
      transparent 100%
    );
    mask-image: radial-gradient(circle 75px, white 90%, transparent 100%);
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 200px 200px;
    mask-size: 200px 200px;
    -webkit-mask-position: 0% 0%;
    mask-position: 0% 0%;
    animation-name: mask-zigzag-path;
    opacity: 0.4;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 90%;
  }

  .content-reveal {
    border-radius: 15px;
    margin: 0 2rem;
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem 0;
    max-width: 100%;
    margin: 0 auto;
  }

  .reveal-title {
    display: none;
    text-align: center;
    font-size: 3rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    transform: translateY(50px);
    animation-name: fade-in-up;
    animation-timeline: --section-timeline;
    animation-fill-mode: both;
    animation-range: entry 10% cover 35%;
  }

  .reveal-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    flex-wrap: nowrap;
    overflow: visible;
    gap: var(--spacer-md);
    padding: 0 1rem var(--spacer-md);
    scrollbar-width: none;
    text-align: left;
    font-size: 1.2rem;
    overflow: visible;
  }

  .reveal-card-list::after {
    content: "";
    flex: 0 0 1px;
  }

  .reveal-card-list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .reveal-card-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1rem;
  }

  .reveal-card-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .reveal-card-shell {
    width: 100%;
  }

  .reveal-card-nav {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--spacer-sm);
    gap: var(--spacer-sm);
    margin-right: var(--spacer-md);
  }

  .reveal-card-button {
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(15, 26, 43, 0.7);
    color: var(--color-ink-light);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-md);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .cta-button {
    display: inline-block;
    margin-top: var(--spacer-lg);
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: var(--color-ink-light);
    border-radius: 50px;
    text-decoration: none;
  }

  .cta-button:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
  }

  .reveal-card-list :global(.app-card) {
    flex: 0 0 82vw;
    max-width: 82vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  @keyframes mask-zigzag-path {
    0% {
      opacity: 0;
      -webkit-mask-position: 0% 0%;
      mask-position: 0% 0%;
    }
    10% {
      opacity: 0.6;
    }
    20% {
      -webkit-mask-position: 80% 10%;
      mask-position: 80% 10%;
    }
    40% {
      -webkit-mask-position: 7% 20%;
      mask-position: 7% 20%;
    }
    60% {
      -webkit-mask-position: 35% 30%;
      mask-position: 35% 30%;
    }
    80% {
      -webkit-mask-position: 5% 40%;
      mask-position: 5% 40%;
    }
    95% {
      -webkit-mask-position: 5% 80%;
      mask-position: 5% 80%;
    }
    100% {
      -webkit-mask-position: 80% 100%;
      mask-position: 80% 100%;
    }
  }

  @media (min-width: 641px) {
    .image-overlay-container {
      height: calc(100dvh - 6rem);
    }

    .content-reveal {
      max-width: 1200px;
      padding: var(--spacer-base) 0;
      gap: var(--spacer-xl);
      justify-content: center;
      height: 100%;
    }

    .code-reveal-section.code-reveal--sticky {
      margin: 0 2rem;
    }

    .reveal-title {
      display: block;
      font-size: 5rem;
    }

    .reveal-card-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--spacer-lg);
      padding: 0;
    }

    .reveal-card-scroll {
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding: 0;
    }

    .reveal-card-nav {
      display: none;
      margin-right: 0;
    }

    .reveal-card-list :global(.app-card) {
      flex: initial;
      max-width: none;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }

    .cta-button {
      padding: var(--spacer-lg) var(--spacer-2xl);
      font-size: var(--font-2xl);
    }

    .circle-mask-image {
      -webkit-mask-image: radial-gradient(
        circle 150px,
        white 90%,
        transparent 100%
      );
      mask-image: radial-gradient(circle 150px, white 90%, transparent 100%);
      -webkit-mask-size: 300px 300px;
      mask-size: 300px 300px;
    }

    @keyframes mask-zigzag-path {
      0% {
        opacity: 0;
        -webkit-mask-position: 0% 5%;
        mask-position: 0% 5%;
      }
      10% {
        opacity: 0.6;
      }
      20% {
        -webkit-mask-position: 40% 10%;
        mask-position: 40% 10%;
      }
      40% {
        -webkit-mask-position: 80% 20%;
        mask-position: 80% 20%;
      }
      60% {
        -webkit-mask-position: 3% 50%;
        mask-position: 3% 50%;
      }
      80% {
        -webkit-mask-position: 2% 80%;
        mask-position: 2% 80%;
      }
      100% {
        -webkit-mask-position: 0% 100%;
        mask-position: 0% 100%;
      }
    }
  }
</style>
