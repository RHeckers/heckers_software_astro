---
/**
 * The architecture assessment on the home page: why teams ask for one,
 * how it runs, and what they can count on. Sits on a light background
 * between the dark proof band and the contact form, and gives the third
 * service its own section, after the band that argues for an outside read.
 *
 * The plan panel is the one animated element: its vertical line draws
 * down and each step lights up as the panel scrolls into view (CSS
 * scroll-driven animation, no script; fully drawn where unsupported).
 */
import Accent from "./Accent.astro";
import ProofQuote from "./ProofQuote.astro";
import { PRICING, euro } from "../lib/pricing";

const reasons = [
  {
    title: "Before a big decision",
    copy: "A rewrite, a move to Nx, a new Angular major, an acquisition. You want an outside opinion on the code before the budget is committed, from someone who has read a lot of other people's codebases.",
  },
  {
    title: "When velocity has quietly dropped",
    copy: "Releases take longer, estimates miss by a factor of two, the same bugs come back. You want to know which five things cause it, what each costs you per month, and what fixing them takes.",
  },
  {
    title: "As the first step before we build",
    copy: "Every forward-deployed engagement starts with an outside read. On its own, the assessment is the cheapest way to find out whether you need one at all.",
  },
];

const scope =
  "Project graph and module boundaries, dependency and bundle analysis, build and CI times, state management, the testing strategy, Angular and Nx versions and the upgrade path, and the workflow around the code: reviews, releases, ownership.";

const phases = [
  {
    title: "Kick-off and access",
    when: "Day 1",
    copy: "Read access to the repositories and pipelines, a thirty-minute call on what hurts, and the list of people to interview. The price is fixed here, before anything is read.",
  },
  {
    title: "Reading the code",
    when: "Week 1",
    copy: "Project graph, dependency and boundary analysis, bundle and build times, tests and upgrade path. Automated where it can be, read by a senior engineer where it matters.",
  },
  {
    title: "Interviews",
    when: "Week 2",
    copy: "Developers, leads and product. The code says what is there; the people say why, and which parts they avoid touching.",
  },
  {
    title: "Report and roadmap",
    when: "Week 2–3",
    copy: "Every finding ranked by what it costs per month, with the fix and the effort next to each. A roadmap session with your team, sized to your capacity, and thirty days of follow-up questions.",
  },
];

const stack = [
  "Angular",
  "Nx",
  "TypeScript",
  "NgRx and Signal Store",
  "RxJS",
  ".NET and Node.js APIs",
  "Azure pipelines",
];

const commitments = [
  {
    title: "A fixed price, up front",
    copy: `From ${euro(PRICING.assessment.minimum)} for the one-week scan. Minimum and Standard are fixed prices for workspaces up to roughly fifty projects, and the number does not change during the assessment.`,
  },
  {
    title: "Ranked, not listed",
    copy: "Not sixty pages of everything that is wrong. Findings sorted by what they cost you, with the fix next to each, so your team starts at the top and the rest can wait.",
  },
  {
    title: "Yours to run",
    copy: "The roadmap is written so your own developers can execute it, and most teams do. If you would rather have the top findings fixed by us, that is the Advanced tier.",
  },
];
---

<section class="assessment" id="architecture-assessment">
  <div class="assessment__inner">
    <div class="assessment__grid">
      <div class="assessment__copy">
        <header class="assessment__header">
          <h2 class="assessment__title">An outside read of your codebase</h2>
          <p class="assessment__lede">
            The architecture assessment is the diagnosis before anyone builds.
            Senior engineers read your Angular or Nx codebase from the
            outside, talk to the people who work in it every day, and hand
            you every finding
            <Accent range="entry 40% cover 35%" wrap>ranked by what it costs you, not by how ugly it looks</Accent>,
            with the fix and the effort next to each. Fixed scope, two to
            three weeks, and a roadmap your own team can run.
          </p>
        </header>

        <h3 class="assessment__subtitle">Three moments teams ask for one</h3>
        <ul class="offerings">
          {
            reasons.map((item) => (
              <li class="offering">
                <span class="offering__title">{item.title}</span>
                <span class="offering__copy">{item.copy}</span>
              </li>
            ))
          }
        </ul>

        <p class="assessment__scope">
          <span class="assessment__scope-label">What we read</span>
          {scope}
        </p>

        <ProofQuote snippet="ferdiDepth" />
      </div>

      <aside class="plan" aria-labelledby="plan-title">
        <div class="plan__head">
          <h3 class="plan__title" id="plan-title">How the assessment runs</h3>
          <p class="plan__intro">
            Fixed scope, fixed duration, a few hours of your team's time in
            total.
          </p>
        </div>
        <ol class="phases">
          {
            phases.map((phase, index) => (
              <li class="phase" style={`--i: ${index}`}>
                <span class="phase__marker" aria-hidden="true">
                  {index + 1}
                </span>
                <div class="phase__body">
                  <div class="phase__row">
                    <h4 class="phase__title">{phase.title}</h4>
                    <span class="phase__when">{phase.when}</span>
                  </div>
                  <p class="phase__copy">{phase.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="plan__stack">
          <span class="plan__stack-label">
            What we assess. Front end first, with the APIs and pipelines
            behind it where they shape the front end.
          </span>
          <ul class="stack">
            {stack.map((tool) => <li class="stack__item">{tool}</li>)}
          </ul>
        </div>
      </aside>

      <div class="assessment__actions">
        <a href="#contactForm" class="assessment__cta" data-subject="Code Review">
          Book assessment
        </a>
        <p class="assessment__note">
          A short call to scope it. The price is fixed before we start.
        </p>
        <a href="/services/architecture-assessment" class="assessment__details">
          Three tiers, what a finding looks like, and fourteen signs your
          architecture is costing you
        </a>
      </div>
    </div>

    <ul class="commitments" aria-label="What you can count on">
      {
        commitments.map((item) => (
          <li class="commitment">
            <h3 class="commitment__title">{item.title}</h3>
            <p class="commitment__copy">{item.copy}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .assessment {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .assessment__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* --- Header --- */

  .assessment__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    max-width: 60ch;
    margin-bottom: var(--spacer-md);
  }

  .assessment__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .assessment__lede {
    font-family: synonym, sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .assessment__lede :global(.accent) {
    color: var(--color-ink);
  }

  /* --- Two column body --- */

  .assessment__grid {
    display: grid;
    /* minmax(0, …): a column must never grow past the screen to fit its
       widest child; the child wraps or clips instead. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .assessment__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
  }

  .assessment__subtitle {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .offerings {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-stroke-strong);
  }

  .offering {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .offering__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .offering__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .assessment__scope {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .assessment__scope-label {
    display: block;
    font-family: chillax, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    margin-bottom: 0.2rem;
  }

  .assessment__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacer-md);
    margin-top: var(--spacer-base);
  }

  .assessment__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8em 1.8em;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background-color: var(--color-accent-strong);
    border: 1px solid var(--color-accent-strong);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(37, 99, 168, 0.28);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .assessment__cta:hover {
    background-color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
    transform: translateY(-1px);
  }

  .assessment__cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .assessment__note {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  .assessment__details {
    font-family: synonym, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .assessment__details:hover,
  .assessment__details:focus-visible {
    color: var(--color-accent-strong);
  }

  /* --- Project plan panel --- */

  .plan {
    background: var(--background-gradient-primary);
    color: var(--color-ink-light);
    border-radius: 22px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
    box-shadow: 0 30px 60px rgba(11, 18, 32, 0.22);
    view-timeline-name: --plan-reveal;
  }

  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .plan__title {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
  }

  .plan__intro {
    font-family: synonym, sans-serif;
    color: rgba(232, 237, 246, 0.7);
  }

  .phases {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    --marker: 2rem;
  }

  .phase {
    position: relative;
    display: grid;
    grid-template-columns: var(--marker) 1fr;
    gap: var(--spacer-md);
    align-items: start;
  }

  /* Rail segment from this marker down to the next one; the accent copy
     draws over the grey one as the phase scrolls into view. */
  .phase:not(:last-child)::before,
  .phase:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--marker) / 2 - 1px);
    top: calc(var(--marker) / 2);
    bottom: calc(-1 * var(--spacer-lg) - var(--marker) / 2);
    width: 2px;
    border-radius: 2px;
  }

  .phase:not(:last-child)::before {
    background: rgba(232, 237, 246, 0.14);
  }

  .phase:not(:last-child)::after {
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
  }

  .phase__marker {
    width: var(--marker);
    height: var(--marker);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-dark-strong);
    position: relative;
    z-index: 1;
  }

  .phase__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .phase__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .phase__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
  }

  .phase__when {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .phase__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.78);
    max-width: 48ch;
  }

  .plan__stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: var(--spacer-lg);
    border-top: 1px solid rgba(232, 237, 246, 0.12);
  }

  .plan__stack-label {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.6);
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack__item {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(232, 237, 246, 0.2);
    color: var(--color-ink-light);
  }

  /* Scroll-driven reveal: rail draws down, phases fade in in order.

     Phone pacing lives here: the panel fills most of a small screen, so the
     first step holds off until it is a third of the way in and each step then
     takes a longer stretch of scroll. Every offset stays inside the entry
     range, so nothing extrapolates past it. Wide screens override below. */
  @supports (animation-timeline: view()) {
    .phase:not(:last-child)::after {
      transform: scaleY(0);
      animation: plan-rail linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(50% + var(--i) * 11%) entry
        calc(78% + var(--i) * 11%);
    }

    .phase {
      opacity: 0.35;
      animation: plan-phase linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(35% + var(--i) * 11%) entry
        calc(65% + var(--i) * 11%);
    }

    .phase__marker {
      background: var(--color-dark-soft);
      animation: plan-marker linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(35% + var(--i) * 11%) entry
        calc(65% + var(--i) * 11%);
    }

    /* On wide screens the panel enters quickly, so pace the reveal over its
       whole pass through the viewport and start each step later. */
    @media (min-width: 960px) {
      .phase,
      .phase__marker {
        animation-range: cover calc(18% + var(--i) * 11%) cover
          calc(30% + var(--i) * 11%);
      }

      .phase:not(:last-child)::after {
        animation-range: cover calc(24% + var(--i) * 11%) cover
          calc(38% + var(--i) * 11%);
      }
    }
  }

  @keyframes plan-rail {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes plan-phase {
    to {
      opacity: 1;
    }
  }

  @keyframes plan-marker {
    to {
      background: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phase:not(:last-child)::after {
      transform: scaleY(1);
    }
    .phase {
      opacity: 1;
    }
    .phase__marker {
      background: var(--color-accent);
    }
  }

  /* --- Commitments --- */

  .commitments {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-lg);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-stroke-strong);
  }

  .commitment {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-success);
  }

  .commitment__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .commitment__copy {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 40ch;
  }

  /* --- Wider screens --- */

  @media (min-width: 720px) {
    .assessment__cta {
      padding: 0.95em 2.2em;
      font-size: 1.15rem;
    }

    .commitments {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacer-xl);
    }
  }

  @media (min-width: 960px) {
    .assessment__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .plan {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .assessment__actions {
      grid-column: 1;
      margin-top: 0;
    }
  }
</style>
