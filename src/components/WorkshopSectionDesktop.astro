---
import { Image } from "astro:assets";
import effectiveAngular from "../assets/workshop/effective_angular.jpg";
import ngPoland from "../assets/workshop/ng_poland.jpg";
import talk1 from "../assets/workshop/talk_1.jpg";
import talk2 from "../assets/workshop/talk_2.png";
import { HOME_CATEGORY_LINKS, resolveHomeLink } from "../lib/home-links";
import { WORKSHOPS } from "../lib/workshops";

const images = {
  "enterprise-angular": { src: talk1, objectPosition: "center" },
  "nx-monorepo": { src: ngPoland, objectPosition: "left" },
  ai: { src: talk2, objectPosition: "center" },
  "ui-libraries": { src: effectiveAngular, objectPosition: "top center" },
} as const;

const workshops = WORKSHOPS.map((item) => ({
  ...item,
  image: images[item.id].src,
  objectPosition: images[item.id].objectPosition,
}));

// Blog link per workshop, resolved at build time from HOME_CATEGORY_LINKS.
const workshopLinks = await Promise.all(
  workshops.map((item) =>
    resolveHomeLink(
      HOME_CATEGORY_LINKS.workshops[
        item.id as keyof typeof HOME_CATEGORY_LINKS.workshops
      ],
    ),
  ),
);
---

<div class="workshops-scroll-container">
  <section class="workshops workshops--sticky">
    <div class="wheel-pin" data-carousel>
      <div class="wheel-layout">
        <div class="wheel wheel--left">
          <div class="wheel__track" data-wheel="left">
            {
              workshops.map((item, index) => (
                <article
                  class="wheel-card"
                  data-index={index}
                  style={`--card-stagger: ${index * 120}ms`}
                >
                  <p class="card-tag">{item.tag}</p>
                  <h3>{item.title}</h3>
                  <p class="card-description">{item.description}</p>
                  <ul>
                    {item.bullets.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                  <div class="card-actions">
                    <a class="card-cta" href="#contactForm" data-subject="Workshop">
                      Book workshop
                    </a>
                    <a class="card-link" href={`/services/workshops#${item.id}`}>
                      Workshop details &rarr;
                    </a>
                    {workshopLinks[index] && (
                      <a class="card-link" href={workshopLinks[index].href}>
                        {workshopLinks[index].label} &rarr;
                      </a>
                    )}
                  </div>
                </article>
              ))
            }
          </div>
        </div>

        <div class="wheel wheel--right" aria-hidden="true">
          <div class="wheel__track" data-wheel="right">
            {
              workshops.map((item, index) => (
                <figure class="wheel-image" data-index={index}>
                  <Image
                    src={item.image}
                    alt={item.title}
                    loading="lazy"
                    style={`--object-position: ${item.objectPosition ?? "center"}; object-position: var(--object-position);`}
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>
  <div id="workshops-spacer" style="height:0;"></div>
</div>

<style>
  .workshops-scroll-container {
    position: relative;
    /* Height = sticky section height + scroll distance for carousel */
    height: calc(100svh + 1500px); /* Adjust 600px for desired scroll length */
  }
  #workshops-spacer {
    width: 100%;
    transition: height 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .workshops--sticky {
    position: sticky;
    top: 0;
    z-index: 10;
    will-change: transform;
  }
  .workshops {
    color: var(--color-ink);
    padding: clamp(3.5rem, 8vw, 7rem) clamp(1.5rem, 7vw, 6rem);
    overflow: hidden;
  }

  .wheel-pin {
    position: relative;
    height: var(--pin-height, 100svh);
  }

  .wheel-layout {
    position: sticky;
    top: clamp(1.5rem, 6svh, 4rem);
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 6vw, 5rem);
    min-height: clamp(460px, 70vw, 680px);
    width: 100vw;
    margin-left: calc(50% - 50vw);
    padding-inline: 0;
  }

  .wheel {
    position: relative;
    min-height: clamp(460px, 70vw, 680px);
    overflow: visible;
  }

  .wheel__track {
    position: absolute;
    top: 50%;
    width: clamp(520px, 60vw, 720px);
    height: clamp(520px, 60vw, 720px);
  }

  .wheel--left {
    justify-self: start;
    margin-top: 5rem;
  }

  .wheel--left .wheel__track {
    left: 0;
    transform: translate(-55%, -50%);
  }

  .wheel--right {
    justify-self: end;
    margin-top: 5rem;
  }

  .wheel--right .wheel__track {
    right: 0;
    transform: translate(50%, -50%);
  }

  .wheel-card,
  .wheel-image {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    transition:
      transform 0.7s ease,
      filter 0.7s ease,
      opacity 0.7s ease;
    opacity: 0.55;
    filter: blur(3px) saturate(0.95);
  }

  .wheel-card.is-active,
  .wheel-image.is-active {
    opacity: 1;
    filter: blur(0) saturate(1.05);
    z-index: 3;
  }

  .wheel-card {
    width: min(660px, 98vw);
    max-width: 700px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid var(--color-stroke);
    border-radius: 18px;
    padding: 2.2rem 2.6rem 2.1rem 2.4rem;
    box-shadow: 0 26px 60px rgba(40, 12, 19, 0.16);
    display: flex;
    flex-direction: column;
    z-index: 2;
  }

  .wheel-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 18px;
  }

  .wheel-image {
    width: min(370px, 80vw);
    height: min(370px, 80vw);
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(40, 12, 19, 0.2);
    background: var(--color-light-alt);
  }

  .wheel-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--object-position, center);
    transform: scale(1.03);
  }

  .card-tag {
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    font-size: var(--font-sm);
    margin-bottom: 0.35rem;
    margin-top: 0.1rem;
  }

  .wheel-card h3 {
    font-size: clamp(1.7rem, 3.2vw, 2.3rem);
    line-height: 1.13;
    margin-top: 0.1rem;
  }

  .card-description {
    color: var(--color-ink-muted);
    font-size: 1.18rem;
    margin-top: 0.15rem;
    font-family: synonym;
  }

  .wheel-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    margin-top: 0.7rem;
    margin-left: 0.5rem;
    padding: 0;
  }

  .wheel-card li {
    display: flex;
    gap: 0.5em;
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
    margin-bottom: 0.13rem;
    font-family: synonym;
  }

  .wheel-card li::before {
    content: "→";
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-bold);
  }

  .card-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: 1.75rem;
    cursor: pointer;
    z-index: 10;
  }

  .card-link {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .card-link:hover,
  .card-link:focus-visible {
    color: var(--color-accent-strong);
  }

  .card-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 2.2rem;
    font-size: 1.13rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-light);
    background-color: var(--color-accent);
    border-radius: 999px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      background-color 0.3s ease;
  }

  .card-cta:hover,
  .card-cta:focus-visible {
    outline: 2px solid var(--color-accent-strong);
    background-color: var(--color-accent-strong);
  }
</style>

<script>
  // Sticky scroll-animated carousel logic with smooth unstick
  (function () {
    const scrollContainer = document.querySelector(
      ".workshops-scroll-container",
    ) as HTMLElement;
    const section = document.querySelector(".workshops--sticky") as HTMLElement;
    const spacer = document.getElementById("workshops-spacer") as HTMLElement;
    if (!scrollContainer || !section || !spacer) return;

    const carousel = section.querySelector("[data-carousel]") as HTMLElement;
    const leftItems = Array.from(
      carousel.querySelectorAll("[data-wheel='left'] .wheel-card"),
    ) as HTMLElement[];
    const rightItems = Array.from(
      carousel.querySelectorAll("[data-wheel='right'] .wheel-image"),
    ) as HTMLElement[];
    const total = Math.min(leftItems.length, rightItems.length);
    const radiusLeft = 520;
    const radiusRight = 400;
    const arc = Math.PI * 1.25;
    const baseAngleLeft = 0;
    const baseAngleRight = 0;

    function positionItems(activeIndex: number) {
      leftItems.forEach((item, index) => {
        const offset = index - activeIndex;
        const angle = baseAngleLeft + (offset * arc) / (total - 1);
        const x = Math.cos(angle) * radiusLeft;
        const y = Math.sin(angle) * radiusLeft;
        item.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px)`;
        item.classList.toggle("is-active", index === activeIndex);
      });
      rightItems.forEach((item, index) => {
        const offset = index - activeIndex;
        const angle = baseAngleRight - (offset * arc) / (total - 1);
        const x = -Math.cos(angle) * radiusRight;
        const y = Math.sin(angle) * radiusRight;
        item.style.transform = `translate(-50%, -50%) translate(${x}px, ${y}px)`;
        item.classList.toggle("is-active", index === activeIndex);
      });
    }

    requestAnimationFrame(() => {
      let activeIndex = -1;
      let spacerHeight = "";

      function updateFromScroll() {
        // Read layout first, then write, so the browser never has to
        // recalculate layout halfway through this handler (forced reflow).
        const containerRect = scrollContainer.getBoundingClientRect();
        const viewportHeight = window.innerHeight;
        const scrollable = scrollContainer.offsetHeight - viewportHeight;
        const sectionHeight = section.offsetHeight;
        const scrolled = Math.min(Math.max(-containerRect.top, 0), scrollable);
        const progress = scrollable > 0 ? scrolled / scrollable : 0;
        const index = Math.round(progress * (total - 1));

        if (index !== activeIndex) {
          activeIndex = index;
          positionItems(index);
        }
        // Instead of toggling sticky/relative, grow the spacer to push the next section down
        const nextHeight = progress >= 1 ? sectionHeight + "px" : "0px";
        if (nextHeight !== spacerHeight) {
          spacerHeight = nextHeight;
          spacer.style.height = nextHeight;
        }
      }

      updateFromScroll();
      window.addEventListener("scroll", updateFromScroll, { passive: true });
      window.addEventListener("resize", updateFromScroll);
    });

    positionItems(0);
  })();
</script>
