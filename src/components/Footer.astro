---
/**
 * One thin bar with what a footer has to carry and nothing else: who the
 * company is (name, KVK and VAT numbers), how to reach it, and the legal
 * links, including the cookie settings. Services and the about page are in
 * the navigation; the pitch is the page above.
 */
import { COMPANY, PROFILES } from "../consts";

interface Props {
  /** Kept so existing pages keep compiling; the footer is the same thin
   *  bar everywhere now. */
  compact?: boolean;
}

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer__inner">
    <p class="footer__company">
      <span>© {year} {COMPANY.name}</span>
      <span>KVK {COMPANY.kvk}</span>
      <span>BTW {COMPANY.btw}</span>
    </p>

    <ul class="footer__links">
      <li><a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a></li>
      {
        PROFILES.linkedin && (
          <li>
            <a
              href={PROFILES.linkedin}
              rel="me noopener noreferrer"
              target="_blank"
            >
              LinkedIn
            </a>
          </li>
        )
      }
      <li><a href="/legal/terms">Terms</a></li>
      <li><a href="/legal/privacy">Privacy</a></li>
      <li><a href="/legal/cookies">Cookies</a></li>
      <li>
        <button type="button" class="footer__link-button" id="cookieSettings">
          Cookie settings
        </button>
      </li>
    </ul>
  </div>
</footer>

<script>
  document.getElementById("cookieSettings")?.addEventListener("click", () => {
    (window as any).openCookieConsent?.();
  });
</script>

<style>
  .footer {
    position: relative;
    z-index: 10;
    background: var(--color-dark);
    color: rgba(249, 251, 255, 0.7);
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    padding: 1.1rem clamp(1.25rem, 6vw, 5rem);
  }

  .footer__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .footer__company,
  .footer__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1.25rem;
  }

  .footer__links a,
  .footer__link-button {
    color: rgba(249, 251, 255, 0.85);
    text-decoration: none;
    transition: color 180ms ease;
  }

  .footer__link-button {
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    cursor: pointer;
  }

  .footer__links a:hover,
  .footer__links a:focus-visible,
  .footer__link-button:hover,
  .footer__link-button:focus-visible {
    color: var(--color-light-raised);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
