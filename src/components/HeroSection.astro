---
import LogoBanner from "./LogoBanner.astro";
---

<section class="hero bg-gradient">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>

  <div class="hero-content">
    <h1>Complex Systems</h1>

    <div class="particle-text-spacer">
      <h2 class="sr-only">Built With Simplicity</h2>
      <h2 class="sr-only">Architected For Scale</h2>
      <h2 class="sr-only">Performance Driven</h2>
    </div>

    <span class="hero-badge">Angular & Nx Architecture Experts</span>

    <p class="hero-description">
      We architect, build, and rescue large-scale Angular & Nx applications.
    </p>

    <div class="hero-actions">
      <a href="#contactForm" class="btn btn-primary">Book a Call</a>
    </div>
  </div>

  <div class="logo-banner-container">
    <LogoBanner />
  </div>
</section>

<script>
  function initHero() {
    const canvas = document.getElementById(
      "hero-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;

    // Feature-detect WebGL on a temporary canvas
    const testCanvas = document.createElement("canvas");
    const gl =
      testCanvas.getContext("webgl") ||
      testCanvas.getContext("experimental-webgl");
    if (!gl) {
      canvas.style.display = "none";
      return;
    }

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let controller: {
      destroy: () => void;
      pause: () => void;
      resume: () => void;
    } | null = null;

    import("../lib/hero-scene").then(async ({ createHeroScene }) => {
      controller = await createHeroScene({ canvas, reducedMotion });
    });

    function onVisibility() {
      if (!controller) return;
      if (document.hidden) {
        controller.pause();
      } else {
        controller.resume();
      }
    }
    document.addEventListener("visibilitychange", onVisibility);

    function onSwap() {
      controller?.destroy();
      controller = null;
      document.removeEventListener("visibilitychange", onVisibility);
      document.removeEventListener("astro:before-swap", onSwap);
    }
    document.addEventListener("astro:before-swap", onSwap);
  }

  initHero();
  document.addEventListener("astro:after-swap", initHero);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    padding: var(--spacer-xl) var(--spacer-lg);
  }

  h1 {
    color: var(--color-light-raised);
    font-size: clamp(var(--font-2xl), 10vw, var(--font-6xl));
    font-weight: var(--font-weight-light);
    line-height: 1.1;
    margin: 0 0 0.25rem;
    white-space: nowrap;
  }

  /* Spacer where the particle text appears through the canvas */
  .particle-text-spacer {
    height: clamp(3.5rem, 8vw, 5rem);
    margin-bottom: 1.25rem;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.35em 1.1em;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 100px;
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    margin-bottom: 0.5rem;
  }

  .hero-description {
    color: var(--color-ink-muted);
    font-size: clamp(var(--font-md), 1.8vw, var(--font-lg));
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacer-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacer-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7em 1.8em;
    font-size: var(--font-base);
    font-weight: var(--font-weight-medium);
    border-radius: 100px;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
    cursor: pointer;
  }

  .btn-primary {
    background-color: var(--color-accent);
    color: var(--color-light-raised);
    border: 1px solid var(--color-accent);
  }
  .btn-primary:hover {
    background-color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-ink-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--color-light-raised);
  }

  .logo-banner-container {
    position: absolute;
    bottom: -10px;
    width: 100%;
    z-index: 3;
  }

  /* Screen-reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (min-width: 650px) {
    .hero-content {
      padding: var(--spacer-3xl) var(--spacer-xl);
    }

    h1 {
      margin-bottom: 0.5rem;
    }

    .particle-text-spacer {
      margin-bottom: 1.5rem;
    }

    .hero-badge {
      font-size: var(--font-sm);
      margin-bottom: 0.75rem;
    }

    .hero-description {
      white-space: nowrap;
    }

    .hero-actions {
      margin-top: var(--spacer-2xl);
    }
  }
</style>
