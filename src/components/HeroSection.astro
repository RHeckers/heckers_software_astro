---
import { Image } from "astro:assets";
import LogoBanner from "./LogoBanner.astro";

import arch from "../assets/architecture_design.svg";
---

<section class="hero bg-gradient bg-gradient-animation">
  <div class="hero-content">
    <h1 class="headline">Complex Systems</h1>

    <Image
      src={arch}
      alt="Abstract geometric shape representing complex systems"
      class="hero-img"
      loading="eager"
      width={600}
      height={600}
      fetchpriority="high"
    />
    <div class="placeholder"></div>

    <div class="headline-rotator">
      <h1 class="headline headline-2 heading-1">Built With Simplicity</h1>
      <h1 class="headline headline-2 heading-2">Architected For Scale</h1>
      <h1 class="headline headline-2 heading-3">Performance Driven</h1>
    </div>
  </div>

  <div class="logo-banner-container">
    <LogoBanner />
  </div>
</section>

<style>
  .hero-img {
    z-index: 1;
    opacity: 0.5;
    height: auto;
  }

  .headline-rotator {
    position: relative;
    height: 3em;
    width: 100%;
    display: block;
    margin: 0 auto;
    perspective: 800px;
    perspective-origin: 50% 50%;
    margin-top: -23px;
  }

  .headline-rotator h1 {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    margin: 0 auto;
    opacity: 0;
    transform: rotateX(90deg) scale(0.95);
    animation: headline-rotate-3d 9s cubic-bezier(0.77, 0, 0.175, 1) infinite;
    pointer-events: none;
    z-index: 1;
    width: 100%;
    text-align: center;
    backface-visibility: hidden;
    will-change: opacity, transform;
  }

  .headline-rotator .heading-1 {
    animation-delay: 0s;
  }
  .headline-rotator .heading-2 {
    animation-delay: 3s;
  }
  .headline-rotator .heading-3 {
    animation-delay: 6s;
  }

  @keyframes headline-rotate-3d {
    0% {
      opacity: 0;
      transform: rotateX(90deg) scale(0.95);
    }
    8% {
      opacity: 1;
      transform: rotateX(0deg) scale(1);
    }
    28% {
      opacity: 1;
      transform: rotateX(0deg) scale(1);
    }
    36% {
      opacity: 0;
      transform: rotateX(-90deg) scale(0.95);
    }
    100% {
      opacity: 0;
      transform: rotateX(-90deg) scale(0.95);
    }
  }
  .hero {
    position: relative;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    text-align: center;
    margin-top: -64px;
    align-items: center;
    justify-content: center;
    background-color: var(--color-dark);
    padding: var(--spacer-lg);
    gap: var(--spacer-xl);
    --stroke-primary: var(--color-ink-light);
    --stroke-secondary: var(--color-accent);
    --stroke-tertiary: var(--color-light);
    --draw-pass-gap: 5s;
    --draw-pass-duration: calc(var(--draw-pass-gap) * 3);
  }

  .logo-banner-container {
    position: absolute;
    bottom: -10px;
    width: 100%;
  }

  svg {
    z-index: 2;
  }

  h1 {
    color: var(--color-light-raised);
    font-size: clamp(var(--font-lg), var(--font-2xl), var(--font-3xl));
    font-weight: var(--font-weight-light);

    &:first-child {
      text-align: center;
    }
  }

  .draw {
    fill: none;
    stroke-width: 1;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: var(--pathLen, 0);
    stroke-dashoffset: var(--pathLen, 0);
  }

  .draw-primary {
    stroke: var(--stroke-primary);
    animation:
      draw-initial 3s cubic-bezier(0.99, 0, 1, 1) forwards,
      draw-pass var(--draw-pass-duration) cubic-bezier(0.99, 0.01, 0.25, 1)
        infinite;
    animation-delay: var(--draw-pass-duration), 0s;
    animation-fill-mode: forwards, both;
  }

  .draw-secondary {
    stroke: var(--stroke-secondary);
    animation: draw-pass var(--draw-pass-duration)
      cubic-bezier(0.99, 0.01, 0.25, 1) infinite;
    animation-delay: var(--draw-pass-gap);
    animation-fill-mode: both;
  }

  .draw-tertiary {
    stroke: var(--stroke-tertiary);
    animation: draw-pass var(--draw-pass-duration)
      cubic-bezier(0.99, 0.01, 0.25, 1) infinite;
    animation-delay: calc(var(--draw-pass-gap) * 2);
    animation-fill-mode: both;
  }

  @keyframes draw-initial {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes draw-pass {
    0% {
      stroke-dashoffset: var(--pathLen, 0);
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    35% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    70% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    80% {
      opacity: 0;
    }
    100% {
      stroke-dashoffset: var(--pathLen, 0);
      opacity: 0;
    }
  }

  svg {
    width: 50vw;
    height: auto;
  }

  .placeholder {
    display: none;
  }

  @media (min-width: 650px) {
    .placeholder {
      display: block;
    }

    .hero-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      opacity: 0.5;
    }

    .logo-banner-container {
      bottom: 4rem;
    }

    .hero {
      height: calc(100dvh + 80px);
      text-align: left;
    }

    .hero-content {
      position: relative;
      display: grid;
      height: 100%;
      margin-top: -150px;
      grid-template-columns:
        calc(35vw - var(--spacer-xl) - var(--spacer-lg))
        30vw calc(35vw - var(--spacer-xl) - var(--spacer-lg));
      padding: var(--spacer-xl) var(--spacer-xl);
      align-items: center;
    }

    h1 {
      font-size: clamp(var(--font-xl), var(--font-3xl), var(--font-4xl));

      &:first-child {
        text-align: end;
      }
    }

    svg {
      width: auto;
      height: auto;
    }

    .headline-rotator h1 {
      text-align: left !important;
    }
  }
</style>
