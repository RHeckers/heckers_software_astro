    <use href="#hero-shell-path" class="draw draw-primary"></use>
    <use href="#hero-shell-path" class="draw draw-secondary"></use>
    <use href="#hero-shell-path" class="draw draw-tertiary"></use>
  </svg>
  <h1 class="headline headline-2" data-rotate="hero-headline-2">
    Built With Simplicity
  </h1>
</section>

<script>
  import { gsap } from "gsap";

  const HEADLINE_ROTATIONS: string[] = [
    "Architected For Scale",
    "Performance Driven",
    "Built With Simplicity",
  ];

  const HEADLINE_ROTATION_DELAY = 5;

  const shellAnimation = () => {
    // Automatically measure path length so CSS can animate 0% -> 100%
    const path = document.querySelector(
      "#hero-shell-path",
    ) as SVGGeometryElement | null;
    if (!path) return;

    const length = path.getTotalLength();

    // Set CSS variable used by stroke-dasharray/-offset on the root scope
    document.documentElement.style.setProperty("--pathLen", `${length}`);
  };

  const animateHeadlines = () => {
    const elements = document.querySelectorAll(".headline");

    elements.forEach((el) => animateHeadline(el as HTMLElement));
  };

  const animateHeadline = (el: HTMLElement, overrideText?: string) => {
    const text = overrideText ?? el?.textContent ?? "";
    el.textContent = "";

    const frag = document.createDocumentFragment();
    for (const ch of text) {
      const span = document.createElement("span");
      span.className = "char";
      span.textContent = ch === " " ? "\u00A0" : ch;
      frag.appendChild(span);
    }
    el.appendChild(frag);

    const chars = el.querySelectorAll(".char");

    gsap.set(chars, {
      opacity: 0,
      y: 10,
      filter: "blur(12px)",
    });

    gsap.to(chars, {
      opacity: 1,
      y: 0,
      filter: "blur(0px)",
      duration: 2,
      ease: "power3.out",
      stagger: { each: 0.05, from: "random" },
    });
  };

  const initRotatingHeadlines = () => {
    const elements = document.querySelectorAll("[data-rotate]");

    elements.forEach((el) => setupHeadlineRotation(el as HTMLElement));
  };

  const setupHeadlineRotation = (el: HTMLElement) => {
    const phrases = HEADLINE_ROTATIONS;

    if (!phrases || phrases.length < 2 || el.dataset.rotationInit === "true") {
      return;
    }

    el.dataset.rotationInit = "true";

    const initial = (el.textContent ?? "").trim();
    let index = phrases.indexOf(initial);
    index = index === -1 ? 0 : (index + 1) % phrases.length;

    const rotate = () => {
      animateHeadline(el, phrases[index]);
      index = (index + 1) % phrases.length;
      gsap.delayedCall(HEADLINE_ROTATION_DELAY, rotate);
    };

    gsap.delayedCall(HEADLINE_ROTATION_DELAY, rotate);
  };

  requestAnimationFrame(() => {
    shellAnimation();
    animateHeadlines();
    initRotatingHeadlines();
  });
</script>

<style>
  .hero {
    height: calc(100dvh + 80px);
    display: grid;
    margin-top: -80px;
    grid-template-columns:
      calc(35vw - var(--spacer-xl) - var(--spacer-lg))
      30vw calc(35vw - var(--spacer-xl) - var(--spacer-lg));
    align-items: center;
    justify-content: center;
    background-color: var(--color-dark);
    padding: var(--spacer-xl) var(--spacer-xl);
    gap: var(--spacer-xl);
    --stroke-primary: var(--color-ink-light);
    --stroke-secondary: var(--color-accent);
    --stroke-tertiary: var(--color-light);
    --draw-pass-gap: 5s;
    --draw-pass-duration: calc(var(--draw-pass-gap) * 3);
  }

  svg {
    z-index: 2;
  }

  h1 {
    color: var(--color-light-raised);
    font-size: clamp(var(--font-xl), var(--font-3xl), var(--font-4xl));
    font-weight: var(--font-weight-thin);

    &:first-child {
      text-align: end;
    }
  }

  .draw {
    fill: none;
    stroke-width: 1;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: var(--pathLen, 0);
    stroke-dashoffset: var(--pathLen, 0);
  }

  .draw-primary {
    stroke: var(--stroke-primary);
    animation:
      draw-initial 3s cubic-bezier(0.99, 0, 1, 1) forwards,
      draw-pass var(--draw-pass-duration) cubic-bezier(0.99, 0.01, 0.25, 1)
        infinite;
    animation-delay: var(--draw-pass-duration), 0s;
    animation-fill-mode: forwards, both;
  }

  .draw-secondary {
    stroke: var(--stroke-secondary);
    animation: draw-pass var(--draw-pass-duration)
      cubic-bezier(0.99, 0.01, 0.25, 1) infinite;
    animation-delay: var(--draw-pass-gap);
    animation-fill-mode: both;
  }

  .draw-tertiary {
    stroke: var(--stroke-tertiary);
    animation: draw-pass var(--draw-pass-duration)
      cubic-bezier(0.99, 0.01, 0.25, 1) infinite;
    animation-delay: calc(var(--draw-pass-gap) * 2);
    animation-fill-mode: both;
  }

  @keyframes draw-initial {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes draw-pass {
    0% {
      stroke-dashoffset: var(--pathLen, 0);
      opacity: 0;
    }
    5% {
      opacity: 1;
    }
    35% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    70% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    80% {
      opacity: 0;
    }
    100% {
      stroke-dashoffset: var(--pathLen, 0);
      opacity: 0;
    }
  }
</style>
