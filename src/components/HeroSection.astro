---
import LogoBanner from "./LogoBanner.astro";
---

<section class="hero bg-gradient">
  <canvas id="hero-canvas" aria-hidden="true"></canvas>

  <div class="hero-content">
    <h1>Complex Systems</h1>

    <div class="particle-text-spacer">
      <p class="sr-only">
        Built With Simplicity. Architected For Scale. Performance Driven.
      </p>
    </div>

    <p class="hero-description">
      We architect, build, and rescue large-scale Angular & Nx applications.
    </p>

    <div class="hero-actions">
      <a href="#contactForm" class="btn btn-primary">Book a Call</a>
    </div>
  </div>

  <div class="logo-banner-container">
    <LogoBanner />
  </div>
</section>

<script>
  function initHero() {
    const canvas = document.getElementById(
      "hero-canvas",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let controller: {
      destroy: () => void;
      pause: () => void;
      resume: () => void;
    } | null = null;

    let heroVisible = true;

    let disposed = false;

    // Load the scene off the critical path: after the page has loaded and
    // the main thread is idle, so it never competes with LCP or TTI.
    function loadScene() {
      if (disposed) return;
      import("../lib/hero-scene")
        .then(async ({ createHeroScene }) => {
          if (disposed) return;
          const scene = await createHeroScene({ canvas, reducedMotion });
          if (disposed) {
            scene.destroy();
            return;
          }
          controller = scene;
          // If hero scrolled away before scene loaded, pause immediately
          if (!heroVisible) controller.pause();
        })
        .catch(() => {
          canvas.style.display = "none";
        });
    }

    function scheduleLoad() {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(loadScene, { timeout: 1500 });
      } else {
        window.setTimeout(loadScene, 300);
      }
    }

    if (document.readyState === "complete") {
      scheduleLoad();
    } else {
      window.addEventListener("load", scheduleLoad, { once: true });
    }

    // Pause/resume based on whether the hero is on screen
    const heroSection = canvas.closest(".hero")!;
    const scrollObserver = new IntersectionObserver(
      ([entry]) => {
        heroVisible = entry.isIntersecting;
        if (!controller || document.hidden) return;
        if (entry.isIntersecting) {
          controller.resume();
        } else {
          controller.pause();
        }
      },
      { threshold: 0 },
    );
    scrollObserver.observe(heroSection);

    function onVisibility() {
      if (!controller) return;
      if (document.hidden) {
        controller.pause();
      } else if (heroVisible) {
        controller.resume();
      }
    }
    document.addEventListener("visibilitychange", onVisibility);

    function onSwap() {
      disposed = true;
      controller?.destroy();
      controller = null;
      scrollObserver.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
      document.removeEventListener("astro:before-swap", onSwap);
    }
    document.addEventListener("astro:before-swap", onSwap);
  }

  initHero();
  document.addEventListener("astro:after-swap", initHero);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 900px;
    padding: var(--spacer-xl) var(--spacer-lg);
  }

  h1 {
    color: var(--color-light-raised);
    font-size: clamp(var(--font-2xl), 10vw, var(--font-6xl));
    font-weight: var(--font-weight-light);
    line-height: 1.1;
    margin: 0 0 0.75rem;
    white-space: nowrap;
  }

  /* Spacer where the particle text appears through the canvas */
  .particle-text-spacer {
    height: clamp(3.5rem, 8vw, 5rem);
    margin-bottom: 1.75rem;
  }

  .hero-description {
    color: var(--color-ink-muted);
    font-size: clamp(var(--font-md), 1.8vw, var(--font-lg));
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: var(--spacer-md);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--spacer-xl);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.7em 1.8em;
    font-size: var(--font-base);
    font-weight: var(--font-weight-medium);
    border-radius: 100px;
    text-decoration: none;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
    cursor: pointer;
  }

  /* accent-strong keeps white text at >= 4.5:1 contrast */
  .btn-primary {
    background-color: var(--color-accent-strong);
    color: var(--color-light-raised);
    border: 1px solid var(--color-accent-strong);
  }
  .btn-primary:hover {
    background-color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .btn-outline {
    background: transparent;
    color: var(--color-ink-light);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }
  .btn-outline:hover {
    border-color: rgba(255, 255, 255, 0.45);
    color: var(--color-light-raised);
  }

  .logo-banner-container {
    position: absolute;
    bottom: -10px;
    width: 100%;
    z-index: 3;
  }

  /* Screen-reader only */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  @media (min-width: 650px) {
    .hero-content {
      padding: var(--spacer-3xl) var(--spacer-xl);
    }

    h1 {
      margin-bottom: 1rem;
    }

    .particle-text-spacer {
      margin-bottom: 2.25rem;
    }

    .hero-description {
      white-space: nowrap;
    }

    .hero-actions {
      margin-top: var(--spacer-2xl);
    }
  }
</style>
