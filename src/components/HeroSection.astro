---
import LogoBanner from "./LogoBanner.astro";
import PilotToProduction from "./art/PilotToProduction.astro";

/**
 * Hero: headline, lead and the two calls to action, with the one thing the
 * company does as a diagram next to them: a pilot taken through discovery,
 * build and integration into production (components/art/PilotToProduction).
 * No script, no canvas; the h1 is the LCP element.
 */
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <h1>Software and AI that reach production.</h1>
      <!-- Two versions of the lead; CSS shows one. The phone version says
           the same in half the words so the buttons stay in the first
           screenful. -->
      <p class="hero-lead">
        <span class="hero-lead__full">
          Most software and AI initiatives stall between a promising pilot and
          a product people use. Heckers Software comes into your company and
          closes that gap: we run the discovery, build the software, integrate
          the AI and ship it into production, at a fixed price per outcome.
          Hand us the backlog, or let us find the highest-impact work first.
        </span>
        <span class="hero-lead__short">
          Most software and AI initiatives stall between pilot and production.
          We come into your company and close that gap: discovery, build, AI
          integration and deployment, at a fixed price per outcome.
        </span>
      </p>
      <div class="hero-actions">
        <a href="#contactForm" class="btn btn-primary" data-subject="Development"
          >Book a discovery call</a
        >
        <a href="#testimonials" class="btn btn-ghost">See testimonials</a>
      </div>
    </div>

    <PilotToProduction class="hero-graph" />
  </div>

  <div class="logo-banner-container">
    <LogoBanner placement="hero" />
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* The logo reel's blend panels must composite against this opaque
       background, not against a transparent group (see LogoBanner). */
    isolation: isolate;
    /* On phones the reel starts 75px above the bottom edge. The gradient
       must be flat by then, so the stop is in pixels from the bottom
       rather than a percentage of the viewport-dependent hero height. */
    --hero-fade-end: 90px;
    background: linear-gradient(
      to bottom,
      var(--color-dark) 0%,
      var(--color-dark-alt) 55%,
      var(--color-light-alt) calc(100% - var(--hero-fade-end))
    );
  }

  .hero-inner {
    flex: 1;
    width: 100%;
    max-width: 1180px;
    margin: 0 auto;
    padding: 7rem 1.5rem 12rem;
    display: grid;
    gap: 3rem;
    align-content: center;
  }

  /* --- Copy --- */

  h1 {
    font-family: "chillax", sans-serif;
    font-weight: var(--font-weight-light);
    font-size: clamp(2.5rem, 5.6vw, 4.75rem);
    line-height: 1.04;
    letter-spacing: -0.015em;
    color: var(--color-light-raised);
    max-width: 13ch;
    margin: 0 0 1.25rem;
  }

  .hero-lead {
    font-family: "synonym", sans-serif;
    font-size: clamp(1.0625rem, 1.5vw, 1.25rem);
    line-height: 1.6;
    color: rgba(232, 237, 246, 0.74);
    max-width: 44ch;
    margin: 0 0 2rem;
  }

  .hero-lead__short {
    display: none;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8em 1.7em;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    border-radius: 100px;
    text-decoration: none;
    border: 1px solid transparent;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .btn:focus-visible {
    outline: 2px solid var(--color-light-raised);
    outline-offset: 3px;
  }

  /* accent-strong keeps white text at >= 4.5:1 contrast */
  .btn-primary {
    background-color: var(--color-accent-strong);
    border-color: var(--color-accent-strong);
    color: var(--color-light-raised);
  }

  .btn-primary:hover {
    background-color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .btn-ghost {
    color: var(--color-ink-light);
    border-color: rgba(232, 237, 246, 0.3);
  }

  .btn-ghost:hover {
    border-color: rgba(232, 237, 246, 0.7);
    color: var(--color-light-raised);
  }

  /* --- Diagram --- */

  .hero-graph {
    justify-self: center;
  }

  /* --- Logo banner --- */

  /* No z-index here: that would make this a stacking context, and the
     banner's mix-blend-mode panels would then blend against a transparent
     backdrop and leave a grey line along the top of the reel. */
  /* Phones only: the reel sits in the hero so the client logos are inside
     the first screenful. Wider screens get the titled band below instead
     (see LogoBanner). */
  .logo-banner-container {
    position: absolute;
    bottom: -10px;
    width: 100%;
  }

  @media (min-width: 769px) {
    .logo-banner-container {
      display: none;
    }
  }

  /* --- Layout breakpoints --- */

  /* On phones the diagram shrinks below legibility and lands on the light
     part of the gradient; the headline and buttons carry the hero there. */
  @media (max-width: 649px) {
    .hero-inner {
      padding-top: 6rem;
      padding-bottom: 10rem;
    }

    .hero-graph {
      display: none;
    }

    .hero-lead__full {
      display: none;
    }

    .hero-lead__short {
      display: inline;
    }

    .hero-lead {
      margin-bottom: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .hero-inner {
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
      align-items: center;
      gap: 4rem;
      padding-top: 8rem;
      padding-bottom: 14rem;
    }

    .hero-graph {
      justify-self: end;
    }
  }
</style>

