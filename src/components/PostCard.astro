---
import CategoryChips from "./CategoryChips.astro";
import { formatDate, postHref, type BlogPost } from "../lib/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, categories } = post.data;
const href = postHref(post);
---

<article class="post-card">
  <div class="post-card__body">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <CategoryChips categories={categories} />
  </div>
</article>

<style>
  .post-card {
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-light-raised);
    overflow: hidden;
    transition:
      box-shadow 200ms ease,
      border-color 200ms ease;
  }

  .post-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  /* A soft shadow is invisible on a dark page; lift the border instead. */
  :global(:root[data-theme="dark"]) .post-card:hover {
    border-color: var(--color-stroke-strong);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.45);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    font-family: "synonym", sans-serif;
  }

  time {
    color: var(--color-ink-muted);
    font-size: var(--font-sm);
  }

  h2 {
    font-family: "chillax", sans-serif;
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.2;
    margin: 0;
  }

  h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h2 a:hover,
  h2 a:focus-visible {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  p {
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 769px) {
    .post-card__body {
      padding: 2rem;
    }
  }
</style>
