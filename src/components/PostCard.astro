---
import { Image } from "astro:assets";
import CategoryChips from "./CategoryChips.astro";
import { formatDate, postHref, type BlogPost } from "../lib/blog";

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { title, description, pubDate, heroImage, categories } = post.data;
const href = postHref(post);
---

<article class="post-card">
  {
    heroImage && (
      <a class="post-card__media" href={href} tabindex="-1">
        <Image
          src={heroImage}
          alt={title}
          width={720}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="post-card__body">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
    <h2><a href={href}>{title}</a></h2>
    <p>{description}</p>
    <CategoryChips categories={categories} />
  </div>
</article>

<style>
  .post-card {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-light-raised);
    overflow: hidden;
    transition: box-shadow 200ms ease;
  }

  .post-card:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .post-card__media {
    display: block;
  }

  .post-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left center;
    display: block;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    font-family: "synonym", sans-serif;
  }

  time {
    color: var(--color-ink-muted);
    font-size: var(--font-sm);
  }

  h2 {
    font-family: "chillax", sans-serif;
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.3;
    margin: 0;
  }

  h2 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h2 a:hover,
  h2 a:focus-visible {
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  p {
    color: var(--color-ink-muted);
    line-height: 1.6;
    margin: 0;
  }

  @media (min-width: 769px) {
    .post-card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }

    .post-card__body {
      padding: 2rem;
    }
  }
</style>
