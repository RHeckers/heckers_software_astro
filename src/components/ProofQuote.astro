---
/**
 * One short client quote placed next to a claim, with the name, position
 * and, where we have it, the company logo. Works on light and dark grounds;
 * on dark the logo is rendered as a white silhouette so brand colours never
 * fight the panel.
 */
import { Image } from "astro:assets";
import { getSnippet, type SnippetKey } from "../lib/testimonials";

interface Props {
  snippet: SnippetKey;
  tone?: "light" | "dark";
  class?: string;
}

const { snippet, tone = "light", class: className } = Astro.props;
const proof = getSnippet(snippet);
const position = proof.company
  ? `${proof.title}, ${proof.company}`
  : proof.title;
---

<figure class:list={["proof", `proof--${tone}`, className]}>
  <blockquote class="proof__quote">
    <p>{proof.quote}</p>
  </blockquote>
  <figcaption class="proof__by">
    <Image
      class="proof__photo"
      src={proof.image}
      alt=""
      width={44}
      height={44}
      fit="cover"
      loading="lazy"
    />
    <span class="proof__who">
      <span class="proof__name">{proof.name}</span>
      <span class="proof__position">{position}</span>
    </span>
    {
      proof.logo && (
        <Image
          class="proof__logo"
          src={proof.logo}
          alt={`${proof.company} logo`}
          height={22}
          loading="lazy"
        />
      )
    }
  </figcaption>
</figure>

<style>
  .proof {
    --ink: var(--color-ink);
    --muted: var(--color-ink-muted);
    --rule: var(--color-stroke);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem 1.35rem 1.25rem 1.5rem;
    border-radius: 15px;
    border: 1px solid var(--rule);
    background: var(--color-light-raised);
    color: var(--ink);
    position: relative;
  }

  /* An opening quote mark as the only ornament. */
  .proof::before {
    content: "\201C";
    position: absolute;
    left: 0.9rem;
    top: 0.35rem;
    font-size: 2.5rem;
    line-height: 1;
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    opacity: 0.6;
  }

  /* On dark grounds the card itself stays pale, like the workshop cards on
     the home page, so client logos keep their brand colours and contrast. */
  .proof--dark {
    --ink: var(--color-ink);
    --muted: var(--color-ink-muted);
    --rule: var(--color-stroke);
    background: var(--color-light-alt);
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 20px 40px rgba(5, 10, 20, 0.35);
  }

  .proof__quote {
    padding-left: 0.9rem;
  }

  .proof__quote p {
    font-family: synonym, sans-serif;
    font-size: 1.05rem;
    line-height: 1.55;
    color: var(--ink);
  }

  /* Pinned to the bottom so that, when cards in a row are stretched to the
     same height, every attribution sits on the same line regardless of how
     long the quote above it is. */
  .proof__by {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
  }

  .proof__photo {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    flex-shrink: 0;
  }

  .proof__who {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    flex: 1;
  }

  .proof__name {
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.2;
    color: var(--ink);
  }

  .proof__position {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    line-height: 1.3;
    color: var(--muted);
  }

  .proof__logo {
    height: 22px;
    width: auto;
    max-width: 120px;
    object-fit: contain;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .proof--dark .proof__logo {
    opacity: 1;
  }
</style>
