---
interface Props {
  word: string;
  callToAction?: string;
  size?: "small" | "medium" | "large";
  reversedAnimation?: boolean;
}

const {
  word,
  callToAction,
  size = "medium",
  reversedAnimation = false,
} = Astro.props as Props;
---

<div
  class={"expanding-word-outer size-" +
    size +
    (reversedAnimation ? " reversed" : "")}
>
  <div class="expanding-word-wrapper">
    <p class="expanding-word expanding-up-1">{word}</p>
    <p class="expanding-word expanding-up-2">{word}</p>
    <p class="expanding-word expanding-up-3">{word}</p>
    <p class="expanding-word center-word">
      {word}
      {
        callToAction && (
          <a href="#contact-target" class="call-to-action">
            {callToAction}
          </a>
        )
      }
    </p>
    <p class="expanding-word expanding-down-1">{word}</p>
    <p class="expanding-word expanding-down-2">{word}</p>
    <p class="expanding-word expanding-down-3">{word}</p>
  </div>
</div>

<style>
  .size-small {
    --font-size: 8rem;
    --step-size: 2rem;
  }

  .size-medium {
    --font-size: 10rem;
    --step-size: 3rem;
  }

  .size-large {
    --font-size: 13rem;
    --step-size: 5.5rem;
  }

  @media (max-width: 640px) {
    .size-small {
      --font-size: 4.5rem;
      --step-size: 1.25rem;
    }

    .size-medium {
      --font-size: 6rem;
      --step-size: 1.75rem;
    }

    .size-large {
      --font-size: 7.5rem;
      --step-size: 2.5rem;
    }

    .expanding-word {
      margin-top: -10svh;
    }
  }

  .expanding-word-outer {
    height: 200svh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    text-transform: uppercase;
    background-color: inherit;
    position: relative;
    z-index: 3;
  }

  .expanding-word-wrapper {
    position: sticky;
    width: 100%;
    text-align: center;
    top: 0;
    left: 0;
    height: calc(50%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: inherit;
  }

  .center-word {
    z-index: 4;
    position: relative;
    display: inline-block;
  }

  .call-to-action {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
    font-size: 0.2em;
    color: var(--color-accent);
    font-weight: var(--font-weight-fat);
    padding: 0.25em;
    border-radius: 1em;
    pointer-events: auto;
    white-space: nowrap;
    cursor: pointer;
    text-decoration: none;
    font-family: synonym;
    backdrop-filter: blur(4px);
    border: 2px solid var(--color-accent);

    &:hover {
      color: var(--color-accent-strong);
      border-color: var(--color-accent-strong);
    }
  }

  .expanding-word {
    position: absolute;
    top: 40%;
    font-size: var(--font-size);
    font-weight: var(--font-weight-medium);
    padding: 0.5rem 0;
    line-height: 0.8;
    color: var(--color-ink-light);
    background-color: inherit;
    animation-timeline: view();
    animation-fill-mode: both;
    animation-range: entry 10% cover 80%;
    cursor: default;
    width: 100%;
  }

  .reversed .expanding-word {
    animation-direction: reverse;
  }

  .expanding-up-1 {
    animation-name: move-up-1;
    z-index: 3;
  }
  .expanding-up-2 {
    animation-name: move-up-2;
    z-index: 2;
  }
  .expanding-up-3 {
    animation-name: move-up-3;
  }

  .expanding-down-1 {
    animation-name: move-down-1;
    z-index: 3;
  }
  .expanding-down-2 {
    animation-name: move-down-2;
    z-index: 2;
  }
  .expanding-down-3 {
    animation-name: move-down-3;
  }

  @keyframes move-up-1 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * -1));
    }
  }

  @keyframes move-up-2 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * -2));
    }
  }

  @keyframes move-up-3 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * -3));
    }
  }

  @keyframes move-down-1 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * 1));
    }
  }

  @keyframes move-down-2 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * 2));
    }
  }

  @keyframes move-down-3 {
    from {
      transform: translateY(0px);
    }
    to {
      transform: translateY(calc(var(--step-size) * 3));
    }
  }
</style>
