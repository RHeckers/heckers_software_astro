---
import BlogFilterBar from "./BlogFilterBar.astro";
import NewsletterForm from "./NewsletterForm.astro";
import PostCard from "./PostCard.astro";
import type { BlogPost } from "../lib/blog";
import type { BlogCategory } from "../lib/categories";

interface Props {
  heading: string;
  intro?: string;
  posts: BlogPost[];
  /** Categories shown in the filter bar (those with at least one post). */
  categories: readonly BlogCategory[];
  /** Active filter; undefined on the main /blog index. */
  active?: BlogCategory;
}

const { heading, intro, posts, categories, active } = Astro.props;

// The signup block sits after the second post: far enough in that the reader
// has shown interest, early enough that most visitors still see it. With one
// post it simply follows that post.
const signupAfter = Math.min(1, posts.length - 1);
---

<section class="blog-listing">
  <header>
    <h1>{heading}</h1>
    {intro && <p class="intro">{intro}</p>}
    <BlogFilterBar categories={categories} active={active} />
  </header>

  <ul>
    {
      posts.map((post, index) => (
        <>
          <li>
            <PostCard post={post} />
          </li>
          {index === signupAfter && (
            <li class="blog-listing__signup">
              <NewsletterForm
                id="newsletter"
                variant="inline"
                heading="New posts, straight to your inbox"
                text="One practical article on Angular, Nx or .NET at a time, sent the day it goes out. Nothing else."
              />
            </li>
          )}
        </>
      ))
    }
  </ul>
</section>

<style>
  .blog-listing {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(6rem, 10vw, 8rem) 1.5rem 4rem;
    color: var(--color-ink);
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: var(--font-3xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }

  .intro {
    max-width: 640px;
    margin: 0 0 1.5rem;
    color: var(--color-ink-muted);
    font-family: "synonym", sans-serif;
    font-size: var(--font-md);
    line-height: 1.6;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  @media (max-width: 769px) {
    h1 {
      font-size: var(--font-2xl);
    }
  }
</style>
