---
import { Image } from "astro:assets";
import desktop from "../assets/desktop_lookup.svg";
import cicd from "../assets/ci_cd.svg";
import { TESTIMONIALS } from "../lib/testimonials";

// Full recommendations; the short quotes elsewhere on the site are cut
// from these same texts (see lib/testimonials.ts).
const reviews = TESTIMONIALS.map((item) => ({
  ...item,
  title: item.company ? `${item.title}, ${item.company}` : item.title,
}));
---

<section class="reviews-section" id="testimonials">
  <div class="parallax-bg-reviews">
    <Image
      src={desktop}
      alt="Desktop Lookup"
      class="parallax-img-reviews parallax-desktop-lookup"
      loading="lazy"
      width={200}
      height={150}
    />
    <Image
      src={cicd}
      alt="CI/CD"
      class="parallax-img-reviews parallax-cicd"
      loading="lazy"
      width={200}
      height={150}
    />
  </div>
  <div class="reviews-container">
    <div class="reviews-header">
      <h2 class="reviews-title">Testimonials</h2>
    </div>
    <div class="reviews-card-shell">
      <div class="reviews-card-scroll">
        <ul class="reviews-list">
          {
            reviews.map((review) => (
              <li class="review-card">
                <Image
                  src={review.image}
                  alt={review.name}
                  class="review-img"
                  width={56}
                  height={56}
                  fit="cover"
                />
                <div class="review-info">
                  <div class="review-name">{review.name}</div>
                  <div class="review-title">{review.title}</div>
                  <p class="review-content">{review.content}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="reviews-card-nav" role="group" aria-label="Scroll reviews">
        <button
          class="reviews-card-button"
          data-direction="prev"
          aria-label="Previous review">&lt;</button
        >
        <button
          class="reviews-card-button"
          data-direction="next"
          aria-label="Next review">&gt;</button
        >
      </div>
    </div>
  </div>
</section>

<style>
  .parallax-bg-reviews {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100svh;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }
  .parallax-img-reviews {
    position: absolute;
    will-change: transform;
    opacity: 0.7;
    transition: transform 0.2s linear;
    max-width: 30vw;
    min-width: 120px;
    height: auto;
  }
  .parallax-desktop-lookup {
    left: 2vw;
    top: 2svh;
    width: 16vw;
    max-width: 200px;
    z-index: 1;
  }

  .parallax-cicd {
    right: 2vw;
    bottom: 10vh;
    width: 16vw;
    max-width: 200px;
    z-index: 1;
  }
  @media (max-width: 640px) {
    .parallax-bg-reviews {
      display: none;
    }
    .parallax-img-reviews {
      max-width: 60vw;
      min-width: 80px;
    }
    .parallax-desktop-lookup {
      left: 0vw;
      top: 0svh;
      width: 35vw;
    }
  }
  .reviews-section {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    background: var(--background-gradient-primary);
  }

  .reviews-container {
    position: relative;
    z-index: 1;
    padding: clamp(3.5rem, 8vw, 6rem) 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    margin: 0 auto;
    max-width: 1200px;
    gap: var(--spacer-xl);
  }

  .reviews-title {
    font-size: 2.5rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    width: 100%;
    text-align: center;
  }

  .reviews-card-shell {
    width: 100%;
  }
  .reviews-card-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1rem;
  }
  .reviews-card-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
  }
  .reviews-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--spacer-md);
    padding: 0 1rem var(--spacer-md);
    font-size: 1.2rem;
    width: 100%;
    text-align: left;
  }
  .reviews-list::after {
    content: "";
    flex: 0 0 1px;
  }
  .reviews-list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }
  .review-card {
    flex: 0 0 82vw;
    max-width: 82vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    background: var(--background-gradient-transparent);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    padding: var(--spacer-xl);
    text-align: left;
    isolation: isolate;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
    gap: var(--spacer-md);
  }
  .review-img {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    object-fit: cover;
    border: 2px solid var(--color-accent);
    flex-shrink: 0;
  }
  .review-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .review-name {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semibold);
    margin: 0;
    color: var(--color-ink-light);
  }
  .review-title {
    font-size: var(--font-md);
    color: var(--color-accent);
  }
  .review-content {
    margin: 0;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.85);
    padding: 0 var(--spacer-sm);
    font-size: var(--font-md);
  }
  .reviews-card-nav {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--spacer-sm);
    gap: var(--spacer-sm);
    margin-right: var(--spacer-md);
  }
  .reviews-card-button {
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(15, 26, 43, 0.7);
    color: var(--color-ink-light);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-md);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }
  @media (min-width: 650px) {
    .reviews-container {
      padding: var(--spacer-3xl) var(--spacer-2xl);
    }

    .reviews-list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--spacer-lg);
      padding: 0;
    }
    .reviews-card-scroll {
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding: 0;
    }
    .reviews-card-nav {
      display: none;
      margin-right: 0;
    }
    .review-card {
      flex: initial;
      max-width: none;
      flex-direction: row;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }
    .review-img {
      width: 58px;
      height: 58px;
    }
    .review-name {
      font-size: var(--font-xl);
    }
    .review-title {
      font-size: var(--font-md);
    }
    .reviews-title {
      font-size: 5rem;
    }
    .review-content {
      font-size: var(--font-md);
      font-family: synonym;
    }
  }
</style>
<script is:inline>
  // Parallax for the two sketches. Driven by the section's own position in
  // the viewport rather than absolute scrollY, so it keeps working when the
  // sections above change height.
  (() => {
    const section = document.querySelector(".reviews-section");
    const desktopLookup = document.querySelector(".parallax-desktop-lookup");
    const cicdImage = document.querySelector(".parallax-cicd");
    if (!section || (!desktopLookup && !cicdImage)) return;
    let ticking = false;
    const update = () => {
      ticking = false;
      // 0 when the section top reaches the viewport bottom, growing as it
      // scrolls up; stays small so the drift is subtle.
      const offset = window.innerHeight - section.getBoundingClientRect().top;
      if (desktopLookup) {
        desktopLookup.style.transform = `translateY(${offset * 0.08}px)`;
      }
      if (cicdImage) {
        cicdImage.style.transform = `translateY(${-offset * 0.09}px)`;
      }
    };
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  })();
  // Card scroll logic for reviews
  const reviewShells = document.querySelectorAll(".reviews-card-shell");
  reviewShells.forEach((shell) => {
    const container = shell.querySelector(".reviews-card-scroll");
    const list = shell.querySelector(".reviews-list");
    const buttons = shell.querySelectorAll(".reviews-card-button");
    if (!container || !list || buttons.length === 0) return;
    const getStep = () => {
      const firstCard = list.querySelector(".review-card");
      const styles = window.getComputedStyle(list);
      const gap = parseFloat(styles.columnGap || styles.gap || "0");
      return (firstCard?.clientWidth || 0) + gap;
    };
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = button.getAttribute("data-direction");
        const step = getStep() || container.clientWidth;
        const delta = direction === "next" ? step : -step;
        container.scrollBy({ left: delta, behavior: "smooth" });
      });
    });
  });
</script>
