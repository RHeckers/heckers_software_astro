---
import ExpandingWord from "./ExpandingWord.astro";
import WorkshopSectionDesktop from "./WorkshopSectionDesktop.astro";
import WorkshopSectionMobile from "./WorkshopSectionMobile.astro";
---

<section>
  <div class="workshop-section-desktop">
    <ExpandingWord word="Workshops" callToAction="BOOK NOW" size="large" />
    <WorkshopSectionDesktop client:visible={{ rootMargin: "500px" }} />
  </div>
  <div class="workshop-section-mobile">
    <WorkshopSectionMobile client:visible={{ rootMargin: "500px" }} />
  </div>
</section>

<style>
  section,
  .workshop-section-desktop {
    background: var(--color-nude);
  }
  .workshop-section-desktop {
    display: none;
  }
  .workshop-section-mobile {
    display: block;
  }
  @media (min-width: 1425px) {
    .workshop-section-desktop {
      display: block;
    }
    .workshop-section-mobile {
      display: none;
    }
  }
</style>
