---
import WorkshopSectionDesktop from "./WorkshopSectionDesktop.astro";
import WorkshopSectionMobile from "./WorkshopSectionMobile.astro";
---

<section id="workshops">
  <div class="workshop-section-desktop">
    <WorkshopSectionDesktop />
  </div>
  <div class="workshop-section-mobile">
    <WorkshopSectionMobile />
  </div>
</section>

<style>
  /* Flat here; the gradient goes on the boxes that are actually a
     viewport tall (see both child components). This section is ~2,400px
     high, so a gradient stretched over it would only ever show a flat
     slice on screen. The colour is the gradient's end, so the two meet
     without a seam. */
  section {
    background: var(--color-dark);
  }
  .workshop-section-desktop {
    display: none;
  }
  .workshop-section-mobile {
    display: block;
  }
  @media (min-width: 1425px) {
    .workshop-section-desktop {
      display: block;
    }
    .workshop-section-mobile {
      display: none;
    }
  }
</style>
