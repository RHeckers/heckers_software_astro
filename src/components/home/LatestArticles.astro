---
/**
 * The three newest blog posts, below the contact form: nothing stands
 * between a ready visitor and the form, and a visitor who is not ready to
 * talk yet still has somewhere to go that shows the work.
 *
 * A light band after the dark contact section, with the same rows as
 * "The work behind it" on the service pages: a small label above, then
 * one hairline row per post with the date, the title and an arrow.
 */
import { formatDate, getSortedPosts, postHref } from "../../lib/blog";

const posts = (await getSortedPosts()).slice(0, 3);
---

{
  posts.length > 0 && (
    <section class="articles" aria-labelledby="articles-heading">
      <div class="articles__inner">
        <h2 class="articles__title" id="articles-heading">
          Latest articles
        </h2>

        <ul class="articles__list">
          {posts.map((post) => (
            <li>
              <a href={postHref(post)}>
                <time
                  class="article__date"
                  datetime={post.data.pubDate.toISOString()}
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <span class="article__title">{post.data.title}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>

        <a class="articles__all" href="/blog/">
          All articles <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </section>
  )
}

<style>
  .articles {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(3.5rem, 8vw, 6rem) clamp(1.25rem, 6vw, 5rem);
  }

  .articles__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  .articles__title {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-bottom: 0.75rem;
  }

  .articles__list {
    list-style: none;
    border-top: 1px solid color-mix(in srgb, currentColor 22%, transparent);
  }

  .articles__list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 1.1rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 14%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .article__date {
    grid-column: 1 / -1;
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  .article__title {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-medium);
    line-height: 1.25;
  }

  .articles__list a:hover .article__title,
  .articles__list a:focus-visible .article__title,
  .articles__all {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .articles__all {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: synonym, sans-serif;
    color: inherit;
  }

  @media (min-width: 760px) {
    .articles__list a {
      grid-template-columns: 14rem 1fr auto;
    }

    .article__date {
      grid-column: auto;
    }
  }
</style>
