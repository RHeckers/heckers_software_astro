---
/**
 * Results at clients: the proof at the foot of the dark "I come in and
 * deliver" band, as one block. Four clients, each with its logo, the
 * result, what it measures and a link to the case study behind it. The
 * other clients follow in one quiet line of logos underneath. One row of
 * four from 900px up, two by two below that.
 *
 * As the block scrolls in, the results arrive one after the other: the
 * accent rule draws down, the logo and the figure rise into place, the
 * figure counts up, and the label and the link follow. Scroll-driven CSS,
 * simply shown where that is unsupported or when motion is reduced.
 *
 * The logos are the on-dark versions in assets/logos/on-dark: each one a
 * single light shape, so seven brands in seven colours do not fight the
 * dark blue. Those files are generated; see scripts/make-on-dark-logos.mjs.
 *
 * The results come from lib/results.ts and nowhere else. A result links to
 * its case study as soon as that case study is published.
 */
import { Image } from "astro:assets";
import CountUp from "../CountUp.astro";
import { RESULTS, type Result } from "../../lib/results";
import { getCaseStudies } from "../../lib/case-studies";
import vattenfall from "../../assets/logos/on-dark/vattenfall_logo.png";
import marel from "../../assets/logos/on-dark/marel_logo.png";
import wgk from "../../assets/logos/on-dark/wgk-antwerpen.png";
import dhAutomation from "../../assets/logos/on-dark/dh_automation_logo.png";
import spacewell from "../../assets/logos/on-dark/spacewell_logo.png";
import phitaal from "../../assets/logos/on-dark/phitaal_logo.png";
import defensie from "../../assets/logos/on-dark/ministerie_van_defensie_logo.png";

/* Only case studies a visitor may see are linked: none while they are
   all drafts in a production build. */
const published = new Set((await getCaseStudies()).map((study) => study.id));

/* The logo of each client with a result. `scale` enlarges a logo whose
   type is too small to read at the shared height. */
const LOGOS: Record<Result["id"], { src: ImageMetadata; scale?: number }> = {
  vattenfall: { src: vattenfall },
  "wit-gele-kruis": { src: wgk, scale: 1.25 },
  marel: { src: marel },
  "dh-automation": { src: dhAutomation, scale: 1.5 },
};

/* Clients without a result on the page yet. */
const others = [
  { src: spacewell, name: "Spacewell" },
  { src: defensie, name: "Ministerie van Defensie" },
  { src: phitaal, name: "Phitaal" },
];
---

<div class="results">
  <header class="results__head">
    <h3 class="results__title" id="results-heading">Results at clients</h3>
    {
      published.size > 0 && (
        <a class="results__all" href="/case-studies/" target="_blank" rel="noopener">
          All case studies <span aria-hidden="true">&rarr;</span>
        </a>
      )
    }
  </header>

  <ul class="results__list" aria-labelledby="results-heading">
    {
      RESULTS.map((result, index) => (
        <li class="result" style={`--i: ${index}; --scale: ${LOGOS[result.id].scale ?? 1}`}>
          <p class="result__logo">
            <Image
              src={LOGOS[result.id].src}
              alt={result.client}
              width={170}
              densities={[1, 2]}
              loading="lazy"
            />
          </p>
          <p class="result__value">
            <CountUp value={result.value} />
          </p>
          <p class="result__label">{result.label}</p>
          {published.has(result.caseStudy) ? (
            <p class="result__more">
              <a href={`/case-studies/${result.caseStudy}/`} target="_blank" rel="noopener">
                Read the case study <span aria-hidden="true">&rarr;</span>
              </a>
            </p>
          ) : (
            <p class="result__more" />
          )}
        </li>
      ))
    }
  </ul>

  <div class="results__others">
    <p class="results__others-title" id="others-title">Also delivered for</p>
    <ul aria-labelledby="others-title">
      {
        others.map((client) => (
          <li>
            <Image
              src={client.src}
              alt={client.name}
              width={170}
              densities={[1, 2]}
              loading="lazy"
            />
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* Stands on the dark band it is placed in: its colours are the band's
     light colour and tints of it, and the one accent. */
  .results {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .results__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .results__title {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: var(--font-weight-light);
    line-height: 1.15;
    color: var(--color-light-raised);
  }

  .results__all,
  .results__others-title {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    color: color-mix(in srgb, var(--c-light) 72%, transparent);
  }

  .results__all,
  .result__more a {
    text-decoration: underline;
    text-decoration-color: var(--c-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .result__more a {
    color: inherit;
  }

  .results__all:hover,
  .results__all:focus-visible,
  .result__more a:hover,
  .result__more a:focus-visible {
    color: var(--c-light);
  }

  .results__list {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.25rem, 5vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem);
    view-timeline-name: --results;
  }

  /* Every block is four rows (logo, result, what it measures, link) laid
     on the rows of the list itself, so across one line of blocks each of
     them starts at the same height and the accent rules are equally tall,
     however the text wraps. */
  .result {
    position: relative;
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.75rem;
    align-content: start;
    padding-left: clamp(1rem, 2vw, 1.5rem);
  }

  /* Without subgrid: a column with the link on the bottom line. */
  @supports not (grid-template-rows: subgrid) {
    .result {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .result__more {
      margin-top: auto;
    }
  }

  /* The accent line: the same colour and the same two pixels as the
     underlines of the links in this block, so the yellow reads the same
     everywhere in it. */
  .result::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--c-accent);
    transform-origin: top;
  }

  /* Each logo keeps its own proportions inside the same box, left
     aligned, and the box has one height so the results below line up. */
  /* Each logo keeps its own proportions inside the same box, left
     aligned, and the box has one height so the results below line up. */
  .result__logo {
    display: flex;
    align-items: center;
    height: calc(clamp(2rem, 3vw, 2.6rem) * 1.5);
  }

  .result__logo :global(img),
  .results__others :global(img) {
    display: block;
    width: auto;
    height: auto;
    opacity: 0.92;
    max-height: calc(clamp(1.9rem, 2.8vw, 2.4rem) * var(--scale, 1));
    max-width: min(100%, calc(clamp(6rem, 10vw, 9rem) * var(--scale, 1)));
  }

  .result__value {
    font-size: clamp(1.6rem, 2.9vw, 2.5rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-light-raised);
    /* A result in words may take two lines; the rows of the list keep
       the labels under it level across the blocks. */
    text-wrap: balance;
  }

  .result__label {
    font-family: synonym, sans-serif;
    font-size: var(--font-lg);
    line-height: 1.35;
    max-width: 22ch;
    color: color-mix(in srgb, var(--c-light) 88%, transparent);
  }

  .result__more {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    color: color-mix(in srgb, var(--c-light) 72%, transparent);
    padding-top: 0.25rem;
  }

  /* The clients without a result here: one quiet line of logos. */
  .results__others {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid color-mix(in srgb, var(--c-light) 16%, transparent);
  }

  .results__others ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem clamp(1.5rem, 4vw, 3rem);
  }

  .results__others :global(img) {
    opacity: 0.75;
    max-height: clamp(1.8rem, 2.6vw, 2.3rem);
    max-width: clamp(6rem, 10vw, 9rem);
  }

  /* One block after the other, left to right: the rule draws down, then
     the logo and the figure rise and the two lines under them follow.
     Unhurried: the first block starts as the row comes onto the screen
     and the last one settles when the row is around the middle of it. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .result::before {
        animation: result-rule cubic-bezier(0.22, 0.61, 0.36, 1) both;
        animation-timeline: --results;
        animation-range: cover calc(4% + var(--i) * 7%) cover calc(24% + var(--i) * 7%);
      }

      .result__logo,
      .result__value {
        animation: result-rise cubic-bezier(0.22, 0.61, 0.36, 1) both;
        animation-timeline: --results;
        animation-range: cover calc(9% + var(--i) * 7%) cover calc(31% + var(--i) * 7%);
      }

      .result__label,
      .result__more {
        animation: result-fade linear both;
        animation-timeline: --results;
        animation-range: cover calc(16% + var(--i) * 7%) cover calc(38% + var(--i) * 7%);
      }
    }
  }

  @keyframes result-rule {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes result-rise {
    from {
      opacity: 0;
      translate: 0 1.5rem;
    }
  }

  @keyframes result-fade {
    from {
      opacity: 0;
      translate: 0 0.75rem;
    }
  }

  @media (max-width: 420px) {
    .result__value {
      font-size: 1.4rem;
    }

    .result__label {
      font-size: var(--font-md);
    }
  }

  @media (min-width: 900px) {
    .results__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
