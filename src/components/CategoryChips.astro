---
import {
  categoryHref,
  categoryToSlug,
  type BlogCategory,
} from "../lib/categories";

interface Props {
  categories: readonly BlogCategory[];
  label?: string;
}

const { categories, label = "Categories" } = Astro.props;

// One chip per category page: frontmatter that says both "Nx" and "nx"
// points at a single route, so it should not render the chip twice.
const seen = new Set<string>();
const unique = categories.filter((category) => {
  const slug = categoryToSlug(category);
  if (seen.has(slug)) return false;
  seen.add(slug);
  return true;
});
---

{
  unique.length > 0 && (
    <ul class="chips" aria-label={label}>
      {unique.map((category) => (
        <li>
          <a class="chip" href={categoryHref(category)}>
            {category}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .chips {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
  }

  .chip {
    display: inline-block;
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 999px;
    background: var(--color-light-alt);
    color: var(--color-link);
    font-family: "synonym", sans-serif;
    font-size: var(--font-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .chip:hover,
  .chip:focus-visible {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
</style>
