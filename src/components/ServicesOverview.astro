---
/**
 * Step 3 of the home page, "How can you help me?", right after the band
 * that says it in three verbs. Not a list of services: a question, and
 * three answers side by side. Each column is a sentence a visitor might
 * say about their own company, drawn as a diagram, with the service that
 * answers it and its price underneath. The column is one link.
 *
 * No cards and no rows: three open columns on the page's own ground,
 * divided by hairlines, so the section looks nothing like the row lists
 * in the dark bands above and below it. The life is in the diagrams, as
 * in the insight sections on the service pages: each one plays a slow
 * loop of the one thing it is about (stages lighting up in order, a
 * circular dependency being flagged, code typed on a screen until someone
 * gets it), and the columns rise into place one after the other as the
 * section scrolls in.
 *
 * The diagrams are inline SVG in the same idiom as the hero's project graph
 * (rounded nodes, thin edges, one accent), here in the dark-on-light
 * colours. Their colours are presentation attributes on the markup rather
 * than stylesheet rules, so they render the same everywhere.
 */
import { PRICING, VAT_NOTE, euro } from "../lib/pricing";

const ACCENT = "#2f7dd1";
const DANGER = "#c2413b";
const EDGES =
  'fill="none" stroke="rgba(54, 61, 75, 0.4)" stroke-width="1.5" stroke-linecap="round"';
const NODES =
  'fill="rgba(54, 61, 75, 0.04)" stroke="rgba(54, 61, 75, 0.55)" stroke-width="1.5"';
const ACCENT_NODE = `fill="rgba(47, 125, 209, 0.14)" stroke="${ACCENT}"`;
const FONT = 'font-family="chillax, sans-serif" text-anchor="middle"';

const services = [
  {
    title: "End to end engineering",
    copy: "An industry expert inside your company who delivers outcomes end to end: discovery, development, AI integration and deployment. With AI, one senior engineer ships what a team did before.",
    href: "/services/forward-deployed-engineering",
    label: "How an engagement runs",
    /* Three connected stages: discover, build, ship. */
    art: `
      <g ${EDGES}>
        <path class="art-flow" d="M 110 48 L 110 62" />
        <path class="art-flow" d="M 110 92 L 110 106" />
      </g>
      <g ${NODES}>
        <rect x="40" y="16" width="140" height="32" rx="8" ${ACCENT_NODE} />
        <rect class="art-layer" x="40" y="62" width="140" height="30" rx="8" />
        <rect class="art-layer" x="40" y="106" width="140" height="30" rx="8" />
      </g>
      <g ${FONT} font-size="12.5" font-weight="500" fill="#363d4b">
        <text x="110" y="36.5" fill="#1f4f87">Discover</text>
        <text class="art-label" x="110" y="81.5">Build and integrate AI</text>
        <text class="art-label" x="110" y="125.5">Ship to production</text>
      </g>
    `,
  },
  {
    title: "Architecture assessment",
    copy: "Senior engineers read your Angular or Nx codebase from the outside and hand you a ranked report and a roadmap. Fixed scope, two to three weeks. The diagnosis before anyone builds.",
    href: "/services/architecture-assessment",
    label: "Everything about the assessment",
    /* A dependency graph with one circular dependency flagged. */
    art: `
      <g ${EDGES}>
        <path d="M 90 40 C 90 52, 60 52, 60 64" />
        <path d="M 90 40 C 90 52, 118 52, 118 64" />
        <path d="M 160 40 C 160 52, 132 52, 132 64" />
        <path d="M 160 40 C 160 52, 190 52, 190 64" />
        <path d="M 60 86 C 60 98, 88 98, 88 110" />
        <path d="M 118 86 C 118 98, 100 98, 100 110" />
        <path d="M 125 86 C 125 98, 152 98, 152 110" />
        <path d="M 190 86 C 190 98, 166 98, 166 110" />
      </g>
      <path class="art-loop" d="M 172 110 C 210 96, 212 46, 186 30" fill="none" stroke="${DANGER}" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="5 4" />
      <g ${NODES}>
        <rect x="62" y="18" width="56" height="22" rx="6" />
        <rect x="132" y="18" width="56" height="22" rx="6" />
        <rect x="32" y="64" width="56" height="22" rx="6" />
        <rect x="97" y="64" width="56" height="22" rx="6" />
        <rect x="162" y="64" width="56" height="22" rx="6" />
        <rect x="66" y="110" width="56" height="22" rx="6" />
        <rect x="131" y="110" width="56" height="22" rx="6" />
      </g>
      <g class="art-flag">
        <circle cx="206" cy="46" r="11" fill="${DANGER}" />
        <text x="206" y="50.5" fill="#ffffff" ${FONT} font-size="15" font-weight="700">!</text>
      </g>
    `,
  },
  {
    title: "Workshops and training",
    copy: "Hands-on training on your own codebase: automating development with AI agents, AI-driven front ends, Nx monorepos and enterprise Angular architecture. So your team keeps the pace after we leave.",
    href: "/services/workshops",
    label: "See all workshops",
    /* A classroom: a screen with code being walked through, three
       attendees in front of it, and a check on the one who just got it. */
    art: `
      <g ${NODES}>
        <rect x="30" y="14" width="160" height="72" rx="8" ${ACCENT_NODE} />
      </g>
      <g fill="rgba(31, 79, 135, 0.4)">
        <rect class="art-line" x="44" y="28" width="60" height="5" rx="2.5" />
        <rect class="art-line" x="56" y="41" width="88" height="5" rx="2.5" />
        <rect class="art-line" x="56" y="54" width="52" height="5" rx="2.5" />
        <rect class="art-line" x="44" y="67" width="34" height="5" rx="2.5" />
      </g>
      <g ${EDGES}>
        <path d="M 110 86 L 110 94" />
        <path d="M 98 95.5 L 122 95.5" stroke-width="3" />
      </g>
      <g ${NODES}>
        <circle cx="55" cy="112" r="7" />
        <path d="M 41 136 C 41 122, 69 122, 69 136" />
        <circle cx="110" cy="112" r="7" />
        <path d="M 96 136 C 96 122, 124 122, 124 136" />
        <circle cx="165" cy="112" r="7" />
        <path d="M 151 136 C 151 122, 179 122, 179 136" />
      </g>
      <g class="art-spark">
        <circle cx="174" cy="105" r="6.5" fill="${ACCENT}" />
        <path d="M 170.8 105.2 L 173.2 107.6 L 177.4 102.8" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    `,
  },
];

/* What each column says, in the order of `services`. */
const lines = [
  {
    says: "We have a backlog nobody gets to, or a pilot that stalled.",
    terms: "Fixed price per outcome",
  },
  {
    says: "We want the diagnosis before we commit.",
    terms: `From ${euro(PRICING.assessment.minimum)}`,
  },
  {
    says: "Our own team has to keep the pace.",
    terms: `From ${euro(PRICING.workshops.oneDay)} a day`,
  },
];

const offers = services.map((service, index) => ({
  ...service,
  ...lines[index],
}));
---

<section class="services" id="services" aria-labelledby="services-heading">
  <div class="services__inner">
    <h2 class="services__title" id="services-heading">
      Which one sounds like you?
    </h2>

    <ul class="offers">
      {
        offers.map((offer, index) => (
          <li class="offer" style={`--i: ${index}`}>
            <a class="offer__link" href={offer.href}>
              <svg
                class="offer__art"
                viewBox="0 0 220 150"
                aria-hidden="true"
                focusable="false"
                set:html={offer.art}
              />
              <span class="offer__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="offer__says">{offer.says}</span>
              <span class="offer__name">
                {offer.title}
                <span class="offer__arrow" aria-hidden="true">
                  &rarr;
                </span>
              </span>
              <span class="offer__terms">{offer.terms}</span>
            </a>
          </li>
        ))
      }
    </ul>

  </div>
</section>

<style>
  .services {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .services__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .services__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .offers {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /* Phones: one under the other, a hairline between them. */
  .offer {
    padding: clamp(1.75rem, 5vw, 2.5rem) 0;
    border-top: 1px solid var(--color-stroke-strong);
  }

  .offer__link {
    display: flex;
    flex-direction: column;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }

  .offer__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 6px;
    border-radius: 8px;
  }

  .offer__art {
    width: min(100%, 250px);
    height: auto;
    overflow: visible;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .offer__index {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.05em;
    color: var(--color-accent-ink);
    margin-bottom: 0.5rem;
  }

  /* The sentence is the headline of the column: it is what the visitor
     recognises, before the name of anything. */
  .offer__says {
    font-size: clamp(1.4rem, 2.1vw, 1.8rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    letter-spacing: -0.01em;
    margin-bottom: clamp(1.25rem, 2.5vw, 2rem);
  }

  /* Pushed to the bottom, so the three names and prices line up whatever
     the length of the sentence above them. */
  .offer__name {
    margin-top: auto;
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--font-lg);
    font-weight: var(--font-weight-medium);
    color: var(--color-link);
  }

  .offer__arrow {
    transition: transform 0.35s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .offer__terms {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    color: var(--color-ink-muted);
    margin-top: 0.2rem;
  }

  .offer__link:hover .offer__art,
  .offer__link:focus-visible .offer__art {
    transform: translateY(-6px);
  }

  .offer__link:hover .offer__arrow,
  .offer__link:focus-visible .offer__arrow {
    transform: translateX(8px);
  }

  .offer__link:hover .offer__name,
  .offer__link:focus-visible .offer__name {
    color: var(--color-link-hover);
  }

  .services__vat {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  /* Each column rises into place as the section scrolls in, the second
     and third a beat after the first. */
  @supports (animation-timeline: view()) {
    .offers {
      view-timeline-name: --offers;
    }

    .offer__link {
      opacity: 0;
      transform: translateY(36px);
      animation: offer-rise cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-timeline: --offers;
      /* Starts as soon as the columns show at the bottom of the screen and
         runs until they are about halfway up it: a long stretch of scroll,
         so the rise is slow rather than late. */
      animation-range: entry calc(10% + var(--i) * 15%) cover
        calc(42% + var(--i) * 5%);
    }
  }

  @keyframes offer-rise {
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* --- The diagrams' loops ---
     The SVG markup is injected, so these rules are global by necessity.
     Each loop is slow and leaves the diagram in its drawn state for most
     of the cycle; with reduced motion the global rule stops them there. */

  /* Engineering: the three stages light up top to bottom, hold, reset. */
  .offer__art :global(.art-layer) {
    animation: art-stage 7s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .offer__art :global(.art-label) {
    animation: art-stage-label 7s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .offer__art :global(.art-layer:nth-child(3)),
  .offer__art :global(.art-label:nth-child(3)) {
    animation-delay: 0.9s;
  }

  .offer__art :global(.art-flow) {
    stroke-dasharray: 14;
    animation: art-draw 7s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .offer__art :global(.art-flow:nth-child(2)) {
    animation-delay: 0.9s;
  }

  @keyframes art-stage {
    0%,
    12% {
      fill: rgba(54, 61, 75, 0.04);
      stroke: rgba(54, 61, 75, 0.55);
    }
    24%,
    78% {
      fill: rgba(47, 125, 209, 0.14);
      stroke: #2f7dd1;
    }
    90%,
    100% {
      fill: rgba(54, 61, 75, 0.04);
      stroke: rgba(54, 61, 75, 0.55);
    }
  }

  @keyframes art-stage-label {
    0%,
    12% {
      fill: #363d4b;
    }
    24%,
    78% {
      fill: #1f4f87;
    }
    90%,
    100% {
      fill: #363d4b;
    }
  }

  @keyframes art-draw {
    0%,
    6% {
      stroke-dashoffset: 14;
    }
    16%,
    100% {
      stroke-dashoffset: 0;
    }
  }

  /* Assessment: the circular dependency marches and its flag pulses. */
  .offer__art :global(.art-loop) {
    animation: art-march 0.9s linear infinite;
  }

  .offer__art :global(.art-flag) {
    transform-box: fill-box;
    transform-origin: center;
    animation: art-flag 2.6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  @keyframes art-march {
    to {
      stroke-dashoffset: -18;
    }
  }

  @keyframes art-flag {
    0%,
    60%,
    100% {
      transform: scale(1);
    }
    75% {
      transform: scale(1.22);
    }
  }

  /* Workshops: the code types in line by line, then the check pops on the
     attendee who got it. */
  .offer__art :global(.art-line) {
    transform-box: fill-box;
    transform-origin: left center;
    animation: art-type 6s cubic-bezier(0.22, 0.61, 0.36, 1) infinite;
  }

  .offer__art :global(.art-line:nth-child(2)) {
    animation-delay: 0.3s;
  }

  .offer__art :global(.art-line:nth-child(3)) {
    animation-delay: 0.6s;
  }

  .offer__art :global(.art-line:nth-child(4)) {
    animation-delay: 0.9s;
  }

  .offer__art :global(.art-spark) {
    transform-box: fill-box;
    transform-origin: center;
    animation: art-spark 6s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
  }

  @keyframes art-type {
    0% {
      transform: scaleX(0);
    }
    10%,
    84% {
      transform: scaleX(1);
    }
    92%,
    100% {
      transform: scaleX(0);
    }
  }

  @keyframes art-spark {
    0%,
    28% {
      transform: scale(0);
    }
    36% {
      transform: scale(1.3);
    }
    42%,
    84% {
      transform: scale(1);
    }
    92%,
    100% {
      transform: scale(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .offer__link {
      opacity: 1;
      transform: none;
    }

    .offer__art,
    .offer__arrow {
      transition: none;
    }

    .offer__link:hover .offer__art,
    .offer__link:focus-visible .offer__art,
    .offer__link:hover .offer__arrow,
    .offer__link:focus-visible .offer__arrow {
      transform: none;
    }
  }

  /* Wide screens: three columns, a vertical hairline between them. */
  @media (min-width: 900px) {
    .offers {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .offer {
      padding: 0 clamp(1.5rem, 3vw, 3rem);
      border-top: 0;
      border-left: 1px solid var(--color-stroke-strong);
    }

    .offer:first-child {
      padding-left: 0;
      border-left: 0;
    }

    .offer:last-child {
      padding-right: 0;
    }
  }
</style>
