---
/**
 * The three services in one glance, right under the hero. Three equal dark
 * panels in the same style as the story cards below, each a link to its
 * section. Static on purpose: nothing resizes on hover, only the diagram
 * lifts, one detail inside it moves, and the link brightens.
 *
 * The diagrams are inline SVG in the same idiom as the hero's project graph
 * (rounded nodes, thin edges, one accent), so all three share one size and
 * one visual language. Their colours are presentation attributes on the
 * markup rather than stylesheet rules, so they render the same everywhere
 * and never depend on a stylesheet being current.
 */
const ACCENT = "#2f7dd1";
const DANGER = "#c2413b";
const EDGES =
  'fill="none" stroke="rgba(232, 237, 246, 0.42)" stroke-width="1.5" stroke-linecap="round"';
const NODES =
  'fill="rgba(232, 237, 246, 0.06)" stroke="rgba(232, 237, 246, 0.6)" stroke-width="1.5"';
const ACCENT_NODE = `fill="rgba(47, 125, 209, 0.28)" stroke="${ACCENT}"`;
const FONT = 'font-family="chillax, sans-serif" text-anchor="middle"';

const services = [
  {
    title: "Architecture assessment",
    copy: "Industry leading experts read your Angular or Nx codebase and hand you a ranked report and a roadmap. Fixed scope, two to three weeks for a full review.",
    href: "/services/architecture-assessment",
    label: "Everything about the assessment",
    /* A dependency graph with one circular dependency flagged. */
    art: `
      <g ${EDGES}>
        <path d="M 90 40 C 90 52, 60 52, 60 64" />
        <path d="M 90 40 C 90 52, 118 52, 118 64" />
        <path d="M 160 40 C 160 52, 132 52, 132 64" />
        <path d="M 160 40 C 160 52, 190 52, 190 64" />
        <path d="M 60 86 C 60 98, 88 98, 88 110" />
        <path d="M 118 86 C 118 98, 100 98, 100 110" />
        <path d="M 125 86 C 125 98, 152 98, 152 110" />
        <path d="M 190 86 C 190 98, 166 98, 166 110" />
      </g>
      <path class="art-loop" d="M 172 110 C 210 96, 212 46, 186 30" fill="none" stroke="${DANGER}" stroke-width="1.75" stroke-linecap="round" stroke-dasharray="5 4" />
      <g ${NODES}>
        <rect x="62" y="18" width="56" height="22" rx="6" />
        <rect x="132" y="18" width="56" height="22" rx="6" />
        <rect x="32" y="64" width="56" height="22" rx="6" />
        <rect x="97" y="64" width="56" height="22" rx="6" />
        <rect x="162" y="64" width="56" height="22" rx="6" />
        <rect x="66" y="110" width="56" height="22" rx="6" />
        <rect x="131" y="110" width="56" height="22" rx="6" />
      </g>
      <g class="art-flag">
        <circle cx="206" cy="46" r="11" fill="${DANGER}" />
        <text x="206" y="50.5" fill="#ffffff" ${FONT} font-size="15" font-weight="700">!</text>
      </g>
    `,
  },
  {
    title: "Angular and Nx workshops",
    copy: "Hands-on training for your team in enterprise Angular patterns, Nx monorepos and AI-assisted development.",
    href: "/services/workshops",
    label: "See all workshops",
    /* A classroom: a screen with code being walked through, three
       attendees in front of it, and a check on the one who just got it. */
    art: `
      <g ${NODES}>
        <rect x="30" y="14" width="160" height="72" rx="8" ${ACCENT_NODE} />
      </g>
      <g fill="rgba(232, 237, 246, 0.55)">
        <rect class="art-line" x="44" y="28" width="60" height="5" rx="2.5" />
        <rect class="art-line" x="56" y="41" width="88" height="5" rx="2.5" />
        <rect class="art-line" x="56" y="54" width="52" height="5" rx="2.5" />
        <rect class="art-line" x="44" y="67" width="34" height="5" rx="2.5" />
      </g>
      <g ${EDGES}>
        <path d="M 110 86 L 110 94" />
        <path d="M 98 95.5 L 122 95.5" stroke-width="3" />
      </g>
      <g ${NODES}>
        <circle cx="55" cy="112" r="7" />
        <path d="M 41 136 C 41 122, 69 122, 69 136" />
        <circle cx="110" cy="112" r="7" />
        <path d="M 96 136 C 96 122, 124 122, 124 136" />
        <circle cx="165" cy="112" r="7" />
        <path d="M 151 136 C 151 122, 179 122, 179 136" />
      </g>
      <g class="art-spark">
        <circle cx="174" cy="105" r="6.5" fill="${ACCENT}" />
        <path d="M 170.8 105.2 L 173.2 107.6 L 177.4 102.8" fill="none" stroke="#ffffff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </g>
    `,
  },
  {
    title: "Application development",
    copy: "A section of your enterprise software or a complete new application, built full stack by one senior team.",
    href: "/services/application-development",
    label: "See how we build",
    /* Three connected layers: front end, API, data. */
    art: `
      <g ${EDGES}>
        <path class="art-flow" d="M 110 48 L 110 62" />
        <path class="art-flow" d="M 110 92 L 110 106" />
      </g>
      <g ${NODES}>
        <rect x="40" y="16" width="140" height="32" rx="8" ${ACCENT_NODE} />
        <rect class="art-layer" x="40" y="62" width="140" height="30" rx="8" />
        <rect class="art-layer" x="40" y="106" width="140" height="30" rx="8" />
      </g>
      <g ${FONT} font-size="12.5" font-weight="500" fill="rgba(232, 237, 246, 0.8)">
        <text x="110" y="36.5" fill="#ffffff">Front end</text>
        <text x="110" y="81.5">API</text>
        <text x="110" y="125.5">Data</text>
      </g>
    `,
  },
];
---

<section class="services" aria-labelledby="services-heading">
  <div class="services__inner">
    <h2 class="services__title" id="services-heading">Three ways we help</h2>

    <ul class="trio">
      {
        services.map((service) => (
          <li class="panel">
            <a class="panel__link" href={service.href}>
              <svg
                class="panel__art"
                viewBox="0 0 220 150"
                aria-hidden="true"
                focusable="false"
                set:html={service.art}
              />
              <span class="panel__body">
                <span class="panel__title">{service.title}</span>
                <span class="panel__copy">{service.copy}</span>
                <span class="panel__cta">{service.label}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="services__next">
      Each page has the full story: the numbers, a self-check for your own team,
      how it runs and what it costs in time. Most teams start with the
      assessment. Here is why.
    </p>
  </div>
</section>

<style>
  .services {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(2.5rem, 6vw, 4.5rem) clamp(1rem, 4vw, 3rem)
      clamp(2rem, 5vw, 3.5rem);
  }

  .services__inner {
    max-width: 1280px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .services__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .trio {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-md);
  }

  .panel {
    position: relative;
    border-radius: 15px;
    overflow: hidden;
    background: var(--background-gradient-primary);
    color: var(--color-ink-light);
    box-shadow: 0 24px 50px rgba(11, 18, 32, 0.18);
    isolation: isolate;
  }

  .panel:nth-child(2) {
    background: var(--background-gradient-secondary);
  }

  .panel:nth-child(3) {
    background: linear-gradient(180deg, #1d2f4a 0%, #16243a 100%);
  }

  /* Soft glow behind the diagram, like the glass cards elsewhere. */
  .panel::before {
    content: "";
    position: absolute;
    right: -15%;
    top: -20%;
    width: 60%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(47, 125, 209, 0.22) 0%,
      rgba(47, 125, 209, 0) 70%
    );
    z-index: 0;
    pointer-events: none;
  }

  .panel__link {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr minmax(120px, 40%);
    align-items: end;
    gap: var(--spacer-md);
    min-height: 230px;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    color: inherit;
    text-decoration: none;
  }

  .panel__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: -3px;
    border-radius: 15px;
  }

  /* --- Diagram --- */

  .panel__art {
    grid-column: 2;
    grid-row: 1;
    justify-self: end;
    align-self: start;
    width: 100%;
    height: auto;
    max-width: 210px;
    overflow: visible;
    transition: transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  /* --- Text --- */

  .panel__body {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .panel__title {
    font-size: 1.5rem;
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.1;
    text-wrap: balance;
  }

  .panel__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.78);
    max-width: 36ch;
  }

  .panel__cta {
    margin-top: 0.3rem;
    font-family: synonym, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink-light);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    transition:
      color 0.2s,
      text-decoration-color 0.2s;
  }

  .panel__link:hover .panel__cta,
  .panel__link:focus-visible .panel__cta {
    color: var(--color-light-raised);
    text-decoration-color: var(--color-light-raised);
  }

  .panel__link:hover .panel__art {
    transform: translateY(-4px);
  }

  /* --- Small movements inside each diagram on hover ---
     The SVG markup is injected, so these rules are global by necessity.
     Each diagram animates the one thing it is about: the flagged cycle,
     the growing skill bars, the data moving between layers. */

  /* Assessment: the circular dependency marches and its badge pops. */
  .panel__link:hover .panel__art :global(.art-loop) {
    animation: art-march 0.9s linear infinite;
  }

  .panel__art :global(.art-flag) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .panel__link:hover .panel__art :global(.art-flag) {
    transform: scale(1.18);
  }

  /* Workshops: the code on the screen types in line by line, then the
     check on the attendee who got it pops. */
  .panel__art :global(.art-line) {
    transform-box: fill-box;
    transform-origin: left center;
  }

  .panel__link:hover .panel__art :global(.art-line) {
    animation: art-type 0.35s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .panel__link:hover .panel__art :global(.art-line:nth-child(2)) {
    animation-delay: 0.12s;
  }

  .panel__link:hover .panel__art :global(.art-line:nth-child(3)) {
    animation-delay: 0.24s;
  }

  .panel__link:hover .panel__art :global(.art-line:nth-child(4)) {
    animation-delay: 0.36s;
  }

  .panel__art :global(.art-spark) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .panel__link:hover .panel__art :global(.art-spark) {
    transform: scale(1.25);
    transition-delay: 0.55s;
  }

  @keyframes art-type {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  /* Application development: the edges redraw top to bottom and each
     layer lights up as the data reaches it. */
  .panel__art :global(.art-flow) {
    stroke-dasharray: 14;
    stroke-dashoffset: 0;
  }

  .panel__link:hover .panel__art :global(.art-flow) {
    animation: art-draw 0.4s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  .panel__link:hover .panel__art :global(.art-flow:nth-child(2)) {
    animation-delay: 0.3s;
  }

  .panel__art :global(.art-layer) {
    transition: fill 0.3s;
  }

  .panel__link:hover .panel__art :global(.art-layer) {
    fill: rgba(232, 237, 246, 0.14);
  }

  .panel__link:hover .panel__art :global(.art-layer:nth-child(2)) {
    transition-delay: 0.3s;
  }

  .panel__link:hover .panel__art :global(.art-layer:nth-child(3)) {
    transition-delay: 0.6s;
  }

  @keyframes art-march {
    to {
      stroke-dashoffset: -18;
    }
  }

  @keyframes art-draw {
    from {
      stroke-dashoffset: 14;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  .services__next {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    color: var(--color-ink-muted);
    text-align: center;
    padding-top: var(--spacer-md);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel__art,
    .panel__cta,
    .panel__art :global(.art-flag),
    .panel__art :global(.art-spark),
    .panel__art :global(.art-layer) {
      transition: none;
    }

    .panel__link:hover .panel__art :global(.art-loop),
    .panel__link:hover .panel__art :global(.art-line),
    .panel__link:hover .panel__art :global(.art-flow) {
      animation: none;
    }

    .panel__link:hover .panel__art :global(.art-flag),
    .panel__link:hover .panel__art :global(.art-spark) {
      transform: none;
    }
  }

  /* --- Wide screens: three equal panels, diagram above the text --- */
  @media (min-width: 900px) {
    .trio {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacer-lg);
    }

    .panel__link {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 0;
      height: 100%;
      min-height: 0;
      padding: clamp(1.5rem, 2.5vw, 2rem);
      /* Room for the diagram above the text. */
      padding-top: clamp(190px, 16vw, 220px);
    }

    .panel__art {
      position: absolute;
      top: clamp(1.5rem, 2.5vw, 2rem);
      right: clamp(1.5rem, 2.5vw, 2rem);
      width: 60%;
      max-width: 220px;
    }

    .panel__body {
      position: relative;
    }

    .panel__title {
      font-size: 1.65rem;
    }

    .services__next {
      padding-top: var(--spacer-base);
    }
  }
</style>
