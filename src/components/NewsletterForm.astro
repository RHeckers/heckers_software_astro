---
/**
 * Mailing-list opt-in (Zoho Campaigns).
 *
 * The form posts into a hidden iframe so the page never navigates. Zoho's
 * response is cross-origin and unreadable, so success is confirmed
 * optimistically after a short delay, exactly as the original form did.
 *
 * Several instances can share one page (end-of-post card, in-feed block,
 * reading bar): `id` keeps their element ids and iframe targets apart, and
 * the script below wires every instance on the page once. A successful
 * submit is remembered in localStorage so the reading bar stops asking.
 */
interface Props {
  /** Unique per page: element id of the block and base of the iframe name. */
  id: string;
  /** card: centred panel; inline: compact two-column panel; bare: form only. */
  variant?: "card" | "inline" | "bare";
  heading?: string;
  text?: string;
}

const { id, variant = "card", heading, text } = Astro.props;
const frameName = `${id}-frame`;
---

<aside class:list={["nl", `nl--${variant}`]} id={id} aria-label="Newsletter">
  {
    (heading || text) && (
      <div class="nl__copy">
        {heading && <h2 class="nl__heading">{heading}</h2>}
        {text && <p class="nl__text">{text}</p>}
      </div>
    )
  }
  <form
    class="nl__form"
    method="POST"
    action="https://zcv2-zcmp.maillist-manage.eu/weboptin.zc"
    target={frameName}
    data-newsletter
  >
    <div class="nl__group">
      <input
        type="email"
        name="CONTACT_EMAIL"
        placeholder="you@company.com"
        required
        autocomplete="email"
        aria-label="Email address"
      />
      <button type="submit">Subscribe</button>
    </div>
    <p class="nl__msg" aria-live="polite">
      No spam, no sales sequence. Unsubscribe in one click.
    </p>
    <input type="hidden" name="submitType" value="optinCustomView" />
    <input type="hidden" name="formType" value="QuickForm" />
    <input type="hidden" name="zx" value="14aec560cd" />
    <input type="hidden" name="zcvers" value="2.0" />
    <input type="hidden" name="mode" value="OptinCreateView" />
    <input type="hidden" name="zcld" value="13ce2114ace6871e" />
    <input type="hidden" name="zctd" value="13ce2114ace68541" />
    <input type="hidden" name="zc_trackCode" value="ZCFORMVIEW" />
    <input
      type="hidden"
      name="zc_formIx"
      value="3zdd934e667aaf45237dedcebdfc4f8ab98f75d0617ab556be86d925d0ec82e9fc"
    />
    <input type="hidden" name="viewFrom" value="URL_ACTION" />
  </form>
  <iframe name={frameName} hidden aria-hidden="true" tabindex="-1"></iframe>
</aside>

<style>
  .nl {
    font-family: "synonym", sans-serif;
    color: var(--color-ink);
    /* Room for the fixed navbar when the reading bar jumps here. */
    scroll-margin-top: 7rem;
  }

  .nl__heading {
    font-family: "chillax", sans-serif;
    font-weight: var(--font-weight-bold);
    line-height: 1.2;
    margin: 0 0 0.5rem;
  }

  .nl__text {
    color: var(--color-ink-muted);
    line-height: 1.7;
    margin: 0;
  }

  .nl__form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
  }

  .nl__group {
    display: flex;
    width: 100%;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--color-stroke-strong);
    background: var(--color-light-raised);
  }

  .nl__group:focus-within {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(47, 125, 209, 0.2);
  }

  .nl__group input {
    flex: 1;
    min-width: 0;
    border: none;
    padding: 0.8rem 1rem;
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    outline: none;
  }

  .nl__group input::placeholder {
    color: var(--color-ink-muted);
    opacity: 0.6;
  }

  .nl__group button {
    flex-shrink: 0;
    border: none;
    padding: 0.8rem 1.5rem;
    font-family: "chillax", sans-serif;
    font-weight: var(--font-weight-semi-bold);
    color: #fff;
    background: var(--color-accent);
    cursor: pointer;
    transition: background 200ms ease;
  }

  .nl__group button:hover {
    background: var(--color-accent-strong);
  }

  .nl__group button:disabled {
    opacity: 0.7;
    cursor: default;
  }

  .nl__msg {
    margin: 0;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
    min-height: 1.2em;
  }

  .nl__msg.is-success {
    color: var(--color-success);
  }

  iframe[hidden] {
    display: none;
  }

  /* --- card: the centred panel at the end of a post --- */

  .nl--card {
    padding: 2.5rem;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-light-alt);
    text-align: center;
  }

  .nl--card .nl__copy {
    margin-bottom: 1.5rem;
  }

  .nl--card .nl__heading {
    font-size: var(--font-xl);
  }

  .nl--card .nl__text {
    max-width: 520px;
    margin: 0 auto;
  }

  .nl--card .nl__form {
    align-items: center;
  }

  .nl--card .nl__group {
    max-width: 460px;
  }

  /* --- inline: compact two-column panel in the post feed --- */

  .nl--inline {
    display: grid;
    /* minmax(0, …) lets the column shrink below the form's intrinsic width
       (email input + button) so narrow phones never scroll sideways. */
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    background: var(--color-light-alt);
  }

  .nl--inline .nl__heading {
    font-size: var(--font-lg);
  }

  .nl--inline .nl__text {
    font-size: var(--font-sm);
  }

  @media (min-width: 769px) {
    .nl--inline {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 2rem;
    }
  }

  /* --- bare: just the form, for the reading bar --- */

  .nl--bare .nl__msg {
    display: none;
  }

  .nl--bare .nl__msg.is-success {
    display: block;
  }

  .nl--bare .nl__group input,
  .nl--bare .nl__group button {
    padding-top: 0.5rem;
    padding-bottom: 0.5rem;
  }

  .nl--bare .nl__group button {
    padding-left: 1rem;
    padding-right: 1rem;
  }

  @media (max-width: 640px) {
    .nl--card {
      padding: 1.75rem 1.25rem;
    }

    .nl--inline {
      padding: 1.25rem;
    }

    .nl--inline .nl__group button {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }
</style>

<script>
  const STORAGE_KEY = "newsletter-subscribed";

  document
    .querySelectorAll<HTMLFormElement>("form[data-newsletter]")
    .forEach((form) => {
      const email = form.querySelector<HTMLInputElement>('input[type="email"]');
      const button = form.querySelector<HTMLButtonElement>("button");
      const msg = form.querySelector<HTMLElement>(".nl__msg");
      if (!email || !button || !msg) return;

      form.addEventListener("submit", () => {
        if (!email.value.trim()) return;

        button.disabled = true;
        button.textContent = "Subscribing...";

        // Zoho handles the POST in the hidden iframe and does not return a
        // readable response, so confirm optimistically.
        setTimeout(() => {
          msg.textContent =
            "You're in! Check your inbox to confirm (and your spam folder, just in case).";
          msg.classList.add("is-success");
          email.value = "";
          button.disabled = false;
          button.textContent = "Subscribe";

          try {
            localStorage.setItem(STORAGE_KEY, "1");
          } catch {
            /* storage unavailable: nothing to remember */
          }
          window.dispatchEvent(new CustomEvent("newsletter-subscribed"));
        }, 1500);
      });
    });
</script>
