---
/**
 * The hero aside of the assessment page: a glimpse of the ranked findings
 * list that the report opens with, so the reader sees the deliverable
 * before the argument. The rows are an anonymised example and say so.
 */
const findings = [
  {
    title: "One shared library imported by 71% of projects",
    meta: "Any change rebuilds 38 of 52 projects",
    weight: 100,
  },
  {
    title: "Seven circular dependencies across three apps",
    meta: "Lazy loading defeated; initial bundle 2.4 MB",
    weight: 76,
  },
  {
    title: "Three Angular majors behind",
    meta: "Upgrade path: four steps, two sprints",
    weight: 54,
  },
  {
    title: "Same state in a service, a store and an input",
    meta: "Behind six of the last ten incidents",
    weight: 38,
  },
];
---

<aside
  class="report"
  aria-label="Example of the ranked findings in an assessment report"
>
  <header class="report__head">
    <p class="report__kicker">Example findings</p>
    <p class="report__meta">Ranked by what they cost per month</p>
  </header>
  <ol class="report__list">
    {
      findings.map((finding, index) => (
        <li class="finding" style={`--w: ${finding.weight}`}>
          <span class="finding__rank" aria-hidden="true">
            {String(index + 1).padStart(2, "0")}
          </span>
          <div class="finding__body">
            <p class="finding__title">{finding.title}</p>
            <p class="finding__meta">{finding.meta}</p>
            <span class="finding__bar" aria-hidden="true" />
          </div>
        </li>
      ))
    }
  </ol>
  <p class="report__foot">
    Each with the fix and the effort next to it, so your team starts at the top.
  </p>
</aside>

<style>
  .report {
    position: relative;
    isolation: isolate;
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    padding: clamp(1.25rem, 2.5vw, 2rem);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    box-shadow: 0 30px 60px rgba(5, 10, 20, 0.35);
    overflow: hidden;
    font-family: synonym, sans-serif;
  }

  .report::before {
    content: "";
    position: absolute;
    left: -30%;
    bottom: -50%;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(194, 65, 59, 0.22) 0%,
      rgba(194, 65, 59, 0) 70%
    );
    z-index: -1;
    pointer-events: none;
  }

  .report__head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid rgba(232, 237, 246, 0.14);
  }

  .report__kicker {
    font-size: var(--font-xs);
    font-weight: var(--font-weight-semi-bold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .report__meta {
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.6);
  }

  .report__list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .finding {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.75rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(232, 237, 246, 0.1);
  }

  .finding:last-child {
    border-bottom: 0;
  }

  .finding__rank {
    font-family: chillax, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    color: rgba(232, 237, 246, 0.5);
    padding-top: 0.15rem;
  }

  .finding__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .finding__title {
    font-family: chillax, sans-serif;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.3;
    color: var(--color-light-raised);
  }

  .finding__meta {
    font-size: var(--font-sm);
    line-height: 1.4;
    color: rgba(232, 237, 246, 0.65);
  }

  /* The bar is the ranking made visible: full for the top finding, shorter
     for each one below it, and shifting from red to blue as it shortens. */
  .finding__bar {
    display: block;
    height: 4px;
    width: calc(var(--w) * 1%);
    margin-top: 0.25rem;
    border-radius: 2px;
    background: linear-gradient(
      90deg,
      var(--color-accent) 0%,
      var(--color-danger) 100%
    );
    background-size: calc(100% / var(--w) * 100) 100%;
  }

  .report__foot {
    font-size: var(--font-sm);
    line-height: 1.45;
    color: rgba(232, 237, 246, 0.6);
    padding-top: 0.75rem;
    border-top: 1px solid rgba(232, 237, 246, 0.12);
  }
</style>
