---
/**
 * The teaching part of the page: what we have learned, what it means, and
 * one thing the reader can do today without us. Each insight is kept to
 * two or three sentences and one takeaway, and carries a small diagram in
 * the same idiom as the home page's project graph and service cards:
 * rounded nodes, thin edges, one accent, red for the problem, labels in
 * chillax. When the row scrolls into view the nodes pop in and the edges
 * draw, with the same easing the home cards use on hover; a few diagrams
 * then keep a slow loop going. Motion is dropped for readers who asked
 * their system for less of it.
 *
 * By default each insight is a row on a dark ground, diagram and title on
 * the left, argument and takeaway on the right. The light grid variant
 * sets the same content as numbered cards on a light ground, for pages
 * that keep their dark panel for the self-check; the diagram colours
 * follow the tone through custom properties.
 */
interface Insight {
  title: string;
  copy: string;
  /** Something the reader can do this week on their own. */
  takeaway: string;
  /** Which diagram sits next to it; see FIGURES below. */
  figure: FigureId;
}

type FigureId =
  | "last-mile"
  | "discovery"
  | "feature"
  | "amplified"
  | "owner"
  | "blind-spot"
  | "decay"
  | "rewrite"
  | "rank"
  | "slides"
  | "rules"
  | "multiply"
  | "team";

interface Props {
  id?: string;
  title: string;
  intro: string;
  items: Insight[];
  tone?: "dark" | "light";
  layout?: "rows" | "grid";
}

const {
  id = "insights",
  title,
  intro,
  items,
  tone = "dark",
  layout = "rows",
} = Astro.props;

/*
 * Diagrams, 220 by 140, the size of the home page's service card art.
 * Classes: n = node, e = edge, t = label; --accent / --danger variants.
 * Reveal classes: p = pops in, d = draws in (needs pathLength="1"),
 * f = fades in; --i staggers them. Looping parts carry a fig-* class.
 */
