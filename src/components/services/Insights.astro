---

<section
  class:list={["insights", `insights--${tone}`, `insights--${layout}`]}
  id={id}
  aria-labelledby={`${id}-heading`}
>
  <div class="insights__inner">
    <header class="insights__head">
      <h2 class="insights__title" id={`${id}-heading`}>{title}</h2>
      <p class="insights__intro">{intro}</p>
    </header>

    <ul class="insight-list">
      {
        items.map((item, index) => (
          <li class="insight" data-insight>
            <div class="insight__lead">
              <svg
                class={`insight__figure fig fig--${item.figure}`}
                viewBox="0 0 220 140"
                aria-hidden="true"
                focusable="false"
                set:html={FIGURES[item.figure]}
              />
              <span class="insight__index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3 class="insight__title">{item.title}</h3>
            </div>
            <div class="insight__body">
              <p class="insight__copy">{item.copy}</p>
              <p class="insight__takeaway">
                <span class="insight__takeaway-label">Do this today.</span>
                {item.takeaway}
              </p>
            </div>
          </li>
        ))
      }
    </ul>

    {
      Astro.slots.has("proof") && (
        <div class="insights__proof">
          <slot name="proof" />
        </div>
      )
    }
  </div>
</section>

<script>
  // Reveal each diagram the first time its row comes into view.
  const rows = document.querySelectorAll<HTMLElement>("[data-insight]");
  if ("IntersectionObserver" in window) {
    const seen = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-in");
            seen.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.35 },
    );
    rows.forEach((row) => seen.observe(row));
  } else {
    rows.forEach((row) => row.classList.add("is-in"));
  }
</script>

<style>
  .insights {
    background: var(--color-dark-soft);
    color: var(--color-ink-light);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .insights__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  .insights__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    max-width: 64ch;
  }

  .insights__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
    color: var(--color-light-raised);
  }

  .insights__intro {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: rgba(232, 237, 246, 0.72);
  }

  .insight-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(232, 237, 246, 0.16);
  }

  .insight {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 3rem;
    padding: clamp(1.75rem, 4vw, 2.5rem) 0;
    border-bottom: 1px solid rgba(232, 237, 246, 0.12);
  }

  .insight__lead {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      "figure index"
      "figure title";
    column-gap: 1.5rem;
    align-content: start;
  }

  .insight__figure {
    grid-area: figure;
    width: clamp(10rem, 15vw, 13rem);
    height: auto;
    align-self: start;
  }

  .insight__index {
    grid-area: index;
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: 0.35rem;
  }

  .insight__title {
    grid-area: title;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    color: var(--color-light-raised);
    max-width: 22ch;
  }

  .insight__body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .insight__copy {
    font-family: synonym, sans-serif;
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.6;
    color: rgba(232, 237, 246, 0.8);
    max-width: 58ch;
  }

  .insight__takeaway {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    font-size: 0.95rem;
    color: var(--color-ink-light);
    max-width: 56ch;
    padding: 0.8rem 1rem;
    border-radius: 12px;
    background: rgba(47, 125, 209, 0.1);
    border: 1px solid rgba(47, 125, 209, 0.25);
  }

  .insight__takeaway-label {
    font-family: chillax, sans-serif;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-accent);
    margin-right: 0.35rem;
  }

  .insights__proof:empty {
    display: none;
  }

  /* --- Light tone --- */

  .insights--light {
    background: var(--color-light-alt);
    color: var(--color-ink);
  }

  .insights--light .insights__title,
  .insights--light .insight__title {
    color: var(--color-ink);
  }

  .insights--light .insights__intro {
    color: var(--color-ink-muted);
  }

  .insights--light .insight__copy {
    color: var(--color-ink);
  }

  .insights--light .insight__index {
    color: var(--color-accent-ink);
  }

  .insights--light .insight__takeaway {
    color: var(--color-ink);
    background: rgba(47, 125, 209, 0.08);
    border-color: rgba(47, 125, 209, 0.3);
  }

  .insights--light .insight__takeaway-label {
    color: var(--color-accent-ink);
  }

  /* --- Grid layout: numbered cards instead of essay rows --- */

  .insights--grid .insight-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-lg);
    border-top: 0;
  }

  .insights--grid .insight {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.5rem, 3vw, 2rem);
    border: 1px solid var(--color-stroke);
    border-radius: 16px;
    background: var(--color-light-raised);
  }

  .insights--grid .insight__lead {
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "index figure"
      "title figure";
    column-gap: 1.5rem;
  }

  .insights--grid .insight__figure {
    width: clamp(9rem, 12vw, 11rem);
    justify-self: end;
  }

  .insights--grid .insight__title {
    max-width: none;
  }

  .insights--grid .insight__body {
    flex: 1;
    justify-content: space-between;
  }

  @media (min-width: 900px) {
    .insights--rows .insight {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    }

    .insights--grid .insight-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .insights--grid .insights__proof {
      margin-left: 0;
      max-width: 40rem;
    }

    /* Sits under the right-hand column, where the arguments were. */
    .insights__proof {
      margin-left: 48%;
      max-width: 40rem;
    }
  }
</style>

<style is:global>
  /* The diagrams are injected as raw SVG, so their rules live here under
     the .fig class. Colours are the home page's: light strokes on dark,
     one accent, red for the problem; the light tone swaps the greys. */
  .fig {
    --fig-edge: rgba(232, 237, 246, 0.42);
    --fig-node-fill: rgba(232, 237, 246, 0.06);
    --fig-node-stroke: rgba(232, 237, 246, 0.6);
    --fig-text: rgba(232, 237, 246, 0.8);
    --fig-bright: #ffffff;
    --fig-line: rgba(232, 237, 246, 0.55);
    --fig-accent: #2f7dd1;
