---
/**
 * The four workshops, each with its own anchor so the home page can link
 * straight to one, plus the one built around a team. A card says what the
 * workshop is in one line; what it covers and what the team leaves with
 * open on request, so the stack can be scanned in a few seconds. Light
 * cards on a light or a dark ground.
 */
import { Image } from "astro:assets";
import effectiveAngular from "../../assets/workshop/effective_angular.jpg";
import ngPoland from "../../assets/workshop/ng_poland.jpg";
import talk1 from "../../assets/workshop/talk_1.jpg";
import talk2 from "../../assets/workshop/talk_2.png";
import {
  TAILORED_WORKSHOP,
  WORKSHOPS,
  type WorkshopId,
} from "../../lib/workshops";

interface Props {
  id?: string;
  title: string;
  intro: string;
  subject: string;
  /** The ground it sits on, so it never repeats the section above it. */
  tone?: "light" | "dark";
}

const { id = "catalog", title, intro, subject, tone = "light" } = Astro.props;

/* What each workshop is, in one line. The long description stays in the
   catalogue data for search engines and the llms files. */
const pitches: Record<WorkshopId | "tailored", string> = {
  ai: "Agents that take a ticket, write the code and the tests, and open the pull request.",
  "ai-frontend":
    "Dashboards that answer questions, chats that reply with components, one message that runs a whole task.",
  "nx-monorepo": "A workspace that shares more code, ships faster and keeps its structure.",
  "enterprise-angular": "Structure for an Angular app that grew faster than its architecture.",
  tailored: "One topic, a mix of several, or something nobody has written a course for yet.",
};

const images: Record<WorkshopId, { src: ImageMetadata; position: string }> = {
  ai: { src: talk2, position: "center" },
  "ai-frontend": { src: talk1, position: "center" },
  "nx-monorepo": { src: ngPoland, position: "left" },
  "enterprise-angular": { src: effectiveAngular, position: "top center" },
};
---

<section class:list={["catalog", `catalog--${tone}`]} id={id} aria-labelledby={`${id}-heading`}>
  <div class="catalog__inner">
    <header class="catalog__head">
      <h2 class="catalog__title" id={`${id}-heading`}>{title}</h2>
      <p class="catalog__intro">{intro}</p>
    </header>

    <div class="catalog__list">
      {
        WORKSHOPS.map((workshop, index) => (
          <article
            class:list={["workshop", { "workshop--flip": index % 2 === 1 }]}
            id={workshop.id}
          >
            <figure class="workshop__media">
              <Image
                src={images[workshop.id].src}
                alt={workshop.title}
                widths={[400, 640, 960]}
                sizes="(min-width: 900px) 480px, 90vw"
                loading="lazy"
                style={`object-position: ${images[workshop.id].position};`}
              />
            </figure>
            <div class="workshop__body">
              <p class="workshop__tag">{workshop.tag}</p>
              <h3 class="workshop__title">{workshop.title}</h3>
              <p class="workshop__description">{pitches[workshop.id]}</p>
              <details class="workshop__more">
                <summary>What we cover</summary>
                <ul class="workshop__bullets">
                  {workshop.bullets.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <p class="workshop__outcome">
                  <span class="workshop__outcome-label">You leave with</span>
                  {workshop.outcome}
                </p>
              </details>
              <a
                class="workshop__cta"
                href="#contactForm"
                data-subject={subject}
                data-message={`I am interested in the ${workshop.title} workshop.`}
              >
                Book this workshop
              </a>
            </div>
          </article>
        ))
      }

      <article class="workshop workshop--tailored" id={TAILORED_WORKSHOP.id}>
        <div class="workshop__body">
          <p class="workshop__tag">{TAILORED_WORKSHOP.tag}</p>
          <h3 class="workshop__title">{TAILORED_WORKSHOP.title}</h3>
          <p class="workshop__description">{pitches.tailored}</p>
        </div>
        <div class="workshop__body workshop__body--second">
          <details class="workshop__more">
            <summary>How it works</summary>
            <ul class="workshop__bullets">
              {TAILORED_WORKSHOP.bullets.map((point) => <li>{point}</li>)}
            </ul>
            <p class="workshop__outcome">
              <span class="workshop__outcome-label">You leave with</span>
              {TAILORED_WORKSHOP.outcome}
            </p>
          </details>
          <a
            class="workshop__cta"
            href="#contactForm"
            data-subject={subject}
            data-message="I am interested in a workshop built around my team. Here is what is slowing us down:"
          >
            Plan a tailored workshop
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .catalog {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  /* Dark ground: the cards stay light, like the client quotes on dark,
     and the tailored card, dark itself, becomes a glass card. */
  .catalog--dark {
    background: var(--c-dark);
    color: var(--c-light);
  }

  .catalog--dark .catalog__intro {
    color: color-mix(in srgb, var(--c-light) 72%, transparent);
  }

  .catalog--dark .workshop {
    color: var(--color-ink);
    border-color: transparent;
    box-shadow: 0 24px 50px color-mix(in srgb, var(--c-dark) 40%, transparent);
  }

  .catalog--dark .workshop--tailored {
    color: var(--color-ink-light);
    background: color-mix(in srgb, var(--c-light) 5%, transparent);
    border-color: color-mix(in srgb, var(--c-light) 14%, transparent);
    box-shadow: none;
  }

  .catalog__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4rem);
  }

  .catalog__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    max-width: 64ch;
  }

  .catalog__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .catalog__intro {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .catalog__list {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .workshop {
    scroll-margin-top: calc(56px + 2rem);
    display: grid;
    grid-template-columns: 1fr;
    background: var(--color-light-raised);
    border: 1px solid var(--color-stroke);
    border-radius: 22px;
    overflow: hidden;
    box-shadow: 0 24px 50px color-mix(in srgb, var(--c-dark) 8%, transparent);
  }

  .workshop__media {
    position: relative;
    min-height: 220px;
    background: var(--color-light-alt);
  }

  .workshop__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .workshop__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }

  .workshop__tag {
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-bold);
    letter-spacing: 0.08em;
    font-size: var(--font-sm);
  }

  .workshop__title {
    font-size: clamp(1.6rem, 2.8vw, 2.1rem);
    line-height: 1.13;
  }

  .workshop__description {
    color: var(--color-ink-muted);
    font-size: 1.1rem;
    line-height: 1.5;
    font-family: synonym, sans-serif;
  }

  /* What it covers, on request. The panel slides open where the browser
     can animate to a content height, and simply opens where it cannot. */
  .workshop__more {
    interpolate-size: allow-keywords;
    margin-top: 0.4rem;
  }

  .workshop__more summary {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    cursor: pointer;
    font-weight: var(--font-weight-semi-bold);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .workshop__more summary::-webkit-details-marker {
    display: none;
  }

  .workshop__more summary::after {
    content: "+";
    font-size: 1.25em;
    line-height: 1;
    font-weight: var(--font-weight-medium);
    transition: rotate 0.25s ease;
  }

  .workshop__more[open] summary::after {
    rotate: 45deg;
  }

  .workshop__more summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }

  .workshop__more::details-content {
    height: 0;
    overflow: clip;
    transition:
      height 0.4s cubic-bezier(0.22, 0.61, 0.36, 1),
      content-visibility 0.4s allow-discrete;
  }

  .workshop__more[open]::details-content {
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .workshop__more::details-content,
    .workshop__more summary::after {
      transition: none;
    }
  }

  .workshop__bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin: 1rem 0 0.4rem;
  }

  .workshop__bullets li {
    display: flex;
    gap: 0.5em;
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
    font-family: synonym, sans-serif;
    line-height: 1.45;
  }

  .workshop__bullets li::before {
    content: "→";
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-bold);
    flex-shrink: 0;
  }

  .workshop__outcome {
    font-family: synonym, sans-serif;
    line-height: 1.55;
    color: var(--color-ink);
    padding: 0.9rem 1.1rem;
    border-radius: 12px;
    background: color-mix(in srgb, var(--c-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--c-accent) 30%, transparent);
    margin-top: 0.5rem;
  }

  .workshop__outcome-label {
    font-family: chillax, sans-serif;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
    margin-right: 0.35rem;
  }

  .workshop__cta {
    align-self: flex-start;
    margin-top: 1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-on-accent);
    background-color: var(--color-accent);
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .workshop__cta:hover {
    background-color: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: 0 0 0 4px var(--color-accent-glow);
  }

  .workshop__cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* The tailored workshop has no photo: two text columns on the dark
     panel gradient, so it reads as the open-ended option after the fixed
     four. */
  .workshop--tailored {
    background: var(--color-dark);
    color: var(--color-ink-light);
    border-color: transparent;
    box-shadow: 0 30px 60px color-mix(in srgb, var(--c-dark) 22%, transparent);
  }

  .workshop--tailored .workshop__tag {
    color: var(--color-highlight-on-dark);
  }

  .workshop--tailored .workshop__title {
    color: var(--color-light-raised);
  }

  .workshop--tailored .workshop__description {
    color: color-mix(in srgb, var(--c-light) 75%, transparent);
  }

  .workshop--tailored .workshop__bullets li {
    color: var(--color-ink-light);
  }

  .workshop--tailored .workshop__bullets li::before {
    color: var(--color-accent);
  }

  .workshop--tailored .workshop__outcome-label {
    color: var(--color-ink-light);
  }

  .workshop--tailored .workshop__outcome {
    color: var(--color-ink-light);
    background: color-mix(in srgb, var(--c-accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--c-accent) 40%, transparent);
  }

  .workshop--tailored .workshop__cta {
    color: var(--color-on-accent);
    background-color: var(--color-accent);
  }

  .workshop--tailored .workshop__cta:hover {
    background-color: var(--color-light-raised);
    color: var(--color-accent-strong);
  }

  .workshop__body--second {
    padding-top: 0;
  }

  @media (min-width: 720px) {
    .workshop__cta {
      padding: 0.85rem 2rem;
      font-size: 1.05rem;
    }
  }

  @media (min-width: 900px) {
    .workshop {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .workshop--tailored {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }

    .workshop__body--second {
      padding-top: clamp(1.5rem, 3vw, 2.5rem);
    }

    /* Flipped cards keep the narrow column for the image, on the right. */
    .workshop--flip {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .workshop--flip .workshop__media {
      order: 2;
    }

    .workshop__media {
      min-height: 100%;
    }
  }
</style>
