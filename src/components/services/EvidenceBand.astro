---
/**
 * The market data the reader needs whether or not they ever hire us. Three
 * numbers with their sources, then one paragraph that translates them into
 * the reader's own situation. Light ground, editorial layout: heading on
 * the left, numbers on the right.
 */
import CountUp from "../CountUp.astro";

interface Stat {
  value: string;
  label: string;
  source: string;
}

interface Props {
  title: string;
  intro: string;
  stats: Stat[];
  /** What the numbers mean for the reader, in plain words. */
  meaning: string;
}

const { title, intro, stats, meaning } = Astro.props;
---

<section class="evidence" aria-labelledby="evidence-heading">
  <div class="evidence__inner">
    <div class="evidence__head">
      <h2 class="evidence__title" id="evidence-heading">{title}</h2>
      <p class="evidence__intro">{intro}</p>
    </div>

    <ol class="stats">
      {
        stats.map((stat) => (
          <li class="stat">
            <p class="stat__value"><CountUp value={stat.value} /></p>
            <p class="stat__label">{stat.label}</p>
            <p class="stat__source">{stat.source}</p>
          </li>
        ))
      }
    </ol>

    <p class="evidence__meaning">{meaning}</p>

    {
      Astro.slots.has("proof") && (
        <div class="evidence__proof">
          <slot name="proof" />
        </div>
      )
    }
  </div>
</section>

<style>
  .evidence {
    background: var(--color-light);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .evidence__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .evidence__head {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
  }

  .evidence__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .evidence__intro {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  /* Phones: number above its text. Wider: one shared value column for the
     whole list (subgrid), so every label starts on the same vertical line
     no matter how wide the number is. */
  .stats {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-stroke-strong);
  }

  .stat {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .stat__value {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent-ink);
    white-space: nowrap;
    margin-bottom: 0.5rem;
  }

  @media (min-width: 600px) {
    .stats {
      grid-template-columns: max-content 1fr;
    }

    .stat {
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
    }

    .stat__value {
      grid-row: 1 / 3;
      margin-bottom: 0;
    }

    @supports not (grid-template-columns: subgrid) {
      .stat {
        grid-template-columns: 13rem 1fr;
      }
    }
  }

  .evidence__proof:empty {
    display: none;
  }

  .stat__label {
    font-family: synonym, sans-serif;
    font-size: var(--font-lg);
    line-height: 1.4;
    color: var(--color-ink);
    max-width: 40ch;
  }

  .stat__source {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  .evidence__meaning {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.6;
    color: var(--color-ink);
    max-width: 62ch;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-accent);
  }

  @media (min-width: 900px) {
    .evidence__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      grid-template-rows: auto auto auto;
    }

    .evidence__head {
      position: sticky;
      top: calc(56px + 2rem);
      align-self: start;
    }

    .stats {
      grid-column: 2;
      grid-row: 1;
    }

    .evidence__meaning {
      grid-column: 2;
      grid-row: 2;
    }

    .evidence__proof {
      grid-column: 2;
      grid-row: 3;
      max-width: 40rem;
    }
  }
</style>
