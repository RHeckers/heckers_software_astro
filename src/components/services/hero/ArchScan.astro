---
/**
 * The picture behind the architecture assessment hero: a codebase being
 * read.
 *
 * It opens on a tangled project graph, boxes scattered and lines crossing.
 * A line of light then sweeps across it, the way a reader goes through
 * code. Every project it passes drops into its layer (apps, features,
 * domain, shared), and every circular dependency it crosses lights up in
 * the accent colour and is counted. When the sweep is done the graph is in
 * order with the violations standing out against it; they are then removed
 * one by one, the count runs back to zero, and work flows down the layers
 * in one direction. Then a new tangle is drawn.
 *
 * The count is the only text in the picture besides the layer names: it is
 * what an assessment finds, and what the roadmap removes.
 *
 * Projects near the pointer light up with their dependencies, hovering the
 * call to action speeds the reading up, and the picture drifts back as the
 * page scrolls on. On phones the graph takes the upper half of the screen
 * and the layer names are left out.
 *
 * Decoration only (aria-hidden). One canvas, redrawn per frame with a few
 * dozen strokes. Pauses off screen and in hidden tabs, and draws the
 * ordered graph as a still for visitors who prefer reduced motion.
 */
const TIERS = ["Apps", "Features", "Domain", "Shared"];
---

<div class="scan" data-arch-scan aria-hidden="true">
  <canvas class="scan__canvas"></canvas>
  {TIERS.map((tier) => <span class="scan__tier">{tier}</span>)}
  <span class="scan__count"></span>
</div>

<script>
  type RGB = [number, number, number];

  interface Node {
    tier: number;
    /** Tangled position. */
    mx: number;
    my: number;
    /** Ordered position. */
    tx: number;
    ty: number;
    x: number;
    y: number;
    w: number;
    seed: number;
    hitAt: number;
  }

  interface Edge {
    a: Node;
    b: Node;
    cycle: boolean;
    foundAt: number;
    /** Order in which a circular dependency is removed. */
    order: number;
    phase: number;
  }

  const root = document.querySelector<HTMLElement>("[data-arch-scan]");
  const hero = root?.closest<HTMLElement>("section");
  const canvas = root?.querySelector<HTMLCanvasElement>("canvas");
  const ctx = canvas?.getContext("2d");

  if (root && hero && canvas && ctx) {
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const tierLabels = Array.from(root.querySelectorAll<HTMLElement>(".scan__tier"));
    const countLabel = root.querySelector<HTMLElement>(".scan__count");
    const cta = hero.querySelector<HTMLElement>("[data-hero-cta]");

    const hex = (name: string, fallback: string): RGB => {
      const v =
        getComputedStyle(document.documentElement).getPropertyValue(name).trim() ||
        fallback;
      const m = /^#?([0-9a-f]{6})$/i.exec(v);
      const n = parseInt(m ? m[1] : fallback.slice(1), 16);
      return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
    };
    const rgba = (c: RGB, a: number) => `rgba(${c[0]}, ${c[1]}, ${c[2]}, ${a})`;
    const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
    const ease = (v: number) => {
      const t = clamp01(v);
      return t * t * (3 - 2 * t);
    };

    const DARK = hex("--c-dark", "#16233a");
    const LIGHT = hex("--c-light", "#f2eee6");
    const ACCENT = hex("--c-accent", "#ffbf2e");

    /* Timing of one cycle, in seconds. */
    const IDLE = 1.1;
    const SWEEP = 3.6;
    const SETTLE = 0.9;
    const FIX_START = IDLE + SWEEP + 0.7;
    const FIX_STEP = 0.4;
    const HOLD = 3.6;
    const FADE = 0.9;

    let w = 0;
    let h = 0;
    let narrow = false;
    /* The part of the hero the graph lives in. */
    let box = { x0: 0, x1: 0, y0: 0, y1: 0 };
    let nodes: Node[] = [];
    let edges: Edge[] = [];
    let cycles = 0;
    let fixEnd = 0;
    let cycleLength = 0;
    let nodeH = 18;
    let shownCount = "";

    const setCount = (text: string, lit: boolean) => {
      if (!countLabel) return;
      if (text !== shownCount) {
        shownCount = text;
        countLabel.textContent = text;
      }
      countLabel.classList.toggle("is-lit", lit);
    };

    /* A new workspace: the same layers, a new tangle, new violations. */
    const plan = () => {
      const perTier = narrow ? [2, 3, 3, 3] : [3, 5, 5, 4];
      const tiers = perTier.length;
      nodeH = narrow ? 14 : 18;
      nodes = [];
      const bw = box.x1 - box.x0;
      const bh = box.y1 - box.y0;

      perTier.forEach((count, tier) => {
        const ty = box.y0 + (bh * (tier + 0.5)) / tiers;
        for (let i = 0; i < count; i++) {
          const nw = (narrow ? 34 : 52) + Math.random() * (narrow ? 14 : 26);
          /* A scattered spot that is not on top of an earlier one. */
          let mx = 0;
          let my = 0;
          for (let attempt = 0; attempt < 30; attempt++) {
            mx = box.x0 + Math.random() * bw;
            my = box.y0 + Math.random() * bh;
            const clear = nodes.every(
              (o) => Math.abs(o.mx - mx) > nw * 1.1 || Math.abs(o.my - my) > nodeH * 2.2,
            );
            if (clear) break;
          }
          nodes.push({
            tier,
            mx,
            my,
            tx: box.x0 + (bw * (i + 0.5)) / count,
            ty,
            x: mx,
            y: my,
            w: nw,
            seed: Math.random() * Math.PI * 2,
            hitAt: -1,
          });
        }
      });

      const tierNodes = (t: number) => nodes.filter((n) => n.tier === t);
      edges = [];
      const link = (a: Node, b: Node, cycle: boolean) => {
        if (edges.some((e) => e.a === a && e.b === b)) return;
        edges.push({ a, b, cycle, foundAt: -1, order: 0, phase: Math.random() });
      };

      /* Dependencies point down a layer: each project to the one or two
         below it that sit nearest. */
      for (let t = 0; t < tiers - 1; t++) {
        const upper = tierNodes(t);
        const lower = tierNodes(t + 1);
        upper.forEach((a) => {
          const near = [...lower].sort(
            (p, q) => Math.abs(p.tx - a.tx) - Math.abs(q.tx - a.tx),
          );
          link(a, near[0], false);
          if (near[1] && Math.random() < 0.7) link(a, near[1], false);
        });
        /* Nothing in the lower layer is left unused. */
        lower.forEach((b) => {
          if (edges.some((e) => e.b === b)) return;
          const near = [...upper].sort(
            (p, q) => Math.abs(p.tx - b.tx) - Math.abs(q.tx - b.tx),
          );
          link(near[0], b, false);
        });
      }

      /* The violations: a lower layer reaching back up. */
      const wanted = narrow ? 4 : 6;
      for (let attempt = 0; attempt < 60 && edges.filter((e) => e.cycle).length < wanted; attempt++) {
        const from = nodes[Math.floor(Math.random() * nodes.length)];
        const to = nodes[Math.floor(Math.random() * nodes.length)];
        if (from.tier <= to.tier) continue;
        if (edges.some((e) => e.cycle && (e.a === from || e.b === to))) continue;
        if (edges.some((e) => e.a === to && e.b === from)) continue;
        link(from, to, true);
      }
      const found = edges.filter((e) => e.cycle);
      /* Removed in the order the sweep found them. */
      found
        .sort((p, q) => (p.a.mx + p.b.mx) / 2 - (q.a.mx + q.b.mx) / 2)
        .forEach((e, i) => (e.order = i));
      cycles = found.length;
      fixEnd = FIX_START + cycles * FIX_STEP + 0.5;
      cycleLength = fixEnd + HOLD + FADE;
    };

    const setup = () => {
      const rect = hero.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      narrow = w < 760;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      box = narrow
        ? { x0: w * 0.1, x1: w * 0.9, y0: h * 0.12, y1: h * 0.43 }
        : { x0: w * 0.6, x1: w * 0.95, y0: h * 0.2, y1: h * 0.78 };

      const tiers = tierLabels.length;
      tierLabels.forEach((label, i) => {
        label.style.left = box.x0 - (narrow ? 0 : 36) + "px";
        label.style.top = box.y0 + ((box.y1 - box.y0) * (i + 0.5)) / tiers + "px";
      });
      if (countLabel) {
        countLabel.style.left = (box.x0 + box.x1) / 2 + "px";
        countLabel.style.top = box.y1 + (narrow ? 14 : 34) + "px";
      }
      plan();
    };

    const curve = (e: Edge) => {
      const dy = (e.b.y - e.a.y) * 0.5;
      ctx.moveTo(e.a.x, e.a.y);
      ctx.bezierCurveTo(e.a.x, e.a.y + dy, e.b.x, e.b.y - dy, e.b.x, e.b.y);
    };
    const along = (e: Edge, t: number): [number, number] => {
      const dy = (e.b.y - e.a.y) * 0.5;
      const u = 1 - t;
      const k0 = u * u * u;
      const k1 = 3 * u * u * t;
      const k2 = 3 * u * t * t;
      const k3 = t * t * t;
      return [
        k0 * e.a.x + k1 * e.a.x + k2 * e.b.x + k3 * e.b.x,
        k0 * e.a.y + k1 * (e.a.y + dy) + k2 * (e.b.y - dy) + k3 * e.b.y,
      ];
    };
    const box2 = (x: number, y: number, bw: number, bh: number, r: number) => {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.arcTo(x + bw, y, x + bw, y + bh, r);
      ctx.arcTo(x + bw, y + bh, x, y + bh, r);
      ctx.arcTo(x, y + bh, x, y, r);
      ctx.arcTo(x, y, x + bw, y, r);
      ctx.closePath();
    };

    const pointer = { x: 0, y: 0, on: false };
    let tiersLit = false;

    /* Draw the picture at time t (seconds into the cycle). */
    const draw = (t: number, gain: number) => {
      ctx.clearRect(0, 0, w, h);
      const out = t > fixEnd + HOLD ? Math.max(0, 1 - (t - fixEnd - HOLD) / FADE) : 1;
      const alpha = gain * out;
      const sweep = clamp01((t - IDLE) / SWEEP);
      const pad = narrow ? 30 : 60;
      const sx = box.x0 - pad + (box.x1 - box.x0 + pad * 2) * sweep;
      const sweeping = t > IDLE && sweep < 1;
      const ordered = clamp01((t - FIX_START) / 0.6);

      /* Where every project is now. */
      let hover: Node | null = null;
      for (const n of nodes) {
        if (n.hitAt < 0 && t > IDLE && sx >= n.mx) n.hitAt = t;
        const p = n.hitAt < 0 ? 0 : ease((t - n.hitAt) / SETTLE);
        const loose = 1 - p;
        n.x = n.mx + (n.tx - n.mx) * p + Math.sin(t * 0.7 + n.seed) * 5 * loose;
        n.y = n.my + (n.ty - n.my) * p + Math.cos(t * 0.6 + n.seed * 1.7) * 4 * loose;
        if (
          pointer.on &&
          Math.abs(pointer.x - n.x) < n.w / 2 + 14 &&
          Math.abs(pointer.y - n.y) < nodeH / 2 + 14
        ) {
          hover = n;
        }
      }

      ctx.lineCap = "round";

      /* Dependencies. */
      let found = 0;
      let left = 0;
      for (const e of edges) {
        const lit = hover !== null && (e.a === hover || e.b === hover);
        if (!e.cycle) {
          ctx.beginPath();
          curve(e);
          ctx.lineWidth = lit ? 1.6 : 1;
          ctx.strokeStyle = lit
            ? rgba(ACCENT, 0.9 * alpha)
            : rgba(LIGHT, (0.16 + 0.14 * ordered) * alpha);
          ctx.stroke();
          continue;
        }
        const mid = (e.a.mx + e.b.mx) / 2;
        if (e.foundAt < 0 && t > IDLE && sx >= mid) e.foundAt = t;
        const removeAt = FIX_START + e.order * FIX_STEP;
        const gone = clamp01((t - removeAt) / 0.45);
        if (e.foundAt >= 0) found++;
        if (e.foundAt >= 0 && gone < 0.5) left++;
        if (gone >= 1) continue;
        ctx.beginPath();
        curve(e);
        if (e.foundAt < 0) {
          ctx.lineWidth = 1;
          ctx.strokeStyle = rgba(LIGHT, 0.16 * alpha);
          ctx.stroke();
        } else {
          const flash = 1 - clamp01((t - e.foundAt) / 0.7);
          ctx.setLineDash([5, 5]);
          ctx.lineWidth = 1.6 + flash * 1.4;
          ctx.strokeStyle = rgba(ACCENT, (0.75 + 0.25 * flash) * (1 - gone) * alpha);
          ctx.stroke();
          ctx.setLineDash([]);
          /* A ring where it was found, and again where it is removed. */
          const m = along(e, 0.5);
          const ring = flash > 0 ? 1 - flash : gone > 0 ? gone : -1;
          if (ring >= 0) {
            ctx.beginPath();
            ctx.arc(m[0], m[1], 5 + ring * 18, 0, Math.PI * 2);
            ctx.lineWidth = 1.2;
            ctx.strokeStyle = rgba(ACCENT, 0.7 * (1 - ring) * alpha);
            ctx.stroke();
          }
        }
      }

      /* In order: work flows down the layers, one direction only. */
      const flow = clamp01((t - fixEnd + 0.4) / 0.8);
      if (flow > 0) {
        ctx.fillStyle = rgba(ACCENT, 0.95 * alpha * flow);
        for (const e of edges) {
          if (e.cycle) continue;
          const at = (t * 0.45 + e.phase) % 1;
          const p = along(e, at);
          ctx.beginPath();
          ctx.arc(p[0], p[1], 2, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      /* Projects. */
      for (const n of nodes) {
        const p = n.hitAt < 0 ? 0 : clamp01((t - n.hitAt) / SETTLE);
        const flash = n.hitAt < 0 ? 0 : 1 - clamp01((t - n.hitAt) / 0.6);
        const lit = n === hover;
        box2(n.x - n.w / 2, n.y - nodeH / 2, n.w, nodeH, 5);
        ctx.fillStyle = rgba(DARK, 1);
        ctx.fill();
        ctx.fillStyle = rgba(LIGHT, (0.04 + 0.05 * p) * alpha);
        ctx.fill();
        ctx.lineWidth = lit ? 1.8 : 1.2;
        ctx.strokeStyle =
          lit || flash > 0.05
            ? rgba(ACCENT, Math.max(lit ? 1 : 0, flash) * alpha)
            : rgba(LIGHT, (0.34 + 0.3 * p) * alpha);
        ctx.stroke();
        if (flash > 0.05 && !lit) {
          ctx.strokeStyle = rgba(LIGHT, (0.34 + 0.3 * p) * (1 - flash) * alpha);
          ctx.stroke();
        }
        /* A short bar inside, like a name. */
        ctx.fillStyle = rgba(LIGHT, (0.22 + 0.3 * p) * alpha);
        ctx.fillRect(n.x - n.w / 2 + 7, n.y - 1, Math.max(8, n.w * 0.45), 2);
      }

      /* The reading line. */
      if (sweeping) {
        const top = box.y0 - (narrow ? 26 : 50);
        const bottom = box.y1 + (narrow ? 26 : 50);
        const trail = ctx.createLinearGradient(sx - (narrow ? 60 : 110), 0, sx, 0);
        trail.addColorStop(0, rgba(ACCENT, 0));
        trail.addColorStop(1, rgba(ACCENT, 0.13 * alpha));
        ctx.fillStyle = trail;
        ctx.fillRect(sx - (narrow ? 60 : 110), top, narrow ? 60 : 110, bottom - top);
        const line = ctx.createLinearGradient(0, top, 0, bottom);
        line.addColorStop(0, rgba(ACCENT, 0));
        line.addColorStop(0.15, rgba(ACCENT, 0.9 * alpha));
        line.addColorStop(0.85, rgba(ACCENT, 0.9 * alpha));
        line.addColorStop(1, rgba(ACCENT, 0));
        ctx.fillStyle = line;
        ctx.fillRect(sx - 0.75, top, 1.5, bottom - top);
      }

      /* The text. */
      const lit = ordered >= 1 && out >= 1;
      if (lit !== tiersLit) {
        tiersLit = lit;
        tierLabels.forEach((label) => label.classList.toggle("is-lit", lit));
      }
      if (out < 1 || t < IDLE) setCount("Reading your codebase", false);
      else if (found === 0) setCount("Reading your codebase", true);
      else {
        const n = t >= FIX_START ? left : found;
        setCount(`${n} circular ${n === 1 ? "dependency" : "dependencies"}`, true);
      }
    };

    setup();

    if (reduced) {
      draw(fixEnd + 1, 1);
    } else {
      let raf = 0;
      let last = 0;
      let visible = true;
      let time = 0;
      let intro = 0;
      let boost = 0;
      let boostTarget = 0;
      let scroll = 0;
      let scrollTarget = 0;

      const loop = (now: number) => {
        const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
        last = now;
        boost += (boostTarget - boost) * Math.min(1, dt * 4);
        intro = Math.min(1, intro + dt * 1.2);
        time += dt * (1 + boost * 1.6);
        if (time >= cycleLength) {
          time = 0;
          plan();
        }
        const before = scroll;
        scroll += (scrollTarget - scroll) * Math.min(1, dt * 7);
        if (Math.abs(scroll - before) > 0.0005) {
          root.style.setProperty("--drift", (scroll * h * 0.14).toFixed(1) + "px");
        }
        draw(time, intro);
        raf = requestAnimationFrame(loop);
      };
      const play = () => {
        if (!raf && visible && !document.hidden) {
          last = 0;
          raf = requestAnimationFrame(loop);
        }
      };
      const pause = () => {
        cancelAnimationFrame(raf);
        raf = 0;
      };

      new IntersectionObserver((entries) => {
        visible = entries[0].isIntersecting;
        visible ? play() : pause();
      }).observe(hero);
      document.addEventListener("visibilitychange", () =>
        document.hidden ? pause() : play(),
      );

      hero.addEventListener("pointermove", (e) => {
        if (e.pointerType === "touch") return;
        const rect = hero.getBoundingClientRect();
        pointer.x = e.clientX - rect.left;
        pointer.y = e.clientY - rect.top;
        pointer.on = true;
      });
      hero.addEventListener("pointerleave", () => (pointer.on = false));
      window.addEventListener(
        "scroll",
        () => (scrollTarget = Math.min(1, Math.max(0, window.scrollY / (h * 0.85)))),
        { passive: true },
      );

      const surge = (on: boolean) => () => (boostTarget = on ? 1 : 0);
      cta?.addEventListener("pointerenter", surge(true));
      cta?.addEventListener("pointerleave", surge(false));
      cta?.addEventListener("focus", surge(true));
      cta?.addEventListener("blur", surge(false));

      play();
    }

    let resizeTimer = 0;
    let lastWidth = w;
    window.addEventListener("resize", () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        /* Phone address bars resize the height constantly; only a real
           change of width is worth starting the picture over for. */
        const width = hero.getBoundingClientRect().width;
        if (Math.abs(width - lastWidth) < 2) return;
        lastWidth = width;
        setup();
        if (reduced) draw(fixEnd + 1, 1);
      }, 200);
    });
  }
</script>

<style>
  .scan {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transform: translate3d(0, var(--drift, 0px), 0);
  }

  .scan__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scan__tier,
  .scan__count {
    position: absolute;
    font-family: synonym, sans-serif;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    white-space: nowrap;
    transition:
      color 0.6s ease,
      opacity 0.6s ease;
  }

  /* The layer names appear once the graph is in order. */
  .scan__tier {
    transform: translate(-100%, -50%);
    color: var(--c-accent);
    opacity: 0;
  }

  .scan__tier:global(.is-lit) {
    opacity: 0.85;
  }

  .scan__count {
    transform: translate(-50%, 0);
    color: color-mix(in srgb, var(--c-light) 42%, transparent);
  }

  .scan__count:global(.is-lit) {
    color: var(--c-accent);
  }

  @media (max-width: 759px) {
    .scan__tier {
      display: none;
    }

    .scan__count {
      font-size: 0.625rem;
      letter-spacing: 0.16em;
    }
  }
</style>
