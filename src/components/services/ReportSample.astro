---
/**
 * One finding, shown the way it appears in the assessment report: the
 * impact, the evidence, the fix and the effort. The page sells a document,
 * so the reader gets to see a page of it. Light ground, the finding set on
 * a white "sheet" next to the argument for why it is written this way.
 */
interface Finding {
  /** Position in the report, e.g. "Finding 1 of 23". */
  rank: string;
  title: string;
  impact: string;
  evidence: string[];
  fix: string;
  effort: string;
}

interface Props {
  id?: string;
  title: string;
  intro: string;
  /** What every finding in the report has, one line each. */
  points: string[];
  finding: Finding;
  /** Where the example comes from, shown under the sheet. */
  note: string;
}

const { id = "report", title, intro, points, finding, note } = Astro.props;
---

<section class="sample" id={id} aria-labelledby={`${id}-heading`}>
  <div class="sample__inner">
    <div class="sample__copy">
      <h2 class="sample__title" id={`${id}-heading`}>{title}</h2>
      <p class="sample__intro">{intro}</p>
      <ul class="sample__points">
        {points.map((point) => <li class="sample__point">{point}</li>)}
      </ul>
    </div>

    <article class="sheet" aria-label="Example finding from a report">
      <header class="sheet__head">
        <p class="sheet__rank">{finding.rank}</p>
        <p class="sheet__severity">High impact</p>
      </header>
      <h3 class="sheet__title">{finding.title}</h3>

      <dl class="sheet__fields">
        <div class="sheet__field">
          <dt>Impact</dt>
          <dd>{finding.impact}</dd>
        </div>
        <div class="sheet__field">
          <dt>Evidence</dt>
          <dd>
            <ul class="sheet__evidence">
              {finding.evidence.map((item) => <li>{item}</li>)}
            </ul>
          </dd>
        </div>
        <div class="sheet__field">
          <dt>Fix</dt>
          <dd>{finding.fix}</dd>
        </div>
        <div class="sheet__field">
          <dt>Effort</dt>
          <dd>{finding.effort}</dd>
        </div>
      </dl>
      <p class="sheet__note">{note}</p>
    </article>
  </div>
</section>

<style>
  .sample {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .sample__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .sample__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
  }

  .sample__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
    max-width: 14ch;
  }

  .sample__intro {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .sample__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-stroke);
    max-width: 48ch;
  }

  .sample__point {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    padding: 0.85rem 0 0.85rem 1.75rem;
    border-bottom: 1px solid var(--color-stroke);
    position: relative;
  }

  .sample__point::before {
    content: "";
    position: absolute;
    left: 0.25rem;
    top: 1.35rem;
    width: 0.75rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 2px;
  }

  /* --- The sheet --- */

  .sheet {
    background: var(--color-light-raised);
    border: 1px solid var(--color-stroke);
    border-radius: 6px;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow:
      0 1px 0 rgba(11, 18, 32, 0.04),
      0 24px 48px rgba(11, 18, 32, 0.1);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    font-family: synonym, sans-serif;
  }

  .sheet__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  .sheet__severity {
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-danger);
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 100px;
    font-size: var(--font-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sheet__title {
    font-family: chillax, sans-serif;
    font-size: clamp(1.4rem, 2.4vw, 1.9rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.15;
    padding-bottom: 1rem;
    border-bottom: 2px solid var(--color-ink);
  }

  .sheet__fields {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .sheet__field {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-stroke);
  }

  .sheet__field:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .sheet__field dt {
    font-family: chillax, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-semi-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-ink);
    padding-top: 0.15rem;
  }

  .sheet__field dd {
    line-height: 1.55;
    color: var(--color-ink);
  }

  .sheet__evidence {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .sheet__evidence li {
    padding-left: 1rem;
    position: relative;
  }

  .sheet__evidence li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-stroke-strong);
  }

  .sheet__note {
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-stroke);
  }

  @media (min-width: 900px) {
    .sample__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .sheet {
      /* A sheet of paper, slightly turned, so it reads as a document and
         not as another card. */
      transform: rotate(-0.6deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet {
      transform: none;
    }
  }
</style>
