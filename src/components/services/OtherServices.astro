---
/**
 * The two services this page is not about, so a reader who came for the
 * wrong one has somewhere to go.
 */
import { otherServices, type ServiceSlug } from "../../lib/services";

interface Props {
  current: ServiceSlug;
}

const { current } = Astro.props;
const others = otherServices(current);
---

<section class="others" aria-labelledby="others-heading">
  <div class="others__inner">
    <h2 class="others__title" id="others-heading">Also from Heckers Software</h2>
    <ul class="others__list">
      {
        others.map((service) => (
          <li class="other">
            <a class="other__link" href={service.href}>
              <span class="other__name">{service.name}</span>
              <span class="other__summary">{service.summary}</span>
              <span class="other__cta">Read more</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .others {
    background: var(--color-light);
    color: var(--color-ink);
    padding: 0 clamp(1.25rem, 6vw, 5rem) clamp(4rem, 10vw, 7.5rem);
  }

  .others__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding-top: clamp(2.5rem, 6vw, 4rem);
    border-top: 1px solid var(--color-stroke-strong);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
  }

  .others__title {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-medium);
  }

  .others__list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-lg);
  }

  .other__link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    height: 100%;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    background: var(--color-light-raised);
    border: 1px solid var(--color-stroke);
    border-radius: 15px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .other__link:hover,
  .other__link:focus-visible {
    border-color: var(--color-accent);
    box-shadow: 0 16px 40px rgba(11, 18, 32, 0.1);
  }

  .other__link:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 2px;
  }

  .other__name {
    font-size: 1.35rem;
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.15;
  }

  .other__summary {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .other__cta {
    margin-top: auto;
    padding-top: 0.4rem;
    font-family: synonym, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  @media (min-width: 720px) {
    .others__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
