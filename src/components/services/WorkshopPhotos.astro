---
/**
 * The hero aside of the workshops page: three photographs from real rooms,
 * stacked like prints on a table, instead of a number in a glass card. A
 * training page should show people in a room before it shows statistics.
 */
import { Image } from "astro:assets";
import stage from "../../assets/workshop/ng-poland-2024.jpg";
import zurich from "../../assets/workshop/angular-zurich.png";
import talk from "../../assets/workshop/talk_2.png";
---

<figure class="photos" aria-label="Workshops and talks given by Heckers Software">
  <div class="photos__stack">
    <Image
      src={stage}
      alt="Roberto Heckers on stage at ngPoland"
      width={900}
      loading="eager"
      class="photos__item photos__item--main"
    />
    <Image
      src={zurich}
      alt="Workshop at Angular Zurich"
      width={600}
      loading="lazy"
      class="photos__item photos__item--second"
    />
    <Image
      src={talk}
      alt="A hands-on workshop session"
      width={600}
      loading="lazy"
      class="photos__item photos__item--third"
    />
  </div>
  <figcaption class="photos__caption">
    Conference rooms and company rooms: ngPoland, Angular Zurich, and
    enterprise teams on their own code.
  </figcaption>
</figure>

<style>
  .photos {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .photos__stack {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(6, 1fr);
    aspect-ratio: 5 / 4;
    width: 100%;
  }

  .photos__item {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
    border: 3px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 24px 48px rgba(5, 10, 20, 0.45);
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .photos__item--main {
    grid-column: 1 / 5;
    grid-row: 1 / 5;
    transform: rotate(-2deg);
    z-index: 1;
  }

  .photos__item--second {
    grid-column: 3 / 7;
    grid-row: 3 / 7;
    transform: rotate(2.5deg);
    z-index: 2;
  }

  .photos__item--third {
    grid-column: 1 / 4;
    grid-row: 4 / 7;
    transform: rotate(-4deg) translateY(4%);
    z-index: 3;
  }

  .photos__stack:hover .photos__item--main {
    transform: rotate(-1deg) translateY(-2%);
  }

  .photos__stack:hover .photos__item--second {
    transform: rotate(1.5deg) translateY(-2%);
  }

  .photos__stack:hover .photos__item--third {
    transform: rotate(-3deg) translateY(2%);
  }

  .photos__caption {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    line-height: 1.45;
    color: rgba(232, 237, 246, 0.6);
    max-width: 36ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .photos__item {
      transition: none;
    }
  }
</style>
