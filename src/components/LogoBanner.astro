---
/**
 * The client logos, as one calm row at the foot of the dark "We come in
 * and deliver" band: a short title and the seven logos in one light
 * tone, spread across the page column. They stand under the stage
 * photograph, so the band reads as one block of proof: this is who does
 * the work, and these are the companies it was done for.
 *
 * No panel and no frame: the logos stand directly on the band, all in
 * one soft white. Seven brands in seven colours do not sit well on dark
 * blue, so the row uses the on-dark versions in assets/logos/on-dark: each
 * logo as a single light shape, with its white details cut out so they
 * stay readable. Those files are generated; see
 * scripts/make-on-dark-logos.mjs.
 *
 * Not a section of its own and not a moving strip. The logos fade up one
 * after the other as the row scrolls in (scroll-driven CSS; simply shown
 * where unsupported or when motion is reduced).
 */
import { Image } from "astro:assets";
import vattenfall from "../assets/logos/on-dark/vattenfall_logo.png";
import marel from "../assets/logos/on-dark/marel_logo.png";
import wgka from "../assets/logos/on-dark/wgk-antwerpen.png";
import spacewell from "../assets/logos/on-dark/spacewell_logo.png";
import phitaal from "../assets/logos/on-dark/phitaal_logo.png";
import dh_automation from "../assets/logos/on-dark/dh_automation_logo.png";
import ministerie_van_defensie from "../assets/logos/on-dark/ministerie_van_defensie_logo.png";

const clients = [
  { src: vattenfall, name: "Vattenfall" },
  { src: marel, name: "Marel" },
  { src: spacewell, name: "Spacewell" },
  { src: ministerie_van_defensie, name: "Ministerie van Defensie" },
  { src: phitaal, name: "Phitaal" },
  { src: wgka, name: "Wit-Gele Kruis Antwerpen" },
  /* A round mark with two short lines of small type beside it: at the
     shared height the type is too small to read, so it gets more room. */
  // { src: dh_automation, name: "DH Automation", scale: 1.6 },
];
---

<div class="clients">
  <p class="clients__title" id="clients-title">
    We deliver for these companies and more
  </p>

  <ul class="clients__row" aria-labelledby="clients-title">
    {
      clients.map((client, index) => (
        <li
          class="client"
          style={`--i: ${index}; --scale: ${"scale" in client ? client.scale : 1}`}
        >
          <Image
            src={client.src}
            alt={client.name}
            width={170}
            densities={[1, 2]}
            loading="lazy"
          />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .clients {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .clients__title {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    line-height: 1.4;
    color: color-mix(in srgb, var(--c-light) 72%, transparent);
  }

  /* Phones: three to a line. */
  .clients__row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.25rem, 4vw, 2rem) clamp(1rem, 4vw, 2rem);
    align-items: center;
    view-timeline-name: --clients;
  }

  .client {
    display: flex;
    align-items: center;
  }

  /* Each logo keeps its own proportions and is fitted inside the same
     box, so the image is exactly as wide as the logo: a long wordmark is
     scaled down as a whole and carries no empty space beside it. */
  .client :global(img) {
    display: block;
    width: auto;
    height: auto;
    opacity: 0.9;
    max-height: calc(clamp(2rem, 3vw, 2.6rem) * var(--scale, 1));
    max-width: min(
      100%,
      calc(clamp(5.5rem, 10vw, 8.5rem) * var(--scale, 1))
    );
  }

  @supports (animation-timeline: view()) {
    .client {
      opacity: 0;
      transform: translateY(12px);
      animation: client-in cubic-bezier(0.22, 0.61, 0.36, 1) both;
      animation-timeline: --clients;
      animation-range: entry calc(20% + var(--i) * 12%) entry
        calc(110% + var(--i) * 12%);
    }
  }

  @keyframes client-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client {
      opacity: 1;
      transform: none;
    }
  }

  /* Wide screens: all seven on one line, spread across the panel. */
  @media (min-width: 900px) {
    .clients__row {
      display: flex;
      justify-content: space-between;
      gap: clamp(1.5rem, 3vw, 3rem);
    }

    .client {
      flex: 0 0 auto;
    }

    /* A fixed cap, not a percentage: with a percentage the list item is
       sized from the logo's full natural width and keeps that width after
       the image has been scaled down, which leaves a gap beside it. */
    .client :global(img) {
      max-width: calc(clamp(6rem, 11vw, 10rem) * var(--scale, 1));
    }
  }
</style>
