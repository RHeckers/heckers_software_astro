---
import { Image } from "astro:assets";
import vattenfall from "../assets/logos/vattenfall_logo.svg";
import marel from "../assets/logos/marel_logo.svg";
import wgka from "../assets/logos/wgk-antwerpen.svg";
import spacewell from "../assets/logos/spacewell_logo.svg";
import phitaal from "../assets/logos/phitaal_logo.svg";
import dh_automation from "../assets/logos/dh_automation_logo.svg";
import ministerie_van_defensie from "../assets/logos/ministerie_van_defensie_logo.png";
import lamp from "../assets//lamp.svg";

const logosBase = [
  {
    src: vattenfall,
    id: "Vattenfall",
  },
  {
    src: marel,
    id: "Marel",
  },
  {
    src: spacewell,
    id: "Spacewell",
  },
  {
    src: ministerie_van_defensie,
    id: "Ministerie van Defensie",
  },
  {
    src: phitaal,
    id: "Phitaal",
  },
  {
    src: wgka,
    id: "Wit-Gele Kruis Antwerpen",
  },
  {
    src: dh_automation,
    id: "DH Automation",
  },
];

const logos = [...logosBase, ...logosBase];

const isMobile = typeof window !== "undefined" ? window.innerWidth < 600 : true;
const lampHeight = isMobile ? 150 : 300;
const logoWidth = isMobile ? 100 : 135;
---

<section>
  <div class="lamp-frame">
    <Image
      src={lamp}
      width={lampHeight}
      height={lampHeight}
      alt="Logo spotlight"
      class="lamp-img"
    />
  </div>
  <div class="reel" aria-label="Trusted clients marquee moving left to right">
    <div class="overlay"></div>
    <div class="track">
      {
        logos.map((client, index) => (
          <div
            class="logo-container"
            data-index={index}
            aria-hidden={index >= logos.length ? "true" : undefined}
          >
            <Image
              src={client.src}
              alt={`Client Logo ${client.id}`}
              width={logoWidth}
              densities={[1, 2]}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
    <div class="overlay"></div>
  </div>
</section>

<style>
  section {
    max-width: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lamp-frame {
    height: 120px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .lamp-frame :global(img.lamp-img) {
    height: 120px;
    object-fit: cover;
    object-position: top center;
  }

  .reel {
    --marquee-duration: 90s;
    overflow: hidden;
    width: 100%;
    position: relative;
    margin-top: -75px;
  }

  .track {
    display: flex;
    gap: 0;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  .overlay {
    position: absolute;
    bottom: 0;
    left: -20px;
    height: 100px;
    width: calc(50% - 20px);
    transform: skewX(341deg);
    z-index: 2;
    background: #b0ceff80;
    opacity: 1;
    -webkit-backdrop-filter: grayscale(1);
    backdrop-filter: grayscale(1);

    &:last-of-type {
      right: -20px;
      left: auto;
      width: calc(50% - 17px);
      transform: skewX(20deg);
    }
  }

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 85px;
    width: 225px;
    flex: 0 0 auto;
  }

  @keyframes marquee {
    0% {
      transform: translateX(-50%);
    }

    100% {
      transform: translateX(0);
    }
  }

  @media (min-width: 650px) {
    .lamp-frame {
      height: 150px;
    }

    .lamp-frame :global(img.lamp-img) {
      height: 200px;
    }

    .overlay {
      width: calc(50% - 34px);

      &:last-of-type {
        width: calc(50% - 30px);
      }
    }
  }
</style>
