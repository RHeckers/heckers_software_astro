---
import { Image } from "astro:assets";
import vattenfall from "../assets/logos/vattenfall_logo.svg";
import marel from "../assets/logos/marel_logo.svg";
import wgka from "../assets/logos/wgk-antwerpen.svg";
import spacewell from "../assets/logos/spacewell_logo.png";
import phitaal from "../assets/logos/phitaal_logo.png";
import dh_automation from "../assets/logos/dh_automation_logo.svg";
import ministerie_van_defensie from "../assets/logos/ministerie_van_defensie_logo.png";
import lamp from "../assets/lamp.png";

const logosBase = [
  {
    src: vattenfall,
    id: "Vattenfall",
  },
  {
    src: marel,
    id: "Marel",
  },
  {
    src: spacewell,
    id: "Spacewell",
  },
  {
    src: ministerie_van_defensie,
    id: "Ministerie van Defensie",
  },
  {
    src: phitaal,
    id: "Phitaal",
  },
  {
    src: wgka,
    id: "Wit-Gele Kruis Antwerpen",
  },
  {
    src: dh_automation,
    id: "DH Automation",
  },
];

// Three copies so even very wide screens are filled from the first frame;
// the track shifts by exactly one copy per cycle for a seamless loop.
const logos = [...logosBase, ...logosBase, ...logosBase];

const isMobile = typeof window !== "undefined" ? window.innerWidth < 600 : true;
const lampHeight = isMobile ? 150 : 300;
const logoWidth = isMobile ? 100 : 135;
---

<section aria-label="Trusted clients">
  <div class="lamp-frame">
    <Image
      src={lamp}
      width={lampHeight}
      height={lampHeight}
      alt=""
      class="lamp-img"
    />
  </div>
  <div class="reel">
    <div class="track">
      {
        logos.map((client, index) => (
          <div
            class="logo-container"
            data-index={index}
            aria-hidden={index >= logosBase.length ? "true" : undefined}
          >
            <Image
              src={client.src}
              alt={`Client Logo ${client.id}`}
              width={logoWidth}
              densities={[1, 2]}
              loading="lazy"
            />
          </div>
        ))
      }
    </div>
    <div class="overlay overlay--mute overlay--left"></div>
    <div class="overlay overlay--mute overlay--right"></div>
    <div class="overlay overlay--desaturate overlay--left"></div>
    <div class="overlay overlay--desaturate overlay--right"></div>
  </div>
</section>

<style>
  section {
    max-width: 100%;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .lamp-frame {
    height: 120px;
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .lamp-frame :global(img.lamp-img) {
    height: 120px;
    object-fit: cover;
    object-position: top center;
  }

  .reel {
    --marquee-duration: 90s;
    overflow: hidden;
    width: 100%;
    position: relative;
    margin-top: -75px;
  }

  .track {
    display: flex;
    gap: 0;
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
    will-change: transform;
  }

  /*
    The lamp "lights" the logos: skewed panels cover the reel and leave a
    wedge under the lamp where the logos keep their colour. Each side is
    two opaque blend panels: `lighten` with a mid grey lifts the logos' dark
    ink to that grey (mutes them), then `saturation` with the page's light
    colour turns them grey. Both leave the light background exactly as it
    is, so the reel has no visible edge. (A backdrop-filter or translucent
    wash would tint the background itself and leave a band with a hard top
    edge, especially on phones.)

    The panels rely on blending against the hero's opaque background: the
    hero is `isolation: isolate` and nothing between it and the panels may
    form a stacking context (see .logo-banner-container in HeroSection).
  */
  .overlay {
    position: absolute;
    bottom: 0;
    height: 100px;
    z-index: 2;
    pointer-events: none;
  }

  .overlay--left {
    left: -20px;
    width: calc(50% - 20px);
    transform: skewX(341deg);
  }

  .overlay--right {
    right: -20px;
    width: calc(50% - 17px);
    transform: skewX(20deg);
  }

  .overlay--mute {
    background: #6e6e6e;
    mix-blend-mode: lighten;
  }

  .overlay--desaturate {
    background: var(--color-light);
    mix-blend-mode: saturation;
  }

  .logo-container {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 85px;
    width: 225px;
    flex: 0 0 auto;
  }

  @keyframes marquee {
    0% {
      transform: translateX(calc(-100% / 3));
    }

    100% {
      transform: translateX(0);
    }
  }

  @media (min-width: 650px) {
    .lamp-frame {
      height: 150px;
    }

    .lamp-frame :global(img.lamp-img) {
      height: 200px;
    }

    .overlay--left {
      width: calc(50% - 34px);
    }

    .overlay--right {
      width: calc(50% - 30px);
    }
  }
</style>
