---
import "../styles/global.scss";
import type { ImageMetadata } from "astro";
import FallbackImage from "../assets/logos/html_logo.png";
import { SITE_TITLE } from "../consts";

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  author: string;
  tags: readonly string[];
}

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  /** Open Graph type; posts pass "article". */
  type?: "website" | "article";
  /** Article-specific Open Graph metadata (only used when type is "article"). */
  article?: ArticleMeta;
  /** JSON-LD structured data, serialized into the head. */
  jsonLd?: Record<string, unknown>;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image = FallbackImage,
  type = "website",
  article,
  jsonLd,
} = Astro.props;

const UMAMI_WEBSITE_ID = "545aa7d1-96e0-4cc0-b51a-0cebb3e14c39";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Preload the fonts used above the fold (navbar and hero). Every other
     weight is discovered through the inlined CSS and swaps in afterwards. -->
<link
  rel="preload"
  href="/fonts/Chillax-Medium.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Light.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Semibold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Synonym-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Synonym-Medium.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
{
  type === "article" && article && (
    <Fragment>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      {article.modifiedTime && (
        <meta
          property="article:modified_time"
          content={article.modifiedTime.toISOString()}
        />
      )}
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </Fragment>
  )
}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- Structured data -->
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}

<!-- Analytics (Umami is cookieless; production builds only).
     Injected after the load event so the external script never sits on the
     critical path of the first paint. -->
{
  import.meta.env.PROD && (
    <script is:inline define:vars={{ UMAMI_WEBSITE_ID }}>
      window.addEventListener(
        "load",
        () => {
          const s = document.createElement("script");
          s.defer = true;
          s.src = "https://cloud.umami.is/script.js";
          s.dataset.websiteId = UMAMI_WEBSITE_ID;
          document.head.appendChild(s);
        },
        { once: true },
      );
    </script>
  )
}
