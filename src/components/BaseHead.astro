---
import "../styles/global.scss";
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "../consts";
import { ogCardPath } from "../lib/og-cards";

export interface ArticleMeta {
  publishedTime: Date;
  modifiedTime?: Date;
  author: string;
  tags: readonly string[];
}

interface Props {
  title: string;
  description: string;
  /**
   * Social preview image: an imported asset, or a site path such as the
   * generated card at /og/<page>.png. Defaults to the card for the page's
   * own path when one is generated, and to the logo otherwise.
   */
  image?: ImageMetadata | string;
  /** Open Graph type; posts pass "article". */
  type?: "website" | "article";
  /** Article-specific Open Graph metadata (only used when type is "article"). */
  article?: ArticleMeta;
  /** JSON-LD structured data, serialized into the head. */
  jsonLd?: Record<string, unknown>;
  /** Keep the page out of search results (the 404 page). */
  noindex?: boolean;
  /**
   * Trail from the homepage to this page, emitted as BreadcrumbList data.
   * The homepage is added automatically; the last item is this page.
   */
  breadcrumbs?: readonly Breadcrumb[];
}

export interface Breadcrumb {
  name: string;
  path: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
  title,
  description,
  image,
  type = "website",
  article,
  jsonLd,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const breadcrumbLd = breadcrumbs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [{ name: "Home", path: "/" }, ...breadcrumbs].map(
        (crumb, index) => ({
          "@type": "ListItem",
          position: index + 1,
          name: crumb.name,
          item: new URL(crumb.path, Astro.site).href,
        }),
      ),
    }
  : undefined;

// Pages without their own image get the generated 1200x630 card for their
// path (see src/pages/og/[...card].png.ts).
const isCard = typeof image !== "object";
const imageSrc =
  typeof image === "object"
    ? image.src
    : (image ?? ogCardPath(Astro.url.pathname));
const imageURL = new URL(imageSrc, Astro.site);

const UMAMI_WEBSITE_ID = "545aa7d1-96e0-4cc0-b51a-0cebb3e14c39";
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />

<!-- Preload the fonts used above the fold (navbar and hero). Every other
     weight is discovered through the inlined CSS and swaps in afterwards. -->
<link
  rel="preload"
  href="/fonts/Chillax-Medium.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Light.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Semibold.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Chillax-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Synonym-Regular.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link
  rel="preload"
  href="/fonts/Synonym-Medium.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL("rss.xml", Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, follow" />}

<!-- Open Graph / Facebook -->
<meta property="og:site_name" content="Heckers Software" />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
{
  isCard && (
    <Fragment>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </Fragment>
  )
}
<meta property="og:image:alt" content={title} />
{
  type === "article" && article && (
    <Fragment>
      <meta
        property="article:published_time"
        content={article.publishedTime.toISOString()}
      />
      {article.modifiedTime && (
        <meta
          property="article:modified_time"
          content={article.modifiedTime.toISOString()}
        />
      )}
      <meta property="article:author" content={article.author} />
      {article.tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </Fragment>
  )
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />
<meta name="twitter:image:alt" content={title} />

<!-- Structured data -->
{
  jsonLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  )
}
{
  breadcrumbLd && (
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbLd)}
    />
  )
}

<!-- Analytics (Umami is cookieless; production builds only).
     Injected after the load event so the external script never sits on the
     critical path of the first paint. -->
{
  import.meta.env.PROD && (
    <script is:inline define:vars={{ UMAMI_WEBSITE_ID }}>
      window.addEventListener(
        "load",
        () => {
          const s = document.createElement("script");
          s.defer = true;
          s.src = "https://cloud.umami.is/script.js";
          s.dataset.websiteId = UMAMI_WEBSITE_ID;
          document.head.appendChild(s);
        },
        { once: true },
      );
    </script>
  )
}
