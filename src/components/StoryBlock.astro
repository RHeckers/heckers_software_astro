  <div class="sticky-wrapper">
    <div class="story-block story-block-1">
      <p class="story-text">
        Angular bugs <Accent tone="danger" range="cover 20% cover 60%"
          >increasing</Accent
        >
      </p>
      <p class="story-text">
        Nx builds <Accent tone="danger" range="cover 20% cover 60%"
          >slowing down</Accent
        >
      </p>
      <p class="story-text">
        Architecture <span class="danger-3 falling-word"
          ><Accent tone="danger" range="cover 20% cover 60%">crumbling?</Accent
          ></span
        >
      </p>
    </div>
    <div class="sticky-spacer"></div>
  </div>
  <div class="sticky-wrapper sticky-wrapper-long">
    <div class="story-block story-block-2">
      <div class="stacked-text">
        <p class="small-text">
          With our <Accent
            range="cover 14% cover 34%"
            mobileRange="cover 2% cover 32%">Architecture assessment</Accent
          >
          <br />
          Angular and Nx <Accent
            range="cover 18% cover 38%"
            mobileRange="cover 6% cover 36%">experts</Accent
          >
          <br />
          Show you how to
          <br />
        </p>
        <p class="large-text">
          <Accent range="cover 20% cover 44%" mobileRange="cover 12% cover 44%"
            >IMPROVE</Accent
          >
        </p>
      </div>
    </div>
    <div class="sticky-spacer"></div>
  </div>
  <div class="sticky-wrapper sticky-wrapper-long">
    <div class="story-block story-block-3">
      <p class="story-text line-4">
        <Accent range="cover 30% cover 54%" mobileRange="cover 20% cover 60%"
          >Find</Accent
        > the real problems
      </p>
      <p class="story-text line-5">
        <Accent range="cover 38% cover 58%" mobileRange="cover 30% cover 70%"
          >Fix</Accent
        > what matters
      </p>
      <p class="story-text line-5">
        <Accent range="cover 42% cover 62%" mobileRange="cover 40% cover 80%"
          >Train</Accent
        > your team
      </p>
      <p class="story-caption">
        One review. A report, a roadmap, and the people to carry it out.
      </p>
    </div>
    <div class="sticky-spacer"></div>
  </div>
</div>

<style>
  .story {
    position: relative;
    width: 100%;
    background-color: var(--color-light);
    /* margin-bottom: 20px; */

    .story-block {
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: fit-content;

      .story-text {
        font-size: var(--font-6xl);
        color: var(--color-ink-light);

        &:not(.accent, .danger) {
          font-weight: var(--font-weight-light);
        }
      }
      .danger-3 {
        animation-name: word-fall;
        animation-timeline: view();
        animation-fill-mode: both;
        animation-range: cover 6% cover 34%;
      }
    }

    /*
      The accent wipes and the falling word run on each word's own view
      timeline, in the lower part of the viewport (cover 6% to 45%). That
      maps to the same on-screen moment on phones and desktops, unlike a
      range on the block itself, since the blocks are much shorter than the
      viewport on phones. The blocks pin once they reach the top and the
      words stop moving, so every range finishes before that point.
    */
    .story-block-1 {
      background-color: var(--color-light);
      position: sticky;
      top: 0;
      padding-bottom: 20svh;

      .story-text {
        color: var(--color-ink);
      }
    }

    /* Brighter green on the dark cards, the light-page token is too muddy there. */
    .story-block-2 :global(.accent__copy),
    .story-block-3 :global(.accent__copy) {
      color: #3fae8c;
    }

    .sticky-wrapper {
      position: sticky;
      top: 60px;
      z-index: 2;
      margin: 0 var(--spacer-2xl);
      --sticky-tail: 20svh;
    }

    .sticky-wrapper-long {
      --sticky-tail: 5svh;

      &:has(.story-block-2) {
        background-color: var(--color-light);
      }
    }

    .story-block-2 {
      position: relative;
      padding: 1rem;
      color: var(--color-ink-light);
      background: var(--background-gradient-primary);
      border-radius: 15px;
      height: calc(100svh - 120px);

      .stacked-text {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: end;
        text-align: end;
        font-size: 2rem;
        overflow: visible;

        .small-text {
          padding-bottom: 5.5rem;

          span {
            font-size: 2rem;
          }
        }

        .large-text {
          font-size: clamp(6rem, 11vw, 15rem);
        }
      }
    }

    .story-caption {
      margin-top: var(--spacer-xl);
      font-family: synonym, sans-serif;
      font-size: clamp(1.05rem, 1.5vw, 1.35rem);
      color: rgba(232, 237, 246, 0.72);
      max-width: 40ch;
      padding: 0 var(--spacer-md);
    }

    .sticky-spacer {
      height: var(--sticky-tail);
    }

    .story-block-3 {
      background: var(--background-gradient-secondary);
      z-index: 2;
      position: sticky;
      border-radius: 15px;
      margin-bottom: 0;
      height: calc(100svh - 120px);

      .background-image {
        object-fit: fill;
      }
    }

    svg {
      pointer-events: none;
      position: absolute;
      inset: 0;
      z-index: 3;
      height: calc(360svh - 240px);
      width: 100%;
    }
  }

  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* object-position: bottom; */
    border-radius: 15px;
    z-index: -1;
  }

  .story-line {
    stroke-dasharray: 250;
    stroke-dashoffset: 250;
    animation-name: line-draw;
    animation-timeline: view();
    animation-range: entry 50% cover 180%;
    animation-fill-mode: forwards;
  }

  .falling-word {
    display: inline-block;
    animation-name: word-fall;
    animation-timeline: view();
    animation-range: entry 400% cover 100%;
  }

  @keyframes line-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes word-fall {
    from {
      transform: rotate(0deg) translateY(0) translateX(0);
    }
    to {
      transform: rotate(15deg) translateY(3rem) translateX(1rem);
    }
  }

  @media (max-width: 640px) {
    .story .story-block {
      height: 60svh;
      min-height: 500px;
    }

    .story .story-block-1 {
      padding-bottom: 0;
    }

    /*
      The dark cards keep a gutter on every side. The accent words never
      wrap, so the type scales with the viewport (vw) and stays inside the
      card on narrow phones instead of running past the rounded edge.
    */
    .story .story-block-2,
    .story .story-block-3 {
      padding: var(--spacer-xl) var(--spacer-lg);
      /* clip, not hidden: hidden makes the card a scroll container, which
         would pin the accent words' view timelines to the card instead of
         the page and freeze their wipe. */
      overflow: clip;
    }

    .story .story-block .story-text {
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
      font-weight: var(--font-weight-normal);
      max-width: 100%;
      text-wrap: balance;
    }

    .story .stacked-text {
      flex-direction: column;
      max-width: 100%;

      .small-text,
      .large-text {
        max-width: 100%;
        min-width: 0;
      }

      .small-text {
        font-size: clamp(0.9rem, 4.6vw, 1.5rem);
        padding-bottom: 0px;

        span {
          font-size: inherit;
        }
      }

      .large-text {
        font-size: clamp(3rem, 16vw, 5rem);
        line-height: 1;
      }
    }

    .story .story-caption {
      margin-top: var(--spacer-lg);
      font-size: 1rem;
      padding: 0;
    }

    .story svg {
      display: none;
    }

    .story .sticky-wrapper {
      margin: 0 var(--spacer-md);
    }

    .story .sticky-wrapper,
    .story .sticky-wrapper-long {
      top: 15svh;
    }

    .story .story-block-1 {
      top: 15svh;
    }
  }
</style>
