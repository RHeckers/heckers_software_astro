  <div class="sticky-wrapper sticky-wrapper-long">
    <div class="story-block story-block-2">
      <div class="stacked-text">
        <p class="small-text">
          With our <Accent
            range="cover 0% cover 10%"
            mobileRange="cover 0% cover 6.5%">Architecture assessment</Accent
          >
          <br />
          Angular and Nx <Accent
            range="cover 1% cover 9.5%"
            mobileRange="cover 0% cover 6.8%">experts</Accent
          >
          <br />
          Show you how to
          <br />
        </p>
        <p class="large-text">
          <Accent range="cover 2% cover 11%" mobileRange="cover 0% cover 6.3%"
            >IMPROVE</Accent
          >
        </p>
      </div>
    </div>
    <div class="sticky-spacer"></div>
  </div>
  <div class="sticky-wrapper sticky-wrapper-long">
    <div class="story-block story-block-3">
      <p class="story-text line-4">
        <Accent range="cover 1% cover 14%" mobileRange="cover 0% cover 7.5%"
          >Find</Accent
        > the real problems
      </p>
      <p class="story-text line-5">
        <Accent range="cover 1.5% cover 12%" mobileRange="cover 0% cover 6.6%"
          >Fix</Accent
        > what matters
