        > the highest-impact work
      </p>
      <p class="story-text line-5">
        <Accent range="cover 5% cover 20%" mobileRange="cover 2.5% cover 10.5%"
          >Build</Accent
        > it end to end
      </p>
      <p class="story-text line-5">
        <Accent range="cover 4% cover 18%" mobileRange="cover 2% cover 11%"
          >Ship</Accent
        > it into production
      </p>
      <p class="story-caption">
        One industry expert inside your company, amplified by AI. Discovery,
        development, AI integration and deployment, until the outcome is live.
      </p>
    </div>
  </div>
  <div class="sticky-spacer" aria-hidden="true"></div>

  <!--
    Anything slotted here scrolls inside .story, which is the containing
    block of the sticky cards above. They therefore stay pinned while the
    slotted content rises over them as the next card in the stack.
  -->
  <slot />
</div>

<style>
  .story {
    position: relative;
    width: 100%;
    /* Lighter than the cards it holds, so they read as panels on it, and
       darker than the band above: this is where the page turns. */
    background: var(--color-light-alt);
    /* Air on both sides of the stack: the evidence band above must not
       run into the first card, and the last card must not end flush
       against the section that follows. */
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
    /* margin-bottom: 20px; */

    .story-block {
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: fit-content;

      .story-text {
        /* Capped by the viewport height, so the three lines and the caption
           fit the fixed card height on short screens: a card that grows past
           it would be taller than the other two and leave the stack first. */
        font-size: min(var(--font-6xl), 9svh);
        line-height: 1.15;
        color: var(--color-ink-light);

        &:not(.accent, .danger) {
          font-weight: var(--font-weight-light);
        }
      }
    }

    /*
      The accent wipes run on each word's own view timeline, in the lower
      part of the viewport. That maps to the same on-screen moment on phones
      and desktops, unlike a range on the block itself, since the blocks are
      much shorter than the viewport on phones.

      The percentages look tiny because a sticky ancestor stretches the
      view timeline: the browser keeps the word "in view" for as long as
      the pinned card holds it there, so the cover range spans several
      thousand pixels of scroll while the word is only uncovered for a few
      hundred of them. Every range therefore has to finish inside the first
      tenth or so of its pass, before the next card rises over this one. A
      wipe still running when the card is covered reads as broken, so the
      ranges are measured against that moment rather than eyeballed. The
      spacers between the cards hold each one longer, which is what makes
      room for the wipes to start later and run slower than they used to.
    */

    /* Brighter green on the dark cards, the light-page token is too muddy there. */
    .story-block-2 :global(.accent__copy),
    .story-block-3 :global(.accent__copy) {
      color: #3fae8c;
    }

    .sticky-wrapper {
      position: sticky;
      top: 60px;
      z-index: 2;
      margin: 0 var(--spacer-2xl);
    }

    .sticky-wrapper-long {

      &:has(.story-block-2) {
        background-color: var(--color-light-alt);
      }
    }

    .story-block-2 {
      position: relative;
      padding: 1rem;
      color: var(--color-ink-light);
      background: var(--background-gradient-primary);
      border-radius: 15px;
      height: calc(100svh - 120px);

      .stacked-text {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: end;
        text-align: end;
        font-size: 2rem;
        overflow: visible;

        .small-text {
          padding-bottom: 5.5rem;

          span {
            font-size: 2rem;
          }
        }

        .large-text {
          font-size: clamp(6rem, 11vw, 15rem);
        }
      }
    }

    .story-caption {
      margin-top: min(var(--spacer-xl), 3svh);
      font-family: synonym, sans-serif;
      font-size: clamp(1.05rem, 1.5vw, 1.35rem);
      color: rgba(232, 237, 246, 0.72);
      max-width: 40ch;
      padding: 0 var(--spacer-md);
    }

    /* How long a card stays pinned on its own before the next one starts
       to rise over it. The spacer sits between the sticky wrappers, not
       inside them: inside, it would make a wrapper taller than its card
       and release that card before the others when the stack scrolls out.
       All wrappers are the same height, so all three cards leave together. */
    .sticky-spacer {
      height: 40svh;
    }

    .story-block-3 {
      background: var(--background-gradient-secondary);
      z-index: 2;
      position: sticky;
      border-radius: 15px;
      margin-bottom: 0;
      height: calc(100svh - 120px);

      .background-image {
        object-fit: fill;
      }
    }

    svg {
      pointer-events: none;
      position: absolute;
      inset: 0;
      z-index: 3;
      height: calc(360svh - 240px);
      width: 100%;
    }
  }

  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* object-position: bottom; */
    border-radius: 15px;
    z-index: -1;
  }

  .story-line {
    stroke-dasharray: 250;
    stroke-dashoffset: 250;
    animation-name: line-draw;
    animation-timeline: view();
    animation-range: entry 50% cover 180%;
    animation-fill-mode: forwards;
  }

  @keyframes line-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  /*
    Phones. Each card fills the screen below the navigation pill, so the
    three of them stack in one frame the way they do on wide screens. The
    text is left-aligned and set larger than on desktop relative to the
    card, with every phrase on its own line, because a centred cluster of
    small lines looked lost in a card this tall.
  */
  @media (max-width: 640px) {
    .story {
      /* Pinned just under the navigation pill (bottom edge at ~64px), with
         the same gap below the card. */
      --story-card-top: 80px;
    }

    .story .story-block {
      height: calc(100svh - var(--story-card-top) - var(--spacer-md));
      min-height: 0;
      align-items: flex-start;
      text-align: left;
    }

    /*
      The dark cards keep a gutter on every side. The accent words never
      wrap, so the type scales with the viewport (vw) and stays inside the
      card on narrow phones instead of running past the rounded edge.
    */
    .story .story-block-2,
    .story .story-block-3 {
      padding: var(--spacer-xl) clamp(1rem, 5vw, 1.5rem);
      /* clip, not hidden: hidden makes the card a scroll container, which
         would pin the accent words' view timelines to the card instead of
         the page and freeze their wipe. */
      overflow: clip;
    }

    .story .story-block .story-text {
      font-size: clamp(1.75rem, 9vw, 2.75rem);
      font-weight: var(--font-weight-normal);
      line-height: 1.12;
      max-width: 100%;
    }

    .story .story-block .story-text + .story-text {
      margin-top: 0.4em;
    }

    .story .stacked-text {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      max-width: 100%;

      .small-text,
      .large-text {
        max-width: 100%;
        min-width: 0;
      }

      /* "With our" wraps onto its own line above the accent phrase, which
         is the widest nowrap run on the page: 12em, so 6.4vw keeps it
         inside the card down to 320px. */
      .small-text {
        font-size: clamp(1.25rem, 6.4vw, 2rem);
        line-height: 1.3;
        padding-bottom: 0;

        span {
          font-size: inherit;
        }
      }

      /* DELIVER is about 4.1em wide in this face; 18vw keeps it inside
         the card gutter on a 320px phone. */
      .large-text {
        font-size: clamp(3rem, 18vw, 6rem);
        line-height: 0.95;
        margin-top: 0.15em;
      }
    }

    .story .story-caption {
      margin-top: var(--spacer-xl);
      font-size: clamp(1rem, 4.4vw, 1.15rem);
      line-height: 1.5;
      padding: 0;
      max-width: 34ch;
    }

    .story svg {
      display: none;
    }

    .story .sticky-wrapper {
      margin: 0 var(--spacer-md);
    }

    .story .sticky-wrapper,
    .story .sticky-wrapper-long {
      top: var(--story-card-top);
    }
  }
</style>
