  <div class="sticky-wrapper sticky-wrapper-long">
    <div class="story-block story-block-2">
      <div class="stacked-text">
        <p class="small-text">
          With our <Accent
            range="cover 3% cover 17%"
            mobileRange="cover 2% cover 10%">Forward-deployed team</Accent
          >
          <br />
          Industry <Accent
            range="cover 4% cover 17%"
            mobileRange="cover 2.5% cover 10.5%">experts</Accent
          >
          <br />
          Come in and
          <br />
        </p>
        <p class="large-text">
          <Accent range="cover 5% cover 19%" mobileRange="cover 3% cover 10%"
            >DELIVER</Accent
          >
        </p>
      </div>
