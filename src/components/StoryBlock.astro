    </div>
    <div class="sticky-spacer"></div>
  </div>

  <!--
    Anything slotted here scrolls inside .story, which is the containing
    block of the sticky cards above. They therefore stay pinned while the
    slotted content rises over them as the next card in the stack.
  -->
  <slot />
</div>

<style>
  .story {
    position: relative;
    width: 100%;
    /* Lighter than the cards it holds, so they read as panels on it, and
       darker than the band above: this is where the page turns. */
    background: var(--color-light-alt);
    /* Air on both sides of the stack: the evidence band above must not
       run into the first card, and the last card must not end flush
       against the section that follows. */
    padding-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: clamp(4rem, 10vw, 7rem);
    /* margin-bottom: 20px; */

    .story-block {
      height: 100svh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      min-height: fit-content;

      .story-text {
        font-size: var(--font-6xl);
        color: var(--color-ink-light);

        &:not(.accent, .danger) {
          font-weight: var(--font-weight-light);
        }
      }
    }

    /*
      The accent wipes run on each word's own view timeline, in the lower
      part of the viewport. That maps to the same on-screen moment on phones
      and desktops, unlike a range on the block itself, since the blocks are
      much shorter than the viewport on phones.

      The percentages look tiny because a sticky ancestor stretches the
      view timeline: the browser keeps the word "in view" for as long as
      the pinned card holds it there, so the cover range spans several
      thousand pixels of scroll while the word is only uncovered for a few
      hundred of them. Every range therefore has to finish inside the first
      tenth or so of its pass, before the next card rises over this one. A
      wipe still running when the card is covered reads as broken, so the
      ranges are measured against that moment rather than eyeballed.
    */

    /* Brighter green on the dark cards, the light-page token is too muddy there. */
    .story-block-2 :global(.accent__copy),
    .story-block-3 :global(.accent__copy) {
      color: #3fae8c;
    }

    .sticky-wrapper {
      position: sticky;
      top: 60px;
      z-index: 2;
      margin: 0 var(--spacer-2xl);
      --sticky-tail: 20svh;
    }

    .sticky-wrapper-long {
      --sticky-tail: 5svh;

      &:has(.story-block-2) {
        background-color: var(--color-light-alt);
      }
    }

    .story-block-2 {
      position: relative;
      padding: 1rem;
      color: var(--color-ink-light);
      background: var(--background-gradient-primary);
      border-radius: 15px;
      height: calc(100svh - 120px);

      .stacked-text {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: end;
        text-align: end;
        font-size: 2rem;
        overflow: visible;

        .small-text {
          padding-bottom: 5.5rem;

          span {
            font-size: 2rem;
          }
        }

        .large-text {
          font-size: clamp(6rem, 11vw, 15rem);
        }
      }
    }

    .story-caption {
      margin-top: var(--spacer-xl);
      font-family: synonym, sans-serif;
      font-size: clamp(1.05rem, 1.5vw, 1.35rem);
      color: rgba(232, 237, 246, 0.72);
      max-width: 40ch;
      padding: 0 var(--spacer-md);
    }

    .sticky-spacer {
      height: var(--sticky-tail);
    }

    .story-block-3 {
      background: var(--background-gradient-secondary);
      z-index: 2;
      position: sticky;
      border-radius: 15px;
      margin-bottom: 0;
      height: calc(100svh - 120px);

      .background-image {
        object-fit: fill;
      }
    }

    svg {
      pointer-events: none;
      position: absolute;
      inset: 0;
      z-index: 3;
      height: calc(360svh - 240px);
      width: 100%;
    }
  }

  .background-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* object-position: bottom; */
    border-radius: 15px;
    z-index: -1;
  }

  .story-line {
    stroke-dasharray: 250;
    stroke-dashoffset: 250;
    animation-name: line-draw;
    animation-timeline: view();
    animation-range: entry 50% cover 180%;
    animation-fill-mode: forwards;
  }

  @keyframes line-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (max-width: 640px) {
    .story .story-block {
      height: 60svh;
      min-height: 500px;
    }

    /*
      The dark cards keep a gutter on every side. The accent words never
      wrap, so the type scales with the viewport (vw) and stays inside the
      card on narrow phones instead of running past the rounded edge.
    */
    .story .story-block-2,
    .story .story-block-3 {
      padding: var(--spacer-xl) var(--spacer-lg);
      /* clip, not hidden: hidden makes the card a scroll container, which
         would pin the accent words' view timelines to the card instead of
         the page and freeze their wipe. */
      overflow: clip;
    }

    .story .story-block .story-text {
      font-size: clamp(1.75rem, 8.5vw, 2.5rem);
      font-weight: var(--font-weight-normal);
      max-width: 100%;
      text-wrap: balance;
    }

    .story .stacked-text {
      flex-direction: column;
      max-width: 100%;

      .small-text,
      .large-text {
        max-width: 100%;
        min-width: 0;
      }

      .small-text {
        font-size: clamp(0.9rem, 4.6vw, 1.5rem);
        padding-bottom: 0px;

        span {
          font-size: inherit;
        }
      }

      .large-text {
        font-size: clamp(3rem, 16vw, 5rem);
        line-height: 1;
      }
    }

    .story .story-caption {
      margin-top: var(--spacer-lg);
      font-size: 1rem;
      padding: 0;
    }

    .story svg {
      display: none;
    }

    .story .sticky-wrapper {
      margin: 0 var(--spacer-md);
    }

    .story .sticky-wrapper,
    .story .sticky-wrapper-long {
      top: 15svh;
    }
  }
</style>
