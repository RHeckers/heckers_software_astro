---
/**
 * The forward-deployed expert: the ways to engage, how an engagement runs,
 * and what a client can count on. Sits on a light background so it reads as
 * its own section between the dark proof band and the contact form, and
 * closes the home page's argument for the main offer with the practical
 * details a buyer needs before they write to us.
 *
 * The engagement plan panel is the one animated element: its vertical line
 * draws down and each phase lights up as the panel scrolls into view
 * (CSS scroll-driven animation, no script; fully drawn where unsupported).
 */
import Accent from "./Accent.astro";
import ProofQuote from "./ProofQuote.astro";

const engagements = [
  {
    title: "Hand us the work",
    copy: "You know what needs building: a backlog your team cannot get to, a module, a portal, an integration, an application. We take it on end to end, inside your codebase and your standards, and deliver it with working software every two weeks.",
  },
  {
    title: "Let us find the work",
    copy: "You know something should be faster or cheaper but not where to start. A two-week discovery with the people who do the work ends in a ranked list of what software and AI can take off their plate, and a scoped plan for the top of it. Then we build it.",
  },
  {
    title: "Get an AI pilot into production",
    copy: "A proof of concept worked on a laptop and stalled at the ERP, the data or security. We take it the rest of the way: integration, evaluation, guardrails, pipeline and monitoring, so it earns its place in the daily workflow.",
  },
];

const scope =
  "Customer and partner portals, back-office modules, internal tools, reporting, integrations with your ERP and CRM, document and workflow automation, AI assistants on your own data, and the APIs and pipelines behind all of it.";

const phases = [
  {
    title: "Discovery",
    when: "Week 1–2",
    copy: "We sit with the people who do the work, read the systems and the code, and find where software and AI save the most. You get a ranked list, a scoped plan and a realistic estimate before you commit to anything.",
  },
  {
    title: "Foundation",
    when: "Week 2–3",
    copy: "Data model, integrations and code structure designed to fit your landscape and standards, so what we build slots into your suite instead of beside it.",
  },
  {
    title: "Build in short cycles",
    when: "Every 2 weeks",
    copy: "Working software your stakeholders can click through, reviewed together. AI wired into the workflow where it earns its place, with evaluation and guardrails. Tests and deployments through your pipelines from the first sprint.",
  },
  {
    title: "Ship, hand over, stay or leave",
    when: "Final weeks",
    copy: "Go-live, documentation and a working session with your developers. Then you choose: we keep delivering the next outcome with you, or we leave with everything in your hands.",
  },
];

const stack = [
  "Angular",
  "TypeScript",
  ".NET",
  "Node.js",
  "SQL",
  "Azure",
  "Claude and OpenAI APIs",
];

const commitments = [
  {
    title: "Outcomes, not hours",
    copy: "Every engagement is scoped around an outcome you can see in production, with the plan, the team and the price agreed before we start. Hours are how we get there, not what you buy.",
  },
  {
    title: "One expert, a team's output",
    copy: "With coding agents doing the typing, one senior engineer who knows the whole stack now delivers what a team of several did before, with one person accountable. Everything learned about your company is written into your repositories, and when an outcome needs more hands, we bring them.",
  },
  {
    title: "You own everything",
    copy: "Code, documentation, infrastructure and the decisions behind them live in your repositories and accounts from day one. No lock-in, no maintenance contract you did not plan for.",
  },
];
---

<section class="app-dev" id="app-development">
  <div class="app-dev__inner">
    <div class="app-dev__grid">
      <div class="app-dev__copy">
        <header class="app-dev__header">
          <h2 class="app-dev__title">An industry expert inside your company</h2>
          <p class="app-dev__lede">
            Forward-deployed engineering is what the AI labs call it when
            their engineers go to the customer and build until it works. We do
            the same for companies that cannot hire one: founder Roberto
            Heckers comes in, finds or takes on the highest-impact work, and
            delivers it end to end, from the screens your users see to the
            backend, the AI and the deployment behind them. With AI doing the
            typing,
            <Accent range="entry 40% cover 35%">one expert now ships what a team did before</Accent>,
            and when an outcome needs more hands, a team is built around him.
          </p>
        </header>

        <h3 class="app-dev__subtitle">Three ways to bring us in</h3>
        <ul class="offerings">
          {
            engagements.map((item) => (
              <li class="offering">
                <span class="offering__title">{item.title}</span>
                <span class="offering__copy">{item.copy}</span>
              </li>
            ))
          }
        </ul>

        <p class="app-dev__scope">
          <span class="app-dev__scope-label">What that covers</span>
          {scope}
        </p>

        <ProofQuote snippet="ferdiDelivery" />
      </div>

      <aside class="plan" aria-labelledby="plan-title">
        <div class="plan__head">
          <h3 class="plan__title" id="plan-title">How an engagement runs</h3>
          <p class="plan__intro">
            Fixed steps, short feedback loops, no long silences.
          </p>
        </div>
        <ol class="phases">
          {
            phases.map((phase, index) => (
              <li class="phase" style={`--i: ${index}`}>
                <span class="phase__marker" aria-hidden="true">
                  {index + 1}
                </span>
                <div class="phase__body">
                  <div class="phase__row">
                    <h4 class="phase__title">{phase.title}</h4>
                    <span class="phase__when">{phase.when}</span>
                  </div>
                  <p class="phase__copy">{phase.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="plan__stack">
          <span class="plan__stack-label">
            Our default stack. Where your platform requires another, we work in
            yours.
          </span>
          <ul class="stack">
            {stack.map((tool) => <li class="stack__item">{tool}</li>)}
          </ul>
        </div>
      </aside>

      <div class="app-dev__actions">
        <a href="#contactForm" class="app-dev__cta" data-subject="Development">
          Book a discovery call
        </a>
        <p class="app-dev__note">
          No obligation. A short call to see whether we are the right fit.
        </p>
        <a href="/services/forward-deployed-engineering" class="app-dev__details">
          How an engagement runs, and three ways to work with us
        </a>
      </div>
    </div>

    <ul class="commitments" aria-label="What you can count on">
      {
        commitments.map((item) => (
          <li class="commitment">
            <h3 class="commitment__title">{item.title}</h3>
            <p class="commitment__copy">{item.copy}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .app-dev {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .app-dev__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* --- Header --- */

  .app-dev__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    max-width: 60ch;
    margin-bottom: var(--spacer-md);
  }

  .app-dev__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .app-dev__lede {
    font-family: synonym, sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .app-dev__lede :global(.accent) {
    color: var(--color-ink);
  }

  /* --- Two column body --- */

  .app-dev__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .app-dev__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
  }

  .app-dev__subtitle {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .offerings {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-stroke-strong);
  }

  .offering {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .offering__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .offering__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .app-dev__scope {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .app-dev__scope-label {
    display: block;
    font-family: chillax, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    margin-bottom: 0.2rem;
  }

  .app-dev__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacer-md);
    margin-top: var(--spacer-base);
  }

  .app-dev__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95em 2.2em;
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background-color: var(--color-accent-strong);
    border: 1px solid var(--color-accent-strong);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(37, 99, 168, 0.28);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .app-dev__cta:hover {
    background-color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
    transform: translateY(-1px);
  }

  .app-dev__cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .app-dev__note {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  .app-dev__details {
    font-family: synonym, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
  }

  .app-dev__details:hover,
  .app-dev__details:focus-visible {
    color: var(--color-accent-strong);
  }

  /* --- Project plan panel --- */

  .plan {
    background: var(--background-gradient-primary);
    color: var(--color-ink-light);
    border-radius: 22px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
    box-shadow: 0 30px 60px rgba(11, 18, 32, 0.22);
    view-timeline-name: --plan-reveal;
  }

  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .plan__title {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
  }

  .plan__intro {
    font-family: synonym, sans-serif;
    color: rgba(232, 237, 246, 0.7);
  }

  .phases {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    --marker: 2rem;
  }

  .phase {
    position: relative;
    display: grid;
    grid-template-columns: var(--marker) 1fr;
    gap: var(--spacer-md);
    align-items: start;
  }

  /* Rail segment from this marker down to the next one; the accent copy
     draws over the grey one as the phase scrolls into view. */
  .phase:not(:last-child)::before,
  .phase:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--marker) / 2 - 1px);
    top: calc(var(--marker) / 2);
    bottom: calc(-1 * var(--spacer-lg) - var(--marker) / 2);
    width: 2px;
    border-radius: 2px;
  }

  .phase:not(:last-child)::before {
    background: rgba(232, 237, 246, 0.14);
  }

  .phase:not(:last-child)::after {
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
  }

  .phase__marker {
    width: var(--marker);
    height: var(--marker);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-dark-strong);
    position: relative;
    z-index: 1;
  }

  .phase__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .phase__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .phase__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
  }

  .phase__when {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .phase__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.78);
    max-width: 48ch;
  }

  .plan__stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: var(--spacer-lg);
    border-top: 1px solid rgba(232, 237, 246, 0.12);
  }

  .plan__stack-label {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.6);
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack__item {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(232, 237, 246, 0.2);
    color: var(--color-ink-light);
  }

  /* Scroll-driven reveal: rail draws down, phases fade in in order.

     Phone pacing lives here: the panel fills most of a small screen, so the
     first step holds off until it is a third of the way in and each step then
     takes a longer stretch of scroll. Every offset stays inside the entry
     range, so nothing extrapolates past it. Wide screens override below. */
  @supports (animation-timeline: view()) {
    .phase:not(:last-child)::after {
      transform: scaleY(0);
      animation: plan-rail linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(50% + var(--i) * 11%) entry
        calc(78% + var(--i) * 11%);
    }

    .phase {
      opacity: 0.35;
      animation: plan-phase linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(35% + var(--i) * 11%) entry
        calc(65% + var(--i) * 11%);
    }

    .phase__marker {
      background: var(--color-dark-soft);
      animation: plan-marker linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(35% + var(--i) * 11%) entry
        calc(65% + var(--i) * 11%);
    }

    /* On wide screens the panel enters quickly, so pace the reveal over its
       whole pass through the viewport and start each step later. */
    @media (min-width: 960px) {
      .phase,
      .phase__marker {
        animation-range: cover calc(18% + var(--i) * 11%) cover
          calc(30% + var(--i) * 11%);
      }

      .phase:not(:last-child)::after {
        animation-range: cover calc(24% + var(--i) * 11%) cover
          calc(38% + var(--i) * 11%);
      }
    }
  }

  @keyframes plan-rail {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes plan-phase {
    to {
      opacity: 1;
    }
  }

  @keyframes plan-marker {
    to {
      background: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phase:not(:last-child)::after {
      transform: scaleY(1);
    }
    .phase {
      opacity: 1;
    }
    .phase__marker {
      background: var(--color-accent);
    }
  }

  /* --- Commitments --- */

  .commitments {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-lg);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-stroke-strong);
  }

  .commitment {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-success);
  }

  .commitment__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .commitment__copy {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 40ch;
  }

  /* --- Wider screens --- */

  @media (min-width: 720px) {
    .commitments {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacer-xl);
    }
  }

  @media (min-width: 960px) {
    .app-dev__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .plan {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .app-dev__actions {
      grid-column: 1;
      margin-top: 0;
    }
  }
</style>
