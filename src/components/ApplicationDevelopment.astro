---
import Accent from "./Accent.astro";
import ContentCards from "./ContentCards.astro";
import { Image } from "astro:assets";

import laptopEnTelefoon from "../assets/laptop_en_telefoon.svg";
import cloud from "../assets/cloud.svg";
---

<section class="section-4">
  <div class="app-development" id="app-development">
    <div class="parallax-bg">
      <Image
        src={laptopEnTelefoon}
        alt="Laptop and Phone"
        class="parallax-img parallax-laptop"
        loading="lazy"
        width={260}
        height={180}
      />
      <Image
        src={cloud}
        alt="Cloud"
        class="parallax-img parallax-cloud"
        loading="lazy"
        width={180}
        height={120}
      />
    </div>
    <div class="app-dev-content">
      <h2 class="app-dev-title">Application Development</h2>
      <div class="app-dev-card-shell">
        <div class="app-dev-card-scroll">
          <ul class="app-dev-list">
            <ContentCards icon="✦" title="Concept to Delivery">
              From idea to launch, we partner with you to build
              <Accent range="entry 65% cover 50%" timeline="--app-dev-timeline">products that resonate</Accent> with your
              users and achieve your business goals.
            </ContentCards>
            <ContentCards icon="⧉" title="Cross Platform Applications">
              Shared UI and domain core with
              <Accent range="entry 65% cover 50%" timeline="--app-dev-timeline">platform-specific polish</Accent> so every
              surface feels intentional while shipping from a single codebase.
            </ContentCards>
            <ContentCards icon="⚙" title="Architected for Scale">
              From modular architecture to <Accent range="entry 70% cover 50%" timeline="--app-dev-timeline"
                >cloud-native infrastructure</Accent
              >, we build applications designed to <Accent range="entry 70% cover 50%" timeline="--app-dev-timeline"
                >grow</Accent
              > with your business.
            </ContentCards>
          </ul>
        </div>
        <div class="app-dev-card-nav" role="group" aria-label="Scroll cards">
          <button
            class="app-dev-card-button"
            data-direction="prev"
            aria-label="Previous card"
          >
            &lt;
          </button>
          <button
            class="app-dev-card-button"
            data-direction="next"
            aria-label="Next card"
          >
            &gt;
          </button>
        </div>
      </div>
      <a href="#contactForm" class="app-dev-cta">Build It With Us</a>
    </div>
  </div>
</section>

<style>
  .parallax-bg {
    position: absolute;
    inset: 0;
    width: 100vw;
    height: 100svh;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }
  .parallax-img {
    position: absolute;
    will-change: transform;
    opacity: 0.7;
    transition: transform 0.2s linear;
    max-width: 30vw;
    min-width: 120px;
    height: auto;
  }
  .parallax-laptop {
    left: 2vw;
    top: 8svh;
    width: 18vw;
    max-width: 260px;
    z-index: 1;
  }
  .parallax-cloud {
    right: 6vw;
    top: 18svh;
    width: 14vw;
    max-width: 180px;
    z-index: 1;
  }
  .parallax-computer {
    left: 55vw;
    bottom: 7svh;
    width: 16vw;
    max-width: 200px;
    z-index: 1;
  }
  @media (max-width: 640px) {
    .parallax-bg {
      display: none;
    }
    .parallax-img {
      max-width: 60vw;
      min-width: 80px;
    }
    .parallax-laptop {
      left: 0vw;
      top: 4svh;
      width: 40vw;
    }
    .parallax-cloud {
      right: 0vw;
      top: 10svh;
      width: 30vw;
    }
    .parallax-computer {
      left: 30vw;
      bottom: 2svh;
      width: 35vw;
    }
  }

  .section-4 {
    position: relative;
    overflow: hidden;
  }
  .section-4 {
    view-timeline-name: --app-dev-timeline;
  }

  .app-development {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .app-dev-content {
    text-align: center;
    color: var(--color-ink-light);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
    align-items: center;
    justify-content: center;
    padding: var(--spacer-base) 0;
    max-width: 100%;
    margin: 0 auto;
  }

  .app-dev-title {
    font-size: 2.5rem;
    font-weight: var(--font-weight-medium);
  }

  .app-dev-list .accent {
    font-weight: var(--font-weight-normal);
  }

  .app-dev-card-shell {
    width: 100%;
  }

  .app-dev-card-scroll {
    width: 100%;
    overflow-x: auto;
    overflow-y: visible;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 1rem;
  }

  .app-dev-card-scroll::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .app-dev-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: nowrap;
    overflow: visible;
    gap: var(--spacer-md);
    padding: 0 1rem var(--spacer-md);
    scrollbar-width: none;
    font-size: 1.2rem;
    width: 100%;
    text-align: left;
    overflow: visible;
  }

  .app-dev-list::after {
    content: "";
    flex: 0 0 1px;
  }

  .app-dev-list::-webkit-scrollbar {
    width: 0;
    height: 0;
  }

  .app-dev-list :global(.app-card) {
    flex: 0 0 82vw;
    max-width: 82vw;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .app-dev-card-nav {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--spacer-sm);
    gap: var(--spacer-sm);
    margin-right: var(--spacer-md);
  }

  .app-dev-card-button {
    border: 2px solid rgba(255, 255, 255, 0.3);
    background: rgba(15, 26, 43, 0.7);
    color: var(--color-ink-light);
    width: 40px;
    height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-md);
    cursor: pointer;
    backdrop-filter: blur(8px);
  }

  .app-dev-cta {
    display: inline-block;
    align-self: center;
    margin-top: var(--spacer-lg);
    padding: var(--spacer-md) var(--spacer-xl);
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: var(--color-ink-light);
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      color 0.3s ease;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
  }

  .app-dev-cta:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
    transform: translateY(-2px);
  }

  @media (min-width: 650px) {
    .app-dev-content {
      max-width: 1200px;
      padding: var(--spacer-3xl) var(--spacer-2xl);
    }

    .app-dev-title {
      font-size: 5rem;
    }

    .app-dev-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--spacer-lg);
      padding: 0;
    }

    .app-dev-card-scroll {
      overflow: visible;
      scroll-snap-type: none;
      scroll-padding: 0;
    }

    .app-dev-card-nav {
      display: none;
      margin-right: 0;
    }

    .app-dev-list :global(.app-card) {
      flex: initial;
      max-width: none;
      scroll-snap-align: unset;
      scroll-snap-stop: normal;
    }

    .app-dev-cta {
      font-size: var(--font-2xl);
      padding: var(--spacer-lg) var(--spacer-2xl);
    }
  }
</style>

<script is:inline>
  // Card scroll logic ...existing code...
  const appDevShells = document.querySelectorAll(".app-dev-card-shell");
  appDevShells.forEach((shell) => {
    const container = shell.querySelector(".app-dev-card-scroll");
    const list = shell.querySelector(".app-dev-list");
    const buttons = shell.querySelectorAll(".app-dev-card-button");
    if (!container || !list || buttons.length === 0) return;
    const getStep = () => {
      const firstCard = list.querySelector(".app-card");
      const styles = window.getComputedStyle(list);
      const gap = parseFloat(styles.columnGap || styles.gap || "0");
      return (firstCard?.clientWidth || 0) + gap;
    };
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const direction = button.getAttribute("data-direction");
        const step = getStep() || container.clientWidth;
        const delta = direction === "next" ? step : -step;
        container.scrollBy({ left: delta, behavior: "smooth" });
      });
    });
  });

  // Parallax scroll effect
  window.addEventListener("scroll", () => {
    const scrollY = window.scrollY;
    const laptop = document.querySelector(".parallax-laptop");
    const cloud = document.querySelector(".parallax-cloud");
    // Only move a couple of pixels for subtle effect
    if (laptop) {
      laptop.style.transform = `translateY(${scrollY * 0.05 - 450}px)`;
    }
    if (cloud) {
      cloud.style.transform = `translateY(${scrollY * 0.06 - 200}px)`;
    }
  });
</script>
