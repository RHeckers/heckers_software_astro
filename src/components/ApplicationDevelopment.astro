---
/**
 * Application development: what we build, how a project runs, and what a
 * client can count on. Sits on a light background so it reads as its own
 * section between the dark workshops and testimonials blocks.
 *
 * The project plan panel is the one animated element: its vertical line
 * draws down and each phase lights up as the panel scrolls into view
 * (CSS scroll-driven animation, no script; fully drawn where unsupported).
 */
import Accent from "./Accent.astro";

const engagements = [
  {
    title: "Outsource a section of your application",
    copy: "A module, a customer portal, a reporting suite or an integration, built inside your existing codebase to your standards and handed over cleanly to your own developers.",
  },
  {
    title: "Add a new application to your suite",
    copy: "A complete product from first sketch to production: architecture, front end, backend, deployment and handover. One accountable team, one point of contact.",
  },
];

const scope =
  "Customer and partner portals, back-office modules, internal tools, reporting, integrations with your ERP and CRM, and the APIs behind them.";

const phases = [
  {
    title: "Discovery",
    when: "Week 1–2",
    copy: "We map the goals, the users and the systems the application must integrate with, and align with your architects and security requirements. You get a scoped plan and a realistic estimate.",
  },
  {
    title: "Foundation",
    when: "Week 2–3",
    copy: "Data model, integrations and code structure are designed to fit your landscape and standards, so the application slots into your suite instead of beside it.",
  },
  {
    title: "Build in short cycles",
    when: "Every 2 weeks",
    copy: "Working software your stakeholders can click through, reviewed together. Automated tests and deployments through your pipelines from the first sprint.",
  },
  {
    title: "Launch and handover",
    when: "Final weeks",
    copy: "Go-live, documentation and a walkthrough for your developers. We stay available for support, or keep running it with you.",
  },
];

const stack = ["Angular", "TypeScript", ".NET", "Node.js", "SQL", "Azure"];

const commitments = [
  {
    title: "Fits your standards",
    copy: "Your coding guidelines, security and compliance requirements, and release process. We adapt to your landscape, not the other way around.",
  },
  {
    title: "Senior hands only",
    copy: "The people you talk to are the people who build. No hand-off to a junior team.",
  },
  {
    title: "You own everything",
    copy: "Code, documentation and infrastructure live in your repositories from day one. No lock-in.",
  },
];
---

<section class="app-dev" id="app-development">
  <div class="app-dev__inner">
    <div class="app-dev__grid">
      <div class="app-dev__copy">
        <header class="app-dev__header">
          <h2 class="app-dev__title">Application development</h2>
          <p class="app-dev__lede">
            We take on application development for enterprise teams: a
            section of your existing software, or a complete new application
            within your suite. Full stack, from the screens your users see to
            the backend and deployment behind them, delivered by
            <Accent range="entry 40% cover 35%">one senior team</Accent> that
            fits into how you already work.
          </p>
        </header>

        <h3 class="app-dev__subtitle">Two ways to work with us</h3>
        <ul class="offerings">
          {
            engagements.map((item) => (
              <li class="offering">
                <span class="offering__title">{item.title}</span>
                <span class="offering__copy">{item.copy}</span>
              </li>
            ))
          }
        </ul>
        <p class="app-dev__scope">
          <span class="app-dev__scope-label">What that covers</span>
          {scope}
        </p>
      </div>

      <aside class="plan" aria-labelledby="plan-title">
        <div class="plan__head">
          <h3 class="plan__title" id="plan-title">How a project runs</h3>
          <p class="plan__intro">
            Fixed steps, short feedback loops, no long silences.
          </p>
        </div>
        <ol class="phases">
          {
            phases.map((phase, index) => (
              <li class="phase" style={`--i: ${index}`}>
                <span class="phase__marker" aria-hidden="true">
                  {index + 1}
                </span>
                <div class="phase__body">
                  <div class="phase__row">
                    <h4 class="phase__title">{phase.title}</h4>
                    <span class="phase__when">{phase.when}</span>
                  </div>
                  <p class="phase__copy">{phase.copy}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="plan__stack">
          <span class="plan__stack-label">
            Our default stack. Where your platform requires another, we work
            in yours.
          </span>
          <ul class="stack">
            {stack.map((tool) => <li class="stack__item">{tool}</li>)}
          </ul>
        </div>
      </aside>

      <div class="app-dev__actions">
        <a href="#contactForm" class="app-dev__cta" data-subject="Development">
          Plan your project
        </a>
        <p class="app-dev__note">
          No obligation. A short call to see whether we are the right fit.
        </p>
      </div>
    </div>

    <ul class="commitments" aria-label="What you can count on">
      {
        commitments.map((item) => (
          <li class="commitment">
            <h3 class="commitment__title">{item.title}</h3>
            <p class="commitment__copy">{item.copy}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .app-dev {
    background: var(--color-light);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .app-dev__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vw, 4.5rem);
  }

  /* --- Header --- */

  .app-dev__header {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    max-width: 60ch;
    margin-bottom: var(--spacer-md);
  }

  .app-dev__title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .app-dev__lede {
    font-family: synonym, sans-serif;
    font-size: clamp(1.1rem, 1.6vw, 1.35rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
  }

  .app-dev__lede :global(.accent) {
    color: var(--color-ink);
  }

  /* --- Two column body --- */

  .app-dev__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .app-dev__copy {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
  }

  .app-dev__subtitle {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .offerings {
    list-style: none;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--color-stroke-strong);
  }

  .offering {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .offering__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .offering__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .app-dev__scope {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 52ch;
  }

  .app-dev__scope-label {
    display: block;
    font-family: chillax, sans-serif;
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
    margin-bottom: 0.2rem;
  }

  .app-dev__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacer-md);
    margin-top: var(--spacer-base);
  }

  .app-dev__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.95em 2.2em;
    font-size: 1.15rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background-color: var(--color-accent-strong);
    border: 1px solid var(--color-accent-strong);
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 14px 30px rgba(37, 99, 168, 0.28);
    transition:
      background-color 0.2s,
      border-color 0.2s,
      transform 0.2s;
  }

  .app-dev__cta:hover {
    background-color: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
    transform: translateY(-1px);
  }

  .app-dev__cta:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .app-dev__note {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-ink-muted);
  }

  /* --- Project plan panel --- */

  .plan {
    background: var(--background-gradient-secondary);
    color: var(--color-ink-light);
    border-radius: 22px;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
    box-shadow: 0 30px 60px rgba(11, 18, 32, 0.22);
    view-timeline-name: --plan-reveal;
  }

  .plan__head {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .plan__title {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
  }

  .plan__intro {
    font-family: synonym, sans-serif;
    color: rgba(232, 237, 246, 0.7);
  }

  .phases {
    list-style: none;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
    --marker: 2rem;
  }

  .phase {
    position: relative;
    display: grid;
    grid-template-columns: var(--marker) 1fr;
    gap: var(--spacer-md);
    align-items: start;
  }

  /* Rail segment from this marker down to the next one; the accent copy
     draws over the grey one as the phase scrolls into view. */
  .phase:not(:last-child)::before,
  .phase:not(:last-child)::after {
    content: "";
    position: absolute;
    left: calc(var(--marker) / 2 - 1px);
    top: calc(var(--marker) / 2);
    bottom: calc(-1 * var(--spacer-lg) - var(--marker) / 2);
    width: 2px;
    border-radius: 2px;
  }

  .phase:not(:last-child)::before {
    background: rgba(232, 237, 246, 0.14);
  }

  .phase:not(:last-child)::after {
    background: var(--color-accent);
    transform-origin: top;
    transform: scaleY(1);
  }

  .phase__marker {
    width: var(--marker);
    height: var(--marker);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-dark-strong);
    position: relative;
    z-index: 1;
  }

  .phase__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.2rem;
  }

  .phase__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .phase__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
  }

  .phase__when {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .phase__copy {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
    color: rgba(232, 237, 246, 0.78);
    max-width: 48ch;
  }

  .plan__stack {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: var(--spacer-lg);
    border-top: 1px solid rgba(232, 237, 246, 0.12);
  }

  .plan__stack-label {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    color: rgba(232, 237, 246, 0.6);
  }

  .stack {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .stack__item {
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid rgba(232, 237, 246, 0.2);
    color: var(--color-ink-light);
  }

  /* Scroll-driven reveal: rail draws down, phases fade in in order. */
  @supports (animation-timeline: view()) {
    .phase:not(:last-child)::after {
      transform: scaleY(0);
      animation: plan-rail linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(35% + var(--i) * 15%)
        entry calc(60% + var(--i) * 15%);
    }

    .phase {
      opacity: 0.35;
      animation: plan-phase linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(20% + var(--i) * 15%)
        entry calc(45% + var(--i) * 15%);
    }

    .phase__marker {
      background: var(--color-dark-soft);
      animation: plan-marker linear both;
      animation-timeline: --plan-reveal;
      animation-range: entry calc(20% + var(--i) * 15%)
        entry calc(45% + var(--i) * 15%);
    }

    /* On wide screens the panel enters quickly, so pace the reveal over its
       whole pass through the viewport and start each step later. */
    @media (min-width: 960px) {
      .phase,
      .phase__marker {
        animation-range: cover calc(18% + var(--i) * 11%)
          cover calc(30% + var(--i) * 11%);
      }

      .phase:not(:last-child)::after {
        animation-range: cover calc(24% + var(--i) * 11%)
          cover calc(38% + var(--i) * 11%);
      }
    }
  }

  @keyframes plan-rail {
    to {
      transform: scaleY(1);
    }
  }

  @keyframes plan-phase {
    to {
      opacity: 1;
    }
  }

  @keyframes plan-marker {
    to {
      background: var(--color-accent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .phase:not(:last-child)::after {
      transform: scaleY(1);
    }
    .phase {
      opacity: 1;
    }
    .phase__marker {
      background: var(--color-accent);
    }
  }

  /* --- Commitments --- */

  .commitments {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-lg);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-stroke-strong);
  }

  .commitment {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1rem;
    border-left: 3px solid var(--color-success);
  }

  .commitment__title {
    font-size: 1.15rem;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-ink);
  }

  .commitment__copy {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    color: var(--color-ink-muted);
    max-width: 40ch;
  }

  /* --- Wider screens --- */

  @media (min-width: 720px) {
    .commitments {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacer-xl);
    }
  }

  @media (min-width: 960px) {
    .app-dev__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
    }

    .plan {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .app-dev__actions {
      grid-column: 1;
      margin-top: 0;
    }
  }
</style>
