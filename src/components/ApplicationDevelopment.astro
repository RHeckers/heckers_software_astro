---
import ContentCards from "./ContentCards.astro";
---

<section class="section-4">
  <div class="app-development">
    <div class="app-dev-content">
      <h2 class="app-dev-title">Application Development</h2>
      <ul class="app-dev-list">
        <ContentCards icon="✦" title="Discovery to Delivery">
          Product discovery, architecture, and delivery in one
          <span class="accent accent-1">cross-functional team</span> that stays with
          you from first storyboard to launch.
        </ContentCards>
        <ContentCards icon="⧉" title="Cross Platform Applications">
          Shared UI and domain core with
          <span class="accent accent-1">platform-specific polish</span> so every surface
          feels intentional while shipping from a single codebase.
        </ContentCards>
        <ContentCards icon="⚙" title="Architected for Scale">
          From modular architecture to cloud-native infrastructure, we build
          applications designed to <span class="accent accent-2">grow</span> with
          your business.
        </ContentCards>
      </ul>
      <a href="#" class="app-dev-cta">Build It With Us</a>
    </div>
  </div>
</section>

<style>
  .section-4 {
    background-color: var(--color-dark-soft);
    view-timeline-name: --app-dev-timeline;
  }

  .app-development {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacer-3xl) var(--spacer-2xl);
  }

  .app-dev-content {
    text-align: center;
    color: white;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-xl);
  }

  .app-dev-title {
    font-size: 6rem;
    font-weight: var(--font-weight-light);
  }

  .app-dev-list .accent {
    font-weight: var(--font-weight-normal);
    animation-timeline: --app-dev-timeline;
  }

  .accent-1 {
    animation-range: entry 65% cover 40%;
  }

  .accent-2 {
    animation-range: entry 70% cover 40%;
  }

  .app-dev-list {
    list-style: none;
    padding: 0;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--spacer-lg);
    font-size: 1.2rem;
    max-width: 1100px;
  }

  .app-dev-cta {
    display: inline-block;
    align-self: center;
    margin-top: var(--spacer-lg);
    padding: var(--spacer-lg) var(--spacer-2xl);
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-accent);
    background-color: white;
    border-radius: 50px;
    text-decoration: none;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease,
      color 0.3s ease;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.25);
  }

  .app-dev-cta:hover {
    outline: 4px solid var(--color-accent-strong);
    color: var(--color-accent-strong);
    transform: translateY(-2px);
  }
</style>
