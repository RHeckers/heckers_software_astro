---
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form class="contact-form" name="contact" autocomplete="on" id="contactForm">
  <!-- Honeypot field for bot protection -->
  <div style="display:none;">
    <label for="website">Website</label>
    <input
      type="text"
      id="website"
      name="website"
      autocomplete="off"
      tabindex="-1"
    />
  </div>
  <div class="form-group">
    <label for="name">Name*</label>
    <input type="text" id="name" name="name" required placeholder="Your name" />
    <div class="error-message" id="nameError"></div>
  </div>

  <div class="form-group">
    <label for="email">Email*</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      placeholder="your@email.com"
    />
    <div class="error-message" id="emailError"></div>
  </div>

  <div class="form-group">
    <label for="phone">Phone</label>
    <input type="tel" id="phone" name="phone" placeholder="Optional" />
    <div class="error-message" id="phoneError"></div>
  </div>

  <div class="form-group">
    <label for="subject">Subject*</label>
    <select id="subject" name="subject" required>
      <option value="General">General</option>
      <option value="Code Review">Code Review</option>
      <option value="Workshop">Workshop</option>
      <option value="Development">Development</option>
      <option value="Feedback">Feedback</option>
      <option value="Other">Other</option>
    </select>
    <div class="error-message" id="subjectError"></div>
  </div>

  <div class="form-group">
    <label for="content">Content*</label>
    <textarea
      id="content"
      name="content"
      required
      placeholder="Type your message..."></textarea>
    <div class="error-message" id="contentError"></div>
  </div>

  <div class="turnstile-group">
    <div
      id="turnstileWidget"
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-callback="onTurnstileSuccess"
      data-expired-callback="onTurnstileExpired"
      data-theme="light"
    >
    </div>
    <div id="turnstilePlaceholder" class="turnstile-placeholder" hidden>
      <span>Spam protection needs a cookie to load.</span>
      <button type="button" id="enableTurnstile">Accept cookies to enable</button>
    </div>
    <div class="error-message" id="turnstileError"></div>
  </div>

  <div class="submit-group">
    <button type="submit" id="contactSubmit">
      <span id="submitText">Send</span>
      <span id="submitCheck" style="display:none;">✔️</span>
    </button>
    <div class="error-message" id="submitError"></div>
  </div>
</form>

<script>
  // Load Cloudflare Turnstile (which may set a cookie) only after the visitor
  // has accepted cookies. Until then, show a placeholder that lets them opt in.
  const CONSENT_KEY = "cookie-consent";
  const TURNSTILE_SRC =
    "https://challenges.cloudflare.com/turnstile/v0/api.js";

  function hasConsent(): boolean {
    try {
      return localStorage.getItem(CONSENT_KEY) === "accepted";
    } catch {
      return false;
    }
  }

  let turnstileLoaded = false;
  function loadTurnstile() {
    if (turnstileLoaded) return;
    turnstileLoaded = true;
    const placeholder = document.getElementById("turnstilePlaceholder");
    if (placeholder) placeholder.hidden = true;
    const script = document.createElement("script");
    script.src = TURNSTILE_SRC;
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  function showPlaceholder() {
    const placeholder = document.getElementById("turnstilePlaceholder");
    if (placeholder) placeholder.hidden = false;
  }

  if (hasConsent()) {
    loadTurnstile();
  } else {
    showPlaceholder();
  }

  // React when the visitor accepts cookies via the consent banner.
  window.addEventListener("cookie-consent-changed", (e: Event) => {
    if ((e as CustomEvent).detail === "accepted") loadTurnstile();
  });

  // The "Accept cookies to enable" button reopens the consent banner.
  document
    .getElementById("enableTurnstile")
    ?.addEventListener("click", () => {
      (window as any).openCookieConsent?.();
    });
</script>

<script>
  if (typeof window !== "undefined") {
    const form = document.getElementById(
      "contactForm",
    ) as HTMLFormElement | null;
    const button = document.getElementById(
      "contactSubmit",
    ) as HTMLButtonElement | null;
    const submitText = document.getElementById(
      "submitText",
    ) as HTMLSpanElement | null;
    const submitCheck = document.getElementById(
      "submitCheck",
    ) as HTMLSpanElement | null;
    const submitError = document.getElementById(
      "submitError",
    ) as HTMLDivElement | null;

    // Turnstile token state
    let turnstileToken: string = "";

    // Global callbacks for Turnstile widget
    (window as any).onTurnstileSuccess = (token: string) => {
      turnstileToken = token;
      const turnstileError = document.getElementById(
        "turnstileError",
      ) as HTMLDivElement | null;
      if (turnstileError) turnstileError.textContent = "";
      validateForm();
    };
    (window as any).onTurnstileExpired = () => {
      turnstileToken = "";
      validateForm();
    };

    type Field = {
      id: string;
      errorId: string;
      required: boolean;
      label: string;
      type?: string;
    };
    const fields: Field[] = [
      { id: "name", errorId: "nameError", required: true, label: "Name" },
      {
        id: "email",
        errorId: "emailError",
        required: true,
        label: "Email",
        type: "email",
      },
      {
        id: "phone",
        errorId: "phoneError",
        required: false,
        label: "Phone",
        type: "tel",
      },
      {
        id: "subject",
        errorId: "subjectError",
        required: true,
        label: "Subject",
      },
      {
        id: "content",
        errorId: "contentError",
        required: true,
        label: "Content",
      },
    ];

    // Track dirty state and submission
    const dirty: { [key: string]: boolean } = {};
    let formSubmitted = false;

    fields.forEach((f) => {
      dirty[f.id] = false;
    });

    function validateField(field: Field): boolean {
      const input = document.getElementById(field.id) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | HTMLSelectElement
        | null;
      const errorDiv = document.getElementById(
        field.errorId,
      ) as HTMLDivElement | null;
      let value =
        input &&
        typeof (
          input as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        ).value === "string"
          ? (
              input as
                | HTMLInputElement
                | HTMLTextAreaElement
                | HTMLSelectElement
            ).value.trim()
          : "";
      let error = "";
      if (field.required && !value) {
        error = `${field.label} is required.`;
      } else if (field.type === "email" && value) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(value)) {
          error = "Please enter a valid email address.";
        }
      }
      // Only show error if dirty or form submitted
      if (errorDiv) {
        if (dirty[field.id] || formSubmitted) {
          errorDiv.textContent = error;
        } else {
          errorDiv.textContent = "";
        }
      }
      return !error;
    }

    function validateForm(): boolean {
      let valid = true;
      for (const field of fields) {
        if (!validateField(field)) valid = false;
      }
      const hasTurnstile = !!turnstileToken;
      if (button) button.disabled = !valid || !hasTurnstile;
      return valid && hasTurnstile;
    }

    if (form) {
      // Mark fields as dirty on change
      fields.forEach((field) => {
        const input = document.getElementById(field.id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;
        if (input) {
          input.addEventListener("input", () => {
            dirty[field.id] = true;
            validateField(field);
            validateForm();
          });
        }
      });
      window.addEventListener("DOMContentLoaded", validateForm);

      form.addEventListener("submit", async (e: Event) => {
        e.preventDefault();
        formSubmitted = true;
        if (submitError) submitError.textContent = "";
        validateForm();
        if (!validateForm()) {
          return;
        }

        // Validate Turnstile
        const turnstileError = document.getElementById(
          "turnstileError",
        ) as HTMLDivElement | null;
        if (!turnstileToken) {
          if (turnstileError)
            turnstileError.textContent =
              "Please complete the verification.";
          return;
        }

        if (button) button.disabled = true;
        if (submitText) submitText.style.display = "none";
        if (submitCheck) submitCheck.style.display = "none";

        const getValue = (id: string): string => {
          const el = document.getElementById(id) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | HTMLSelectElement
            | null;
          return el && typeof el.value === "string" ? el.value : "";
        };
        const name = getValue("name");
        const email = getValue("email");
        const phone = getValue("phone");
        const subject = getValue("subject");
        const message = getValue("content");
        const website = getValue("website"); // Honeypot

        try {
          const res = await fetch("/api/send-contact-email", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name,
              email,
              phone,
              subject,
              message,
              website,
              turnstileToken,
            }),
          });
          if (res.ok) {
            // Success: show checkmark, reset form, clear errors
            if (submitCheck) submitCheck.style.display = "inline";
            if (submitText) submitText.style.display = "none";
            setTimeout(() => {
              if (submitCheck) submitCheck.style.display = "none";
              if (submitText) submitText.style.display = "inline";
            }, 1500);
            if (typeof form.reset === "function") form.reset();
            fields.forEach((f) => {
              const errDiv = document.getElementById(
                f.errorId,
              ) as HTMLDivElement | null;
              if (errDiv) errDiv.textContent = "";
              dirty[f.id] = false;
            });
            formSubmitted = false;
            // Reset Turnstile widget for next submission
            turnstileToken = "";
            if ((window as any).turnstile) {
              (window as any).turnstile.reset("#turnstileWidget");
            }
            validateForm();
          } else {
            if (submitError)
              submitError.textContent =
                "Failed to send message. Please try again.";
            if (button) button.disabled = false;
            if (submitText) submitText.style.display = "inline";
            if (submitCheck) submitCheck.style.display = "none";
          }
        } catch (err) {
          if (submitError)
            submitError.textContent =
              "An error occurred. Please try again later.";
          if (button) button.disabled = false;
          if (submitText) submitText.style.display = "inline";
          if (submitCheck) submitCheck.style.display = "none";
        }
      });
    }
  }
</script>

<style>
  .contact-form {
    scroll-margin-top: calc(56px + 1rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.07);
    max-width: 100%;
    margin: 0 1rem;
  }
  .contact-form label {
    font-size: 1rem;
    font-weight: 500;
  }
  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    margin-top: 0.25rem;
    font-size: 1rem;
    padding: 0.75rem;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    background: #f9fafb;
    outline: none;
    width: 100%;
    box-sizing: border-box;
  }
  .contact-form select {
    cursor: pointer;
    padding-right: 2.5rem;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background: #f9fafb
      url('data:image/svg+xml;utf8,<svg fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><path d="M6 8L10 12L14 8" stroke="%231c2a45" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>')
      no-repeat right 1rem center/1.2em;
  }

  .contact-form textarea {
    min-height: 100px;
    resize: vertical;
  }
  .contact-form button {
    background: var(--color-primary, #1c2a45);
    color: #fff;
    border: none;
    padding: 0.75rem;
    border-radius: 0.5rem;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s;
  }
  .contact-form button:disabled {
    background: #d1d5db;
    color: #888;
    cursor: not-allowed;
    opacity: 0.7;
  }
  .contact-form button:hover:not(:disabled) {
    background: #0f1a2b;
  }
  .error-message {
    color: #d32f2f;
    font-size: 0.95rem;
    margin-top: 0.2rem;
    min-height: 1.2em;
  }
  .turnstile-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .turnstile-placeholder[hidden] {
    display: none;
  }
  .turnstile-placeholder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px dashed #d1d5db;
    border-radius: 0.5rem;
    background: #f9fafb;
    font-size: 0.95rem;
    color: #555;
  }
  .turnstile-placeholder button {
    background: transparent;
    border: 1px solid var(--color-primary, #1c2a45);
    color: var(--color-primary, #1c2a45);
    padding: 0.35rem 0.75rem;
    border-radius: 0.4rem;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }
  .turnstile-placeholder button:hover {
    background: var(--color-primary, #1c2a45);
    color: #fff;
  }
  .submit-group {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
  }
  #submitCheck {
    font-size: 1.2em;
    color: #2ecc40;
    margin-left: 0.5em;
    vertical-align: middle;
  }
  @media (min-width: 600px) {
    .contact-form {
      max-width: 1100px;
      margin: 0 auto;
    }
  }
</style>
