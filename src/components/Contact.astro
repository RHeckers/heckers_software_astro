---
import { COMPANY } from "../consts";
import ProofQuote from "./ProofQuote.astro";

const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;

const nextSteps = [
  "You get a personal reply from Roberto, not an autoresponder.",
  "We schedule a short call to understand your situation and goals.",
  "You receive a clear proposal with scope, timeline and price.",
];
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="contact__inner">
    <div class="contact__intro">
      <h2 class="contact__title" id="contact-heading">
        Tell us about your project
      </h2>
      <p class="contact__lede">
        An audit, a workshop, a new application or a codebase that needs
        rescuing. Describe where you are and we will tell you honestly whether
        we can help.
      </p>
      <ol class="next-steps">
        {
          nextSteps.map((step, index) => (
            <li class="next-step">
              <span class="next-step__marker" aria-hidden="true">
                {index + 1}
              </span>
              <span class="next-step__copy">{step}</span>
            </li>
          ))
        }
      </ol>
      <p class="contact__direct">
        Prefer email? Write to
        <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a>
      </p>
      <ProofQuote snippet="nicoTeam" />
    </div>

<form
  class="contact-form"
  name="contact"
  autocomplete="on"
  id="contactForm"
  aria-labelledby="contact-heading"
>
  <!-- Honeypot field for bot protection -->
  <div style="display:none;">
    <label for="website">Website</label>
    <input
      type="text"
      id="website"
      name="website"
      autocomplete="off"
      tabindex="-1"
    />
  </div>
  <div class="form-row">
    <div class="form-group">
      <label for="name">Name*</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        placeholder="Your name"
        autocomplete="name"
      />
      <div class="error-message" id="nameError"></div>
    </div>

    <div class="form-group">
      <label for="email">Email*</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        placeholder="your@email.com"
        autocomplete="email"
      />
      <div class="error-message" id="emailError"></div>
    </div>
  </div>

  <div class="form-row">
    <div class="form-group">
      <label for="phone">Phone</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        placeholder="Optional"
        autocomplete="tel"
      />
      <div class="error-message" id="phoneError"></div>
    </div>

    <div class="form-group">
      <label for="subject">Subject*</label>
      <select id="subject" name="subject" required>
        <option value="General">General</option>
        <option value="Code Review">Code Review</option>
        <option value="Workshop">Workshop</option>
        <option value="Development">Development</option>
        <option value="Feedback">Feedback</option>
        <option value="Other">Other</option>
      </select>
      <div class="error-message" id="subjectError"></div>
    </div>
  </div>

  <div class="form-group">
    <label for="content">Message*</label>
    <textarea
      id="content"
      name="content"
      required
      placeholder="What are you building, and where does it hurt?"></textarea>
    <div class="error-message" id="contentError"></div>
  </div>

  <div class="turnstile-group">
    <div
      id="turnstileWidget"
      class="cf-turnstile"
      data-sitekey={turnstileSiteKey}
      data-callback="onTurnstileSuccess"
      data-expired-callback="onTurnstileExpired"
      data-theme="light"
    >
    </div>
    <div id="turnstilePlaceholder" class="turnstile-placeholder" hidden>
      <span>Spam protection needs a cookie to load.</span>
      <button type="button" id="enableTurnstile">Accept cookies to enable</button>
    </div>
    <div class="error-message" id="turnstileError"></div>
  </div>

  <div class="submit-group">
    <button type="submit" id="contactSubmit">
      <span id="submitText">Send message</span>
      <span id="submitCheck" style="display:none;">Sent ✔</span>
    </button>
    <div class="error-message" id="submitError"></div>
  </div>
</form>
  </div>
</section>

<script>
  // Links such as "Plan your project" or "Book workshop" carry a
  // data-subject attribute; preselect that subject when they are followed.
  // A data-message attribute (tier and workshop buttons) is dropped into
  // the message field when it is still empty, so the enquiry names what
  // the visitor was looking at.
  const subjectSelect = document.getElementById(
    "subject",
  ) as HTMLSelectElement | null;
  const messageField = document.getElementById(
    "content",
  ) as HTMLTextAreaElement | null;
  if (subjectSelect) {
    document
      .querySelectorAll<HTMLAnchorElement>('a[href="#contactForm"][data-subject]')
      .forEach((link) => {
        link.addEventListener("click", () => {
          const subject = link.dataset.subject ?? "";
          const exists = Array.from(subjectSelect.options).some(
            (option) => option.value === subject,
          );
          if (exists) {
            subjectSelect.value = subject;
            subjectSelect.dispatchEvent(new Event("input", { bubbles: true }));
          }
          const message = link.dataset.message;
          if (message && messageField && messageField.value.trim() === "") {
            messageField.value = message + "\n\n";
            messageField.dispatchEvent(new Event("input", { bubbles: true }));
          }
        });
      });
  }
</script>

<script>
  // Load Cloudflare Turnstile (which may set a cookie) only after the visitor
  // has accepted cookies. Until then, show a placeholder that lets them opt in.
  const CONSENT_KEY = "cookie-consent";
  const TURNSTILE_SRC =
    "https://challenges.cloudflare.com/turnstile/v0/api.js";

  function hasConsent(): boolean {
    try {
      return localStorage.getItem(CONSENT_KEY) === "accepted";
    } catch {
      return false;
    }
  }

  let turnstileLoaded = false;
  function loadTurnstile() {
    if (turnstileLoaded) return;
    turnstileLoaded = true;
    const placeholder = document.getElementById("turnstilePlaceholder");
    if (placeholder) placeholder.hidden = true;
    const script = document.createElement("script");
    script.src = TURNSTILE_SRC;
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  function showPlaceholder() {
    const placeholder = document.getElementById("turnstilePlaceholder");
    if (placeholder) placeholder.hidden = false;
  }

  if (hasConsent()) {
    loadTurnstile();
  } else {
    showPlaceholder();
  }

  // React when the visitor accepts cookies via the consent banner.
  window.addEventListener("cookie-consent-changed", (e: Event) => {
    if ((e as CustomEvent).detail === "accepted") loadTurnstile();
  });

  // The "Accept cookies to enable" button reopens the consent banner.
  document
    .getElementById("enableTurnstile")
    ?.addEventListener("click", () => {
      (window as any).openCookieConsent?.();
    });
</script>

<script>
  if (typeof window !== "undefined") {
    const form = document.getElementById(
      "contactForm",
    ) as HTMLFormElement | null;
    const button = document.getElementById(
      "contactSubmit",
    ) as HTMLButtonElement | null;
    const submitText = document.getElementById(
      "submitText",
    ) as HTMLSpanElement | null;
    const submitCheck = document.getElementById(
      "submitCheck",
    ) as HTMLSpanElement | null;
    const submitError = document.getElementById(
      "submitError",
    ) as HTMLDivElement | null;

    // Turnstile token state
    let turnstileToken: string = "";

    // Global callbacks for Turnstile widget
    (window as any).onTurnstileSuccess = (token: string) => {
      turnstileToken = token;
      const turnstileError = document.getElementById(
        "turnstileError",
      ) as HTMLDivElement | null;
      if (turnstileError) turnstileError.textContent = "";
      validateForm();
    };
    (window as any).onTurnstileExpired = () => {
      turnstileToken = "";
      validateForm();
    };

    type Field = {
      id: string;
      errorId: string;
      required: boolean;
      label: string;
      type?: string;
    };
    const fields: Field[] = [
      { id: "name", errorId: "nameError", required: true, label: "Name" },
      {
        id: "email",
        errorId: "emailError",
        required: true,
        label: "Email",
        type: "email",
      },
      {
        id: "phone",
        errorId: "phoneError",
        required: false,
        label: "Phone",
        type: "tel",
      },
      {
        id: "subject",
        errorId: "subjectError",
        required: true,
        label: "Subject",
      },
      {
        id: "content",
        errorId: "contentError",
        required: true,
        label: "Message",
      },
    ];

    // Track dirty state and submission
    const dirty: { [key: string]: boolean } = {};
    let formSubmitted = false;

    fields.forEach((f) => {
      dirty[f.id] = false;
    });

    function validateField(field: Field): boolean {
      const input = document.getElementById(field.id) as
        | HTMLInputElement
        | HTMLTextAreaElement
        | HTMLSelectElement
        | null;
      const errorDiv = document.getElementById(
        field.errorId,
      ) as HTMLDivElement | null;
      let value =
        input &&
        typeof (
          input as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        ).value === "string"
          ? (
              input as
                | HTMLInputElement
                | HTMLTextAreaElement
                | HTMLSelectElement
            ).value.trim()
          : "";
      let error = "";
      if (field.required && !value) {
        error = `${field.label} is required.`;
      } else if (field.type === "email" && value) {
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailPattern.test(value)) {
          error = "Please enter a valid email address.";
        }
      }
      // Only show error if dirty or form submitted
      if (errorDiv) {
        if (dirty[field.id] || formSubmitted) {
          errorDiv.textContent = error;
        } else {
          errorDiv.textContent = "";
        }
      }
      return !error;
    }

    function validateForm(): boolean {
      let valid = true;
      for (const field of fields) {
        if (!validateField(field)) valid = false;
      }
      const hasTurnstile = !!turnstileToken;
      if (button) button.disabled = !valid || !hasTurnstile;
      return valid && hasTurnstile;
    }

    if (form) {
      // Mark fields as dirty on change
      fields.forEach((field) => {
        const input = document.getElementById(field.id) as
          | HTMLInputElement
          | HTMLTextAreaElement
          | HTMLSelectElement
          | null;
        if (input) {
          input.addEventListener("input", () => {
            dirty[field.id] = true;
            validateField(field);
            validateForm();
          });
        }
      });
      window.addEventListener("DOMContentLoaded", validateForm);

      form.addEventListener("submit", async (e: Event) => {
        e.preventDefault();
        formSubmitted = true;
        if (submitError) submitError.textContent = "";
        validateForm();
        if (!validateForm()) {
          return;
        }

        // Validate Turnstile
        const turnstileError = document.getElementById(
          "turnstileError",
        ) as HTMLDivElement | null;
        if (!turnstileToken) {
          if (turnstileError)
            turnstileError.textContent =
              "Please complete the verification.";
          return;
        }

        if (button) button.disabled = true;
        if (submitText) submitText.style.display = "none";
        if (submitCheck) submitCheck.style.display = "none";

        const getValue = (id: string): string => {
          const el = document.getElementById(id) as
            | HTMLInputElement
            | HTMLTextAreaElement
            | HTMLSelectElement
            | null;
          return el && typeof el.value === "string" ? el.value : "";
        };
        const name = getValue("name");
        const email = getValue("email");
        const phone = getValue("phone");
        const subject = getValue("subject");
        const message = getValue("content");
        const website = getValue("website"); // Honeypot

        try {
          const res = await fetch("/api/send-contact-email", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name,
              email,
              phone,
              subject,
              message,
              website,
              turnstileToken,
            }),
          });
          if (res.ok) {
            // Success: show checkmark, reset form, clear errors
            if (submitCheck) submitCheck.style.display = "inline";
            if (submitText) submitText.style.display = "none";
            setTimeout(() => {
              if (submitCheck) submitCheck.style.display = "none";
              if (submitText) submitText.style.display = "inline";
            }, 1500);
            if (typeof form.reset === "function") form.reset();
            fields.forEach((f) => {
              const errDiv = document.getElementById(
                f.errorId,
              ) as HTMLDivElement | null;
              if (errDiv) errDiv.textContent = "";
              dirty[f.id] = false;
            });
            formSubmitted = false;
            // Reset Turnstile widget for next submission
            turnstileToken = "";
            if ((window as any).turnstile) {
              (window as any).turnstile.reset("#turnstileWidget");
            }
            validateForm();
          } else {
            if (submitError)
              submitError.textContent =
                "Failed to send message. Please try again.";
            if (button) button.disabled = false;
            if (submitText) submitText.style.display = "inline";
            if (submitCheck) submitCheck.style.display = "none";
          }
        } catch (err) {
          if (submitError)
            submitError.textContent =
              "An error occurred. Please try again later.";
          if (button) button.disabled = false;
          if (submitText) submitText.style.display = "inline";
          if (submitCheck) submitCheck.style.display = "none";
        }
      });
    }
  }
</script>

<style>
  .contact {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .contact__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  /* --- Intro column --- */

  .contact__intro {
    display: flex;
    flex-direction: column;
    gap: var(--spacer-lg);
  }

  .contact__title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .contact__lede {
    font-family: synonym, sans-serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--color-ink-muted);
    max-width: 48ch;
  }

  .next-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacer-md);
    margin-top: var(--spacer-base);
  }

  .next-step {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    gap: var(--spacer-md);
    align-items: start;
  }

  .next-step__marker {
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-light-raised);
    background: var(--color-accent-strong);
  }

  .next-step__copy {
    font-family: synonym, sans-serif;
    line-height: 1.5;
    color: var(--color-ink);
    padding-top: 0.15rem;
    max-width: 44ch;
  }

  .contact__direct {
    font-family: synonym, sans-serif;
    color: var(--color-ink-muted);
  }

  .contact__direct a {
    color: var(--color-accent-ink);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact__direct a:hover,
  .contact__direct a:focus-visible {
    color: var(--color-accent-strong);
  }

  /* --- Form --- */

  .contact-form {
    scroll-margin-top: calc(56px + 1rem);
    display: flex;
    flex-direction: column;
    gap: var(--spacer-md);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    background: var(--color-light-raised);
    border: 1px solid var(--color-stroke);
    border-radius: 22px;
    box-shadow: 0 24px 50px rgba(11, 18, 32, 0.1);
    width: 100%;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacer-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
  }

  .contact-form label {
    font-size: var(--font-md);
    font-weight: var(--font-weight-medium);
    color: var(--color-ink);
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    margin-top: 0.35rem;
    font-family: synonym, sans-serif;
    font-size: 1rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--color-stroke-strong);
    border-radius: 0.6rem;
    background: var(--color-light);
    color: var(--color-ink);
    outline: none;
    width: 100%;
    transition:
      border-color 0.15s,
      box-shadow 0.15s,
      background-color 0.15s;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #8a93a6;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    border-color: var(--color-accent);
    background: var(--color-light-raised);
    box-shadow: 0 0 0 3px rgba(47, 125, 209, 0.22);
  }

  .contact-form select {
    cursor: pointer;
    padding-right: 2.5rem;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg fill="none" height="20" viewBox="0 0 20 20" width="20" xmlns="http://www.w3.org/2000/svg"><path d="M6 8L10 12L14 8" stroke="%23363d4b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>');
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 1.2em;
  }

  .contact-form textarea {
    min-height: 140px;
    resize: vertical;
  }

  .submit-group {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.3rem;
    margin-top: var(--spacer-base);
  }

  .contact-form button[type="submit"] {
    background: var(--color-accent-strong);
    color: var(--color-light-raised);
    border: 1px solid var(--color-accent-strong);
    padding: 0.95rem 2rem;
    border-radius: 999px;
    font-size: 1.1rem;
    font-weight: var(--font-weight-bold);
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .contact-form button[type="submit"]:hover:not(:disabled) {
    background: var(--color-accent-ink);
    border-color: var(--color-accent-ink);
  }

  .contact-form button[type="submit"]:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }

  .contact-form button[type="submit"]:disabled {
    background: var(--color-stroke);
    border-color: var(--color-stroke);
    color: var(--color-ink-muted);
    cursor: not-allowed;
  }

  #submitCheck {
    color: inherit;
  }

  .error-message {
    font-family: synonym, sans-serif;
    color: var(--color-danger);
    font-size: 0.9rem;
    margin-top: 0.2rem;
    min-height: 1.2em;
  }

  .turnstile-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .turnstile-placeholder[hidden] {
    display: none;
  }

  .turnstile-placeholder {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border: 1px dashed var(--color-stroke-strong);
    border-radius: 0.6rem;
    background: var(--color-light);
    font-family: synonym, sans-serif;
    font-size: 0.95rem;
    color: var(--color-ink-muted);
  }

  .turnstile-placeholder button {
    background: transparent;
    border: 1px solid var(--color-accent-strong);
    color: var(--color-accent-ink);
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: var(--font-weight-semi-bold);
    cursor: pointer;
    transition:
      background 0.2s,
      color 0.2s;
  }

  .turnstile-placeholder button:hover {
    background: var(--color-accent-strong);
    color: var(--color-light-raised);
  }

  /* --- Wider screens --- */

  @media (min-width: 600px) {
    .form-row {
      grid-template-columns: 1fr 1fr;
    }

    .submit-group {
      align-items: flex-start;
    }
  }

  @media (min-width: 960px) {
    .contact__inner {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }

    .contact__intro {
      position: sticky;
      top: calc(56px + 2rem);
    }
  }
</style>
