---
interface Props {
  number: string;
  title: string;
  subtitle?: string;
  description?: string;
}

const { number, title, subtitle, description } = Astro.props as Props;
---

<div class="card">
  <header>
    <div class="header-text">
      {
        (
          <h3>
            <slot name="subtitle">{subtitle}</slot>
          </h3>
        )
      }
      <h2>{title}</h2>
    </div>
    <span class="number">{number}</span>
  </header>
  {
    (
      <p>
        <slot name="description">{description}</slot>
      </p>
    )
  }
</div>

<style>
  .card {
    border-radius: 10px;
    padding: 24px;
    background: linear-gradient(var(--color-nude), var(--color-accent))
      padding-box;
  }

  .card header {
    display: flex;
    align-items: end;
    margin-bottom: var(--spacer-lg);
  }

  .card header h2 {
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-bold);
  }

  .card header h3 {
    font-size: var(--font-lg);
    font-weight: var(--font-weight-semi-bold);
  }

  .card header .header-text span {
    color: var(--color-accent);
  }

  .card .number {
    line-height: 1;
    font-size: 10rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-stone);
    transform: rotate(-90deg);
    opacity: 0.5;
  }

  p {
    font-size: var(--font-lg);
    padding-right: var(--spacer-2xl);
    font-family: var(--font-secondary);
  }
</style>
