---
import { Image } from "astro:assets";
interface Props {
  title: string;
  image: ImageMetadata;
  subtitle?: string;
  description?: string;
}

const { title, image, subtitle, description } = Astro.props as Props;
---

<div class="card">
  <header>
    <div class="header-text">
      <slot name="subtitle">{subtitle}</slot>
      <h2>{title}</h2>
    </div>
    <!-- <span class="number">{number}</span> -->
    <Image
      src={image}
      width={200}
      height={200}
      alt="Decorative architecture image"
    />
  </header>
  {
    (
      <p>
        <slot name="description">{description}</slot>
      </p>
    )
  }
</div>

<style>
  .card {
    border-radius: 10px;
  }

  .card header {
    display: flex;
    align-items: anchor-center;
  }

  .card header h2 {
    color: var(--color-text);
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-bold);
  }

  .card header .header-text span {
    color: var(--color-accent);
  }

  .card .number {
    line-height: 1.1;
    font-size: 10rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-stone);
    opacity: 0.3;
  }

  p {
    font-size: var(--font-lg);
    padding-right: var(--spacer-2xl);
    font-family: var(--font-secondary);
  }
</style>
