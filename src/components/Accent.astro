---
/**
 * Inline word(s) that take on an accent colour with a left-to-right wipe as
 * they scroll into view.
 *
 * Two layers, each a clipping box with a counter-translated copy inside so
 * the text itself never appears to move: the base-coloured layer slides out
 * to the right while the accent-coloured layer slides in from the left.
 * The two windows are complementary and never overlap, so no anti-aliased
 * fringe of the base colour shows around the accent glyphs. Transforms only,
 * so scrolling never repaints these words.
 *
 * Styling lives in global.scss (.accent / .danger). `range` and `timeline`
 * are passed down as CSS custom properties so parents can tune the
 * scroll-driven animation without reaching into this component's markup.
 *
 * The accent copy is aria-hidden; assistive technology reads the slot once.
 */
interface Props {
  /** Colour token: "accent" (success green) or "danger" (red). */
  tone?: "accent" | "danger";
  /** animation-range for the reveal, e.g. "entry 80% entry 95%". */
  range?: string;
  /**
   * animation-range used on phones (max-width 640px) instead of `range`.
   * A flick scrolls hundreds of pixels at once, so a wipe that spans a
   * narrow band of the viewport is over before anyone sees it; give it a
   * wider range here.
   */
  mobileRange?: string;
  /** Named scroll/view timeline to drive the reveal; defaults to the element's own view timeline. */
  timeline?: string;
}

const { tone = "accent", range, mobileRange, timeline } = Astro.props;

const style = [
  range && `--accent-range: ${range}`,
  mobileRange && `--accent-range-mobile: ${mobileRange}`,
  timeline && `--accent-timeline: ${timeline}`,
]
  .filter(Boolean)
  .join("; ");
---

<span class={tone} style={style || undefined}>
  <span class="accent__base">
    <span class="accent__base-copy"><slot /></span>
  </span>
  <span class="accent__clip" aria-hidden="true">
    <span class="accent__copy"><slot /></span>
  </span>
</span>
