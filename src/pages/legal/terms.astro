    <strong>{COMPANY.name}</strong><br />
    {COMPANY.street}<br />
    {COMPANY.postalCode} {COMPANY.city}, {COMPANY.country}<br />
    Tel: <a href={`tel:${COMPANY.phone}`}>{COMPANY.phone}</a><br />
    Email: <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
    Chamber of Commerce (KVK): {COMPANY.kvk}<br />
    VAT (BTW): {COMPANY.btw}
  </address>

  <h2>2. Use of the website</h2>
