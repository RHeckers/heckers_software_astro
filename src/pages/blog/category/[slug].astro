---
import BlogListing from "../../../components/BlogListing.astro";
import PageLayout from "../../../layouts/PageLayout.astro";
import {
  categoryGroups,
  getSortedPosts,
  type BlogPost,
} from "../../../lib/blog";
import type { BlogCategory } from "../../../lib/categories";

interface Props {
  category: BlogCategory;
  posts: BlogPost[];
  categories: BlogCategory[];
}

export async function getStaticPaths() {
  // Routes come straight from the categories the posts use, so adding a new
  // label to a post's frontmatter is all it takes to get a category page.
  const groups = categoryGroups(await getSortedPosts());
  const categories = groups.map((group) => group.category);

  return groups.map((group) => ({
    params: { slug: group.slug },
    props: {
      category: group.category,
      posts: group.posts,
      categories,
    } satisfies Props,
  }));
}

const { category, posts, categories } = Astro.props;
const count = posts.length;
const title = `${category} articles — Heckers Software`;
const description = `${count} ${count === 1 ? "article" : "articles"} about ${category} from Heckers Software: practical guidance on Angular, Nx monorepos, and frontend architecture.`;
---

<PageLayout title={title} description={description} themeToggle>
  <BlogListing
    heading={`${category} articles`}
    intro={`Everything we have written about ${category}.`}
    posts={posts}
    categories={categories}
    active={category}
  />
</PageLayout>
