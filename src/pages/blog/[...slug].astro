---
import { render } from "astro:content";
import CategoryChips from "../../components/CategoryChips.astro";
import NewsletterBar from "../../components/NewsletterBar.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import logo from "../../assets/logos/logo.png";
import { AUTHOR, PROFILES, SITE_TITLE, profileLinks } from "../../consts";
import {
  formatDate,
  getSortedPosts,
  postHref,
  relatedPosts,
  type BlogPost,
} from "../../lib/blog";

interface Props {
  post: BlogPost;
  related: BlogPost[];
}

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) } satisfies Props,
  }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, heroImage, categories } =
  post.data;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const heroURL = heroImage ? new URL(heroImage.src, Astro.site).href : undefined;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  description,
  ...(heroURL && { image: [heroURL] }),
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    "@type": "Person",
    name: AUTHOR.name,
    url: AUTHOR.url,
    jobTitle: AUTHOR.jobTitle,
    sameAs: profileLinks(),
  },
  publisher: {
    "@type": "Organization",
    name: SITE_TITLE,
    url: Astro.site?.href,
    logo: {
      "@type": "ImageObject",
      url: new URL(logo.src, Astro.site).href,
    },
  },
  keywords: [...categories],
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
};
---

<PageLayout
  title={title}
  description={description}
  image={heroImage}
  type="article"
  article={{
    publishedTime: pubDate,
    modifiedTime: updatedDate,
    author: AUTHOR.name,
    tags: categories,
  }}
  jsonLd={jsonLd}
  themeToggle
>
  <article class="post">
    <header>
      <div class="header-meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <a href="/blog/" class="back-link">&larr; All posts</a>
      </div>
      {
        updatedDate && (
          <span class="updated">(Updated: {formatDate(updatedDate)})</span>
        )
      }
      <h1 class="title">{title}</h1>
      <div class="post-categories">
        <CategoryChips categories={categories} />
      </div>
      {
        heroImage && (
          <img src={heroImage.src} alt={title} width="960" height="480" />
        )
      }
    </header>

    <div class="prose" id="post-body">
      <Content />
    </div>

    <NewsletterForm
      id="newsletter"
      variant="card"
      heading="Liked this one? The next one can land in your inbox."
      text="Every post, the day it goes out, and nothing else: one real problem from an Angular, Nx or .NET codebase, worked through to a decision you can reuse."
    />

    <aside class="author" aria-labelledby="author-heading">
      <p class="author__label" id="author-heading">Written by</p>
      <p class="author__name">
        <a href="/about">{AUTHOR.name}</a>
      </p>
      <p class="author__bio">{AUTHOR.bio}</p>
      <ul class="author__links">
        <li><a href="/about">About Heckers Software</a></li>
        {
          PROFILES.linkedin && (
            <li>
              <a href={PROFILES.linkedin} rel="me noopener noreferrer" target="_blank">
                LinkedIn
              </a>
            </li>
          )
        }
        <li>
          <a href={PROFILES.book.url} target="_blank" rel="noopener noreferrer">
            {PROFILES.book.title} ({PROFILES.book.publisher},{" "}
            {PROFILES.book.year})
          </a>
        </li>
      </ul>
    </aside>

    <aside class="cta">
      <h2>Ready to level up your Angular&nbsp;or&nbsp;Nx project?</h2>
      <p>
        Our engineers help teams ship faster with clean architecture, scalable
        Nx monorepos, and battle-tested Angular patterns. Whether you need a
        code review, hands-on support, or a full architecture overhaul, we've
        got you covered!
      </p>
      <a href="/#contactForm" class="cta-button">Get in touch</a>
    </aside>

    {
      related.length > 0 && (
        <aside class="more-posts" aria-labelledby="more-posts-heading">
          <h2 id="more-posts-heading">More posts</h2>
          <ul>
            {related.map((item) => (
              <li>
                <a href={postHref(item)}>{item.data.title}</a>
                <time datetime={item.data.pubDate.toISOString()}>
                  {formatDate(item.data.pubDate)}
                </time>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <footer>
      <a href="/blog/">&larr; Back to all posts</a>
    </footer>
  </article>

  <NewsletterBar watch="#post-body" target="newsletter" />
</PageLayout>

<style>
  /* Base: synonym for body text, ink color — children inherit */
  .post {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(6rem, 10vw, 8rem) 1.5rem 4rem;
    font-family: "synonym", sans-serif;
    color: var(--color-ink);
  }

  /* Display font for headings, table headers, buttons */
  h1,
  .prose :global(h2),
  .prose :global(h3),
  .prose :global(th),
  .cta h2,
  .cta-button {
    font-family: "chillax", sans-serif;
  }

  /* Monospace for code */
  .prose :global(pre),
  .prose :global(code) {
    font-family:
      ui-monospace, "Cascadia Code", "Fira Code", Menlo, Consolas, monospace;
  }

  /* --- Header --- */

  header {
    margin-bottom: 2rem;
  }

  .header-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  time,
  .back-link,
  .updated {
    font-size: var(--font-sm);
  }

  time,
  .updated {
    color: var(--color-ink-muted);
  }

  .updated {
    font-style: italic;
  }

  .back-link {
    color: var(--color-link);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  h1 {
    font-size: var(--font-3xl);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    margin: 0.5rem 0 1.5rem;
  }

  .post-categories {
    margin: -0.5rem 0 1.5rem;
  }

  header img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    object-fit: cover;
  }

  /* --- Prose (markdown content) --- */

  .prose {
    font-size: var(--font-md);
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.2;
    margin: 2rem 0 0.75rem;
  }

  .prose :global(h2) {
    font-size: var(--font-2xl);
  }

  .prose :global(h3) {
    font-size: var(--font-xl);
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-link-hover);
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .prose :global(pre) {
    background: var(--color-dark);
    color: var(--color-ink-light);
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: var(--font-sm);
    line-height: 1.6;
  }

  .prose :global(code) {
    font-size: 0.9em;
  }

  .prose :global(:not(pre) > code) {
    background: var(--color-light-alt);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .prose :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .prose :global(.table-wrapper) {
    overflow-x: auto;
    margin: 1.5rem 0;
    -webkit-overflow-scrolling: touch;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-sm);
    line-height: 1.6;
  }

  .prose :global(thead) {
    background: var(--color-dark);
    color: var(--color-ink-light);
  }

  .prose :global(th) {
    font-weight: var(--font-weight-semi-bold);
    text-align: left;
    padding: 0.75rem 1.25rem;
  }

  .prose :global(td) {
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-stroke);
    vertical-align: top;
  }

  .prose :global(tbody tr:hover) {
    background: var(--color-light-alt);
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-stroke);
    margin: 2rem 0;
  }

  /* The signup card follows the article body directly. */
  .post > :global(.nl) {
    margin-top: 3rem;
  }

  /* --- CTA --- */

  .cta {
    margin-top: 3rem;
    padding: 2.5rem;
    background: var(--color-dark);
    border-radius: 12px;
    text-align: center;
  }

  .cta h2 {
    font-size: var(--font-xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-light);
    margin: 0 0 0.75rem;
    line-height: 1.2;
  }

  .cta p {
    color: var(--color-ink-light);
    opacity: 0.85;
    line-height: 1.7;
    max-width: 560px;
    margin: 0 auto 1.5rem;
  }

  .cta-button {
    display: inline-block;
    font-weight: var(--font-weight-semi-bold);
    color: var(--color-dark);
    background: var(--color-light);
    padding: 0.75rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    transition:
      background 200ms ease,
      transform 200ms ease;
  }

  .cta-button:hover {
    background: #fff;
    transform: translateY(-1px);
  }

  /* The CTA keeps its brand-dark panel in both themes, so only the pill
     inside it needs help: --color-light is the dark page now. */
  :global(:root[data-theme="dark"]) .cta {
    border: 1px solid var(--color-stroke);
  }

  :global(:root[data-theme="dark"]) .cta-button {
    color: var(--color-dark);
    background: var(--color-ink);
  }

  /* --- More posts --- */

  .more-posts {
    margin-top: 3rem;
  }

  .more-posts h2 {
    font-family: "chillax", sans-serif;
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
    line-height: 1.2;
    margin: 0 0 1rem;
  }

  .more-posts ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .more-posts li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
  }

  .more-posts a {
    color: var(--color-link);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .more-posts a:hover {
    color: var(--color-link-hover);
  }

  /* --- Footer --- */

  footer {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-stroke);
  }

  footer a {
    color: var(--color-link);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
  }

  footer a:hover {
    text-decoration: underline;
  }

  @media (max-width: 769px) {
    .title {
      font-size: var(--font-2xl);
    }

    .prose :global(h2),
    .prose :global(h3) {
      font-size: var(--font-xl);
    }
  }

  /* --- Author block --- */

  .author {
    margin: 2.5rem 0;
    padding: 1.5rem 1.75rem;
    border: 1px solid var(--color-stroke);
    border-radius: 16px;
    display: grid;
    gap: 0.5rem;
  }

  .author__label {
    font-size: var(--font-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .author__name {
    font-family: "chillax", sans-serif;
    font-size: var(--font-xl);
    font-weight: var(--font-weight-medium);
  }

  .author__name a {
    color: inherit;
    text-decoration: none;
  }

  .author__name a:hover {
    color: var(--color-link);
  }

  .author__bio {
    line-height: 1.6;
    max-width: 68ch;
  }

  .author__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0;
    margin-top: 0.5rem;
    font-size: var(--font-sm);
  }

  .author__links a {
    color: var(--color-link);
    font-weight: var(--font-weight-medium);
  }
</style>
