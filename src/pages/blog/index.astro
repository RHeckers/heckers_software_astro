---
import BlogListing from "../../components/BlogListing.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { categoriesWithPosts, getSortedPosts, postHref } from "../../lib/blog";

const posts = await getSortedPosts();
const categories = categoriesWithPosts(posts);

const siteUrl = Astro.site?.href ?? "https://heckerssoftware.com/";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${siteUrl}blog/#blog`,
  name: "Heckers Software Blog",
  url: `${siteUrl}blog/`,
  inLanguage: "en",
  publisher: { "@id": `${siteUrl}#organization` },
  blogPost: posts.map((post) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    url: new URL(postHref(post), Astro.site).href,
    datePublished: post.data.pubDate.toISOString(),
  })),
};
---

<PageLayout
  title="Angular, Nx & AI Engineering Blog | Heckers Software"
  description="Practical articles on Angular, Nx monorepos, AI-driven front ends and the architecture decisions that keep large frontends fast and maintainable."
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Blog", path: "/blog/" }]}
  themeToggle
>
  <BlogListing
    heading="Blog"
    intro="Practical articles on Angular, Nx monorepos, and the architecture decisions that keep large frontends fast and maintainable."
    posts={posts}
    categories={categories}
  />
</PageLayout>
