---
import BlogListing from "../../components/BlogListing.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { categoriesWithPosts, getSortedPosts } from "../../lib/blog";

const posts = await getSortedPosts();
const categories = categoriesWithPosts(posts);
---

<PageLayout
  title="Blog — Heckers Software"
  description="Insights on software architecture, code analysis, and building reliable systems."
>
  <BlogListing
    heading="Blog"
    intro="Practical articles on Angular, Nx monorepos, and the architecture decisions that keep large frontends fast and maintainable."
    posts={posts}
    categories={categories}
  />
</PageLayout>
