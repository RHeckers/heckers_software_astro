---
import { getCollection } from "astro:content";
import PageLayout from "../../layouts/PageLayout.astro";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<PageLayout
  title="Blog — Heckers Software"
  description="Insights on software architecture, code analysis, and building reliable systems."
>
  <section class="blog-listing">
    <h1>Blog</h1>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`}>
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage.src}
                  alt={post.data.title}
                />
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</PageLayout>

<style>
  .blog-listing {
    max-width: 1100px;
    margin: 0 auto;
    padding: clamp(6rem, 10vw, 8rem) 1.5rem 4rem;
    color: var(--color-ink);
  }

  h1 {
    font-size: var(--font-3xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: 2rem;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  li {
    border: 1px solid var(--color-stroke);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 200ms ease;
  }

  li:hover {
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
