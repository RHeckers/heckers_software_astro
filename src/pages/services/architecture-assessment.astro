---
/**
 * Service page: the architecture assessment. The page sells a diagnosis,
 * so its own elements are the ones a diagnosis produces: a project graph
 * being read and put in order (the hero), the same graph to hover over
 * (what we do), and a page of the report itself (what you gain).
 *
 * The same eight-step journey as the home page, a line per point, no
 * paragraphs. Grounds alternate dark and light all the way down (the
 * self-check counts as dark: it is one dark panel; the client quotes are
 * the second half of the dark process band).
 *
 *   1. The promise      What can you help me achieve?     Hero (ArchScan)
 *   2. The challenge    Do you understand my problem?     EvidenceBand, SymptomCheck
 *   3. What we do       How can you help me?              Approach, with the project graph
 *   4. What you gain    What changes for my company?      ReportSample
 *   5. How we do it     What is it like to work together? ProcessSteps
 *   6. Why us + proof   Why should I trust you?           ProofRow
 *   7. Who we are       Who will I actually work with?    Founder
 *   8. Take the leap    How do we get started?            Faq, Tiers
 *
 * The contact form opens in a dialog from every call to action and the
 * footer is the compact one, so the last thing a reader sees is the price.
 */
import PageLayout from "../../layouts/PageLayout.astro";
import HeroShell from "../../components/services/hero/HeroShell.astro";
import ArchScan from "../../components/services/hero/ArchScan.astro";
import Approach from "../../components/services/Approach.astro";
import Founder from "../../components/services/Founder.astro";
import NxGraph from "../../components/art/NxGraph.astro";
import ReportSample from "../../components/services/ReportSample.astro";
import EvidenceBand from "../../components/services/EvidenceBand.astro";
import SymptomCheck from "../../components/services/SymptomCheck.astro";
import ProcessSteps from "../../components/services/ProcessSteps.astro";
import Tiers from "../../components/services/Tiers.astro";
import Faq from "../../components/services/Faq.astro";
import { FAQS } from "../../lib/faqs";
import ProofQuote from "../../components/ProofQuote.astro";
import ProofRow from "../../components/ProofRow.astro";
import ContactDialog from "../../components/ContactDialog.astro";
import { COMPANY } from "../../consts";
import { getService } from "../../lib/services";
import { PRICING, VAT_NOTE, euro } from "../../lib/pricing";

const service = getService("architecture-assessment");
const price = PRICING.assessment;

const title = "Angular & Nx Architecture Assessment | Heckers Software";
const description =
  "A fixed-scope assessment of your Angular or Nx codebase by a senior engineer: every finding ranked by cost, with the fix, and a roadmap your team can execute.";

const tiers = [
  {
    name: "Minimum",
    tagline: "A structural scan: where you stand and what to fix first.",
    duration: "One week",
    price: { amount: euro(price.minimum), detail: `fixed, ${VAT_NOTE}` },
    includes: [
      "Project graph, dependency and boundary analysis",
      "Bundle size and build time analysis",
      "The ten costliest findings, ranked, each with its fix",
      "A 60-minute walkthrough with your lead developers",
    ],
  },
  {
    name: "Standard",
    badge: "Most teams choose this",
    recommended: true,
    tagline: "The full picture, and a plan your team can run itself.",
    duration: "Two to three weeks",
    price: { amount: euro(price.standard), detail: `fixed, ${VAT_NOTE}` },
    includes: [
      "Everything in Minimum",
      "Interviews with developers, leads and product",
      "Testing strategy and Nx setup reviewed",
      "Full report: every finding ranked, with fix and effort",
      "Roadmap session, then thirty days of follow-up",
    ],
  },
  {
    name: "Advanced",
    tagline: "The top findings fixed by me, not just found.",
    duration: "Three weeks, then execution in sprints",
    price: {
      amount: "On quote",
    },
    includes: [
      "Everything in Standard",
      "I implement the top findings with your developers",
      "Module boundaries enforced in lint and build",
      "Review of the first pull requests after the roadmap",
      "Monthly check-in for one quarter",
    ],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Architecture assessment for Angular and Nx",
  serviceType: "Software architecture assessment",
  description,
  url: new URL(service.href, Astro.site).toString(),
  provider: {
    "@type": "Organization",
    "@id": new URL("/#organization", Astro.site).href,
    name: COMPANY.name,
    url: Astro.site?.href,
    email: COMPANY.email,
    telephone: COMPANY.phone,
  },
  areaServed: "Europe",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Assessment tiers",
    itemListElement: tiers.map((tier) => ({
      "@type": "Offer",
      name: `${tier.name} assessment`,
      description: tier.tagline,
    })),
  },
};
---

<PageLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Architecture assessment", path: service.href }]}
  compactFooter
>
  {/* 1. The promise */}
  <HeroShell
    eyebrow="Architecture assessment · Angular & Nx"
    ctaLabel={service.cta}
    subject={service.subject}
    note="Fixed price. Two to three weeks."
  >
    <ArchScan />
    <Fragment slot="title">
      Know what your codebase <em>costs you.</em>
    </Fragment>
  </HeroShell>

  {/* 2. The challenge */}
  <EvidenceBand
    title="What the numbers say"
    intro="None of them are mine."
    stats={[
      {
        value: "42%",
        label: "of developer time goes to maintenance and bad code.",
        source: "Stripe, The Developer Coefficient",
      },
      {
        value: "10–20%",
        label: "of the budget for new products is diverted to technical debt.",
        source: "McKinsey, Tech debt: reclaiming tech equity",
      },
      {
        value: "20–40%",
        label: "of the value of a technology estate is technical debt.",
        source: "McKinsey, Tech debt: reclaiming tech equity",
      },
    ]}
    meaning="The money is spent either way. The question is whether you know where."
  >
    <ProofQuote slot="proof" snippet="peterApproach" />
  </EvidenceBand>

  <SymptomCheck
    title="Fourteen signs your Angular or Nx architecture is costing you"
    intro="Untick what you can honestly rule out. What is left is your score."
    items={[
      "A one-line change rebuilds and retests the whole workspace instead of only what it touched.",
      "Nobody can say with confidence which libraries an app depends on without opening the code.",
      "Barrel files (index.ts) re-export whole folders for convenience.",
      "There is a shared or utils library that almost everything imports from.",
      "Bugs get fixed in one place and reappear in another.",
      "The Angular upgrade has been planned for after this release, for the third release in a row.",
      "The same piece of state lives in a service, a store and a component input at once.",
      "Tests are green, yet production incidents come from code that had tests.",
      "New developers need more than a month before their first confident merge.",
      "Estimates for small changes are consistently wrong by a factor of two or more.",
      "Certain files are only touched by one person, because nobody else dares.",
      "Lazy loading exists on paper, but the initial bundle keeps growing.",
      "Lint rules exist, but nothing in the build enforces which library may import which.",
      'The words "we should refactor" have been said about the same module for over a year.',
    ]}
    verdicts={[
      {
        min: 0,
        title: "Healthy, for now.",
        copy: "Keep the discipline. An assessment now is the cheapest one you will ever buy.",
      },
      {
        min: 3,
        title: "Early decay.",
        copy: "The cost is still invisible in your planning. This is when it is cheapest to fix.",
      },
      {
        min: 6,
        title: "Compounding.",
        copy: "Your team pays the maintenance tax every sprint, and the fix grows every quarter.",
      },
      {
        min: 10,
        title: "Critical.",
        copy: "Feature work is mostly archaeology. You probably do not need a rewrite. You do need a diagnosis.",
      },
    ]}
    ctaLabel="Talk about your score"
    subject={service.subject}
    preChecked
  />

  {/* 3. What we do */}
  <Approach
    title="I read the code. You get the roadmap."
    lede="A senior engineer, from the outside, in two to three weeks."
    verbs={[
      { verb: "Read", rest: "every project, dependency and boundary" },
      { verb: "Rank", rest: "each finding by what it costs you" },
      { verb: "Roadmap", rest: "the fixes for your own team" },
    ]}
  >
    <NxGraph
      before="Found"
      after="After the roadmap"
      caption="Your project graph, before and after. Hover a project to see what it depends on."
    />
  </Approach>

  {/* 4. What you gain */}
  <ReportSample
    title="Every finding comes with its cost and its fix"
    intro="One page per finding. Sorted by what it costs you."
    points={[
      "Ranked by cost per month, not by how ugly the code looks",
      "The concrete fix, with your library and file names in it",
      "An effort estimate your team can put in a sprint",
    ]}
    finding={{
      rank: "Finding 1 of 23",
      title: "One shared library is imported by 71% of the workspace",
      impact:
        "Every change to libs/shared rebuilds 38 of 52 projects. About forty minutes of CI per pull request.",
      evidence: [
        "Imported by 37 of 52 projects",
        "Average CI run: 41 minutes",
        "11 of the last 30 incidents trace back to it",
      ],
      fix: "Split it into domain libraries and a thin ui-kit. Enforce the split with tags and the boundary lint rule.",
      effort: "Three to four developer-days, over two sprints",
    }}
    note="Anonymised example from a Standard assessment. Names and numbers changed."
  />

  {/* 5. How we do it */}
  <ProcessSteps
    surface="dark"
    title="How the assessment runs"
    intro="Fixed scope. Fixed price. A few hours of your team's time."
    deliverablesTitle="What you receive"
    deliverables={[
      "A report with every finding ranked by cost, with fix and effort",
      "A dependency and boundary map with the violations marked",
      "An upgrade path for your Angular and Nx versions",
      "A roadmap sized to your team, and thirty days of follow-up",
    ]}
    steps={[
      {
        title: "Kickoff",
        when: "Day 1",
        copy: "What hurts, what is planned, what I may not touch. Read access to the repository is all I need.",
      },
      {
        title: "Deep dive",
        when: "Week 1–2",
        copy: "I read the code and the project graph, then talk to the people who work in it every day.",
      },
      {
        title: "Report",
        when: "Week 2–3",
        copy: "Every finding ranked by what it costs you, with the fix and the effort next to it.",
      },
      {
        title: "Roadmap with your team",
        when: "Week 3",
        copy: "I turn the findings into a plan that fits your capacity. Most teams run it themselves.",
      },
      {
        title: "Hands-on execution",
        when: "After the roadmap",
        optional: true,
        copy: "Want it done? I implement the fixes inside your codebase, together with your developers.",
      },
    ]}
    ctaLabel={service.cta}
    subject={service.subject}
  />

  {/* 6. Why us + proof */}
  <ProofRow
    title="Why teams trust me with their code"
    lede="The words of people who had me inside their codebase."
    snippets={["ferdiDepth", "peterLasting", "marcChallenges"]}
    service="architecture-assessment"
  />

  {/* 7. Who we are */}
  <Founder stage="code" title="Recognized and proven Angular and Nx expert" />

  {/* 8. Take the leap */}
  <Faq
    tone="dark"
    title="Questions I hear first"
    items={FAQS["architecture-assessment"]}
  />

  <Tiers
    title="Three ways to start"
    intro="Fixed prices. The number does not change during the assessment."
    serviceName="architecture assessment"
    subject={service.subject}
    tiers={tiers}
    note={`Minimum and Standard are fixed, ${VAT_NOTE}, for workspaces up to about fifty projects. Larger workspaces get a fixed quote after a thirty-minute call. Advanced adds execution, quoted after the roadmap.`}
    otherLabel="Tell me about your codebase"
  />

  <ContactDialog />
</PageLayout>
