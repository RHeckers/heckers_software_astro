---
/**
 * Service page: forward-deployed engineering, the main offer. One
 * industry expert, amplified by AI, who comes into a company and delivers
 * outcomes end to end: discovery, development, AI integration and
 * deployment.
 *
 * The same eight-step journey as the home page, told for this one service
 * in the service pages' own blocks: diagram rows, pinned left and right
 * columns, the stepped rail, ticks that draw themselves. Every section is
 * short on purpose: a line per point, no paragraphs. Grounds alternate
 * dark and light all the way down (the self-check counts as dark: it is
 * one dark panel).
 *
 *   1. The promise      What can you help me achieve?     Hero
 *   2. The challenge    Do you understand my problem?     EvidenceBand, SymptomCheck
 *   3. What we do       How can you help me?              Insights (diagram rows)
 *   4. What you gain    What changes for my company?      Outcomes
 *   5. How we do it     What is it like to work together? ProcessSteps
 *   6. Why us + proof   Why should I trust you?           ProofRow, SeeItWorking
 *   7. Who we are       Who will I actually work with?    Founder
 *   8. Take the leap    How do we get started?            Faq, Tiers
 *
 * The contact form opens in a dialog from every call to action and the
 * footer is the compact one, so the last thing a reader scrolls to is the
 * offer.
 */
import PageLayout from "../../layouts/PageLayout.astro";
import HeroShell from "../../components/services/hero/HeroShell.astro";
import FdeRoute from "../../components/services/hero/FdeRoute.astro";
import EvidenceBand from "../../components/services/EvidenceBand.astro";
import SymptomCheck from "../../components/services/SymptomCheck.astro";
import Insights from "../../components/services/Insights.astro";
import Outcomes from "../../components/services/Outcomes.astro";
import Founder from "../../components/services/Founder.astro";
import SeeItWorking from "../../components/services/SeeItWorking.astro";
import ProofRow from "../../components/ProofRow.astro";
import ProcessSteps from "../../components/services/ProcessSteps.astro";
import Tiers from "../../components/services/Tiers.astro";
import Faq from "../../components/services/Faq.astro";
import { FAQS } from "../../lib/faqs";
import ProofQuote from "../../components/ProofQuote.astro";
import ContactDialog from "../../components/ContactDialog.astro";
import { CAPACITY_STATEMENT, COMPANY } from "../../consts";
import { getService } from "../../lib/services";

const service = getService("forward-deployed-engineering");

const title = "Forward-Deployed Engineering: Software & AI, End to End";
const description =
  "A senior engineer inside your team who delivers end to end: discovery, development, AI integration and deployment. AI is one of the tools, used where it earns its place.";

const tiers = [
  {
    name: "Minimum",
    tagline: "One outcome you can already describe, delivered end to end.",
    duration: "One outcome, delivered in 4 weeks or less",
    price: {
      amount: "Fixed price",
      detail: "per outcome, set after a few days of scoping",
    },
    includes: [
      "A few days of scoping, then a fixed price",
      "Front end, API, data and integrations, in your repositories",
      "Tests and a deployment pipeline from the first week",
      "New working software every two weeks",
      "Documentation and a handover session",
    ],
  },
  {
    name: "Standard",
    badge: "Most companies choose this",
    recommended: true,
    tagline: "Discovery first, I find the highest-impact outcomes and deliver them.",
    duration: "Two-week discovery, then two-week increments",
    price: {
      amount: "Fixed price",
      detail: "per outcome, set after discovery",
    },
    includes: [
      "Everything in Minimum",
      "Two-week discovery: a ranked list and a scoped plan",
      "Solutions delivered in two-week increments",
      "AI wired in where it earns its place, with guardrails",
      "A demo every two weeks with your stakeholders",
      "More hands brought in when the scope needs them",
    ],
  },
  {
    name: "Advanced",
    tagline: "A roadmap of outcomes, quarter by quarter.",
    duration: "Quarterly, renewed per outcome list",
    price: {
      amount: "Fixed price",
      detail: "per outcome, planned a quarter at a time",
    },
    includes: [
      "Everything in Standard",
      "Roadmap refreshed every quarter with the people who do the work",
      "A team assembled when one person is not enough",
      "AI integration and deployment, with guardrails and a person in the loop",
      "AI enablement for your own developers",
      "Bi-weekly steering with leadership",
    ],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Forward-deployed engineering",
  serviceType: "End-to-end software delivery and AI integration",
  description,
  url: new URL(service.href, Astro.site).toString(),
  provider: {
    "@type": "Organization",
    "@id": new URL("/#organization", Astro.site).href,
    name: COMPANY.name,
    url: Astro.site?.href,
    email: COMPANY.email,
    telephone: COMPANY.phone,
  },
  areaServed: "Europe",
  audience: [
    { "@type": "Audience", audienceType: "Enterprise teams" },
    { "@type": "Audience", audienceType: "Scale-ups" },
    { "@type": "Audience", audienceType: "Startups" },
  ],
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Engagement models",
    itemListElement: tiers.map((tier) => ({
      "@type": "Offer",
      name: tier.name,
      description: tier.tagline,
    })),
  },
};
---

<PageLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Forward-deployed engineering", path: service.href }]}
  compactFooter
>
  {/* 1. The promise */}
  <HeroShell
    eyebrow="Forward-deployed engineering"
    ctaLabel={service.cta}
    subject={service.subject}
    note="Fixed price per outcome. No obligation."
  >
    <FdeRoute />
    <Fragment slot="title">
      One senior engineer. Idea to <em>production.</em>
    </Fragment>
  </HeroShell>

  {/* 2. The challenge */}
  <EvidenceBand
    title="What the numbers say about AI"
    intro="I break the cycle of failed AI initiatives."
    stats={[
      {
        value: "95%",
        label: "of enterprise AI pilots return nothing measurable.",
        source: "MIT NANDA, The GenAI Divide: State of AI in Business 2025",
      },
      {
        value: "88%",
        label: "of AI proofs of concept never reach production.",
        source: "IDC, 2025",
      },
      {
        value: "2×",
        label: "as many reach production when built with an outside partner.",
        source: "MIT NANDA, The GenAI Divide: State of AI in Business 2025",
      },
    ]}
    meaning="The demo is the easy part. The last mile needs an owner."
  >
    <ProofQuote slot="proof" snippet="ferdiFullStack" />
  </EvidenceBand>

  <SymptomCheck
    title="Twelve signs your company is behind on AI automation"
    intro="Untick what you can honestly rule out. What is left is your score."
    items={[
      "Someone retypes data from PDFs, emails or one system into another every week.",
      "Customer questions with a standard answer still wait for a person to type it.",
      "Reports are assembled by hand in a spreadsheet before every management meeting.",
      "AI in your company means a few people with a chat subscription and no shared way of working.",
      "There is an AI policy, or a plan to write one, but no model running inside a business process.",
      "Documents are read, classified and routed by people, one at a time.",
      "Your developers type every line themselves; coding agents are not set up on your repositories.",
      "Nobody can name a process where a model does the first draft and a person checks it.",
      "An AI pilot impressed everyone last year and is used by no one today.",
      "Approvals wait in one inbox, and when that person is on holiday they wait longer.",
      "The data a model would need lives in four systems, and nobody owns getting it together.",
      "A competitor, supplier or customer has mentioned what they automated, and you have no answer yet.",
    ]}
    verdicts={[
      {
        min: 0,
        title: "Ahead of the pack.",
        copy: "Models already do real work in your company. I add the next outcome, not the first.",
      },
      {
        min: 2,
        title: "Typical.",
        copy: "A subscription here, a pilot there, the real work still by hand. Every tick is a step a model could draft tomorrow.",
      },
      {
        min: 5,
        title: "Falling behind.",
        copy: "The hours behind these ticks usually add up to a few salaries a year. A two-week discovery puts that number on paper.",
      },
      {
        min: 8,
        title: "The gap is growing.",
        copy: "Others automated these steps a year ago. Another pilot will not close the gap. Shipping to production will.",
      },
    ]}
    ctaLabel="Talk about your score"
    subject={service.subject}
    preChecked
  />

  {/* 3. What we do */}
  <Insights
    id="what-we-do"
    title="One engineer owns discovery to deployment"
    intro="Inside your team, accountable until it is live, with AI where it earns its place."
    items={[
      {
        figure: "discovery",
        title: "Discover what saves the most.",
        copy: "I sit with the people who do the work and rank what software and AI would save.",
      },
      {
        figure: "last-mile",
        title: "Build the last mile.",
        copy: "The ERP, the data, the identity provider, the pipeline. In your repositories.",
      },
      {
        figure: "feature",
        title: "Integrate AI where it earns its place.",
        copy: "One workflow step, a model, guardrails, and a person checking the output.",
      },
      {
        figure: "owner",
        title: "Deploy it, and own it until it runs.",
        copy: "One accountable owner in production. That is why I price per outcome.",
      },
    ]}
  />

  {/* 4. What you gain */}
  <Outcomes
    tone="light"
    title="What changes for your company"
    stat={{
      value: "2×",
      label: "as many initiatives reach production with an outside partner.",
      source: "MIT NANDA, 2025",
    }}
    outcomes={[
      {
        title: "Software and AI live in production",
        detail: "Wired into your systems, your data and your Monday morning.",
      },
      {
        title: "One owner instead of a team to align",
        detail: "Coding agents do the typing. One senior engineer owns the outcome.",
      },
      {
        title: "A fixed price per outcome",
        detail: "Agreed before I build. The number does not change.",
      },
      {
        title: "Everything in your repositories",
        detail: "Code, pipelines and decisions are yours from the first commit.",
      },
      {
        title: "A team that keeps the pace",
        detail: "Your developers get a working session, not just a document.",
      },
    ]}
  />

  {/* 5. How we do it */}
  <ProcessSteps
    surface="dark"
    title="How an engagement runs"
    intro="Fixed steps. Short loops. No long silences."
    deliverablesTitle="What you can count on"
    deliverables={[
      "A scoped plan and a fixed price before you commit",
      "Everything in your repositories and accounts from day one",
      "Working software to click through every two weeks",
      "The person you talk to is the person who builds",
    ]}
    steps={[
      {
        title: "Discovery",
        when: "Week 1–2",
        copy: "I sit with the people who do the work. It ends in a ranked list of what saves the most.",
      },
      {
        title: "Scope and commit",
        when: "End of week 2",
        copy: "The top of the list gets a fixed price and a timeline. You decide.",
      },
      {
        title: "Foundation",
        when: "Week 3",
        copy: "Data model, integrations and pipeline, fitted to your landscape. Security is in the room from the start.",
      },
      {
        title: "Build in short cycles",
        when: "Every 2 weeks",
        copy: "Working software, reviewed with the people who will use it. Every demo is a release candidate.",
      },
      {
        title: "AI integration",
        when: "Where it earns its place",
        copy: "A model takes over one workflow step, with guardrails and a person checking. If it does not earn its place, I say so.",
      },
      {
        title: "Ship and hand over",
        when: "Per outcome",
        copy: "Live, monitored and documented. Then I take the next outcome, or leave it all in your hands.",
      },
    ]}
    ctaLabel={service.cta}
    subject={service.subject}
  />

  {/* 6. Why us + proof */}
  <ProofRow
    title="Why companies trust me with it"
    lede="The words of people who had me inside their team."
    snippets={["ferdiBeyondScope", "peterMentoring", "nicoTeam"]}
    service="forward-deployed-engineering"
  />

  <SeeItWorking />

  {/* 7. Who we are */}
  <Founder stage="hall" note={CAPACITY_STATEMENT} />

  {/* 8. Take the leap */}
  <Faq
    tone="dark"
    title="Questions I hear first"
    items={FAQS["forward-deployed-engineering"]}
  />

  <Tiers
    title="Three ways to start"
    intro="Every tier is a fixed price per outcome."
    serviceName="forward-deployed engineering"
    subject={service.subject}
    tiers={tiers}
    note="Each outcome is priced before I build it. Default stack: Angular, TypeScript, .NET, Node.js, SQL and Azure, with the Claude and OpenAI APIs. Or yours."
    otherLabel="Tell me what you need"
  />

  <ContactDialog />
</PageLayout>
