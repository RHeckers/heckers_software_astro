---
/**
 * Service page: workshops. A training page, so its own elements are rooms
 * and choices: a team finding one direction (the hero), the catalogue of
 * workshops, a finder that points a team at the one it needs first, and
 * photographs from real rooms next to what a team leaves with.
 *
 * The same eight-step journey as the home page, a line per point, no
 * paragraphs. Grounds alternate dark and light all the way down.
 *
 *   1. The promise      What can you help me achieve?     Hero (TeamAlign)
 *   2. The challenge    Do you understand my problem?     EvidenceBand
 *   3. What we do       How can you help me?              WorkshopCatalog, WorkshopFinder
 *   4. What you gain    What changes for my company?      Outcomes, with the photographs
 *   5. How we do it     What is it like to work together? ProcessSteps
 *   6. Why us + proof   Why should I trust you?           ProofRow
 *   7. Who we are       Who will I actually work with?    Founder
 *   8. Take the leap    How do we get started?            Faq, Tiers
 *
 * The contact form opens in a dialog from every call to action and the
 * footer is the compact one, so the last thing a reader sees is the price.
 */
import PageLayout from "../../layouts/PageLayout.astro";
import HeroShell from "../../components/services/hero/HeroShell.astro";
import TeamAlign from "../../components/services/hero/TeamAlign.astro";
import Outcomes from "../../components/services/Outcomes.astro";
import Founder from "../../components/services/Founder.astro";
import WorkshopPhotos from "../../components/services/WorkshopPhotos.astro";
import WorkshopFinder from "../../components/services/WorkshopFinder.astro";
import EvidenceBand from "../../components/services/EvidenceBand.astro";
import WorkshopCatalog from "../../components/services/WorkshopCatalog.astro";
import ProcessSteps from "../../components/services/ProcessSteps.astro";
import Tiers from "../../components/services/Tiers.astro";
import Faq from "../../components/services/Faq.astro";
import { FAQS } from "../../lib/faqs";
import ProofQuote from "../../components/ProofQuote.astro";
import ProofRow from "../../components/ProofRow.astro";
import ContactDialog from "../../components/ContactDialog.astro";
import { COMPANY } from "../../consts";
import { getService } from "../../lib/services";
import { TAILORED_WORKSHOP, WORKSHOPS } from "../../lib/workshops";
import { PRICING, VAT_NOTE, euro } from "../../lib/pricing";

const service = getService("workshops");
const price = PRICING.workshops;

const title = "Angular & Nx Workshops for Enterprise Teams | Heckers";
const description =
  "Hands-on workshops on AI-native development, Nx monorepos and Angular architecture, run on your own codebase and ending in rules your build enforces.";

const tiers = [
  {
    name: "Minimum",
    tagline: "One workshop, prepared on your own codebase.",
    duration: "One day, twelve seats included",
    price: { amount: euro(price.oneDay), detail: `fixed, ${VAT_NOTE}` },
    includes: [
      "Intake call and a read of your repository",
      "One full day, on site or remote",
      "Exercises built from your own code, not slides",
      "A one-page decision record the team agreed on",
    ],
  },
  {
    name: "Standard",
    badge: "Most teams choose this",
    recommended: true,
    tagline: "The rules agreed, and enforced before I leave.",
    duration: "Two days, twelve seats included",
    price: { amount: euro(price.twoDays), detail: `fixed, ${VAT_NOTE}` },
    includes: [
      "Everything in Minimum",
      "Half of day two on your own codebase",
      "Boundary and lint rules implemented together",
      "Decision records committed to the repository",
      "Thirty days of follow-up questions",
    ],
  },
  {
    name: "Advanced",
    tagline: "A whole department on the same rules, towards one measurable goal.",
    duration: "Two days, then one quarter, any group size",
    price: {
      amount: "On quote",
    },
    includes: [
      "Everything in Standard",
      "Unlimited seats, run as parallel groups",
      "A measurable goal, agreed at the start and reviewed at the end",
      "Monthly half-day sessions and pull request reviews",
      "A second workshop topic in month three",
    ],
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Angular and Nx workshops",
  serviceType: "Software development training",
  description,
  url: new URL(service.href, Astro.site).toString(),
  provider: {
    "@type": "Organization",
    "@id": new URL("/#organization", Astro.site).href,
    name: COMPANY.name,
    url: Astro.site?.href,
    email: COMPANY.email,
    telephone: COMPANY.phone,
  },
  areaServed: "Europe",
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Workshops",
    itemListElement: [...WORKSHOPS, TAILORED_WORKSHOP].map((workshop) => ({
      "@type": "Offer",
      name: workshop.title,
      description: workshop.description,
    })),
  },
};
---

<PageLayout
  title={title}
  description={description}
  jsonLd={jsonLd}
  breadcrumbs={[{ name: "Workshops", path: service.href }]}
  compactFooter
>
  {/* 1. The promise */}
  <HeroShell
    eyebrow="Workshops · AI, Nx & Angular"
    ctaLabel={service.cta}
    subject={service.subject}
    note="On your own codebase. One or two days."
  >
    <TeamAlign />
    <Fragment slot="title">
      One team. One way of <em>working.</em>
    </Fragment>
  </HeroShell>

  {/* 2. The challenge */}
  <EvidenceBand
    title="What the numbers say"
    intro="None of them are mine."
    stats={[
      {
        value: "76%",
        label: "of developers use AI tools. Fewer than half trust the output.",
        source: "Stack Overflow Developer Survey 2024",
      },
      {
        value: "79%",
        label: "of Angular developers are on the latest two versions. One in five is not.",
        source: "Angular developer survey 2024, close to 10,000 responses",
      },
      {
        value: "94%",
        label: "of employees stay longer at a company that invests in their learning.",
        source: "LinkedIn Workplace Learning Report, 2018",
      },
    ]}
    meaning="Everyone uses the tools. Almost no team has agreed on the rules."
  >
    <ProofQuote slot="proof" snippet="ferdiDepth" />
  </EvidenceBand>

  {/* 3. What we do */}
  <WorkshopCatalog
    tone="dark"
    title="The workshops"
    intro="Four topics and one built around your team. Each prepared on your own codebase."
    subject={service.subject}
  />

  <WorkshopFinder
    title="Which workshop fits your team?"
    intro="Three questions. One recommendation."
    subject={service.subject}
  />

  {/* 4. What you gain */}
  <Outcomes
    title="What your team leaves with"
    outcomes={[
      {
        title: "Rules the whole team agreed on",
        detail: "Written down as decision records, in your repository.",
      },
      {
        title: "A build that enforces them",
        detail: "Lint rules and module boundaries, merged before I leave.",
      },
      {
        title: "Exercises from your own code",
        detail: "Built from your repository, and yours to keep.",
      },
      {
        title: "A list of what breaks the rules today",
        detail: "Ranked, so the team knows where to start on Monday.",
      },
      {
        title: "Thirty days of follow-up",
        detail: "Questions answered while the team applies what it learned.",
      },
    ]}
  >
    <WorkshopPhotos slot="aside" />
  </Outcomes>

  {/* 5. How we do it */}
  <ProcessSteps
    title="How a workshop runs"
    intro="I spend more time reading your code than I spend in the room."
    deliverablesTitle="What you can count on"
    deliverables={[
      "Prepared on your own repository, not on a demo app",
      "Short explanations, long exercises",
      "Every block ends in a decision the team makes",
      "On site or remote, twelve seats included",
    ]}
    steps={[
      {
        title: "Intake",
        when: "Two weeks before",
        copy: "A call with the lead and the attendees: what the team struggles with and where the app is going.",
      },
      {
        title: "Preparation",
        when: "The week before",
        copy: "I read your code and build the exercises from it: your project graph, your state, your CI.",
      },
      {
        title: "The workshop",
        when: "One or two days",
        copy: "All in your codebase. Every block ends with what we do from now on, and what enforces it.",
      },
      {
        title: "Decisions in the build",
        when: "Last afternoon",
        copy: "The agreed rules become lint rules and module boundaries. Merged, not planned.",
      },
      {
        title: "Follow-up",
        when: "The month after",
        copy: "Questions by email while the team applies it. In Advanced, monthly sessions until the goal is met.",
      },
    ]}
    ctaLabel={service.cta}
    subject={service.subject}
  />

  {/* 6. Why us + proof */}
  <ProofRow
    title="Why teams trust me in the room"
    lede="The words of people who had me working with their developers."
    snippets={["nicoAngular", "alexThinkAlong", "marcChallenges"]}
  />

  {/* 7. Who we are */}
  <Founder stage="applause" title="Taught by the person who wrote the book" />

  {/* 8. Take the leap */}
  <Faq
    tone="dark"
    title="Questions I hear first"
    items={FAQS["workshops"]}
  />

  <Tiers
    title="Three ways to start"
    intro="Agreed, enforced, or measured. Pick how far the change should go."
    serviceName="workshops"
    subject={service.subject}
    tiers={tiers}
    note={`Minimum and Standard are fixed for twelve seats, ${VAT_NOTE}; travel outside the Netherlands at cost. Each extra seat is ${euro(price.extraSeatPerDay)} per workshop day. Advanced is quoted per goal and group size.`}
    otherLabel="Tell me what your team needs"
  />

  <ContactDialog />
</PageLayout>
