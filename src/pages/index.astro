---
import ExpandingWord from "../components/ExpandingWord.astro";
import HeroSection from "../components/HeroSection.astro";
import StoryBlock from "../components/StoryBlock.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";

import CodeReveal from "../components/CodeReveal.astro";
import ServicesOverview from "../components/ServicesOverview.astro";
import WorkshopSection from "../components/WorkshopSection.astro";
import ApplicationDevelopment from "../components/ApplicationDevelopment.astro";
import Reviews from "../components/Reviews.astro";
import Contact from "../components/Contact.astro";
import ProofRow from "../components/ProofRow.astro";
import HomeEvidence from "../components/HomeEvidence.astro";
import HomeLessons from "../components/HomeLessons.astro";
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HeroSection />
  <section class="section-1">
    <ServicesOverview />
    <HomeEvidence />
    <StoryBlock />
  </section>

  <div class="expanding">
    <ExpandingWord
      word="Fix Your app"
      callToAction="Book assessment"
      subject="Code Review"
      size="large"
      reversedAnimation={true}
    />
    <CodeReveal />
  </div>

  <WorkshopSection />
  <ProofRow
    tone="dark"
    snippets={["peterApproach", "ferdiDepth", "marcFramework"]}
  />

  <ApplicationDevelopment />
  <HomeLessons />
  <Reviews />
  <Contact />
</PageLayout>

<style>
  .section-1 {
    background-color: var(--color-light);
  }

  .expanding {
    background-color: var(--color-dark-alt);
  }
</style>
