---
import ExpandingWord from "../components/ExpandingWord.astro";
import HeroSection from "../components/HeroSection.astro";
import StoryBlock from "../components/StoryBlock.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";

import CodeReveal from "../components/CodeReveal.astro";
import WorkshopSection from "../components/WorkshopSection.astro";
import ApplicationDevelopment from "../components/ApplicationDevelopment.astro";
import Reviews from "../components/Reviews.astro";
import Contact from "../components/Contact.astro";
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HeroSection />
  <section class="section-1">
    <StoryBlock />
  </section>

  <div class="expanding">
    <ExpandingWord
      word="Fix Your app"
      callToAction="Book A call"
      size="large"
      reversedAnimation={true}
    />
    <CodeReveal />
  </div>

  <WorkshopSection />

  <section class="bottom-section">
    <ApplicationDevelopment />
    <Reviews />
    <Contact />
  </section>
</PageLayout>

<style>
  .section-1 {
    background-color: var(--color-light);
  }

  .expanding {
    background-color: var(--color-dark-alt);
  }

  .bottom-section {
    padding-bottom: 3rem;
    background: var(--background-gradient-primary);
  }
</style>
