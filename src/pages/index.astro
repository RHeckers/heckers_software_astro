---
import HeroSection from "../components/HeroSection.astro";
import {
  AUTHOR,
  COMPANY,
  HOME_TITLE,
  SITE_DESCRIPTION,
  profileLinks,
} from "../consts";
import logo from "../assets/logos/logo.png";
import PageLayout from "../layouts/PageLayout.astro";

import ServicesOverview from "../components/ServicesOverview.astro";
import ProcessSteps from "../components/services/ProcessSteps.astro";
import Contact from "../components/Contact.astro";
import Challenge from "../components/home/Challenge.astro";
import WhatWeDo from "../components/home/WhatWeDo.astro";
import Gains from "../components/home/Gains.astro";
import WhyUs from "../components/home/WhyUs.astro";
import WhoWeAre from "../components/home/WhoWeAre.astro";

/**
 * The page is one visitor's journey, eight steps, each answering the
 * question the step before it raises. Every section is short on purpose:
 * a pain or a solution per line, and the service pages carry the detail.
 *
 *   1. The promise      What can you help me achieve?     Hero
 *   2. The challenge    Do you understand my problem?     Challenge
 *   3. What we do       How can you help me?              WhatWeDo (logos, results), three ways to start
 *   4. What you gain    What changes for my company?      Gains
 *   5. How we do it     What is it like to work together? ProcessSteps
 *   6. Why us + proof   Why should I trust you?           WhyUs
 *   7. Who we are       Who will I actually work with?    WhoWeAre
 *   8. Take the leap    How do we get started?            Contact
 *
 * One look, shared with the service pages: full-width sections on a 1200px
 * column, one heading scale, rows divided by hairlines, a coloured rule
 * for a claim, and the dark stepped panel for a process. Two grounds only:
 * the light-alt the hero fades into, and the dark band. No near-white
 * sections; the hero, the logos and the challenge are one unbroken ground.
 */

// The homepage is where search engines look for the site's identity: the
// WebSite entity plus a compact Organization. The full organisation, person
// and book graph lives on /about and shares the same @id values.
const siteUrl = Astro.site?.href ?? "https://heckerssoftware.com/";
const orgId = `${siteUrl}#organization`;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteUrl}#website`,
      url: siteUrl,
      name: COMPANY.name,
      description: SITE_DESCRIPTION,
      inLanguage: "en",
      publisher: { "@id": orgId },
    },
    {
      "@type": "Organization",
      "@id": orgId,
      name: COMPANY.name,
      url: siteUrl,
      logo: new URL(logo.src, Astro.site).href,
      email: COMPANY.email,
      telephone: COMPANY.phone,
      founder: { "@type": "Person", "@id": `${siteUrl}about/#person`, name: AUTHOR.name },
      sameAs: profileLinks(),
    },
  ],
};
---

<PageLayout title={HOME_TITLE} description={SITE_DESCRIPTION} jsonLd={jsonLd}>
  <div class="home">
  {/* 1. The promise */}
  <HeroSection />

  {/* 2. The challenge */}
  <Challenge />

  {/* 3. What we do */}
  <WhatWeDo />
  <ServicesOverview />

  {/* 4. What you gain */}
  <Gains />

  {/* 5. How we do it */}
  <ProcessSteps
    surface="alt"
    title="How we work together"
    intro="Four steps, one owner, no long silences."
    deliverablesTitle="While we work"
    deliverables={[
      "Working software to click through every two weeks",
      "Tests and deployment through a pipeline from the first sprint",
      "Your standards, security rules and release process, followed",
    ]}
    steps={[
      {
        title: "Discovery",
        when: "Week 1–2",
        copy: "I sit with the people who do the work and find where software and AI save the most. It ends in a ranked list and a fixed price.",
      },
      {
        title: "Development",
        when: "Every 2 weeks",
        copy: "Built in your repositories, to your standards, reviewed with you every two weeks.",
      },
      {
        title: "AI integration",
        when: "Where it earns its place",
        copy: "Where a model earns its place, I wire it into the workflow with guardrails. Where it does not, I say so.",
      },
      {
        title: "Deployment and handover",
        when: "Per outcome",
        copy: "Live in your own cloud account, documented, and handed to your developers.",
      },
    ]}
    ctaLabel="Book a discovery call"
    subject="Development"
  />

  {/* 6. Why us + proof */}
  <WhyUs />

  {/* 7. Who we are */}
  <WhoWeAre />

  {/* 8. Take the leap */}
  <Contact tone="dark" />
  </div>
</PageLayout>

<style>
  /* The ground every light section shares. Painting it behind them too
     means a sub-pixel seam between two sections shows this colour and not
     the white of the page. */
  .home {
    background: var(--color-light-alt);
  }
</style>
