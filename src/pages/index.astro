---
import HeroSection from "../components/HeroSection.astro";
import LogoBanner from "../components/LogoBanner.astro";
import StoryBlock from "../components/StoryBlock.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";

import CodeReveal from "../components/CodeReveal.astro";
import ServicesOverview from "../components/ServicesOverview.astro";
import WorkshopSection from "../components/WorkshopSection.astro";
import AssessmentSection from "../components/AssessmentSection.astro";
import Contact from "../components/Contact.astro";
import ProofRow from "../components/ProofRow.astro";
import FactBand from "../components/FactBand.astro";

import ngPolandCode from "../assets/workshop/ng-poland-2024.6.jpg";
import ngPolandAudience from "../assets/workshop/ng-poland-2024.7.jpg";
import pointing from "../assets/pointing.jpg";

/**
 * The page alternates two light grounds and two dark ones, and never puts
 * the same one twice in a row. Each service block is followed by the fact
 * band that argues for it, with the photograph swapping sides as you go.
 *
 * Sources:
 * - MIT NANDA, The GenAI Divide: State of AI in Business 2025: ~95% of
 *   enterprise generative AI pilots show no measurable P&L return; the
 *   report blames workflow integration, not the models.
 * - Stripe, The Developer Coefficient, 2018.
 * - Xia et al., "Measuring Program Comprehension: A Large-Scale Field Study
 *   with Professionals", IEEE TSE 2018: ~58% of time on comprehension.
 * - DORA, Accelerate State of DevOps 2023: good internal documentation,
 *   2.4x more likely to be a high performer.
 * - Standish Group, CHAOS Report 2015: incremental delivery succeeds about
 *   three times as often as one big release (39% against 11%).
 */
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HeroSection />
  <LogoBanner />
  <ServicesOverview />

  <FactBand
    title="The model is rarely the problem. The last mile is."
    stat="95%"
    lead="of enterprise generative AI pilots deliver no measurable return. The study behind that number does not blame the models: it blames integration into real workflows, data readiness, and nobody owning the outcome."
    source="MIT NANDA, The GenAI Divide: State of AI in Business 2025"
    note="A pilot is a demo with a budget. What turns it into a return is engineering: the integration with the ERP, the data that has to be cleaned first, the pipeline, the monitoring, the people trained to use it. Companies that brought in an outside partner reached production about twice as often as those who built alone. That is the whole case for an expert who comes in and finishes."
    link={{
      href: "/services/forward-deployed-engineering#self-check",
      label: "Twelve signs your company is behind on AI automation",
    }}
    image={ngPolandCode}
    alt="Roberto Heckers presenting on the main stage at ngPoland"
    side="right"
    surface="alt"
  />

  {
    /* The forward-deployed expert panel is the last card of the story stack,
      so it is slotted into it rather than placed after it. */
  }
  <StoryBlock>
    <CodeReveal />
  </StoryBlock>

  <FactBand
    title="Knowledge without rules evaporates"
    stat="2.4×"
    lead="more likely to be a high-performing team when the decisions that shape the code are written down and easy to find, instead of kept in people's heads."
    source="DORA, Accelerate State of DevOps"
    note="A team can agree on a pattern on Thursday and drift from it by the next sprint, because agreement lives in memory and memory is busy. Everything we build inside your company is handed over with the decisions written down and the lint rules that enforce them. The workshops do the same for the code your own team writes after we leave."
    link={{
      href: "/services/workshops",
      label: "How a workshop turns rules into code",
    }}
    image={pointing}
    imagePosition="center top"
    alt="Roberto Heckers pointing at the headline"
    side="left"
    surface="raised"
    hideOnMobile
  />

  <WorkshopSection />

  <FactBand
    title="The people inside cannot see it, and it is not their fault"
    stat="58%"
    lead="of a developer's time goes to understanding existing code before a single line of it changes. Writing the change is the small part."
    source="Xia et al., IEEE Transactions on Software Engineering"
    note="The people who built the system carry the map in their heads and no longer notice the detours. That is why every engagement starts with an outside read: a discovery for the business, an architecture assessment for the code. Not ready for someone inside yet? The assessment on its own is the cheapest place to start."
    link={{
      href: "/services/architecture-assessment",
      label: "Why an outside read finds what yours cannot",
    }}
    image={ngPolandAudience}
    alt="Roberto Heckers on the ngPoland stage in front of a full auditorium"
    side="right"
    surface="alt"
  />

  <ProofRow
    snippets={["peterApproach", "ferdiFullStack", "ferdiBeyondScope"]}
    tone="light"
  />

  <AssessmentSection />

  <Contact />
</PageLayout>
