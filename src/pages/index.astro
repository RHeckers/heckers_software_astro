---
import ExpandingWord from "../components/ExpandingWord.astro";
import HeroSection from "../components/HeroSection.astro";
import LogoBanner from "../components/LogoBanner.astro";
import StoryBlock from "../components/StoryBlock.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";

import CodeReveal from "../components/CodeReveal.astro";
import WorkshopSection from "../components/WorkshopSection.astro";
import ApplicationDevelopment from "../components/ApplicationDevelopment.astro";
import WorkshopSectionMobile from "../components/WorkshopSectionMobile.astro";
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HeroSection />
  <section class="section-1">
    <StoryBlock />
    <ExpandingWord
      word="Fix Your app"
      callToAction="Book A call"
      size="large"
      reversedAnimation={true}
    />
  </section>

  <CodeReveal client:visible={{ rootMargin: "500px" }} />

  <div class="workshop-section-desktop">
    <WorkshopSection client:visible={{ rootMargin: "500px" }} />
  </div>
  <div class="workshop-section-mobile">
    <WorkshopSectionMobile client:visible={{ rootMargin: "500px" }} />
  </div>

  <ApplicationDevelopment />
</PageLayout>

<style>
  .section-1 {
    background-color: var(--color-light);
  }
  .workshop-section-desktop {
    display: none;
  }
  .workshop-section-mobile {
    display: block;
  }
  @media (min-width: 1425px) {
    .workshop-section-desktop {
      display: block;
    }
    .workshop-section-mobile {
      display: none;
    }
  }
</style>
