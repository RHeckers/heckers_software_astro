---
import ExpandingWord from "../components/ExpandingWord.astro";
import HeroSection from "../components/HeroSection.astro";
import LogoBanner from "../components/LogoBanner.astro";
import StoryBlock from "../components/StoryBlock.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import PageLayout from "../layouts/PageLayout.astro";

import CodeReveal from "../components/CodeReveal.astro";
---

<PageLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <HeroSection />
  <section class="section-1">
    <LogoBanner />
    <StoryBlock />
    <ExpandingWord
      word="Fix Your app"
      callToAction="Book A call"
      size="large"
    />
  </section>

  <section class="section-2">
    <CodeReveal />
  </section>

  <section class="section-3">
    <ExpandingWord
      word="WORKSHOPS"
      callToAction="Book A workshop"
      size="large"
    />
  </section>

  <section class="section-4"></section>
</PageLayout>

<style>
  .section-1 {
    background-color: var(--color-nude);
  }

  .section-2 {
    height: 150vh;
    background-color: var(--color-bordaux-light);
    overflow: visible;
    view-timeline-name: --section-timeline;
  }

  .section-3 {
    /* margin-top: 75vh; */
    background-color: var(--color-nude);
  }
</style>
