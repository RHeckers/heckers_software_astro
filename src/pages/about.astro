---
/**
 * The company page: what Heckers Software is for, the person behind it,
 * and why a company should want him inside its codebase. Built from the
 * same blocks as the service pages, a line per point, no paragraphs, with
 * three elements of its own: the hero picture of a team folding into one
 * expert, the mission as one large statement with a highlighted phrase,
 * and the sheet of plain facts beside the portrait.
 *
 * Grounds alternate dark and light all the way down:
 *
 *   1. The promise      Hero (RolesToOne)              dark
 *   2. Why we exist     The mission statement          light
 *   3. The story        ProcessSteps, as five steps    dark
 *      Proof            ProofRow, tight under it       dark
 *   4. What it buys you Outcomes                       light
 *   5. Three ways in    The services as three links    dark
 *   6. The facts        Portrait and fact sheet        light
 *   7. Take the leap    Contact                        dark
 *
 * The facts a reader, a search engine or an AI assistant might lift are
 * stated plainly in the fact sheet and repeated in the structured data:
 * organisation, person and book as one graph, with the same public
 * profiles the footer and the blog link to.
 */
import PageLayout from "../layouts/PageLayout.astro";
import Contact from "../components/Contact.astro";
import ProofRow from "../components/ProofRow.astro";
import { Image } from "astro:assets";
import HeroShell from "../components/services/hero/HeroShell.astro";
import RolesToOne from "../components/services/hero/RolesToOne.astro";
import ProcessSteps from "../components/services/ProcessSteps.astro";
import Outcomes from "../components/services/Outcomes.astro";
import Accent from "../components/Accent.astro";
import portrait from "../assets/pointing.jpg";
import logo from "../assets/logos/logo.png";
import { AUTHOR, COMPANY, PROFILES, profileLinks } from "../consts";
import { SERVICES } from "../lib/services";

const title = `About ${COMPANY.name} and ${AUTHOR.name}`;
const description = `${COMPANY.name} brings software and AI into production inside companies. Founded by ${AUTHOR.name}, author of ${PROFILES.book.title} and conference speaker.`;

const siteUrl = Astro.site?.href ?? "https://heckerssoftware.com/";
const orgId = `${siteUrl}#organization`;
const personId = `${siteUrl}about/#person`;
const bookId = `${siteUrl}about/#book`;
const knowsAbout = [
  "Angular",
  "TypeScript",
  "Nx monorepos",
  "NgRx and Signal Store",
  ".NET",
  "Node.js",
  "Microsoft Azure",
  "Software architecture",
  "AI integration and workflow automation",
  "AI-native development with coding agents",
  "Large language model applications",
];

const talkNames = PROFILES.talks.map((talk) => talk.event.replace(/ \d{4}$/, ""));

/* Each service in one line, for the links at the foot of the page. */
const wayLines: Record<string, string> = {
  "forward-deployed-engineering": "One senior engineer who delivers end to end, at a fixed price per outcome.",
  "architecture-assessment": "Know what your Angular or Nx codebase costs you, and what to fix first.",
  workshops: "One team, one way of working, on your own codebase.",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": orgId,
      name: COMPANY.name,
      url: siteUrl,
      logo: new URL(logo.src, Astro.site).href,
      email: COMPANY.email,
      telephone: COMPANY.phone,
      address: {
        "@type": "PostalAddress",
        streetAddress: COMPANY.street,
        postalCode: COMPANY.postalCode,
        addressLocality: COMPANY.city,
        addressCountry: "NL",
      },
      vatID: COMPANY.btw,
      identifier: {
        "@type": "PropertyValue",
        propertyID: "KVK",
        value: COMPANY.kvk,
      },
      founder: { "@id": personId },
      areaServed: ["Netherlands", "Belgium", "Europe", "Worldwide"],
      knowsAbout,
      sameAs: profileLinks(),
      makesOffer: SERVICES.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.name,
          url: new URL(service.href, Astro.site).href,
          description: service.summary,
        },
      })),
    },
    {
      "@type": "Person",
      "@id": personId,
      name: AUTHOR.name,
      url: AUTHOR.url,
      jobTitle: AUTHOR.jobTitle,
      description: AUTHOR.bio,
      worksFor: { "@id": orgId },
      email: COMPANY.email,
      knowsAbout,
      sameAs: profileLinks(),
      author: { "@id": bookId },
      performerIn: PROFILES.talks.map((talk) => ({
        "@type": "Event",
        name: talk.event,
        url: talk.url,
      })),
    },
    {
      "@type": "Book",
      "@id": bookId,
      name: PROFILES.book.title,
      alternateName: `${PROFILES.book.title}: ${PROFILES.book.subtitle}`,
      author: { "@id": personId },
      publisher: { "@type": "Organization", name: PROFILES.book.publisher },
      datePublished: PROFILES.book.year,
      isbn: PROFILES.book.isbn,
      url: PROFILES.book.url,
    },
  ],
};
---

<PageLayout title={title} description={description} jsonLd={jsonLd}>
  {/* 1. The promise */}
  <HeroShell
    eyebrow={`About ${COMPANY.name}`}
    ctaLabel="Book a discovery call"
    subject="Development"
    note="Founder-led. Fixed price per outcome."
  >
    <RolesToOne />
    <Fragment slot="title">
      One expert.<br />A team's worth of <em>output.</em>
    </Fragment>
  </HeroShell>

  {/* 2. Why we exist */}
  <section class="mission" aria-labelledby="mission-heading">
    <div class="mission__inner">
      <p class="mission__label" id="mission-heading">Why we exist</p>
      <p class="mission__statement">
        Companies do not lack ideas, budgets or talent. They lack someone who
        <Accent marker wrap range="cover 30% cover 55%" mobileRange="cover 25% cover 55%">owns the outcome until it is live.</Accent>
      </p>
      <ul class="mission__pillars">
        {
          [
            ["Find", "the highest-impact work"],
            ["Build", "it end to end"],
            ["Ship", "it into production"],
            ["Hand over", "the know-how, in your repositories"],
          ].map(([verb, rest], index) => (
            <li class="mission__pillar" style={`--i: ${index}`}>
              <strong>{verb}</strong>
              <span>{rest}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 3. The story */}
  <ProcessSteps
    id="story"
    surface="dark"
    title="Enterprise code, one book, a front-row seat on AI"
    intro={`How ${AUTHOR.name} got here, in five steps.`}
    deliverablesTitle="On the record"
    deliverables={[
      `${PROFILES.book.title}, ${PROFILES.book.publisher} ${PROFILES.book.year}`,
      `Speaker at ${talkNames.slice(0, -1).join(", ")} and ${talkNames.at(-1)}`,
      "Energy, healthcare, industry and government",
      "AI knowledge groups with industry leaders",
    ]}
    steps={[
      {
        title: "Self-taught, on AngularJS",
        when: "Where it started",
        copy: "Then years inside the systems large organisations run on: Angular, .NET, Node.js, SQL and Azure.",
      },
      {
        title: "Angular at enterprise scale",
        when: "Hundreds of projects",
        copy: "Codebases with teams in several countries. Where software either ships every two weeks for years, or quietly stops.",
      },
      {
        title: "The book and the stage",
        when: PROFILES.book.year,
        copy: `${PROFILES.book.title}, and the same material on stage at ${talkNames.slice(0, -1).join(", ")} and ${talkNames.at(-1)}.`,
      },
      {
        title: "AI changed what one engineer ships",
        when: "Since coding agents",
        copy: "Agents do the typing. One senior engineer who knows the whole stack ships what a team shipped.",
      },
      {
        title: "Plugged into the people figuring AI out",
        when: "Every week",
        copy: "New agents and models are tested on real code before they reach yours. What does not work never reaches your budget.",
      },
    ]}
    ctaLabel="Book a discovery call"
    subject="Development"
  />

  {/* 5. Proof */}
  <ProofRow
    title="From the people we have worked with"
    lede="The words of people who had us inside their team."
    snippets={["ferdiFullStack", "peterMentoring", "nicoTeam"]}
  />

  {/* 4. What it buys you */}
  <Outcomes
    id="promise"
    tone="light"
    title="What every client should be able to say"
    outcomes={[
      {
        title: "“What we needed is live.”",
        detail: "In production, wired into your systems, used on a Monday morning.",
      },
      {
        title: "“Our own developers can run it.”",
        detail: "Every decision written down, every rule enforced in the build.",
      },
      {
        title: "“We know what to build next.”",
        detail: "A ranked list of the next outcomes, with what each is worth.",
      },
    ]}
  />

  {/* 7. Three ways in */}
  <section class="ways" aria-labelledby="ways-heading">
    <div class="ways__inner">
      <h2 class="ways__title" id="ways-heading">Three ways in</h2>
      <ul class="ways__list">
        {
          SERVICES.map((service, index) => (
            <li>
              <a class="way" href={service.href}>
                <span class="way__index" aria-hidden="true">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="way__name">{service.name}</span>
                <span class="way__line">{wayLines[service.slug]}</span>
                <span class="way__arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* 6. The facts */}
  <section class="facts" aria-labelledby="facts-heading">
    <div class="facts__inner">
      <div class="facts__lead">
        <h2 class="facts__title" id="facts-heading">The facts</h2>
        <div class="facts__photo">
          <Image
            src={portrait}
            alt={`${AUTHOR.name}, founder of ${COMPANY.name}`}
            widths={[320, 480, 640]}
            sizes="(min-width: 900px) 320px, 70vw"
            loading="lazy"
          />
        </div>
      </div>

      <dl class="facts__list">
        <div>
          <dt>Company</dt>
          <dd>{COMPANY.name}</dd>
        </div>
        <div>
          <dt>Founder</dt>
          <dd>{AUTHOR.name}</dd>
        </div>
        <div>
          <dt>Based in</dt>
          <dd>{COMPANY.city}, {COMPANY.country}</dd>
        </div>
        <div>
          <dt>Works</dt>
          <dd>On site across the Netherlands and Belgium, remote globally</dd>
        </div>
        <div>
          <dt>Languages</dt>
          <dd>Dutch, English</dd>
        </div>
        <div>
          <dt>Stack</dt>
          <dd>Angular, TypeScript, Nx, .NET, Node.js, SQL, Azure, Claude and OpenAI APIs</dd>
        </div>
        <div>
          <dt>Book</dt>
          <dd>
            <a href={PROFILES.book.url} target="_blank" rel="noopener noreferrer">{PROFILES.book.title}</a>
            ({PROFILES.book.publisher}, {PROFILES.book.year})
          </dd>
        </div>
        <div>
          <dt>Talks</dt>
          <dd class="facts__talks">
            {
              PROFILES.talks.map((talk) => (
                <a href={talk.url} target="_blank" rel="noopener noreferrer">{talk.event}</a>
              ))
            }
          </dd>
        </div>
        <div>
          <dt>AI</dt>
          <dd>Member of AI knowledge groups with industry leaders</dd>
        </div>
        <div>
          <dt>Clients include</dt>
          <dd>Ministry of Defense, Vattenfall, Marel, Wit-Gele Kruis</dd>
        </div>
        {
          PROFILES.linkedin && (
            <div>
              <dt>Profile</dt>
              <dd>
                <a href={PROFILES.linkedin} rel="me noopener noreferrer" target="_blank">LinkedIn</a>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Registration</dt>
          <dd>KVK {COMPANY.kvk}</dd>
        </div>
        <div>
          <dt>Contact</dt>
          <dd>
            <a href={`mailto:${COMPANY.email}`}>{COMPANY.email}</a><br />
            <a href={`tel:${COMPANY.phone}`}>{COMPANY.phone}</a>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  {/* 8. Take the leap */}
  <Contact tone="dark" />
</PageLayout>

<style>
  /* --- Why we exist: one statement, large, on the light ground --- */

  .mission {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4.5rem, 11vw, 9rem) clamp(1.25rem, 6vw, 5rem);
  }

  .mission__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .mission__label {
    font-family: synonym, sans-serif;
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .mission__statement {
    font-size: clamp(2rem, 5vw, 4.25rem);
    font-weight: var(--font-weight-light);
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 22ch;
    text-wrap: balance;
  }

  /* The highlighted phrase is covered over its full height, like a
     marker pen drawn across the line, rather than underlined. */
  .mission__statement :global(.accent__mark) {
    background: linear-gradient(
      transparent 10%,
      var(--c-accent) 10%,
      var(--c-accent) 96%,
      transparent 96%
    );
  }

  /* What we do about it: four pillars, a large verb and what it applies
     to, each behind a short accent rule. No numbers and no connecting
     line: the story below is the numbered one. As the row scrolls in, each
     pillar's rule draws down and its words come up, one after the other. */
  .mission__pillars {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3rem) clamp(1.25rem, 3vw, 2.5rem);
    margin-top: clamp(1.5rem, 4vw, 3.5rem);
    view-timeline-name: --pillars;
  }

  .mission__pillar {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1.25rem;
  }

  .mission__pillar::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    border-radius: 3px;
    background: var(--c-accent);
    transform-origin: top;
  }

  .mission__pillar strong {
    font-size: clamp(1.75rem, 3.4vw, 2.75rem);
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: -0.015em;
  }

  .mission__pillar span {
    font-family: synonym, sans-serif;
    font-size: var(--font-lg);
    line-height: 1.35;
    color: var(--color-ink-muted);
    max-width: 18ch;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .mission__pillar::before {
        animation: pillar-rule linear both;
        animation-timeline: --pillars;
        animation-range: cover calc(14% + var(--i) * 6%) cover calc(26% + var(--i) * 6%);
      }

      .mission__pillar strong,
      .mission__pillar span {
        animation: pillar-words linear both;
        animation-timeline: --pillars;
        animation-range: cover calc(18% + var(--i) * 6%) cover calc(30% + var(--i) * 6%);
      }
    }
  }

  @keyframes pillar-rule {
    from {
      transform: scaleY(0);
    }
  }

  @keyframes pillar-words {
    from {
      opacity: 0.25;
      translate: 0 0.75rem;
    }
  }

  @media (min-width: 760px) {
    .mission__pillars {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* --- The facts: a portrait and a sheet of plain facts --- */

  .facts {
    background: var(--color-light-alt);
    color: var(--color-ink);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .facts__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .facts__lead {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .facts__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .facts__photo {
    width: min(70vw, 320px);
    aspect-ratio: 4 / 5;
    border-radius: 22px;
    overflow: hidden;
    background: var(--color-light-raised);
    border: 1px solid var(--c-dark);
    box-shadow: 0 24px 50px color-mix(in srgb, var(--c-dark) 14%, transparent);
  }

  .facts__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 12%;
  }

  .facts__list {
    border-top: 1px solid var(--color-stroke-strong);
  }

  .facts__list > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem 1.5rem;
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--color-stroke);
  }

  .facts__list dt {
    font-family: synonym, sans-serif;
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    padding-top: 0.3rem;
  }

  .facts__list dd {
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.5;
  }

  .facts__list a {
    color: var(--color-ink);
    font-weight: var(--font-weight-medium);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .facts__talks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }

  @media (min-width: 560px) {
    .facts__list > div {
      grid-template-columns: 9rem 1fr;
    }
  }

  @media (min-width: 900px) {
    .facts__inner {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }

    .facts__lead {
      position: sticky;
      top: calc(56px + 2rem);
    }
  }

  /* --- Three ways in: the services as three large links --- */

  .ways {
    background: var(--c-dark);
    color: var(--c-light);
    padding: clamp(4rem, 10vw, 7.5rem) clamp(1.25rem, 6vw, 5rem);
  }

  .ways__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, 3rem);
  }

  .ways__title {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: var(--font-weight-medium);
    line-height: 1.02;
    letter-spacing: -0.01em;
  }

  .ways__list {
    list-style: none;
    border-top: 1px solid color-mix(in srgb, var(--c-light) 16%, transparent);
  }

  .way {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    grid-template-areas:
      "index name arrow"
      ". line arrow";
    align-items: baseline;
    gap: 0.35rem 0.5rem;
    padding: clamp(1.4rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--c-light) 12%, transparent);
    color: inherit;
    text-decoration: none;
  }

  .way__index {
    grid-area: index;
    font-family: synonym, sans-serif;
    font-size: var(--font-sm);
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.12em;
    color: var(--c-accent);
  }

  .way__name {
    grid-area: name;
    font-size: clamp(1.5rem, 3.2vw, 2.5rem);
    font-weight: var(--font-weight-light);
    line-height: 1.1;
    transition: color 0.25s ease;
  }

  .way__line {
    grid-area: line;
    font-family: synonym, sans-serif;
    font-size: var(--font-md);
    line-height: 1.45;
    color: color-mix(in srgb, var(--c-light) 72%, transparent);
  }

  .way__arrow {
    grid-area: arrow;
    align-self: center;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--c-accent);
    transition: transform 0.3s cubic-bezier(0.22, 0.61, 0.36, 1);
  }

  .way:hover .way__name,
  .way:focus-visible .way__name {
    color: var(--c-accent);
  }

  .way:hover .way__arrow,
  .way:focus-visible .way__arrow {
    transform: translateX(8px);
  }

  .way:focus-visible {
    outline: 2px solid var(--c-accent);
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>
