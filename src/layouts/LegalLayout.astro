---
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  description: string;
  lastUpdated: string;
}

const { title, description, lastUpdated } = Astro.props;
---

<PageLayout title={`${title} — Heckers Software`} description={description}>
  <article class="legal">
    <header>
      <a href="/" class="back-link">&larr; Back to home</a>
      <h1>{title}</h1>
      <p class="last-updated">Last updated: {lastUpdated}</p>
    </header>

    <div class="prose">
      <slot />
    </div>
  </article>
</PageLayout>

<style>
  .legal {
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(6rem, 10vw, 8rem) 1.5rem 4rem;
    font-family: "synonym", sans-serif;
    color: var(--color-ink);
  }

  header {
    margin-bottom: 2.5rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-accent-ink);
    text-decoration: none;
    font-weight: var(--font-weight-medium);
    font-size: var(--font-sm);
  }

  .back-link:hover {
    text-decoration: underline;
  }

  h1 {
    font-family: "chillax", sans-serif;
    font-size: var(--font-3xl);
    font-weight: var(--font-weight-bold);
    margin: 0.25rem 0 0.75rem;
  }

  .last-updated {
    color: var(--color-ink-muted);
    font-size: var(--font-sm);
    font-style: italic;
    margin: 0;
  }

  .prose {
    font-size: var(--font-md);
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-family: "chillax", sans-serif;
    font-size: var(--font-2xl);
    font-weight: var(--font-weight-semi-bold);
    margin: 2.5rem 0 0.75rem;
  }

  .prose :global(h3) {
    font-family: "chillax", sans-serif;
    font-size: var(--font-xl);
    font-weight: var(--font-weight-semi-bold);
    margin: 1.75rem 0 0.5rem;
  }

  .prose :global(p) {
    margin-bottom: 1.25rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 1.25rem 1.5rem;
  }

  .prose :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose :global(a) {
    color: var(--color-accent-ink);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .prose :global(a:hover) {
    color: var(--color-accent-strong);
  }

  .prose :global(strong) {
    font-weight: var(--font-weight-semi-bold);
  }

  .prose :global(address) {
    font-style: normal;
    line-height: 1.7;
    margin-bottom: 1.25rem;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--font-sm);
    line-height: 1.6;
    margin: 1.5rem 0;
  }

  .prose :global(th) {
    font-family: "chillax", sans-serif;
    font-weight: var(--font-weight-semi-bold);
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 2px solid var(--color-stroke-strong);
  }

  .prose :global(td) {
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-stroke);
    vertical-align: top;
  }

  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-stroke);
    margin: 2.5rem 0;
  }

  @media (max-width: 769px) {
    h1 {
      font-size: var(--font-2xl);
    }

    .prose :global(h2) {
      font-size: var(--font-xl);
    }
  }
</style>
