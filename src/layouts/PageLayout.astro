---
import BaseHead, { type ArticleMeta, type Breadcrumb } from "../components/BaseHead.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CookieConsent from "../components/CookieConsent.astro";
import ThemeScript from "../components/ThemeScript.astro";
import { PALETTE, PALETTES } from "../consts";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  type?: "website" | "article";
  article?: ArticleMeta;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  breadcrumbs?: readonly Breadcrumb[];
  /**
   * Opt the page into light/dark theming: resolves the stored theme before
   * the first paint and puts the switch in the navbar. Pages that leave this
   * off never get a `data-theme` attribute and keep the light palette.
   */
  themeToggle?: boolean;
  /** Compact footer: legal links only, for pages that end on their offer. */
  compactFooter?: boolean;
}

const {
  title,
  description,
  image,
  type,
  article,
  jsonLd,
  noindex,
  breadcrumbs,
  themeToggle = false,
  compactFooter = false,
} = Astro.props;
---

<html lang="en" data-palette={PALETTE}>
  <head>
    {/* Preview the other palette with ?palette=<name>; kept for the session. */}
    <script is:inline define:vars={{ palettes: Object.keys(PALETTES) }}>
      (function () {
        try {
          var p = new URLSearchParams(location.search).get("palette");
          if (p && palettes.indexOf(p) !== -1) sessionStorage.setItem("palette", p);
          var stored = sessionStorage.getItem("palette");
          if (stored && palettes.indexOf(stored) !== -1)
            document.documentElement.setAttribute("data-palette", stored);
        } catch (e) {}
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      type={type}
      article={article}
      jsonLd={jsonLd}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
    />
    {themeToggle && <ThemeScript />}
  </head>

  <body>
    <Navbar themeToggle={themeToggle} />
    <main>
      <slot />
    </main>
    <Footer compact={compactFooter} />
    <CookieConsent />
  </body>
</html>
